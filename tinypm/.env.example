# TinyPM Environment Variables
# Copy this to .env and fill in your values
#
# Created: 2026-01-30
# Updated: 2026-01-30 - Production deployment configuration
#
# PRODUCTION DEPLOYMENT CHECKLIST:
# 1. Copy this file to .env
# 2. Fill in all required values
# 3. Set PRODUCTION_DOMAIN to your deployed URL
# 4. Update GOOGLE_REDIRECT_URI to production callback
# 5. Add production domain to Supabase allowed origins
# 6. Add production domain to Google OAuth redirect URIs

# ============================================
# PRODUCTION SETTINGS
# ============================================

# Your production domain (used for OAuth callbacks and CORS)
# Examples: https://tinypm.railway.app, https://tinypm.onrender.com
PRODUCTION_DOMAIN=

# Allowed CORS origins (comma-separated)
# Leave empty to allow PRODUCTION_DOMAIN only, or specify multiple
CORS_ALLOWED_ORIGINS=

# ============================================
# SUPABASE (required for cloud sync)
# ============================================
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for client-side)
SUPABASE_ANON_KEY=your-anon-key

# Service role key (keep secret, server-side only)
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT Secret for verifying Supabase tokens (REQUIRED for multi-tenancy)
# Get from: Project Settings > API > JWT Secret
# CRITICAL: Without this, JWT signature verification is skipped!
SUPABASE_JWT_SECRET=your-jwt-secret

# ============================================
# ANTHROPIC (required for AI)
# ============================================
# Get from: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=your-anthropic-key

# ============================================
# LANGSMITH (optional, for tracing/debugging)
# ============================================
# Get from: https://smith.langchain.com/settings

LANGSMITH_API_KEY=your-langsmith-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tinypm

# ============================================
# GOOGLE OAUTH - ONE-CLICK Calendar + Gmail
# ============================================
# FULL SETUP GUIDE: See GOOGLE_OAUTH_SETUP.md for step-by-step instructions
#
# Quick setup at: https://console.cloud.google.com
#
# SETUP STEPS:
# 1. Create a Google Cloud project
# 2. Enable Gmail API and Google Calendar API
# 3. Configure OAuth consent screen (External user type)
# 4. Create OAuth 2.0 Client ID (Web Application type)
# 5. Add authorized redirect URIs:
#    - http://localhost:8000/oauth/callback (development)
#    - https://YOUR_PRODUCTION_DOMAIN/oauth/callback (production)
# 6. Copy Client ID and Client Secret below
#
# SCOPES REQUESTED (user grants all in one click):
# - calendar.readonly - Read calendar events
# - calendar.events - Create/modify calendar events
# - gmail.readonly - Read emails
# - gmail.send - Send emails
# - gmail.modify - Mark read, labels, etc.
#
# SECURITY NOTE:
# TinyPM has HARD BOUNDARIES preventing access to Google Sheets/Drive.
# These scopes are explicitly FORBIDDEN to maintain separation from Tiny Seed OS.
#
# USAGE FLOW:
# 1. User visits: http://localhost:8000/oauth/google
# 2. Redirected to Google consent screen
# 3. Approves Calendar + Gmail access
# 4. Redirected back, tokens stored securely
# 5. Calendar and Email features immediately work!

# Your OAuth 2.0 Client ID (from Google Cloud Console > Credentials)
# Format: 123456789-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Your OAuth 2.0 Client Secret (from Google Cloud Console > Credentials)
# Format: GOCSPX-xxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# OAuth callback URL - MUST match EXACTLY in Google Cloud Console
# For local development:
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
# For production (uncomment and update):
# GOOGLE_REDIRECT_URI=https://your-domain.com/oauth/callback

# Alternative variable name used by oauth_manager.py
# (Both work, this is for compatibility)
TINYPM_OAUTH_REDIRECT=http://localhost:8000/oauth/callback

# ============================================
# OPENAI (optional, for model routing)
# ============================================
# Get from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your-openai-key

# ============================================
# TINYPM CONFIG
# ============================================

# Default autonomy level (1-5)
# 1 = Inform Only
# 2 = Suggest
# 3 = Propose
# 4 = Execute with Notify
# 5 = Full Autonomy
TINYPM_AUTONOMY_LEVEL=2

# Enable debug logging
TINYPM_DEBUG=false

# Port for web server (usually set by platform)
TINYPM_PORT=8000

# ============================================
# REMOTE TERMINAL BRIDGE (Developer Tier)
# ============================================
# WebSocket bridge for remote Claude Code access

# Bridge server host (0.0.0.0 = all interfaces)
REMOTE_BRIDGE_HOST=0.0.0.0

# Bridge server port (default 8765)
REMOTE_BRIDGE_PORT=8765

# IP whitelist (comma-separated, empty = allow all)
# Example: 192.168.1.100,10.0.0.50
REMOTE_BRIDGE_IP_WHITELIST=

# Token expiry in hours (default 168 = 1 week)
REMOTE_BRIDGE_TOKEN_EXPIRY=168

# ============================================
# A2A PROTOCOL AUTHENTICATION (SECURITY)
# ============================================
# API keys for external agents to access A2A endpoints
# CRITICAL: Without this, your A2A endpoints are PUBLIC

# Comma-separated list of valid API keys
# Generate keys with: python3 a2a_auth.py generate
# Example: A2A_API_KEYS=a2a_abc123,a2a_def456,a2a_ghi789
A2A_API_KEYS=

# Rate limit: requests per minute per API key (default 100)
A2A_RATE_LIMIT=100

# ============================================
# A2A SERVER (optional)
# ============================================

# A2A server port (default 9000)
A2A_PORT=9000

# A2A server host
A2A_HOST=0.0.0.0

# A2A base URL (for Agent Card discovery)
# Set to production URL in deployment
A2A_BASE_URL=http://localhost:9000
