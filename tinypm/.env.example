# TinyPM Environment Variables
# Copy this to .env and fill in your values
#
# Created: 2026-01-30
# Author: Backend_Agent_7

# ============================================
# SUPABASE (required for cloud sync)
# ============================================
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for client-side)
SUPABASE_ANON_KEY=your-anon-key

# Service role key (keep secret, server-side only)
SUPABASE_SERVICE_KEY=your-service-role-key

# ============================================
# ANTHROPIC (required for AI)
# ============================================
# Get from: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=your-anthropic-key

# ============================================
# LANGSMITH (optional, for tracing/debugging)
# ============================================
# Get from: https://smith.langchain.com/settings

LANGSMITH_API_KEY=your-langsmith-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=tinypm

# ============================================
# GOOGLE (optional, for calendar/email)
# ============================================
# Set up OAuth at: https://console.cloud.google.com

GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# ============================================
# OPENAI (optional, for model routing)
# ============================================
# Get from: https://platform.openai.com/api-keys

OPENAI_API_KEY=your-openai-key

# ============================================
# TINYPM CONFIG
# ============================================

# Default autonomy level (1-5)
# 1 = Inform Only
# 2 = Suggest
# 3 = Propose
# 4 = Execute with Notify
# 5 = Full Autonomy
TINYPM_AUTONOMY_LEVEL=2

# Enable debug logging
TINYPM_DEBUG=false

# Port for web server
TINYPM_PORT=8000
