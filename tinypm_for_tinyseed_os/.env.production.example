# ============================================
# TinyPM PRODUCTION Environment Variables
# ============================================
#
# DEPLOYMENT CHECKLIST:
# 1. Copy this file to .env in your deployment environment
# 2. Fill in ALL required values (marked with REQUIRED)
# 3. Set PRODUCTION_DOMAIN to your deployed URL
# 4. Update GOOGLE_REDIRECT_URI to production callback
# 5. Add production domain to Supabase allowed origins
# 6. Add production domain to Google OAuth redirect URIs
# 7. Test /api/health endpoint after deployment
#
# Created: 2026-01-30
# Purpose: Production deployment configuration

# ============================================
# PRODUCTION SETTINGS (REQUIRED)
# ============================================

# Your production domain - CRITICAL for OAuth callbacks and CORS
# Examples:
#   - Railway: https://tinypm-production.up.railway.app
#   - Render: https://tinypm.onrender.com
#   - Custom: https://tinypm.yourdomain.com
# DO NOT include trailing slash
PRODUCTION_DOMAIN=https://your-tinypm-domain.railway.app

# Port - Usually set automatically by Railway (leave empty)
# Railway sets this via $PORT environment variable
PORT=

# ============================================
# ANTHROPIC API (REQUIRED)
# ============================================
# Get from: https://console.anthropic.com/settings/keys
# This is REQUIRED for TinyPM to function

ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ============================================
# SUPABASE (REQUIRED for cloud sync)
# ============================================
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
#
# If you don't have Supabase:
# 1. Create free account at supabase.com
# 2. Create new project
# 3. Go to Project Settings > API
# 4. Copy URL and anon key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-key

# ============================================
# GOOGLE OAUTH (REQUIRED for Calendar/Email)
# ============================================
# Set up at: https://console.cloud.google.com
#
# SETUP STEPS:
# 1. Go to APIs & Services > Credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized redirect URIs:
#    - https://YOUR_PRODUCTION_DOMAIN/oauth/callback
# 4. Enable these APIs in your project:
#    - Google Calendar API
#    - Gmail API
# 5. Copy Client ID and Client Secret

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# CRITICAL: Update this to your production callback URL
# Format: https://YOUR_PRODUCTION_DOMAIN/oauth/callback
GOOGLE_REDIRECT_URI=https://your-tinypm-domain.railway.app/oauth/callback

# ============================================
# CORS SETTINGS
# ============================================
# Allowed origins for CORS (comma-separated)
# Usually just your production domain
# Leave empty to use PRODUCTION_DOMAIN only
CORS_ALLOWED_ORIGINS=

# ============================================
# LANGSMITH (Optional - for tracing)
# ============================================
# Get from: https://smith.langchain.com/settings
# Useful for debugging AI interactions

# LANGSMITH_API_KEY=your-langsmith-key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=tinypm-production

# ============================================
# OPENAI (Optional - for model routing)
# ============================================
# Get from: https://platform.openai.com/api-keys
# Only needed if using OpenAI models

# OPENAI_API_KEY=sk-your-openai-key

# ============================================
# TINYPM APPLICATION CONFIG
# ============================================

# Autonomy level (1-5)
# 1 = Inform Only
# 2 = Suggest (default)
# 3 = Propose
# 4 = Execute with Notify
# 5 = Full Autonomy
TINYPM_AUTONOMY_LEVEL=2

# Debug logging (set to false in production)
TINYPM_DEBUG=false

# ============================================
# REMOTE TERMINAL BRIDGE (Optional)
# ============================================
# WebSocket bridge for remote Claude Code access
# Only enable if you need remote terminal access

# REMOTE_BRIDGE_HOST=0.0.0.0
# REMOTE_BRIDGE_PORT=8765
# REMOTE_BRIDGE_IP_WHITELIST=
# REMOTE_BRIDGE_TOKEN_EXPIRY=168

# ============================================
# A2A PROTOCOL SECURITY (RECOMMENDED)
# ============================================
# API keys for external agents to access A2A endpoints
# Without this, your A2A endpoints are PUBLIC
# Generate keys with: python3 a2a_auth.py generate

A2A_API_KEYS=
A2A_RATE_LIMIT=100

# ============================================
# A2A SERVER (Optional)
# ============================================
# Only if running separate A2A server

# A2A_PORT=9000
# A2A_HOST=0.0.0.0
# A2A_BASE_URL=https://your-tinypm-domain.railway.app

# ============================================
# VERIFICATION CHECKLIST
# ============================================
# After deployment, verify:
#
# 1. Health check: curl https://YOUR_DOMAIN/api/health
#    Should return: {"status": "ok", ...}
#
# 2. OAuth flow: Visit https://YOUR_DOMAIN/oauth/google
#    Should redirect to Google consent screen
#
# 3. Dashboard: Visit https://YOUR_DOMAIN/
#    Should load the PM dashboard
#
# 4. Supabase: Check connection in dashboard
#    Tasks should sync to cloud
