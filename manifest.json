{
  "name": "Tiny Seed Farm - Field App",
  "short_name": "Field App",
  "description": "Employee field app for Tiny Seed Farm - time clock, tasks, harvest logging, scouting, and weather monitoring. Works offline for reliable field operations.",
  "start_url": "./employee.html",
  "id": "/employee.html",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0f172a",
  "theme_color": "#2d5a27",
  "orientation": "portrait-primary",
  "scope": "./",
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
