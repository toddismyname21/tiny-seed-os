  "shortcuts": [
    {
      "name": "Clock In",
      "short_name": "Clock In",
      "description": "Quick clock in for your shift",
      "url": "./employee.html?action=clockin",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "View Today's Tasks",
      "short_name": "Tasks",
      "description": "View and complete your tasks for today",
      "url": "./employee.html?tab=tasks",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Check Weather",
      "short_name": "Weather",
      "description": "View current weather conditions",
      "url": "./employee.html?tab=weather",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Log Harvest",
      "short_name": "Harvest",
      "description": "Record harvest data from the field",
      "url": "./employee.html?tab=harvest",
      "icons": [{ "src": "icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "categories": ["business", "productivity", "lifestyle"],
  "screenshots": [
    {
      "src": "screenshots/employee-dashboard.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Employee Dashboard - Track time, tasks, and weather"
    },
    {
      "src": "screenshots/task-management.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Task Management - Complete field tasks efficiently"
    },
    {
      "src": "screenshots/harvest-logging.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Harvest Logging - Record yields with AI assistance"
    },
    {
      "src": "screenshots/desktop-dashboard.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Farm Management Dashboard"
    }
  ],
  "related_applications": [],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "share_target": {
    "action": "./employee.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+tinyseed",
      "url": "./employee.html?action=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./employee.html",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp"],
        "text/csv": [".csv"]
      }
    }
  ]
}
