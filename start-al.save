      tmux new-session -d -s $session -c $PROJECT_DIR        
      echo "Started: $session"                               
    fi                                                       
  done                                                       
                                                             
  echo "All sessions created."                               
  tmux list-sessions        
nano /Users/samanthapollack/Documents/TIny_Seed_OS/st
