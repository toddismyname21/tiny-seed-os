  "sourceFormats": {
    "shopify_sales": {
      "name": "Shopify Sales by Product",
      "description": "Product-level sales export from Shopify Analytics",
      "requiredColumns": ["Product title", "Total sales"],
      "optionalColumns": ["Year", "Quantity ordered", "Net quantity", "Net sales", "Variant title"],
      "columnMappings": {
        "Product title": "productName",
        "Total sales": "revenue",
        "Net sales": "netRevenue",
        "Quantity ordered": "quantity",
        "Net quantity": "netQuantity",
        "Year": "year",
        "Variant title": "variant"
      },
      "amountFormat": {
        "prefix": "$",
        "thousandsSeparator": ",",
        "decimalSeparator": "."
      },
      "dateFormats": ["YYYY", "YYYY-MM-DD", "MM/DD/YYYY"]
    },

    "shopify_orders": {
      "name": "Shopify Orders Export",
      "description": "Individual order export from Shopify",
      "requiredColumns": ["Name", "Total", "Created at"],
      "optionalColumns": ["Lineitem name", "Lineitem quantity", "Lineitem price", "Email", "Billing Name", "Shipping Name"],
      "columnMappings": {
        "Name": "orderId",
        "Lineitem name": "productName",
        "Lineitem quantity": "quantity",
        "Lineitem price": "lineItemPrice",
        "Total": "orderTotal",
        "Created at": "orderDate",
        "Email": "customerEmail",
        "Billing Name": "customerName",
        "Shipping Name": "shippingName"
      },
      "dateFormats": ["YYYY-MM-DD HH:mm:ss", "YYYY-MM-DDTHH:mm:ssZ"]
    },

    "shopify_pos": {
      "name": "Shopify POS Transactions",
      "description": "Point of sale transactions from farmers markets",
      "requiredColumns": ["Order", "Date", "Total"],
      "optionalColumns": ["Location", "Product", "Quantity", "Payment Type", "Staff"],
      "columnMappings": {
        "Order": "orderId",
        "Date": "transactionDate",
        "Total": "amount",
        "Location": "location",
        "Product": "productName",
        "Quantity": "quantity",
        "Payment Type": "paymentMethod",
        "Staff": "staffMember"
      },
      "defaultCategory": "FARMERS_MARKET",
      "dateFormats": ["YYYY-MM-DD", "MM/DD/YYYY", "M/D/YYYY"]
    },

    "quickbooks_sales": {
      "name": "QuickBooks Sales Report",
      "description": "Sales by Customer/Product report from QuickBooks",
      "requiredColumns": ["Date", "Amount"],
      "optionalColumns": ["Customer", "Product/Service", "Qty", "Memo", "Class", "Account"],
      "columnMappings": {
        "Date": "transactionDate",
        "Amount": "amount",
        "Customer": "customerName",
        "Product/Service": "productName",
        "Qty": "quantity",
        "Memo": "description",
        "Class": "category",
        "Account": "account"
      },
      "amountFormat": {
        "prefix": "",
        "thousandsSeparator": ",",
        "decimalSeparator": ".",
        "negativeFormat": "parentheses"
      },
      "dateFormats": ["MM/DD/YYYY", "YYYY-MM-DD", "M/D/YY"]
    },

    "quickbooks_profit_loss": {
      "name": "QuickBooks Profit & Loss",
      "description": "P&L detail report from QuickBooks",
      "requiredColumns": ["Account", "Amount"],
      "optionalColumns": ["Date", "Memo", "Name", "Class"],
      "columnMappings": {
        "Account": "account",
        "Amount": "amount",
        "Date": "transactionDate",
        "Memo": "description",
        "Name": "customerName",
        "Class": "category"
      },
      "dateFormats": ["MM/DD/YYYY"]
    },

    "square_transactions": {
      "name": "Square Transaction History",
      "description": "Transaction export from Square POS",
      "requiredColumns": ["Date", "Gross Sales"],
      "optionalColumns": ["Time", "Net Sales", "Item", "Qty", "Location", "Payment Method"],
      "columnMappings": {
        "Date": "transactionDate",
        "Time": "transactionTime",
        "Gross Sales": "grossAmount",
        "Net Sales": "netAmount",
        "Item": "productName",
        "Qty": "quantity",
        "Location": "location",
        "Payment Method": "paymentMethod"
      },
      "defaultCategory": "FARMERS_MARKET",
      "dateFormats": ["MM/DD/YYYY", "YYYY-MM-DD"]
    },

    "generic_csv": {
      "name": "Generic CSV",
      "description": "Auto-detect column mappings using AI",
      "requiredColumns": [],
      "optionalColumns": [],
      "columnMappings": {},
      "useAIInference": true
    }
  },

  "classificationPriority": [
    "CSA_VEGETABLE",
    "FLOWER_SUBSCRIPTION",
    "PARTNER_ADDON",
    "WHOLESALE_RESTAURANT",
    "FARMERS_MARKET",
    "DIRECT_SALES"
  ],

  "fuzzyMatching": {
    "enabled": true,
    "minSimilarityThreshold": 0.8,
    "normalizeRules": {
      "removeWords": ["tiny seed", "farm", "pittsburgh", "local", "fresh", "generic", "retail", "pgh"],
      "removePunctuation": true,
      "lowercase": true,
      "collapseWhitespace": true
    }
  },

  "yearExtraction": {
    "pattern": "\\b(20\\d{2})\\b",
    "defaultToCurrent": true
  },

  "revenueAttribution": {
    "CSA_VEGETABLE": {
      "recognitionMethod": "full_at_signup",
      "supportsSeasonSpread": true,
      "description": "Revenue recognized when customer signs up for CSA"
    },
    "FLOWER_SUBSCRIPTION": {
      "recognitionMethod": "full_at_signup",
      "supportsSeasonSpread": true,
      "description": "Revenue recognized when customer signs up for flower subscription"
    },
    "PARTNER_ADDON": {
      "recognitionMethod": "at_delivery",
      "trackPartnerMargin": true,
      "description": "Revenue recognized at each delivery, margin tracked separately"
    },
    "FARMERS_MARKET": {
      "recognitionMethod": "daily_settlement",
      "description": "Revenue recognized daily at market close"
    },
    "WHOLESALE_RESTAURANT": {
      "recognitionMethod": "at_invoice",
      "defaultPaymentTerms": "Net 30",
      "description": "Revenue recognized when invoice is issued"
    },
    "DIRECT_SALES": {
      "recognitionMethod": "at_transaction",
      "description": "Revenue recognized immediately at point of sale"
    }
  },

  "validation": {
    "requiredFields": ["productName"],
    "recommendedFields": ["transactionDate", "amount", "source"],
    "warnings": {
      "missingYear": "No year detected in product name - will use current year",
      "missingAmount": "No amount/revenue found - row will be counted but not summed",
      "unknownCategory": "Product could not be categorized - marked as DIRECT_SALES"
    }
  },

  "reporting": {
    "defaultGroupBy": ["year", "category"],
    "availableGroupings": ["year", "category", "subcategory", "season", "month", "source"],
    "defaultMetrics": ["totalRevenue", "transactionCount", "averageOrderValue"],
    "availableMetrics": ["totalRevenue", "netRevenue", "transactionCount", "quantity", "averageOrderValue", "margin"]
  }
}
