  "fuzzy_matching": {
    "enabled": true,
    "min_similarity_threshold": 0.8,
    "normalize_rules": {
      "remove_words": ["tiny seed", "farm", "pittsburgh", "local", "fresh", "generic", "retail"],
      "remove_punctuation": true,
      "lowercase": true,
      "collapse_whitespace": true
    }
  },

  "year_extraction": {
    "pattern": "\\b(20\\d{2})\\b",
    "default_to_current": true
  },

  "classification_priority": [
    "CSA_SUBSCRIPTION",
    "FLOWER_SUBSCRIPTION",
    "PARTNER_ADDON",
    "WHOLESALE_RESTAURANT",
    "FARMERS_MARKET",
    "DIRECT_SALES"
  ],

  "revenue_attribution": {
    "CSA_SUBSCRIPTION": {
      "recognition_method": "full_at_signup",
      "supports_season_spread": true
    },
    "FLOWER_SUBSCRIPTION": {
      "recognition_method": "full_at_signup",
      "supports_season_spread": true
    },
    "PARTNER_ADDON": {
      "recognition_method": "at_delivery",
      "track_partner_margin": true
    },
    "FARMERS_MARKET": {
      "recognition_method": "daily_settlement"
    },
    "WHOLESALE_RESTAURANT": {
      "recognition_method": "at_invoice",
      "default_payment_terms": "Net 30"
    },
    "DIRECT_SALES": {
      "recognition_method": "at_transaction"
    }
  },

  "validation": {
    "required_fields": ["product_name", "transaction_date", "total_amount"],
    "recommended_fields": ["source_name", "customer_id", "location_id"]
  },

