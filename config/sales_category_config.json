{
  "version": "1.0",
  "last_updated": "2026-02-07",
  "description": "Tiny Seed Farm sales categorization configuration for AI parser",

  "categories": {
    "CSA_SUBSCRIPTION": {
      "display_name": "CSA Subscriptions",
      "description": "Community Supported Agriculture vegetable shares",
      "is_subscription": true,
      "primary_keywords": ["csa", "share", "subscription", "veggie share", "vegetable share", "farm share", "produce share", "community supported"],
      "exclude_if_contains": ["flower", "floral", "fleurs", "bouquet", "bloom", "dahlia", "add-on", "addon", "mushroom", "bread", "cheese", "coffee"]
    },

    "FLOWER_SUBSCRIPTION": {
      "display_name": "Flower Subscriptions",
      "description": "Recurring flower bouquet deliveries",
      "is_subscription": true,
      "primary_keywords": ["flower subscription", "floral subscription", "fleurs", "bouquet share", "bloom share", "dahlia csa", "flower csa"]
    },

    "PARTNER_ADDON": {
      "display_name": "Partner Add-Ons",
