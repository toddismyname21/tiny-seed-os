      "primary_keywords": ["add-on", "addon", "add on"],
      "margin_tracking": true
    },

    "FARMERS_MARKET": {
      "display_name": "Farmers Market Sales",
      "description": "POS transactions at farmers markets",
      "is_subscription": false,
      "source_identifiers": ["pos"],
      "requires_location": true
    },

    "WHOLESALE_RESTAURANT": {
      "display_name": "Wholesale/Restaurant",
      "description": "B2B sales to restaurants and commercial accounts",
      "is_subscription": false,
      "customer_type_identifiers": ["wholesale", "restaurant", "chef", "commercial"]
    },

    "DIRECT_SALES": {
      "display_name": "Direct Sales",
      "description": "Farm stand and online orders",
      "is_subscription": false,
      "is_default": true
    }
  },

