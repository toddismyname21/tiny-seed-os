# ─────────────────────────────────────────────────────────────────────
# CSA portal E2E / quality-harness env.
#
# Copy to .env.test (gitignored) OR rely on the existing .env — the
# Playwright loader (tests/e2e/load-env.ts) reads BOTH and never
# overrides values already set in the real environment (CI secrets win).
#
# The three Supabase vars below are the SAME ones the Astro app already
# uses; if your .env has them, you don't need this file locally. It exists
# to document what CI must provide as GitHub secrets.
# ─────────────────────────────────────────────────────────────────────

# Supabase project URL (public). e.g. https://<ref>.supabase.co
PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key — used to exchange the admin-minted
# magic-link token for a real session.
PUBLIC_SUPABASE_ANON_KEY=

# Supabase SERVICE-ROLE key (SECRET). Used ONLY by the test harness to:
#   - ensure the test member's auth user exists
#   - generate a magic-link token WITHOUT sending an email
#   - seed/clean the deterministic box-swap fixture
# Never commit a real value. In CI, store as the secret SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# The dedicated TEST MEMBER's email. MUST exist as a Supabase `customers`
# row with an active CSA share (customer_type='csa'). The harness will
# auto-create the matching auth.users entry if it's missing. Defaults to
# test@test.com when unset.
E2E_TEST_EMAIL=test@test.com

# Where Playwright + Lighthouse point. Defaults to the local preview.
# Set to a deployed Vercel preview URL to test the live build instead.
# PLAYWRIGHT_BASE_URL=http://localhost:4321
