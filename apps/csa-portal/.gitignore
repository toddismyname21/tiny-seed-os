# build output
dist/
# generated types
.astro/
# Vercel CLI link + prebuilt output (regenerated per deploy)
.vercel/

# dependencies
node_modules/

# Override repo-root .gitignore that excludes lockfiles globally — for the
# CSA portal we WANT package-lock.json committed for reproducible Vercel
# builds. (Root /.gitignore line 39 ignores it everywhere by default.)
!package-lock.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
.env.test
# ...but DO commit the documented example (root .gitignore's `.env.*`
# rule would otherwise swallow it).
!.env.test.example

# test / quality harness artifacts
tests/e2e/.auth/
test-results/
playwright-report/
blob-report/
.lighthouseci/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vercel
scripts/out/
.csa_inbox_state.json
