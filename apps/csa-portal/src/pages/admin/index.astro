---
/**
 * /admin — admin home / overview.
 *
 * Stats overview cards + pending-task callouts. All data is computed
 * server-side via parallel queries through the cookie-aware client.
 * RLS admin-bypass policies (migration 0017) ensure the admin sees
 * EVERY member row, not just their own.
 *
 * Sections (per spec):
 *   1. Stat cards — active members (overall + per share_type), recent
 *      signups (last 7 days)
 *   2. Members by pickup location (table)
 *   3. Pending tasks — three callouts:
 *      a. Unfilled box content for the next pickup Wednesday
 *      b. Members stuck in onboarding > 3 days
 *      c. Churn-risk members (active but no auth.users.last_sign_in_at
 *         within 30 days). NOTE: We can't read auth.users from RLS-scoped
 *         client; we approximate using members.updated_at as a proxy
 *         since middleware updates session tokens which fan out to
 *         updated_at via... actually no. We use a stricter proxy: members
 *         whose status='active' and whose customer's last_order_date is
 *         null or > 60 days ago. This is a defensible churn-risk signal.
 *   4. Quick links footer
 *
 * Mobile: cards stack to single column; everything horizontally
 * scrolls or wraps cleanly.
 */
import AdminShell from '../../components/AdminShell.astro';
import Card from '../../components/Card.astro';
import { DISPLAY_ORDER, countByBucket, type MemberShareRow } from '../../lib/share-buckets';
import { todayET, todayWeekdayET } from '../../lib/delivery';
import { resolveWeekSetup, upcomingSetupWeek } from '../../lib/week-setup';

const supabase = Astro.locals.supabase;

// ─── Next-week setup readiness (box / flex / market) ────────────────
// The prominent card at the top of the home page: does the UPCOMING cycle
// have its standard box, flex catalog, and market list set yet? Shares ONE
// readiness check with /api/cron/flex-list-reminder (lib/week-setup) so the
// banner and the reminder email can never disagree about what's missing.
const setupWeek = upcomingSetupWeek();
const weekSetup = await resolveWeekSetup(supabase, setupWeek);

// Day 9 — today's delivery route (if a route exists for the current date)
const todayDate = todayET();
const todayWeekday = todayWeekdayET();
type TodayRoute = {
  id: string;
  status: 'planned' | 'in_progress' | 'completed' | 'cancelled';
  total_stops: number;
  completed_stops: number;
};
const { data: todayRouteRows } = await supabase
  .from('delivery_routes')
  .select('id, status, total_stops, completed_stops')
  .eq('route_date', todayDate)
  .order('created_at', { ascending: false })
  .limit(1)
  .overrideTypes<TodayRoute[], { merge: false }>();
const todayRoute = todayRouteRows?.[0] ?? null;
const isDeliveryDay = todayWeekday === 'Wed';

// ─────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────
function upcomingWednesday(now: Date = new Date()): string {
  // Same logic as dashboard.astro — compute "this week's pickup" in ET.
  const fmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short',
  });
  const parts = fmt.formatToParts(now);
  const get = (t: string): string => parts.find((p) => p.type === t)?.value ?? '';
  const dayIndex: Record<string, number> = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
  const todayIdx = dayIndex[get('weekday')] ?? 0;
  const daysUntilWed = (3 - todayIdx + 7) % 7;
  const todayET = new Date(`${get('year')}-${get('month')}-${get('day')}T00:00:00-05:00`);
  const wed = new Date(todayET.getTime() + daysUntilWed * 86_400_000);
  return new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric', month: '2-digit', day: '2-digit',
  }).format(wed);
}

const targetWeek = upcomingWednesday();
const targetWeekPretty = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric',
  timeZone: 'America/New_York',
}).format(new Date(`${targetWeek}T12:00:00-04:00`));

const today = new Date();
const sevenDaysAgo = new Date(today.getTime() - 7 * 86_400_000).toISOString();
const threeDaysAgo = new Date(today.getTime() - 3 * 86_400_000).toISOString();

// ─────────────────────────────────────────────────────────────────────
// Parallel data fetches
// ─────────────────────────────────────────────────────────────────────
const [
  activeCountRes,
  byShareTypeRes,
  byLocationRes,
  recentSignupsRes,
  unfilledBoxRes,
  stalledOnboardingRes,
  totalMembersRes,
] = await Promise.all([
  supabase.from('members').select('id', { count: 'exact', head: true }).eq('status', 'active'),
  supabase.from('members').select('share_type, share_size, biweekly_week, status').eq('status', 'active'),
  supabase.from('members')
    .select('pickup_location_id, pickup_location:pickup_locations(name, day_of_week, max_capacity)')
    .eq('status', 'active'),
  supabase.from('members')
    .select('id, share_type, season, status, created_at, customer:customers(contact_name, email)')
    .gte('created_at', sevenDaysAgo)
    .order('created_at', { ascending: false })
    .limit(10),
  supabase.from('box_contents')
    .select('share_type', { count: 'exact', head: false })
    .eq('week_date', targetWeek),
  supabase.from('members')
    .select('id, share_type, customer:customers(contact_name, email)')
    .eq('status', 'onboarding')
    .lte('created_at', threeDaysAgo)
    .order('created_at', { ascending: true })
    .limit(20),
  supabase.from('members').select('id', { count: 'exact', head: true }),
]);

const activeCount = activeCountRes.count ?? 0;
const totalCount = totalMembersRes.count ?? 0;

// ─── Share-type breakdown (granular) ────────────────────────────────
// We bucket each active member into one of the granular display
// groups defined in lib/share-buckets.ts (Summer Small Weekly, Summer
// Large Bi-weekly Wk A, Add-on Weekly, etc.). The simple share_type
// rollup is still kept around for the "unfilled boxes" task pill.
type ShareBreakdownRow = {
  share_type: string;
  share_size: string | null;
  biweekly_week: 'A' | 'B' | null;
  status: string;
};
const shareBreakdownRows = (byShareTypeRes.data ?? []) as unknown as ShareBreakdownRow[];
const byShareType = new Map<string, number>();
for (const row of shareBreakdownRows) {
  byShareType.set(row.share_type, (byShareType.get(row.share_type) ?? 0) + 1);
}
const bucketCounts = countByBucket(shareBreakdownRows as ReadonlyArray<MemberShareRow>);

// How many active members still need a Week A/B assignment? Drives
// the "Auto-assign" panel below.
const unassignedBiweeklyCount = shareBreakdownRows.filter(
  (r) => r.biweekly_week === null
).length;

// ─── Location breakdown ─────────────────────────────────────────────
type LocationBreakdownRow = {
  pickup_location_id: string | null;
  pickup_location: { name: string; day_of_week: string | null; max_capacity: number | null } | null;
};
type LocationStat = {
  name: string;
  day: string | null;
  capacity: number | null;
  count: number;
};
const locationStats = new Map<string, LocationStat>();
let homeDeliveryCount = 0;
for (const row of (byLocationRes.data ?? []) as unknown as LocationBreakdownRow[]) {
  if (!row.pickup_location_id) {
    homeDeliveryCount += 1;
    continue;
  }
  const loc = row.pickup_location;
  const key = row.pickup_location_id;
  if (!locationStats.has(key)) {
    locationStats.set(key, {
      name: loc?.name ?? '(unknown)',
      day: loc?.day_of_week ?? null,
      capacity: loc?.max_capacity ?? null,
      count: 0,
    });
  }
  locationStats.get(key)!.count += 1;
}
const sortedLocations = Array.from(locationStats.values()).sort((a, b) => b.count - a.count);

// ─── Recent signups ─────────────────────────────────────────────────
type SignupRow = {
  id: string;
  share_type: string;
  season: string;
  status: string;
  created_at: string;
  customer: { contact_name: string; email: string } | null;
};
const recentSignups = (recentSignupsRes.data ?? []) as unknown as SignupRow[];

// ─── Unfilled box content for upcoming Wed ──────────────────────────
// We expect box_contents rows for each ACTIVE share_type in production.
// Anything missing → flag it for Todd.
const expectedShareTypes = new Set(Array.from(byShareType.keys()));
const filledShareTypes = new Set<string>();
type BoxStub = { share_type: string };
for (const row of (unfilledBoxRes.data ?? []) as BoxStub[]) {
  filledShareTypes.add(row.share_type);
}
const unfilledShareTypes = Array.from(expectedShareTypes).filter((s) => !filledShareTypes.has(s));

// ─── Stalled onboarding ─────────────────────────────────────────────
type StalledOnboardingRow = {
  id: string;
  share_type: string;
  customer: { contact_name: string; email: string } | null;
};
const stalledOnboarding = (stalledOnboardingRes.data ?? []) as unknown as StalledOnboardingRow[];

// ─── Churn-risk count (lightweight) ─────────────────────────────────
// Members with status='active' whose customer.last_order_date is older
// than 60 days OR null. Could be heavy; we cap at counting only.
const churnRes = await supabase
  .from('members')
  .select('id, customer:customers!inner(last_order_date)', { count: 'exact', head: false })
  .eq('status', 'active');

type ChurnRow = { id: string; customer: { last_order_date: string | null } | null };
const sixtyDaysAgo = new Date(today.getTime() - 60 * 86_400_000);
let churnRiskCount = 0;
for (const row of (churnRes.data ?? []) as unknown as ChurnRow[]) {
  const lod = row.customer?.last_order_date;
  if (!lod) {
    churnRiskCount += 1;
    continue;
  }
  if (new Date(lod) < sixtyDaysAgo) churnRiskCount += 1;
}

// ─────────────────────────────────────────────────────────────────────
// Label helpers
// ─────────────────────────────────────────────────────────────────────
const SHARE_LABEL: Record<string, string> = {
  spring_veg: 'Spring Veg',
  summer_veg: 'Summer Veg',
  fall_veg: 'Fall Veg',
  flower: 'Flower',
  flex: 'Flex',
  add_on: 'Add-on',
  wholesale_csa: 'Wholesale',
};

const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};

function shareLabel(s: string): string { return SHARE_LABEL[s] ?? s; }

// Pending-task pill count for header
const pendingTaskCount =
  unfilledShareTypes.length + stalledOnboarding.length + (churnRiskCount > 0 ? 1 : 0);
---

<AdminShell
  title="Admin overview"
  subtitle={`${activeCount} active members across ${sortedLocations.length} pickup locations`}
  pageTitle="Admin overview — Tiny Seed"
  canonical="https://csa.tinyseedfarm.com/admin"
>
  {/* ════ Set up next week (box · flex · market) ════ */}
  <section aria-labelledby="setup-heading" class="flex flex-col gap-3">
    <h2 id="setup-heading" class="sr-only">Next week setup</h2>
    {weekSetup.allReady ? (
      <Card tone="primary" padding="md" elevation="sm">
        <div class="flex items-center gap-3">
          <span class="text-2xl" aria-hidden="true">✅</span>
          <div class="min-w-0">
            <p class="font-semibold text-ts-text">Next week is ready</p>
            <p class="text-sm text-ts-text-secondary">
              Box, Flex, and Market are all set for <span class="font-medium text-ts-text">{weekSetup.weekLabel}</span>.
            </p>
          </div>
        </div>
      </Card>
    ) : (
      <Card tone="warning" padding="md" elevation="md">
        <div class="flex flex-col gap-4">
          <div class="flex items-start gap-3">
            <span class="text-2xl" aria-hidden="true">🗓️</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-lg font-bold text-ts-text">
                Set up next week
              </p>
              <p class="mt-0.5 text-sm text-ts-text-secondary">
                {weekSetup.weekLabel} —{' '}
                <span class="font-semibold text-ts-warning">
                  {weekSetup.missing.length} of {weekSetup.items.length}
                </span>{' '}
                still need setting.
              </p>
            </div>
          </div>

          <ul class="grid grid-cols-1 gap-2 sm:grid-cols-3">
            {weekSetup.items.map((item) => (
              <li>
                <a
                  href={`${item.href}?week=${weekSetup.week}`}
                  class={[
                    'flex min-h-11 items-center gap-3 rounded-ts-md border px-3 py-2.5 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary',
                    item.set
                      ? 'border-ts-primary/30 bg-ts-primary/5 hover:bg-ts-primary/10'
                      : 'border-ts-warning/40 bg-ts-warning-bg/40 hover:bg-ts-warning-bg/60',
                  ].join(' ')}
                >
                  <span class="text-xl leading-none" aria-hidden="true">
                    {item.set ? '✅' : '☐'}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-ts-text">{item.label}</span>
                    <span class={[
                      'block text-xs font-medium',
                      item.set ? 'text-ts-primary' : 'text-ts-warning',
                    ].join(' ')}>
                      {item.set ? 'Set' : 'Not set — open editor'}
                    </span>
                  </span>
                  <span class="shrink-0 text-ts-text-muted" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Card>
    )}
  </section>

  {/* ════ Stat row ════ */}
  <section aria-labelledby="stats-heading" class="flex flex-col gap-3">
    <h2 id="stats-heading" class="sr-only">Stats</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">
          Active members
        </div>
        <div class="mt-1 font-display text-3xl font-bold text-ts-text tabular-nums sm:text-4xl">
          {activeCount}
        </div>
        <div class="mt-1 text-xs text-ts-text-secondary">
          of {totalCount} total
        </div>
      </Card>

      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">
          Recent signups
        </div>
        <div class="mt-1 font-display text-3xl font-bold text-ts-text tabular-nums sm:text-4xl">
          {recentSignups.length}
        </div>
        <div class="mt-1 text-xs text-ts-text-secondary">last 7 days</div>
      </Card>

      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">
          Pending tasks
        </div>
        <div class={[
          'mt-1 font-display text-3xl font-bold tabular-nums sm:text-4xl',
          pendingTaskCount > 0 ? 'text-ts-warning' : 'text-ts-text',
        ].join(' ')}>
          {pendingTaskCount}
        </div>
        <div class="mt-1 text-xs text-ts-text-secondary">
          {pendingTaskCount === 0 ? "you're all caught up" : 'need attention'}
        </div>
      </Card>

      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">
          Home deliveries
        </div>
        <div class="mt-1 font-display text-3xl font-bold text-ts-text tabular-nums sm:text-4xl">
          {homeDeliveryCount}
        </div>
        <div class="mt-1 text-xs text-ts-text-secondary">active</div>
      </Card>
    </div>
  </section>

  {/* ════ Today's route (Day 9) ════ */}
  <section aria-labelledby="today-route-heading" class="flex flex-col gap-4">
    <h2 id="today-route-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
      Today's route
    </h2>
    <Card padding="md" elevation="sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0 flex-1">
          {todayRoute ? (
            <>
              <p class="font-semibold text-ts-text">
                Route {todayRoute.status === 'in_progress' ? 'in progress' : todayRoute.status}
              </p>
              <p class="mt-1 text-sm text-ts-text-secondary tabular-nums">
                {todayRoute.completed_stops} of {todayRoute.total_stops} stops done
              </p>
            </>
          ) : isDeliveryDay ? (
            <>
              <p class="font-semibold text-ts-text">
                No route created for today yet
              </p>
              <p class="mt-1 text-sm text-ts-text-secondary">
                Wednesday is a delivery day. Open the Route page to auto-seed stops.
              </p>
            </>
          ) : (
            <>
              <p class="font-semibold text-ts-text-secondary">
                Not a delivery day
              </p>
              <p class="mt-1 text-sm text-ts-text-muted">
                Routes run on Wednesdays. View past routes via the Route page.
              </p>
            </>
          )}
        </div>
        <a
          href={todayRoute ? `/admin/route/${todayRoute.id}` : '/admin/route'}
          class="inline-flex h-11 shrink-0 items-center justify-center rounded-ts-md bg-ts-primary px-5 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          {todayRoute ? 'Open route →' : 'Open Route page →'}
        </a>
      </div>
    </Card>
  </section>

  {/* ════ Sync health link ════ */}
  <section aria-labelledby="sync-heading" class="flex flex-col gap-4">
    <h2 id="sync-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
      Sync health
    </h2>
    <Card padding="md" elevation="sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 flex-1 items-start gap-3">
          <span class="text-2xl" aria-hidden="true">🔄</span>
          <div class="min-w-0">
            <p class="font-semibold text-ts-text">Shopify → Supabase order sync</p>
            <p class="mt-1 text-sm text-ts-text-secondary">
              Runs every 15 min, issuing store credit + referral payouts. Check the
              last run, any errored orders, and recent money activity.
            </p>
          </div>
        </div>
        <a
          href="/admin/sync"
          class="inline-flex h-11 shrink-0 items-center justify-center rounded-ts-md bg-ts-primary px-5 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          View sync health →
        </a>
      </div>
    </Card>
  </section>

  {/* ════ Weekly email link ════ */}
  <section aria-labelledby="weekly-email-heading" class="flex flex-col gap-4">
    <h2 id="weekly-email-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
      Weekly email
    </h2>
    <Card padding="md" elevation="sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 flex-1 items-start gap-3">
          <span class="text-2xl" aria-hidden="true">✉️</span>
          <div class="min-w-0">
            <p class="font-semibold text-ts-text">This week's box email</p>
            <p class="mt-1 text-sm text-ts-text-secondary">
              Preview the box-matched recipe email, send a test, then send to
              opted-in members. Manage the recipe library that feeds it.
            </p>
          </div>
        </div>
        <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
          <a
            href="/admin/recipes"
            class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            Recipes
          </a>
          <a
            href="/admin/weekly-email"
            class="inline-flex h-11 items-center justify-center rounded-ts-md bg-ts-primary px-5 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            Compose &amp; send →
          </a>
        </div>
      </div>
    </Card>
  </section>

  {/* ════ Pending tasks ════ */}
  <section aria-labelledby="pending-heading" class="flex flex-col gap-4">
    <h2 id="pending-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
      Pending tasks
    </h2>

    {pendingTaskCount === 0 ? (
      <Card tone="primary" padding="md" elevation="sm">
        <div class="flex items-center gap-3">
          <span class="text-2xl" aria-hidden="true">✓</span>
          <div>
            <p class="font-semibold text-ts-text">All caught up.</p>
            <p class="text-sm text-ts-text-secondary">No outstanding admin tasks.</p>
          </div>
        </div>
      </Card>
    ) : (
      <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
        {unfilledShareTypes.length > 0 && (
          <Card tone="warning" padding="md" elevation="sm">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">📦</span>
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ts-text">
                  Unfilled boxes for {targetWeekPretty}
                </p>
                <p class="mt-1 text-sm text-ts-text-secondary">
                  {unfilledShareTypes.map((s) => shareLabel(s)).join(', ')}
                </p>
                <a
                  href={`/admin/box-contents?week=${targetWeek}`}
                  class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-ts-warning hover:underline"
                >
                  Fill now <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </Card>
        )}

        {stalledOnboarding.length > 0 && (
          <Card tone="warning" padding="md" elevation="sm">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">⏳</span>
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ts-text">
                  Onboarding stalled &gt; 3 days
                </p>
                <p class="mt-1 text-sm text-ts-text-secondary tabular-nums">
                  {stalledOnboarding.length}
                  {' '}
                  {stalledOnboarding.length === 1 ? 'member' : 'members'}
                </p>
                <a
                  href="/admin/members?status=onboarding"
                  class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-ts-warning hover:underline"
                >
                  Review <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </Card>
        )}

        {churnRiskCount > 0 && (
          <Card tone="warning" padding="md" elevation="sm">
            <div class="flex items-start gap-3">
              <span class="text-2xl" aria-hidden="true">📉</span>
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ts-text">Churn-risk members</p>
                <p class="mt-1 text-sm text-ts-text-secondary tabular-nums">
                  {churnRiskCount} active, last order &gt; 60 days
                </p>
                <a
                  href="/admin/reports#churn"
                  class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-ts-warning hover:underline"
                >
                  Report <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </Card>
        )}
      </div>
    )}
  </section>

  {/* ════ Members by share (granular) ════ */}
  <section aria-labelledby="share-heading" class="flex flex-col gap-4">
    <div class="flex items-baseline justify-between gap-3">
      <h2 id="share-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
        Members by share
      </h2>
      <span class="text-xs text-ts-text-muted">
        Every member is bi-weekly · Week A · Week B · Unassigned = needs assignment
      </span>
    </div>
    <Card padding="none" elevation="sm">
      <ul class="divide-y divide-ts-border/60">
        {DISPLAY_ORDER
          .filter((def) => (bucketCounts.get(def.id) ?? 0) > 0)
          .map((def) => {
            const count = bucketCounts.get(def.id) ?? 0;
            const pct = activeCount > 0 ? Math.round((count / activeCount) * 100) : 0;
            const isUnknown = def.id === 'unknown';
            return (
              <li class="flex items-center gap-4 px-5 py-3 sm:px-6">
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <a
                      href={`/admin/members?share_bucket=${def.id}&status=active`}
                      class={[
                        'truncate font-medium underline-offset-2 hover:underline',
                        isUnknown ? 'text-ts-warning' : 'text-ts-text hover:text-ts-primary',
                      ].join(' ')}
                    >
                      {def.label}
                    </a>
                    <span class="shrink-0 text-sm text-ts-text-secondary tabular-nums">
                      {count} · {pct}%
                    </span>
                  </div>
                  <div
                    class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-ts-bg-muted"
                    role="progressbar"
                    aria-valuenow={pct}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-label={`${def.label}: ${pct}% of active members`}
                  >
                    <div
                      class={[
                        'h-full rounded-full',
                        isUnknown ? 'bg-ts-warning' : 'bg-ts-primary',
                      ].join(' ')}
                      style={`width: ${pct}%`}
                    ></div>
                  </div>
                </div>
              </li>
            );
          })
        }
        {Array.from(bucketCounts.values()).reduce((a, b) => a + b, 0) === 0 && (
          <li class="px-5 py-6 text-center text-sm text-ts-text-muted sm:px-6">
            No active members yet.
          </li>
        )}
      </ul>
      {(bucketCounts.get('unknown') ?? 0) > 0 && (
        <div class="border-t border-ts-border/60 bg-ts-warning-bg/40 px-5 py-3 text-xs text-ts-text-secondary sm:px-6">
          <strong class="font-semibold text-ts-warning">
            {bucketCounts.get('unknown')} unbucketed
          </strong>
          {' '}member{(bucketCounts.get('unknown') ?? 0) === 1 ? '' : 's'} need a valid
          {' '}<code class="rounded bg-ts-bg-muted px-1 py-0.5 font-mono text-[11px]">share_size</code>{' '}
          assignment. Open any unbucketed row to set it.
        </div>
      )}
    </Card>
  </section>

  {/* ════ Auto-assign bi-weekly schedule ════ */}
  <section aria-labelledby="biweekly-heading" class="flex flex-col gap-4">
    <h2 id="biweekly-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
      Auto-assign bi-weekly schedule
    </h2>
    <Card padding="md" elevation="sm">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0 flex-1">
          <p class="text-sm leading-relaxed text-ts-text">
            <span class="tabular-nums font-semibold">{unassignedBiweeklyCount}</span>
            {' '}of <span class="tabular-nums">{activeCount}</span> active member{activeCount === 1 ? '' : 's'}
            {' '}{unassignedBiweeklyCount === 1 ? 'is' : 'are'} missing a Week A or Week B assignment.
          </p>
          <p class="mt-1 text-xs text-ts-text-muted">
            The algorithm balances each pickup location's headcount across Week A
            and Week B. Members who already have a week stay put.
          </p>
        </div>
        {unassignedBiweeklyCount > 0 ? (
          <button
            type="button"
            data-biweekly-open
            class="inline-flex h-10 shrink-0 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            Preview &amp; auto-assign
          </button>
        ) : (
          <span class="inline-flex items-center gap-2 rounded-ts-md bg-ts-primary/10 px-3 py-2 text-xs font-semibold text-ts-primary">
            <span aria-hidden="true">✓</span> All members assigned
          </span>
        )}
      </div>
    </Card>
  </section>

  {/* ════ Auto-assign modal ════ */}
  {unassignedBiweeklyCount > 0 && (
    <div
      id="biweekly-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
      data-biweekly-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby="biweekly-modal-heading"
    >
      <div class="w-full max-w-lg rounded-ts-xl bg-ts-bg-surface p-6 shadow-ts-lg">
        <header class="flex items-start justify-between gap-4">
          <div>
            <h3 id="biweekly-modal-heading" class="font-display text-lg font-bold text-ts-text">
              Auto-assign bi-weekly schedule
            </h3>
            <p class="mt-1 text-sm text-ts-text-secondary">
              This will assign Week A or Week B to all {unassignedBiweeklyCount}
              {' '}member{unassignedBiweeklyCount === 1 ? '' : 's'} who don't have one yet.
            </p>
          </div>
          <button
            type="button"
            data-biweekly-close
            aria-label="Close dialog"
            class="rounded-ts-md p-1 text-ts-text-muted transition-colors hover:bg-ts-bg-muted hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            <span aria-hidden="true">×</span>
          </button>
        </header>

        <ul class="mt-4 space-y-1.5 text-sm text-ts-text-secondary">
          <li class="flex gap-2"><span aria-hidden="true">·</span><span>Balances each location's A/B headcount.</span></li>
          <li class="flex gap-2"><span aria-hidden="true">·</span><span>Members who already have Week A or Week B will <strong class="font-medium text-ts-text">not</strong> be changed.</span></li>
          <li class="flex gap-2"><span aria-hidden="true">·</span><span>Members can change their own week later via the member portal.</span></li>
        </ul>

        <div
          data-biweekly-preview
          class="mt-4 max-h-64 overflow-y-auto rounded-ts-md border border-ts-border bg-ts-bg-base p-3 text-xs text-ts-text-muted"
        >
          <p class="text-center" data-biweekly-preview-loading>Loading preview…</p>
        </div>

        <div
          role="alert"
          aria-live="polite"
          class="mt-3 hidden rounded-ts-md border border-ts-danger/30 bg-ts-danger/5 px-3 py-2 text-xs text-ts-danger"
          data-biweekly-error
        ></div>

        <footer class="mt-5 flex flex-col-reverse items-stretch gap-2 sm:flex-row sm:items-center sm:justify-end">
          <button
            type="button"
            data-biweekly-close
            class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-medium text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            Cancel
          </button>
          <button
            type="button"
            data-biweekly-confirm
            disabled
            class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span data-biweekly-confirm-label>Confirm auto-assign</span>
          </button>
        </footer>
      </div>
    </div>

    <script is:inline>
      // Auto-assign modal logic — vanilla JS, no framework. Hooks:
      //   data-biweekly-open    → open the modal + fetch the preview
      //   data-biweekly-close   → close the modal
      //   data-biweekly-confirm → POST to /api/admin/biweekly/auto-assign
      //
      // The confirm button stays DISABLED until the preview successfully
      // loads — so the admin can't fire a write blindly.
      (function () {
        const modal      = document.querySelector('[data-biweekly-modal]');
        const opener     = document.querySelector('[data-biweekly-open]');
        const closers    = document.querySelectorAll('[data-biweekly-close]');
        const previewBox = document.querySelector('[data-biweekly-preview]');
        const errorBox   = document.querySelector('[data-biweekly-error]');
        const confirmBtn = document.querySelector('[data-biweekly-confirm]');
        const confirmLbl = document.querySelector('[data-biweekly-confirm-label]');

        if (!modal || !opener || !previewBox || !confirmBtn) return;

        function setError(msg) {
          if (!errorBox) return;
          if (!msg) {
            errorBox.classList.add('hidden');
            errorBox.textContent = '';
          } else {
            errorBox.classList.remove('hidden');
            errorBox.textContent = msg;
          }
        }

        function open() {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          confirmBtn.disabled = true;
          confirmBtn.removeAttribute('data-loaded');
          setError(null);
          previewBox.innerHTML = '<p class="text-center">Loading preview…</p>';
          fetch('/api/admin/biweekly/auto-assign?preview=1', {
            method: 'GET',
            credentials: 'same-origin',
            headers: { accept: 'application/json' },
          })
            .then((r) => r.json().then((j) => ({ status: r.status, body: j })))
            .then(({ status, body }) => {
              if (status !== 200 || !body || body.ok !== true) {
                setError((body && body.error) || 'Could not load preview.');
                return;
              }
              renderPreview(body);
              confirmBtn.disabled = false;
              confirmBtn.setAttribute('data-loaded', '1');
            })
            .catch(() => setError('Network error. Try again.'));
        }

        function renderPreview(payload) {
          const rows = (payload.byLocation || []);
          if (rows.length === 0) {
            previewBox.innerHTML = '<p class="text-center">Nothing to assign — every active member already has a week.</p>';
            return;
          }
          const html = [
            '<table class="w-full text-left text-xs"><thead><tr class="border-b border-ts-border/60 text-ts-text-muted">',
            '<th class="py-1.5 pr-2 font-semibold">Location</th>',
            '<th class="py-1.5 pr-2 text-right font-semibold">Total</th>',
            '<th class="py-1.5 pr-2 text-right font-semibold">→ A</th>',
            '<th class="py-1.5 text-right font-semibold">→ B</th>',
            '</tr></thead><tbody>',
            ...rows.map((r) => {
              const name = String(r.location_name || '');
              return [
                '<tr class="border-b border-ts-border/30 last:border-b-0">',
                '<td class="py-1.5 pr-2 text-ts-text">' + escapeHtml(name) + '</td>',
                '<td class="py-1.5 pr-2 text-right tabular-nums text-ts-text-secondary">' + r.unassigned + '</td>',
                '<td class="py-1.5 pr-2 text-right tabular-nums text-ts-primary">' + r.to_a + '</td>',
                '<td class="py-1.5 text-right tabular-nums text-ts-primary">' + r.to_b + '</td>',
                '</tr>',
              ].join('');
            }),
            '</tbody><tfoot><tr class="border-t border-ts-border/60 font-semibold text-ts-text">',
            '<td class="pt-2 pr-2">Total</td>',
            '<td class="pt-2 pr-2 text-right tabular-nums">' + (payload.totals?.unassigned ?? 0) + '</td>',
            '<td class="pt-2 pr-2 text-right tabular-nums">' + (payload.totals?.to_a ?? 0) + '</td>',
            '<td class="pt-2 text-right tabular-nums">' + (payload.totals?.to_b ?? 0) + '</td>',
            '</tr></tfoot></table>',
          ].join('');
          previewBox.innerHTML = html;
        }

        function escapeHtml(s) {
          return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        function close() {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        function confirm() {
          if (confirmBtn.disabled) return;
          confirmBtn.disabled = true;
          if (confirmLbl) confirmLbl.textContent = 'Assigning…';
          setError(null);
          fetch('/api/admin/biweekly/auto-assign', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { accept: 'application/json' },
            // Empty body — auth-cookie carries identity, no payload needed.
            body: new FormData(),
          })
            .then((r) => r.json().then((j) => ({ status: r.status, body: j })))
            .then(({ status, body }) => {
              if (status !== 200 || !body || body.ok !== true) {
                setError((body && body.error) || 'Auto-assign failed.');
                confirmBtn.disabled = false;
                if (confirmLbl) confirmLbl.textContent = 'Confirm auto-assign';
                return;
              }
              // Reload to refresh all counts. Cheaper than building a
              // toast + manually re-querying.
              window.location.reload();
            })
            .catch(() => {
              setError('Network error. Try again.');
              confirmBtn.disabled = false;
              if (confirmLbl) confirmLbl.textContent = 'Confirm auto-assign';
            });
        }

        opener.addEventListener('click', open);
        closers.forEach((c) => c.addEventListener('click', close));
        confirmBtn.addEventListener('click', confirm);
        // Close on backdrop click + ESC.
        modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
        });
      })();
    </script>
  )}

  {/* ════ Members by pickup location ════ */}
  <section aria-labelledby="locations-heading" class="flex flex-col gap-4">
    <div class="flex items-baseline justify-between">
      <h2 id="locations-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
        Members by pickup location
      </h2>
      <a
        href="/admin/pickup-locations"
        class="text-sm font-medium text-ts-primary underline-offset-2 hover:underline"
      >
        Manage locations →
      </a>
    </div>
    <Card padding="none" elevation="sm">
      <ul class="divide-y divide-ts-border/60">
        {sortedLocations.length === 0 && homeDeliveryCount === 0 && (
          <li class="px-5 py-6 text-center text-sm text-ts-text-muted sm:px-6">
            No active pickup locations.
          </li>
        )}
        {sortedLocations.map((loc) => {
          const overCapacity = loc.capacity !== null && loc.count > loc.capacity;
          const nearCapacity = loc.capacity !== null && !overCapacity && loc.count >= 0.8 * loc.capacity;
          return (
            <li class="flex items-center gap-4 px-5 py-3 sm:px-6">
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <span class="truncate font-medium text-ts-text">{loc.name}</span>
                  <span class={[
                    'shrink-0 text-sm font-semibold tabular-nums',
                    overCapacity ? 'text-ts-danger' :
                    nearCapacity ? 'text-ts-warning' :
                    'text-ts-text-secondary',
                  ].join(' ')}>
                    {loc.count}
                    {loc.capacity !== null ? ` / ${loc.capacity}` : ''}
                  </span>
                </div>
                <p class="mt-0.5 text-xs text-ts-text-muted">
                  {loc.day ? DAY_LONG[loc.day] ?? loc.day : 'Day TBD'}
                </p>
              </div>
            </li>
          );
        })}
        {homeDeliveryCount > 0 && (
          <li class="flex items-center gap-4 bg-ts-bg-muted/30 px-5 py-3 sm:px-6">
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline justify-between gap-3">
                <a
                  href="/admin/members?pickup_location=home_delivery&status=active"
                  class="truncate font-medium text-ts-text underline-offset-2 hover:text-ts-primary hover:underline"
                >
                  Home delivery / no pickup assigned
                </a>
                <span class="shrink-0 text-sm font-semibold text-ts-text-secondary tabular-nums">
                  {homeDeliveryCount}
                </span>
              </div>
              <p class="mt-0.5 text-xs text-ts-text-muted">
                Members with no <code class="rounded bg-ts-bg-muted px-1 py-0.5 font-mono text-[11px]">pickup_location_id</code>
                {' '}(home delivery, on-farm, or unassigned)
              </p>
            </div>
          </li>
        )}
      </ul>
      {/* Reconciliation footer — sums MUST match the headline active count. */}
      {(() => {
        const locSum = sortedLocations.reduce((a, l) => a + l.count, 0);
        const grandTotal = locSum + homeDeliveryCount;
        const mismatch = grandTotal !== activeCount;
        return (
          <div class={[
            'border-t border-ts-border/60 px-5 py-3 text-xs sm:px-6',
            mismatch ? 'bg-ts-danger-bg/40 text-ts-danger' : 'text-ts-text-muted',
          ].join(' ')}>
            <span class="tabular-nums">{locSum}</span>
            {' '}at pickup locations + <span class="tabular-nums">{homeDeliveryCount}</span>
            {' '}home delivery / unassigned ={' '}
            <strong class="font-semibold tabular-nums">{grandTotal}</strong>
            {mismatch ? (
              <>
                {' '}≠ <span class="tabular-nums">{activeCount}</span> active total — data inconsistency, please report.
              </>
            ) : (
              <>
                {' '}= <span class="tabular-nums">{activeCount}</span> active members ✓
              </>
            )}
          </div>
        );
      })()}
    </Card>
  </section>

  {/* ════ Recent signups ════ */}
  <section aria-labelledby="signups-heading" class="flex flex-col gap-4">
    <h2 id="signups-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
      Recent signups
    </h2>
    <Card padding="none" elevation="sm">
      <ul class="divide-y divide-ts-border/60">
        {recentSignups.length === 0 && (
          <li class="px-5 py-6 text-center text-sm text-ts-text-muted sm:px-6">
            No signups in the last 7 days.
          </li>
        )}
        {recentSignups.map((s) => {
          const when = new Date(s.created_at);
          const whenStr = new Intl.DateTimeFormat('en-US', {
            month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
            timeZone: 'America/New_York',
          }).format(when);
          return (
            <li class="flex items-center gap-3 px-5 py-3 sm:px-6">
              <div class="min-w-0 flex-1">
                <a
                  href={`/admin/members/${s.id}`}
                  class="font-medium text-ts-text underline-offset-2 hover:text-ts-primary hover:underline"
                >
                  {s.customer?.contact_name ?? s.customer?.email ?? '(unknown)'}
                </a>
                <p class="text-xs text-ts-text-muted">
                  {shareLabel(s.share_type)} · {s.season} · {s.status}
                </p>
              </div>
              <span class="shrink-0 text-xs text-ts-text-muted tabular-nums">
                {whenStr}
              </span>
            </li>
          );
        })}
      </ul>
    </Card>
  </section>
</AdminShell>
