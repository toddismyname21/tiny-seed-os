---
/**
 * /admin/vendor-orders/[week] — per-cycle vendor order report.
 *
 * Spec §4.1. For each vendor: auto-computed totals from the cycle
 * resolve, an editable override field per total, an auto-generated
 * email body, and a "Send" button (admin must explicitly click — we
 * never auto-send to vendors).
 *
 * Phase-1 simplification: cron auto-draft is Phase 2. This page is
 * computed on-demand. Admin opens it on Sun/Mon, reviews, clicks Send.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import {
  resolveCycle, prettyWeekHeader, prettyShortDate,
  mondayOfWeek, isMonday,
  type AddOnType,
} from '../../../lib/cycle';
import { CSA_OWNER_EMAIL } from '../../../lib/contact';

const supabase = Astro.locals.supabase;
const slugParam = (Astro.params.slug ?? '') as string;
const segments = slugParam.split('/').filter(Boolean);
const week_input = segments[0] ?? '';
if (!/^\d{4}-\d{2}-\d{2}$/.test(week_input)) {
  return Astro.redirect('/admin/vendor-orders', 303);
}
const week_starting = isMonday(week_input) ? week_input : mondayOfWeek(week_input);

const cycle = await resolveCycle(supabase, week_starting);

// ─── Vendors + persisted vendor_orders for this week ──────────────
type VendorRow = {
  id: string;
  slug: string;
  name: string;
  contact_email: string;
  contact_phone: string | null;
  lead_time_days: number;
  add_on_types: string[];
  is_active: boolean;
  notes: string | null;
};
const { data: vendorRows, error: vendorErr } = await supabase
  .from('vendors')
  .select('id, slug, name, contact_email, contact_phone, lead_time_days, add_on_types, is_active, notes')
  .eq('is_active', true)
  .order('name', { ascending: true })
  .overrideTypes<VendorRow[], { merge: false }>();
if (vendorErr) {
  throw new Error(`vendor fetch failed: ${vendorErr.message}`);
}

type OrderRow = {
  id: string;
  vendor_id: string;
  totals: unknown;
  email_subject: string | null;
  email_body: string | null;
  sent_at: string | null;
  sent_to: string | null;
  override_qty: unknown;
  notes: string | null;
};
const { data: orderRows, error: orderErr } = await supabase
  .from('vendor_orders')
  .select('id, vendor_id, totals, email_subject, email_body, sent_at, sent_to, override_qty, notes')
  .eq('cycle_code', 'WEEKLY')
  .eq('week_starting', week_starting)
  .overrideTypes<OrderRow[], { merge: false }>();
if (orderErr) throw new Error(`vendor_orders fetch failed: ${orderErr.message}`);

const orderByVendorId = new Map<string, OrderRow>();
for (const o of (orderRows ?? [])) orderByVendorId.set(o.vendor_id, o);

// ─── Compute totals for each vendor (live) ────────────────────────
interface VendorTotals {
  vendor: VendorRow;
  // Totals broken down by add-on type + frequency.
  perType: Array<{ type: string; weekly: number; biweekly: number; total: number }>;
  grand: number;
}

function buildVendorTotals(vendor: VendorRow): VendorTotals {
  const perType = (vendor.add_on_types ?? []).map((t) => {
    const bucket = cycle.addOnTotals[t as AddOnType] ?? { weekly: 0, biweekly: 0, total: 0 };
    return { type: t, weekly: bucket.weekly, biweekly: bucket.biweekly, total: bucket.total };
  });
  return { vendor, perType, grand: perType.reduce((a, x) => a + x.total, 0) };
}

const vendorTotals: VendorTotals[] = (vendorRows ?? []).map(buildVendorTotals);

function buildEmailBody(v: VendorTotals): string {
  const distDates = `Tue ${prettyShortDate(cycle.distribution_dates.Tue)}, Wed ${prettyShortDate(cycle.distribution_dates.Wed)}, Sat ${prettyShortDate(cycle.distribution_dates.Sat)}`;
  const lines = v.perType.map((t) => {
    const breakdown = (t.weekly > 0 && t.biweekly > 0)
      ? ` (${t.weekly} weekly + ${t.biweekly} bi-weekly)`
      : '';
    return `  ${t.type}: ${t.total} units${breakdown}`;
  }).join('\n');
  return (
    `Hi ${v.vendor.name.split(' ')[0]} team,\n\n` +
    `Tiny Seed Farm CSA order for the week of ${prettyShortDate(week_starting)} ` +
    `(distribution ${distDates}):\n\n` +
    `${lines}\n\n` +
    `Total units: ${v.grand}\n\n` +
    `Drop-off at the farm by Monday morning. Reply to confirm or flag any issues.\n\n` +
    `Thanks!\n` +
    `Tiny Seed Farm\n` +
    `${CSA_OWNER_EMAIL}`
  );
}

function buildEmailSubject(): string {
  return `Tiny Seed Farm CSA order — week of ${prettyShortDate(week_starting)}`;
}
---

<AdminShell
  title="Vendor orders"
  subtitle={prettyWeekHeader(week_starting)}
  pageTitle="Vendor orders — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <button
      type="button"
      onclick="window.print()"
      class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
    >
      🖨 Print
    </button>
  </Fragment>

  <Card padding="md" elevation="sm" class="print:hidden">
    <p class="text-sm text-ts-text">
      <strong class="font-semibold">Send by Monday 6 AM</strong> for the 1-week lead time
      (vendors deliver the following Monday).
    </p>
    <p class="mt-2 text-xs text-ts-text-secondary">
      Auto-computed totals reflect every active member for this cycle, frequency-aware
      (weekly add-ons every week; bi-weekly add-ons only on the member's A/B week).
      Edit the override fields if you've negotiated a different number, then Send.
      Vendors only receive an email when you explicitly click Send.
    </p>
    {(vendorRows ?? []).some((v) => v.notes?.includes('TODO')) && (
      <p class="mt-3 rounded-ts-md border border-ts-warning/30 bg-ts-warning/5 px-3 py-2 text-xs font-semibold text-ts-warning">
        ⚠ One or more vendors have placeholder contact emails. Confirm with Todd before sending.
      </p>
    )}
  </Card>

  {vendorTotals.length === 0 ? (
    <Card tone="muted" padding="lg" elevation="sm">
      <p class="text-center text-sm text-ts-text-secondary">No active vendors. Add one in the database.</p>
    </Card>
  ) : (
    <div class="flex flex-col gap-6">
      {vendorTotals.map((v) => {
        const existing = orderByVendorId.get(v.vendor.id);
        const isPlaceholderEmail = (v.vendor.notes ?? '').includes('TODO');
        const initialBody = existing?.email_body || buildEmailBody(v);
        const initialSubject = existing?.email_subject || buildEmailSubject();
        const sentAt = existing?.sent_at;
        return (
          <Card padding="md" elevation="sm" as="section">
            <header class="flex items-start justify-between gap-3 border-b border-ts-border pb-3">
              <div class="min-w-0">
                <h2 class="font-display text-xl font-bold text-ts-text">{v.vendor.name}</h2>
                <p class="mt-0.5 text-xs text-ts-text-muted">
                  {v.vendor.contact_email}
                  {v.vendor.contact_phone && ` · ${v.vendor.contact_phone}`}
                  · lead time {v.vendor.lead_time_days} days
                </p>
                {isPlaceholderEmail && (
                  <p class="mt-1 text-xs font-semibold text-ts-warning">
                    ⚠ {v.vendor.notes}
                  </p>
                )}
              </div>
              <div class="shrink-0 text-right">
                <div class="font-display text-3xl font-bold tabular-nums text-ts-primary">{v.grand}</div>
                <div class="text-xs text-ts-text-muted">units</div>
              </div>
            </header>

            {/* Per-type breakdown table */}
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-ts-border/60 text-xs uppercase tracking-wide text-ts-text-muted">
                  <tr>
                    <th class="py-2 pr-3">Type</th>
                    <th class="py-2 pr-3 text-right">Weekly</th>
                    <th class="py-2 pr-3 text-right">Bi-weekly</th>
                    <th class="py-2 pr-3 text-right">Auto total</th>
                    <th class="py-2 text-right">Override</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ts-border/40">
                  {v.perType.map((t) => (
                    <tr>
                      <td class="py-2 pr-3 font-medium text-ts-text">{t.type}</td>
                      <td class="py-2 pr-3 text-right tabular-nums text-ts-text-secondary">{t.weekly}</td>
                      <td class="py-2 pr-3 text-right tabular-nums text-ts-text-secondary">{t.biweekly}</td>
                      <td class="py-2 pr-3 text-right tabular-nums font-semibold text-ts-text">{t.total}</td>
                      <td class="py-2 text-right">
                        <input
                          type="number"
                          name={`override_${v.vendor.id}_${t.type}`}
                          form={`form-${v.vendor.id}`}
                          min="0"
                          placeholder={String(t.total)}
                          class="h-9 w-20 rounded-ts-md border border-ts-border bg-ts-bg-surface px-2 text-right text-sm tabular-nums focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
                        />
                      </td>
                    </tr>
                  ))}
                  {v.perType.length === 0 && (
                    <tr>
                      <td colspan="5" class="py-3 text-center text-xs italic text-ts-text-muted">
                        No add-on types assigned to this vendor.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>

            {/* Email draft + Send form */}
            <form
              id={`form-${v.vendor.id}`}
              method="POST"
              action="/api/admin/vendor-orders/send"
              class="mt-5 flex flex-col gap-3"
            >
              <input type="hidden" name="vendor_id" value={v.vendor.id} />
              <input type="hidden" name="week_starting" value={week_starting} />
              <label class="flex flex-col gap-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Subject</span>
                <input
                  type="text"
                  name="subject"
                  value={initialSubject}
                  class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text"
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Email body</span>
                <textarea
                  name="body"
                  rows="10"
                  class="rounded-ts-md border border-ts-border bg-ts-bg-surface p-3 text-sm font-mono text-ts-text leading-relaxed"
                >{initialBody}</textarea>
              </label>

              <div class="flex flex-col items-stretch justify-between gap-3 sm:flex-row sm:items-center">
                <div class="text-xs text-ts-text-secondary">
                  {sentAt ? (
                    <span class="font-semibold text-ts-primary">
                      ✓ Sent {new Date(sentAt).toLocaleString('en-US', { timeZone: 'America/New_York' })}
                      {' '}to {existing?.sent_to ?? v.vendor.contact_email}
                    </span>
                  ) : (
                    <span>Not yet sent — vendor will receive nothing until you click Send.</span>
                  )}
                </div>
                <div class="flex gap-2">
                  <button
                    type="submit"
                    name="action"
                    value="save_draft"
                    class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
                  >
                    Save draft
                  </button>
                  <button
                    type="submit"
                    name="action"
                    value="send"
                    class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark"
                    onclick="return confirm('Send this order email to the vendor now? They will receive a real email.');"
                  >
                    Send to vendor →
                  </button>
                </div>
              </div>
            </form>
          </Card>
        );
      })}
    </div>
  )}
</AdminShell>
