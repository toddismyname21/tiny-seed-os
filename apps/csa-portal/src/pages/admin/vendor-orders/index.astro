---
/**
 * /admin/vendor-orders — week-picker landing.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { mondayOfWeek, upcomingMonday } from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';

const options = weekOptions();
const defaultWeek = mondayOfWeek(upcomingMonday());
---

<AdminShell
  title="Vendor orders"
  subtitle="Auto-computed add-on totals per vendor, with editable overrides and a Send button."
  pageTitle="Vendor orders — Tiny Seed Admin"
>
  <section aria-label="Week selector">
    <form id="goto-form" class="flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Cycle week</span>
        <select id="week-select" class="h-10 min-w-[260px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text">
          {options.map((opt) => (
            <option value={opt.value} selected={opt.value === defaultWeek}>{opt.label}</option>
          ))}
        </select>
      </label>
      <button type="submit" class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark">
        Open vendor orders →
      </button>
    </form>
  </section>

  <Card padding="md" elevation="sm">
    <h2 class="font-display text-lg font-bold text-ts-text">How vendor orders flow</h2>
    <ul class="mt-3 space-y-1.5 text-sm text-ts-text-secondary">
      <li>• Per Todd's 2026-05-27 decision: ONE weekly cutoff (Mon 6 AM) and 1-week vendor lead time.</li>
      <li>• Open this page on Sunday or Monday morning, review the auto totals, edit overrides if needed.</li>
      <li>• Click <strong class="font-medium text-ts-text">Send to vendor</strong> per vendor to fire the email (confirmation prompt).</li>
      <li>• Vendors only receive an email when you explicitly click — auto-send is intentionally NOT wired.</li>
      <li>• Sent timestamps are recorded so you have an audit trail.</li>
    </ul>
  </Card>
</AdminShell>

<script is:inline>
  document.getElementById('goto-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const wk = (document.getElementById('week-select')).value;
    if (wk) window.location.href = `/admin/vendor-orders/${wk}`;
  });
</script>
