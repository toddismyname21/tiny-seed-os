---
/**
 * /admin/host-sheets — landing page (week + stop picker) for the printable
 * HOST CONTACT SHEET.
 *
 * The actual printable view lives at /admin/host-sheets/[week]/[stop_slug].
 * This page lets admin (1) pick the cycle week and (2) open one stop's host
 * sheet — or "Print all stops" (?all=1 on the slug page) renders every host
 * stop in one doc with a page break between each (handled by the slug page).
 *
 * A host sheet is what we hand the person who HOSTS a pickup stop: a big,
 * readable list of everyone picking up a box at THEIR stop this week, with
 * name + phone, so the host knows who to expect and can reach them.
 *
 * Only REAL pickup stops are host stops — home delivery and "no pickup set"
 * are not hosted by anyone, so they're excluded here (mirrors text-stop's
 * pickup-stop filter). Default week matches the other admin pack pages
 * (upcoming Monday).
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import {
  resolveCycle, slugStop, mondayOfWeek, currentDeliveryWeek, prettyWeekHeader,
  HOME_DELIVERY_BUCKET_ID,
} from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';

const supabase = Astro.locals.supabase;

const wkParam = Astro.url.searchParams.get('week') ?? '';
const week_starting = wkParam && /^\d{4}-\d{2}-\d{2}$/.test(wkParam)
  ? mondayOfWeek(wkParam)
  : currentDeliveryWeek();

const cycle = await resolveCycle(supabase, week_starting);
const options = weekOptions();
if (!options.some((o) => o.value === week_starting)) {
  options.unshift({ value: week_starting, label: `Week of ${week_starting} (selected)` });
}

const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};

// Host stops = real pickup stops only. The home-delivery and no-pickup-set
// buckets have no host, so they never get a host sheet.
const hostStops = cycle.activeStops.filter(
  (s) => s.stop_id !== HOME_DELIVERY_BUCKET_ID && s.stop_id !== 'no_pickup_set',
);
---

<AdminShell
  title="Host sheets"
  subtitle={`📇 Who picks up at each stop · ${prettyWeekHeader(week_starting)}`}
  pageTitle="Host sheets — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <a
      href={`/admin/host-sheets/${week_starting}?all=1`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      Print all host sheets →
    </a>
  </Fragment>

  {/* ── Week selector ─────────────────────────────────────────────── */}
  <section aria-label="Week selector">
    <form method="GET" action="/admin/host-sheets" class="flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Week</span>
        <select
          name="week"
          class="h-10 min-w-[220px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          {options.map((opt) => (
            <option value={opt.value} selected={opt.value === week_starting}>
              {opt.label}
            </option>
          ))}
        </select>
      </label>
      <button
        type="submit"
        class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        Load week
      </button>
    </form>
  </section>

  {/* ── Stops list ────────────────────────────────────────────────── */}
  <section aria-labelledby="hs-stops-heading" class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 id="hs-stops-heading" class="font-display text-xl font-bold text-ts-text">Pickup stops this cycle</h2>
      <p class="text-sm text-ts-text-secondary tabular-nums">
        {hostStops.length} host stop{hostStops.length === 1 ? '' : 's'}
      </p>
    </div>
    {hostStops.length === 0 ? (
      <Card tone="muted" padding="lg" elevation="sm">
        <div class="flex flex-col items-center gap-3 py-6 text-center">
          <span class="text-4xl" aria-hidden="true">📇</span>
          <p class="text-sm text-ts-text-secondary">
            No active pickup stops in this cycle. Try a different week.
          </p>
          <a
            href="/admin/stop-manifest"
            class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
          >
            Open manifests instead →
          </a>
        </div>
      </Card>
    ) : (
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
        {hostStops.map((stop) => {
          const stopSlug = slugStop(stop.stop_name);
          const stopUrl = `/admin/host-sheets/${week_starting}/${stopSlug}`;
          const n = cycle.byStop.get(stop.stop_id)?.length ?? 0;
          return (
            <Card padding="md" elevation="sm" hover>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <a
                    href={stopUrl}
                    class="font-semibold text-ts-text underline-offset-2 hover:text-ts-primary hover:underline"
                  >
                    {stop.stop_name}
                  </a>
                  <p class="mt-0.5 text-xs text-ts-text-muted">
                    {stop.day_of_week ? DAY_LONG[stop.day_of_week] : 'Day TBD'}
                  </p>
                </div>
                <span class="shrink-0 rounded-ts-md bg-ts-primary/10 px-3 py-1 text-base font-bold tabular-nums text-ts-primary">
                  {n}
                </span>
              </div>
              <a
                href={stopUrl}
                class="mt-3 inline-flex h-9 items-center justify-center rounded-ts-md bg-ts-primary px-3 text-xs font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark"
              >
                Open host sheet →
              </a>
            </Card>
          );
        })}
      </div>
    )}
  </section>

  <Card padding="md" elevation="sm">
    <h2 class="font-display text-lg font-bold text-ts-text">How the host sheet prints</h2>
    <ul class="mt-3 space-y-1.5 text-sm text-ts-text-secondary">
      <li>• One sheet per stop (page break between stops) — Letter portrait.</li>
      <li>• Each sheet lists everyone picking up a box at that stop this week, with their name and phone number.</li>
      <li>• Only people actually getting a box are listed (summer veg this week, or flex with an order).</li>
      <li>• Big and readable so the host can scan it. Missing numbers show "no phone on file".</li>
      <li>• Print options: Letter, Portrait, default margins, scale 100%.</li>
    </ul>
  </Card>
</AdminShell>
</content>
</invoke>
