---
/**
 * /admin/substitutions/[week] — "Box Modifications by Stop".
 *
 * The UNIFIED, by-stop window of every veg-box (share_type='summer_veg') member
 * whose box this week differs from the published base box — for ANY reason:
 *   (a) Allergy/dislike auto-subs: an item the member can't/won't eat, pulled
 *       and replaced with "Farmer's choice".
 *   (b) Per-week CUSTOMER swaps: an item the member swapped out for another via
 *       the (forthcoming) self-service swap feature.
 * It regenerates every week straight from the source of truth, so when the
 * customer self-service swap feature goes live, swaps appear here automatically
 * with no further wiring.
 *
 * SOURCE OF TRUTH: resolveCycle(supabase, week_starting). We do NOT re-derive
 * any modifications — each member's ResolvedBoxComposition carries the
 * authoritative lists:
 *   - allergy_subs[]  → { removed, reason } where reason is "allergy: X" or
 *                       "dislike: X" (applyComposition tags both).
 *   - swapped_out[] / swapped_in[] → per-week customer swaps. For a matched
 *     swap, swapped_out[i] pairs positionally with swapped_in[i]; an additive
 *     swap (the swap-out item wasn't in the base box) pushes only to
 *     swapped_in, so swapped_in can be longer than swapped_out. We pair by
 *     index and surface any unpaired remainder as additive (+) / removed (−).
 * Only summer_veg members have a composition. We group members by stop and
 * render their modifications. The slug→week parsing and the resolveCycle call
 * mirror /admin/pack-load exactly; the allergy red treatment mirrors
 * /admin/labels' `.label-flag`.
 *
 * Auth: the /admin prefix is gated by middleware (ADMIN_PREFIXES) — same as
 * every other admin page; no per-page guard is needed.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import {
  resolveCycle, prettyWeekHeader,
  mondayOfWeek, isMonday, currentDeliveryWeek,
  type WeekdayCode,
} from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';

const supabase = Astro.locals.supabase;
const slugParam = (Astro.params.slug ?? '') as string;
const segments = slugParam.split('/').filter(Boolean);

// /admin/substitutions/ → default to the current delivery week.
const week_starting_input = segments[0] ?? currentDeliveryWeek();
if (!/^\d{4}-\d{2}-\d{2}$/.test(week_starting_input)) {
  return Astro.redirect('/admin/substitutions', 303);
}
const week_starting = isMonday(week_starting_input)
  ? week_starting_input
  : mondayOfWeek(week_starting_input);

const cycle = await resolveCycle(supabase, week_starting);
const options = weekOptions();

// ─── Build the by-stop box-modifications list ────────────────────────
// Keep summer_veg members whose resolved composition has ANY modification:
// an allergy/dislike sub OR a per-week customer swap. All of these come
// straight from resolveCycle — we never recompute them.
const HOME_DELIVERY_KEY = '__home_delivery__';
const HOME_DELIVERY_NAME = 'Home delivery';

// A modification row. `kind` drives the visual treatment:
//   'allergy' → red    (⚠ Allergy)
//   'dislike' → normal (Dislike)
//   'swap'    → teal   (↔ Customer swap; paired out → in)
//   'swap-add'→ teal   (additive swap: only an item swapped IN)
//   'swap-rem'→ teal   (unpaired swap: only an item swapped OUT)
type ModKind = 'allergy' | 'dislike' | 'swap' | 'swap-add' | 'swap-rem';
interface SubRow {
  kind: ModKind;
  /** Item removed/swapped-out (empty for additive swaps). */
  removed: string;
  /** Item swapped-in (only for swap kinds). */
  added: string;
  /** Original allergy/dislike reason string (only for allergy/dislike). */
  reason: string;
}
interface SubMember {
  member_id: string;
  contact_name: string;
  size_bucket: string;
  subs: SubRow[];
}
interface SubStop {
  key: string;
  stop_name: string;
  day_of_week: WeekdayCode | null;
  members: SubMember[];
}

const DAY_RANK: Record<WeekdayCode, number> = {
  Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7,
};
const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday', Thu: 'Thursday',
  Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};

const stopMap = new Map<string, SubStop>();
let totalMembers = 0;

for (const m of cycle.members) {
  if (m.share_type !== 'summer_veg') continue;

  const composition = cycle.boxCompositionByMember.get(m.id);
  const allergySubs = composition?.allergy_subs ?? [];
  const swappedOut = composition?.swapped_out ?? [];
  const swappedIn = composition?.swapped_in ?? [];
  // Include this member if their box has ANY modification this week.
  if (allergySubs.length === 0 && swappedOut.length === 0 && swappedIn.length === 0) {
    continue;
  }

  // Stop identity: a real pickup_location, else Home delivery (no
  // pickup_location_id + has delivery_address). Same membership rule the
  // resolver uses for its home_delivery bucket.
  let key: string;
  let stop_name: string;
  let day_of_week: WeekdayCode | null;
  if (m.pickup_location_id && m.pickup_location) {
    key = m.pickup_location.id;
    stop_name = m.pickup_location.name;
    day_of_week = m.pickup_location.day_of_week;
  } else if (!m.pickup_location_id && m.delivery_address) {
    key = HOME_DELIVERY_KEY;
    stop_name = HOME_DELIVERY_NAME;
    day_of_week = 'Wed'; // resolveCycle assigns home delivery to the Wed run
  } else {
    // No pickup location and no delivery address — cannot place on a stop.
    // Bucket under an "Unassigned" group so it is never silently dropped.
    key = '__unassigned__';
    stop_name = 'Unassigned';
    day_of_week = null;
  }

  const subs: SubRow[] = [];

  // (a) Allergy/dislike subs. reason is "allergy: X" or "dislike: X".
  for (const s of allergySubs) {
    const isAllergy = s.reason.trim().toLowerCase().startsWith('allergy');
    subs.push({
      kind: isAllergy ? 'allergy' : 'dislike',
      removed: s.removed,
      added: '',
      reason: s.reason,
    });
  }

  // (b) Per-week customer swaps. Pair positionally: swapped_out[i] → swapped_in[i].
  // applyComposition pushes matched swaps to BOTH arrays in lockstep, and
  // additive swaps (swap-out item not in base) to swapped_in only — so
  // swapped_in may be longer. Pair the overlap, then surface any remainder.
  const pairCount = Math.min(swappedOut.length, swappedIn.length);
  for (let i = 0; i < pairCount; i += 1) {
    subs.push({ kind: 'swap', removed: swappedOut[i], added: swappedIn[i], reason: '' });
  }
  // Extra swap-ins with no matching swap-out → additive (+ item).
  for (let i = pairCount; i < swappedIn.length; i += 1) {
    subs.push({ kind: 'swap-add', removed: '', added: swappedIn[i], reason: '' });
  }
  // Extra swap-outs with no matching swap-in → removed (− item).
  for (let i = pairCount; i < swappedOut.length; i += 1) {
    subs.push({ kind: 'swap-rem', removed: swappedOut[i], added: '', reason: '' });
  }

  let stop = stopMap.get(key);
  if (!stop) {
    stop = { key, stop_name, day_of_week, members: [] };
    stopMap.set(key, stop);
  }
  stop.members.push({
    member_id: m.id,
    contact_name: m.contact_name,
    size_bucket: m.size_bucket,
    subs,
  });
  totalMembers += 1;
}

// Sort stops by day rank (Mon=1..Sun=7, unknown last) then stop name — the
// same DAY_RANK ordering resolveCycle uses for activeStops. Sort members
// within a stop by contact_name.
const stops: SubStop[] = Array.from(stopMap.values()).sort((a, b) => {
  const da = a.day_of_week ? DAY_RANK[a.day_of_week] : 99;
  const db = b.day_of_week ? DAY_RANK[b.day_of_week] : 99;
  if (da !== db) return da - db;
  return a.stop_name.localeCompare(b.stop_name);
});
for (const s of stops) {
  s.members.sort((a, b) => a.contact_name.localeCompare(b.contact_name));
}

function dayLabel(d: WeekdayCode | null): string {
  return d ? (DAY_LONG[d] ?? d) : 'Unscheduled';
}
function sizeLabel(bucket: string): string {
  if (bucket === 'large') return 'Large';
  if (bucket === 'small') return 'Small';
  return 'Box';
}

const weekHeader = prettyWeekHeader(week_starting);
---

<AdminShell
  title="Box Modifications by Stop"
  subtitle={`${weekHeader} · ${totalMembers} member${totalMembers === 1 ? '' : 's'} with a box modification`}
  pageTitle="Box Modifications — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <button
      type="button"
      onclick="window.print()"
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      🖨 Print
    </button>
    <form method="GET" action="/admin/substitutions" class="flex items-end gap-2 screen-only">
      <label class="flex flex-col gap-1">
        <span class="sr-only">Week</span>
        <select
          name="week"
          class="h-10 min-w-[200px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          {options.map((opt) => (
            <option value={opt.value} selected={opt.value === week_starting}>{opt.label}</option>
          ))}
        </select>
      </label>
      <button
        type="submit"
        class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        Load week
      </button>
    </form>
  </Fragment>

  {stops.length === 0 ? (
    <Card tone="muted" padding="lg" elevation="sm">
      <div class="flex flex-col items-center gap-3 py-8 text-center">
        <span class="text-4xl" aria-hidden="true">✅</span>
        <p class="font-display text-lg font-semibold text-ts-text">No box modifications this week</p>
        <p class="max-w-md text-sm text-ts-text-secondary">
          No box modifications this week — no allergy/dislike subs and no customer swaps.
        </p>
      </div>
    </Card>
  ) : (
    <div data-substitutions data-week={week_starting} class="flex flex-col gap-6">
      <p class="screen-only text-sm text-ts-text-secondary">
        Every veg-box member below has a modification to this week's published
        box — an allergy/dislike auto-substituted to
        <strong class="font-semibold text-ts-text"> Farmer's choice</strong>, or
        an item the member swapped. Pack with extra care.
      </p>

      <ul
        class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 py-3 text-xs font-semibold"
        aria-label="Legend"
      >
        <li class="flex items-center gap-1.5">
          <span class="sub-allergy-flag rounded-ts-sm px-2 py-0.5 uppercase tracking-wide">⚠ Allergy</span>
          <span class="text-ts-text-secondary">red — pack with extra care</span>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="sub-dislike-flag rounded-ts-sm border border-ts-border px-2 py-0.5 uppercase tracking-wide text-ts-text-secondary">Dislike</span>
          <span class="text-ts-text-secondary">auto-sub</span>
        </li>
        <li class="flex items-center gap-1.5">
          <span class="sub-swap-flag rounded-ts-sm px-2 py-0.5 uppercase tracking-wide">↔ Customer swap</span>
          <span class="text-ts-text-secondary">teal — member-chosen</span>
        </li>
      </ul>

      {stops.map((stop) => (
        <section class="flex flex-col gap-3" aria-labelledby={`stop-${stop.key}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ts-border pb-2">
            <h2 id={`stop-${stop.key}`} class="font-display text-xl font-bold text-ts-text">
              {stop.stop_name}
            </h2>
            <span class="text-sm font-semibold text-ts-text-secondary">
              {dayLabel(stop.day_of_week)} · {stop.members.length} member{stop.members.length === 1 ? '' : 's'}
            </span>
          </div>

          <Card padding="md" elevation="sm">
            <ul class="flex flex-col divide-y divide-ts-border">
              {stop.members.map((mem) => {
                const hasAllergy = mem.subs.some((s) => s.kind === 'allergy');
                const hasSwap = mem.subs.some(
                  (s) => s.kind === 'swap' || s.kind === 'swap-add' || s.kind === 'swap-rem',
                );
                return (
                  <li
                    class:list={[
                      'flex flex-col gap-1 py-3 first:pt-0 last:pb-0',
                      hasAllergy ? 'sub-allergy' : '',
                    ]}
                  >
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-display text-base font-semibold text-ts-text">
                        {mem.contact_name}
                      </span>
                      <span class="rounded-ts-sm border border-ts-border bg-ts-bg-surface px-2 py-0.5 text-xs font-semibold text-ts-text-secondary">
                        {sizeLabel(mem.size_bucket)}
                      </span>
                      {hasAllergy && (
                        <span class="sub-allergy-flag rounded-ts-sm px-2 py-0.5 text-xs font-bold uppercase tracking-wide">
                          ⚠ Allergy
                        </span>
                      )}
                      {hasSwap && (
                        <span class="sub-swap-flag rounded-ts-sm px-2 py-0.5 text-xs font-bold uppercase tracking-wide">
                          ↔ Swap
                        </span>
                      )}
                    </div>
                    <ul class="flex flex-col gap-0.5 pl-1 text-sm">
                      {mem.subs.map((s) => {
                        if (s.kind === 'allergy' || s.kind === 'dislike') {
                          const label = s.kind === 'allergy' ? '⚠ Allergy' : 'Dislike';
                          return (
                            <li class:list={['flex flex-wrap items-baseline gap-1.5', s.kind === 'allergy' ? 'sub-row-allergy' : '']}>
                              <span class="text-xs font-semibold uppercase tracking-wide">{label}:</span>
                              <span>REMOVE <strong class="font-semibold">{s.removed}</strong></span>
                              <span class="text-ts-text-secondary">→ Farmer's choice</span>
                              <span class="text-xs text-ts-text-secondary">({s.reason})</span>
                            </li>
                          );
                        }
                        // Customer swap rows (teal).
                        return (
                          <li class="flex flex-wrap items-baseline gap-1.5 sub-row-swap">
                            <span class="text-xs font-semibold uppercase tracking-wide">↔ Swap:</span>
                            {s.kind === 'swap' && (
                              <span>
                                <strong class="font-semibold">{s.removed}</strong>
                                <span> → </span>
                                <strong class="font-semibold">{s.added}</strong>
                              </span>
                            )}
                            {s.kind === 'swap-add' && (
                              <span>+ <strong class="font-semibold">{s.added}</strong></span>
                            )}
                            {s.kind === 'swap-rem' && (
                              <span>− <strong class="font-semibold">{s.removed}</strong></span>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  </li>
                );
              })}
            </ul>
          </Card>
        </section>
      ))}
    </div>
  )}
</AdminShell>

<style>
  /* Allergy rows reuse the labels page's `.label-flag` red treatment
     (#b91c1c, bold) so the visual language matches across admin pages. */
  .sub-allergy-flag {
    color: #ffffff;
    background: #b91c1c;
  }
  .sub-row-allergy {
    color: #b91c1c;
    font-weight: 700;
  }
  .sub-row-allergy .text-ts-text-secondary {
    color: #b91c1c;
  }
  .sub-allergy {
    border-left: 3px solid #b91c1c;
    padding-left: 0.5rem;
    margin-left: -0.5rem;
  }

  /* Dislike chip — neutral outline (legend only). Dislike rows themselves use
     the default body treatment, distinguishing them from allergies (red). */
  .sub-dislike-flag {
    background: transparent;
  }

  /* Customer-swap rows + chip — teal (#0e7490, AA 4.69:1 on white) so swaps
     read as member-chosen and visually distinct from the red allergy / plain
     dislike treatments. */
  .sub-swap-flag {
    color: #ffffff;
    background: #0e7490;
  }
  .sub-row-swap {
    color: #0e7490;
    font-weight: 600;
  }

  .screen-only {
    /* hidden when printing */
  }
  @media print {
    .screen-only {
      display: none !important;
    }
  }
</style>
