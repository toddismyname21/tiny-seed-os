---
/**
 * /admin/pack-sheet/[week]?day=Wed — pack-day per-member checklist.
 *
 * Spec §4.6. Grouped by STOP (so packers can stage by stop), then by
 * member. Per member: name · size · box contents (with swap flags) ·
 * add-ons (separate column) · flex items (separate sub-row) · ⚠
 * allergy/owes flag.
 *
 * `?day` filters to one distribution day (Tue / Wed / Sat). Default: Wed.
 * "All" is also supported (omit ?day or pass ?day=all).
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import {
  resolveCycle, prettyWeekHeader, prettyShortDate,
  mondayOfWeek, isMonday,
  HOME_DELIVERY_BUCKET_ID,
  type WeekdayCode, type CycleMember, type StopTotals,
} from '../../../lib/cycle';
import {
  fetchDueNoticesWithMemberForStops, groupNoticesByHint,
  isNoticeOverdue, HOME_DELIVERY_HINT,
  type NoticeWithMember,
} from '../../../lib/notices';
import { getLoadOrder, formatLoadRange, type LoadOrder } from '../../../lib/load-order';

const supabase = Astro.locals.supabase;
const slugParam = (Astro.params.slug ?? '') as string;
const segments = slugParam.split('/').filter(Boolean);
const week_input = segments[0] ?? '';
if (!/^\d{4}-\d{2}-\d{2}$/.test(week_input)) {
  return Astro.redirect('/admin/pack-sheet', 303);
}
const week_starting = isMonday(week_input) ? week_input : mondayOfWeek(week_input);

const dayRaw = (Astro.url.searchParams.get('day') ?? 'wed').toLowerCase();
const day: WeekdayCode | 'all' =
  dayRaw === 'tue' ? 'Tue' :
  dayRaw === 'sat' ? 'Sat' :
  dayRaw === 'sun' ? 'Sun' :
  dayRaw === 'all' ? 'all' :
  'Wed';

const cycle = await resolveCycle(supabase, week_starting);

// ─── Members for the selected day ──────────────────────────────────
// Select by each member's ACTUAL pickup weekday, NOT cycle.byDistributionDay
// (which collapses Sunday pickups into its 'Wed' default — that hid Sunday
// markets like South Side from every day tab). Home delivery / no-pickup
// default to Wed, matching the resolver's distribution-day rule.
function memberDistDay(m: CycleMember): WeekdayCode {
  return m.pickup_location?.day_of_week ?? 'Wed';
}
const selectedMembers: CycleMember[] = day === 'all'
  ? cycle.members
  : cycle.members.filter((m) => memberDistDay(m) === day);

// ─── Group by stop, then alphabetical within stop ──────────────────
const stopOrder = cycle.activeStops.filter((s) => {
  if (day === 'all') return true;
  // For a single-day view, only include stops whose day_of_week matches
  // (home delivery defaults to Wed).
  if (s.stop_id === HOME_DELIVERY_BUCKET_ID) return day === 'Wed';
  return s.day_of_week === day;
});

// ─── TRUCK LOAD ORDER (Todd 2026-07) ─────────────────────────────────
// When an optimized route is SAVED for the week, re-order the per-stop sections
// into TRUCK-LOADING order (load-first at top = the LAST drive stop; reverse of
// the drive order) and print a numbered LOAD banner on each stop. Pickup stops
// map to one truck position; the home-delivery bucket spans several (one per
// household) so it's positioned by its MIN loadSeq and its banner shows the
// range. Off-route stops keep their current relative order, after. No saved
// route → null → the sheet renders exactly as before (fail-soft). Shared
// lib/load-order — the same numbering labels + the truck-door sheet use.
const loadOrder: LoadOrder | null = await getLoadOrder(supabase, week_starting);
const INF = Number.POSITIVE_INFINITY;
function loadSortKeyForStop(stop: StopTotals): number {
  if (!loadOrder) return INF;
  if (stop.stop_id === HOME_DELIVERY_BUCKET_ID) {
    let min = INF;
    for (const m of (cycle.byStop.get(stop.stop_id) ?? [])) {
      const st = loadOrder.home(m.customer_id);
      if (st) min = Math.min(min, st.loadSeq);
    }
    return min;
  }
  return loadOrder.pickup(stop.stop_id)?.loadSeq ?? INF;
}
const orderedStops: StopTotals[] = loadOrder
  ? stopOrder
      .map((s, i) => ({ s, i, k: loadSortKeyForStop(s) }))
      .sort((a, b) => {
        if (a.k !== b.k) {
          if (a.k === INF) return 1;
          if (b.k === INF) return -1;
          return a.k - b.k;
        }
        return a.i - b.i;
      })
      .map((x) => x.s)
  : stopOrder;

// Numbered LOAD banner for a stop (null off-route / no saved route).
interface LoadBanner { load: string; sub: string; }
function loadBannerForStop(stop: StopTotals): LoadBanner | null {
  if (!loadOrder) return null;
  const legTag = (leg: string) => (loadOrder!.legCount > 1 ? ` · Route ${leg}` : '');
  if (stop.stop_id === HOME_DELIVERY_BUCKET_ID) {
    const seqs: number[] = [];
    const legsSeen = new Set<string>();
    for (const m of (cycle.byStop.get(stop.stop_id) ?? [])) {
      const st = loadOrder.home(m.customer_id);
      if (st) { seqs.push(st.loadSeq); legsSeen.add(st.leg); }
    }
    const range = formatLoadRange(seqs);
    if (!range) return null;
    const legLabel = legsSeen.size === 1 ? legTag([...legsSeen][0]) : '';
    return { load: `LOAD ${range}`, sub: `${seqs.length} home stop${seqs.length === 1 ? '' : 's'} of ${loadOrder.total}${legLabel}` };
  }
  const st = loadOrder.pickup(stop.stop_id);
  if (!st) return null;
  return { load: `LOAD #${st.loadSeq}`, sub: `drive stop ${st.routeSeq} of ${loadOrder.total}${legTag(st.leg)}` };
}

// ─── Open MAKE-UP notices due/overdue for the rendered stops ─────────
// THE GAP THIS FIXES: make-up promises ("owed double mushroom", "make-good
// bread + cheese") were wired into /admin/stop-manifest + /admin/pack-check but
// NOT this main pack sheet — so owed add-ons got missed on pack day. We read the
// SAME source of truth (member_notices via lib/notices) so this sheet,
// stop-manifest, and pack-check can never disagree. One bounded query over the
// rendered stops' hints (stop NAME, plus HOME_DELIVERY_HINT for the home
// bucket), filtered to OPEN + due/overdue (overdue make-ups PERSIST until
// fulfilled — isNoticeDueOrOverdue inside the fetch), grouped by hint. Member
// name is joined so the banner reads "Denise Fazio — owed double mushroom".
const noticeHints: string[] = stopOrder.map((s) =>
  s.stop_id === HOME_DELIVERY_BUCKET_ID ? HOME_DELIVERY_HINT : s.stop_name,
);
const dueNotices = await fetchDueNoticesWithMemberForStops(
  supabase, noticeHints, week_starting,
);
const noticesByHint = groupNoticesByHint(dueNotices);
/** The make-up notices to pin for a stop (by its hint). */
function noticesForStop(stop: StopTotals): NoticeWithMember[] {
  const hint = stop.stop_id === HOME_DELIVERY_BUCKET_ID ? HOME_DELIVERY_HINT : stop.stop_name;
  return noticesByHint.get(hint) ?? [];
}
/** Stops (in render order) that actually have ≥1 make-up, for the TOP banner. */
const stopsWithNotices = stopOrder
  .map((s) => ({ stop: s, notices: noticesForStop(s) }))
  .filter((x) => x.notices.length > 0);
const totalMakeups = stopsWithNotices.reduce((a, x) => a + x.notices.length, 0);

/** Short "due Jun 22" / "OVERDUE since Jun 22" tag for a make-up row. */
function dueTag(n: NoticeWithMember): { text: string; overdue: boolean } {
  const overdue = isNoticeOverdue(n.due_week, week_starting);
  if (n.due_week == null) return { text: 'next opportunity', overdue: false };
  const d = new Date(`${n.due_week}T12:00:00Z`);
  const pretty = new Intl.DateTimeFormat('en-US', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
  }).format(d);
  return { text: overdue ? `OVERDUE since ${pretty}` : `due ${pretty}`, overdue };
}

// The path this very sheet renders at — passed to the inline resolve form so
// marking a make-up fulfilled bounces back HERE (not to /admin/notices).
const returnTo = `/admin/pack-sheet/${week_starting}`;

// Pre-fetch flex lines per member for the rendered day.
type FlexLineRow = {
  member_id: string;
  qty: number;
  flex_item: { name: string | null } | null;
};
const flexLinesByMember = new Map<string, Array<{ name: string | null; qty: number }>>();
{
  const memberIds = selectedMembers.map((m) => m.id);
  if (memberIds.length > 0) {
    const { data, error } = await supabase
      .from('flex_orders')
      .select('member_id, qty, flex_item:flex_inventory ( name )')
      .eq('cycle_code', 'WEEKLY')
      .eq('week_starting', week_starting)
      .in('status', ['locked', 'fulfilled'])
      .in('member_id', memberIds)
      .overrideTypes<FlexLineRow[], { merge: false }>();
    if (!error) {
      for (const r of (data ?? []) as FlexLineRow[]) {
        const arr = flexLinesByMember.get(r.member_id) ?? [];
        arr.push({ name: r.flex_item?.name ?? null, qty: r.qty });
        flexLinesByMember.set(r.member_id, arr);
      }
    }
  }
}

function memberSizeLabel(m: CycleMember): string {
  if (m.share_type === 'summer_veg') {
    return m.size_bucket === 'large' ? 'Large' : 'Small';
  }
  return '—';
}

function memberAddons(m: CycleMember): string {
  if (m.share_type !== 'add_on') return '';
  const t = m.addon_type === 'unknown' ? 'add-on' : m.addon_type;
  const f = m.addon_frequency === 'weekly' ? 'weekly' : 'bi-weekly';
  return `${t} (${f})`;
}

function owesFlag(m: CycleMember): boolean {
  const p = (m.payment_status ?? '').trim().toLowerCase();
  return !!p && p !== 'paid';
}

const totalBoxes = selectedMembers.filter((m) => m.share_type === 'summer_veg').length;
const totalAddons = selectedMembers.filter((m) => m.share_type === 'add_on').length;
const totalFlexLines = Array.from(flexLinesByMember.values()).reduce(
  (a, lines) => a + lines.length, 0,
);

const dayLabels: Record<'Tue'|'Wed'|'Sat'|'Sun'|'all', string> = {
  Tue: `Tuesday ${prettyShortDate(cycle.distribution_dates.Tue)}`,
  Wed: `Wednesday ${prettyShortDate(cycle.distribution_dates.Wed)}`,
  Sat: `Saturday ${prettyShortDate(cycle.distribution_dates.Sat)}`,
  Sun: `Sunday ${prettyShortDate(cycle.distribution_dates.Sun)}`,
  all: 'All distribution days',
};
---

<AdminShell
  title="Pack sheet"
  subtitle={`${dayLabels[day]} · ${prettyWeekHeader(week_starting)}`}
  pageTitle="Pack sheet — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <button
      type="button"
      onclick="window.print()"
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark"
    >
      🖨 Print
    </button>
  </Fragment>

  {/* ── Day tab strip ─────────────────────────────────────────────── */}
  <nav aria-label="Distribution day" class="flex flex-wrap gap-1 border-b border-ts-border print:hidden">
    {(['Tue', 'Wed', 'Sat', 'Sun', 'all'] as const).map((d) => (
      <a
        href={`/admin/pack-sheet/${week_starting}?day=${d.toLowerCase()}`}
        aria-current={day === d ? 'page' : undefined}
        class={[
          'inline-flex h-10 items-center border-b-2 px-4 text-sm font-semibold transition-colors',
          day === d
            ? 'border-ts-primary text-ts-primary'
            : 'border-transparent text-ts-text-secondary hover:border-ts-border-strong hover:text-ts-text',
        ].join(' ')}
      >
        {d === 'all' ? 'All days' : dayLabels[d]}
      </a>
    ))}
  </nav>

  {/* ── Stat row ──────────────────────────────────────────────────── */}
  <section aria-label="Stats" class="grid grid-cols-2 gap-3 sm:grid-cols-5">
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Total boxes</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalBoxes}</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Add-on members</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalAddons}</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Flex lines</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalFlexLines}</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Stops</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{stopOrder.length}</div>
    </Card>
    {/* Make-ups owed this week — additive count so the crew sees, up front,
        how many owed items must be packed on top of the normal boxes. */}
    <Card padding="md" elevation="sm" tone={totalMakeups > 0 ? 'danger' : undefined}>
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Make-ups owed</div>
      <div class={[
        'mt-1 font-display text-3xl font-bold tabular-nums',
        totalMakeups > 0 ? 'text-ts-danger' : 'text-ts-text',
      ].join(' ')}>{totalMakeups}</div>
    </Card>
  </section>

  {/* ═══ ⚠ MAKE-UPS — pinned at the very TOP, grouped by stop ═══════════
      The single most important addition: every OPEN make-up promise that's
      due/overdue for this week, so the pack crew packs the owed item BEFORE
      anything else. Overdue (due_week before this Monday) flagged in red.
      Each row has an inline "Mark fulfilled" that POSTs to the existing
      notices/done endpoint and bounces back here (screen-only, no-print —
      the printed make-up reminders ride on /admin/pack-check + stop-manifest).
      Reads the SAME member_notices source as those sheets. */}
  {totalMakeups > 0 && (
    <section
      aria-labelledby="makeups-heading"
      class="makeups-banner rounded-ts-lg border-[3px] p-4 sm:p-5"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="makeups-heading" class="flex items-center gap-2 font-display text-lg font-extrabold uppercase tracking-wide sm:text-xl">
          <span aria-hidden="true">⚠</span>
          Make-ups — pack these until resolved
        </h2>
        <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1 text-sm font-extrabold tabular-nums">
          {totalMakeups} owed
        </span>
      </div>
      <p class="mt-1 text-sm font-medium">
        Owed items the farm promised. Pack each one, then mark it fulfilled. Overdue ones are flagged in red.
      </p>

      <div class="mt-4 flex flex-col gap-4">
        {stopsWithNotices.map(({ stop, notices }) => (
          <div class="makeups-stop rounded-ts-md border-2 bg-white/60 p-3">
            <h3 class="flex items-center gap-2 text-sm font-extrabold uppercase tracking-wide text-ts-text">
              {stop.stop_id === HOME_DELIVERY_BUCKET_ID ? '🏠 ' : '📍 '}{stop.stop_name}
              <span class="rounded-full bg-ts-danger/10 px-2 py-0.5 text-[11px] font-bold tabular-nums text-ts-danger">
                {notices.length}
              </span>
            </h3>
            <ul class="mt-2 flex flex-col divide-y divide-ts-border/50">
              {notices.map((n) => {
                const tag = dueTag(n);
                return (
                  <li class="flex flex-wrap items-start justify-between gap-3 py-2">
                    <div class="min-w-0 flex-1">
                      <p class="text-base font-bold leading-snug text-ts-text">
                        {n.member_name && (
                          <span class="text-ts-text">{n.member_name} — </span>
                        )}
                        {n.title}
                      </p>
                      {n.detail && (
                        <p class="mt-0.5 whitespace-pre-wrap break-words text-sm leading-snug text-ts-text-secondary">
                          {n.detail}
                        </p>
                      )}
                      <span class={[
                        'mt-1 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide',
                        tag.overdue
                          ? 'bg-ts-danger/15 text-ts-danger'
                          : 'bg-ts-bg-muted text-ts-text-secondary',
                      ].join(' ')}>
                        <span aria-hidden="true">🗓</span>{tag.text}
                      </span>
                    </div>
                    <form
                      method="POST"
                      action={`/api/admin/notices/${n.id}/done`}
                      class="m-0 shrink-0"
                    >
                      <input type="hidden" name="action" value="done" />
                      <input type="hidden" name="return_to" value={returnTo} />
                      <button
                        type="submit"
                        class="inline-flex h-9 items-center justify-center rounded-ts-md bg-ts-primary px-3 text-xs font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
                      >
                        ✓ Mark fulfilled
                      </button>
                    </form>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs font-medium text-ts-text-secondary">
        Need to add or edit a make-up? Open the <a href="/admin/notices" class="font-semibold text-ts-primary hover:underline">Notices page</a>.
      </p>
    </section>
  )}

  {!loadOrder && stopOrder.length > 0 && (
    <div class="print:hidden rounded-ts-md border border-ts-border bg-ts-bg-muted/50 px-4 py-3 text-sm text-ts-text-secondary">
      💡 Optimize + save this week's delivery route (Route planner → “Save &amp; send to driver”) to sort these stops into truck-loading order and print a load number on each.
    </div>
  )}

  {/* ── Per-stop pack lists ──────────────────────────────────────── */}
  {stopOrder.length === 0 ? (
    <Card tone="muted" padding="lg" elevation="sm">
      <p class="text-center text-sm text-ts-text-secondary">
        No active members for this distribution day.
      </p>
    </Card>
  ) : (
    <div class="flex flex-col gap-6">
      {orderedStops.map((stop) => {
        const stopMembers = (cycle.byStop.get(stop.stop_id) ?? [])
          .slice()
          .sort((a, b) => a.contact_name.localeCompare(b.contact_name));
        if (stopMembers.length === 0) return null;
        const loadBanner = loadBannerForStop(stop);
        return (
          <section class="page-break" aria-labelledby={`stop-${stop.stop_id}`}>
            {loadBanner && (
              <div class="load-banner flex items-center gap-3 rounded-ts-md px-4 py-2 mb-3">
                <span class="load-banner-num font-display text-xl font-extrabold tabular-nums leading-none">
                  🚚 {loadBanner.load}
                </span>
                <span class="text-xs font-semibold uppercase tracking-wide opacity-90">
                  {loadBanner.sub}
                </span>
              </div>
            )}
            <h2
              id={`stop-${stop.stop_id}`}
              class="font-display text-xl font-bold text-ts-text border-b-2 border-ts-text pb-2 mb-3"
            >
              {stop.stop_name}
              <span class="ml-2 text-sm font-normal text-ts-text-secondary">
                ({stopMembers.length} members)
              </span>
            </h2>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead class="border-b border-ts-border bg-ts-bg-muted/40">
                  <tr>
                    <th class="w-8 px-2 py-2"></th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Member</th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Size</th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Box contents</th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Add-on</th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Flex</th>
                    <th class="px-3 py-2 text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Flags</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-ts-border/60">
                  {stopMembers.map((m) => {
                    const comp = cycle.boxCompositionByMember.get(m.id);
                    const flex = flexLinesByMember.get(m.id) ?? [];
                    return (
                      <tr class="align-top">
                        <td class="px-2 py-3">
                          <span
                            class="inline-block h-4 w-4 rounded border-2 border-ts-text print:border-black"
                            aria-hidden="true"
                          ></span>
                        </td>
                        <td class="px-3 py-3 font-medium text-ts-text whitespace-nowrap">{m.contact_name}</td>
                        <td class="px-3 py-3 text-ts-text-secondary whitespace-nowrap">{memberSizeLabel(m)}</td>
                        <td class="px-3 py-3 text-ts-text-secondary">
                          {comp && comp.items.length > 0 ? (
                            <span>
                              {comp.items.map((it, i) => (
                                <span class={(it.notes === 'swap' || it.notes === 'swap (added)') ? 'text-ts-warning font-medium' : ''}>
                                  {i > 0 ? ', ' : ''}{it.crop}
                                </span>
                              ))}
                            </span>
                          ) : m.share_type === 'summer_veg' ? (
                            <em class="text-ts-text-muted">no box plan published</em>
                          ) : '—'}
                        </td>
                        <td class="px-3 py-3 text-ts-primary font-semibold whitespace-nowrap">
                          {memberAddons(m) || '—'}
                        </td>
                        <td class="px-3 py-3 text-ts-text-secondary">
                          {flex.length > 0 ? (
                            <ul class="space-y-0.5">
                              {flex.map((l) => (
                                <li>🎯 {l.qty}× {l.name ?? 'item'}</li>
                              ))}
                            </ul>
                          ) : '—'}
                        </td>
                        <td class="px-3 py-3">
                          {m.allergies.length > 0 && (
                            <div class="text-xs font-semibold text-ts-warning">
                              ⚠ allergy: {m.allergies.join(', ')}
                            </div>
                          )}
                          {owesFlag(m) && (
                            <div class="mt-0.5 text-xs font-semibold text-ts-warning">⚠ owes</div>
                          )}
                          {m.delivery_notes && (
                            <div class="mt-0.5 text-xs italic text-ts-text-muted">{m.delivery_notes}</div>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        );
      })}
    </div>
  )}
</AdminShell>

<style is:global>
  /* ── ⚠ MAKE-UPS banner — LOUD red so the pack crew packs owed items first.
   *    Fixed hex (not theme tokens) because it must reproduce on paper: a
   *    missed make-up is exactly the failure this banner exists to prevent.
   *    print-color-adjust:exact forces the browser to keep the red. */
  .makeups-banner {
    background: #fee2e2;          /* red-100 band */
    border-color: #dc2626;        /* red-600 frame */
    color: #7f1d1d;               /* red-900 text */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .makeups-banner .makeups-stop {
    border-color: #fca5a5;        /* red-300 inner frame */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* ── 🚚 TRUCK LOAD banner — dark bar, big load number, prints in color ── */
  .load-banner {
    background: #0f172a;          /* slate-900 */
    color: #ffffff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .load-banner .load-banner-num { color: #ffffff; }

  @media print {
    @page { size: Letter portrait; margin: 0.4in; }
    body, html { background: white !important; }
    header[class*="sticky"], nav[aria-label="Admin sections"],
    button[onclick*="print"] { display: none !important; }
