---
/**
 * /admin/pack-sheet/[week]?day=Wed — pack-day per-member checklist.
 *
 * Spec §4.6. Grouped by STOP (so packers can stage by stop), then by
 * member. Per member: name · size · box contents (with swap flags) ·
 * add-ons (separate column) · flex items (separate sub-row) · ⚠
 * allergy/owes flag.
 *
 * `?day` filters to one distribution day (Tue / Wed / Sat). Default: Wed.
 * "All" is also supported (omit ?day or pass ?day=all).
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import {
  resolveCycle, prettyWeekHeader, prettyShortDate,
  mondayOfWeek, isMonday,
  HOME_DELIVERY_BUCKET_ID,
  type WeekdayCode, type CycleMember, type StopTotals, type AddOnType,
} from '../../../lib/cycle';
import {
  fetchDueNoticesWithMemberForStops, groupNoticesByHint,
  isNoticeOverdue, HOME_DELIVERY_HINT,
  type NoticeWithMember,
} from '../../../lib/notices';
import { getLoadOrder, formatLoadRange, type LoadOrder } from '../../../lib/load-order';

const supabase = Astro.locals.supabase;
const slugParam = (Astro.params.slug ?? '') as string;
const segments = slugParam.split('/').filter(Boolean);
const week_input = segments[0] ?? '';
if (!/^\d{4}-\d{2}-\d{2}$/.test(week_input)) {
  return Astro.redirect('/admin/pack-sheet', 303);
}
const week_starting = isMonday(week_input) ? week_input : mondayOfWeek(week_input);

// ─── Distribution-day DEFAULT from TODAY's ET weekday ────────────────
// A pack crew that opens this on the actual pack day should land on THAT
// day's list — not always Wednesday (a Saturday market crew was landing on
// the Wednesday list). Documented mapping (farm's own calendar, America/
// New_York):
//   Sat        → Sat  (Saturday markets)
//   Sun        → Sun  (South Side, Sunday market)
//   Thu / Fri  → Sat  (weekend-market pack/prep happens Thu–Fri)
//   else       → Wed  (Mon/Tue/Wed all point at the main Wednesday delivery)
// An explicit ?day= always wins over the default (the day tabs still work).
function todayETWeekday(now: Date = new Date()): string {
  return new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/New_York', weekday: 'short',
  }).format(now);
}
// Return type is the narrow set of days this sheet actually tabs (never Mon/
// Thu/Fri), so `day` stays within the dayLabels keys (no implicit-any index).
function defaultDayTab(): 'Wed' | 'Sat' | 'Sun' {
  const wd = todayETWeekday();
  if (wd === 'Sat') return 'Sat';
  if (wd === 'Sun') return 'Sun';
  if (wd === 'Thu' || wd === 'Fri') return 'Sat';
  return 'Wed';
}
const dayParam = Astro.url.searchParams.get('day');
const dayRaw = (dayParam ?? '').toLowerCase();
const day: 'Tue' | 'Wed' | 'Sat' | 'Sun' | 'all' =
  dayRaw === 'tue' ? 'Tue' :
  dayRaw === 'wed' ? 'Wed' :
  dayRaw === 'sat' ? 'Sat' :
  dayRaw === 'sun' ? 'Sun' :
  dayRaw === 'all' ? 'all' :
  defaultDayTab();

const cycle = await resolveCycle(supabase, week_starting);

// ─── Members for the selected day ──────────────────────────────────
// Select by each member's ACTUAL pickup weekday, NOT cycle.byDistributionDay
// (which collapses Sunday pickups into its 'Wed' default — that hid Sunday
// markets like South Side from every day tab). Home delivery / no-pickup
// default to Wed, matching the resolver's distribution-day rule.
function memberDistDay(m: CycleMember): WeekdayCode {
  return m.pickup_location?.day_of_week ?? 'Wed';
}
const selectedMembers: CycleMember[] = day === 'all'
  ? cycle.members
  : cycle.members.filter((m) => memberDistDay(m) === day);

// ─── Group by stop, then alphabetical within stop ──────────────────
const stopOrder = cycle.activeStops.filter((s) => {
  if (day === 'all') return true;
  // For a single-day view, only include stops whose day_of_week matches
  // (home delivery defaults to Wed).
  if (s.stop_id === HOME_DELIVERY_BUCKET_ID) return day === 'Wed';
  return s.day_of_week === day;
});

// ─── TRUCK LOAD ORDER + individual home stops (Todd 2026-07) ─────────
// When an optimized route is SAVED for the week: (1) split the aggregate home
// bucket into INDIVIDUAL home stops (each its own numbered slot — change 2), and
// (2) re-order the per-stop sections into TRUCK-LOADING order (LEG-then-LOAD:
// leg A load-first…last, then leg B; per-leg loadSeq restarts). Off-route stops
// + the "not on a saved route" home bucket sort to the end. No saved route →
// the sheet renders as before (fail-soft). Shared lib/load-order — the SAME
// per-leg numbering the labels + the truck sheets use (ONE numbering truth).
const loadOrder: LoadOrder | null = await getLoadOrder(supabase, week_starting);
const INF = Number.POSITIVE_INFINITY;
const HOME_SPLIT_PREFIX = `${HOME_DELIVERY_BUCKET_ID}__`;
const HOME_CUST_PREFIX = `${HOME_SPLIT_PREFIX}cust:`;
const isHomeStop = (id: string): boolean =>
  id === HOME_DELIVERY_BUCKET_ID || id.startsWith(HOME_SPLIT_PREFIX);

/** Per-stop tally for a synthetic (individual/unrouted) home stop — mirrors
 *  resolveCycle's counting so the header count stays accurate. */
function buildSubsetTotals(stop_id: string, stop_name: string, members: CycleMember[]): StopTotals {
  const totals: StopTotals = {
    stop_id, stop_name, day_of_week: 'Wed',
    boxes_small: 0, boxes_large: 0,
    addons: { mushroom: 0, bread: 0, cheese: 0, coffee: 0, eggs: 0, unknown: 0 },
    flex_orders: 0, owes_count: 0,
  };
  for (const m of members) {
    if (m.share_type === 'summer_veg') {
      if (m.size_bucket === 'large') totals.boxes_large += 1; else totals.boxes_small += 1;
    }
    if (m.share_type === 'add_on') totals.addons[m.addon_type] += 1;
    if (m.payment_status && m.payment_status.toLowerCase() !== 'paid') totals.owes_count += 1;
  }
  return totals;
}

// Split the home bucket into individual stops when a route is saved (change 2).
let bodyStops: StopTotals[] = stopOrder;
if (loadOrder && stopOrder.some((s) => s.stop_id === HOME_DELIVERY_BUCKET_ID)) {
  const homeMembers = cycle.byStop.get(HOME_DELIVERY_BUCKET_ID) ?? [];
  if (homeMembers.length > 0) {
    const byCustomer = new Map<string, CycleMember[]>();
    for (const m of homeMembers) {
      const arr = byCustomer.get(m.customer_id);
      if (arr) arr.push(m); else byCustomer.set(m.customer_id, [m]);
    }
    const homeStops: StopTotals[] = [];
    const unrouted: CycleMember[] = [];
    for (const [customerId, members] of byCustomer) {
      if (loadOrder.home(customerId)) {
        const sid = `${HOME_CUST_PREFIX}${customerId}`;
        cycle.byStop.set(sid, members);
        homeStops.push(buildSubsetTotals(sid, members[0]?.contact_name ?? 'Home delivery', members));
      } else {
        unrouted.push(...members);
      }
    }
    if (unrouted.length > 0) {
      const sid = `${HOME_SPLIT_PREFIX}unassigned`;
      cycle.byStop.set(sid, unrouted);
      homeStops.push(buildSubsetTotals(sid, 'Home delivery · not on a saved route', unrouted));
    }
    bodyStops = stopOrder.filter((s) => s.stop_id !== HOME_DELIVERY_BUCKET_ID).concat(homeStops);
  }
}

// ─── WHOLESALE stops on the pack sheet (Todd 2026-08-12) ─────────────
// "Can we have the wholesale on there too? So we are not missing anything
// in the loading order?" Wholesale orders for this day's delivery date are
// rendered as their own stop sections, interleaved at their saved-route
// LOAD position (orderKey `wc:<customers.id>`), each with an item checklist.
const WHOLESALE_PREFIX = 'wholesale__';
interface WholesaleSection {
  stop_id: string;            // wholesale__<customers.id>
  customer_id: string;        // customers.id (wc: orderKey target)
  name: string;               // restaurant name
  items: { name: string; qty: number }[];
  note: string | null;
  /** False when wholesale_accounts.customer_id is NULL — the stop cannot be
   *  saved to a driver route, so it can never carry a load number. */
  linked: boolean;
}
const wholesaleSections: WholesaleSection[] = [];
{
  // The sheet's delivery date for the selected tab (Wed default; 'all' → Wed).
  const wsDay: 'Tue' | 'Wed' | 'Sat' | 'Sun' = day === 'all' || day === 'Tue' ? 'Wed' : day;
  const wsDate = cycle.distribution_dates[wsDay];
  const { data: wsOrders } = await supabase
    .from('wholesale_orders')
    .select('id, account_id, notes, wholesale_accounts:account_id ( restaurant_name, customer_id )')
    .eq('delivery_date', wsDate)
    .in('status', ['submitted', 'confirmed', 'packed']);
  const orderIds = (wsOrders ?? []).map((o: any) => o.id);
  const itemsByOrder = new Map<string, { name: string; qty: number }[]>();
  if (orderIds.length > 0) {
    const { data: wsItems } = await supabase
      .from('wholesale_order_items')
      .select('order_id, product_name, qty')
      .in('order_id', orderIds);
    for (const it of (wsItems ?? []) as any[]) {
      const arr = itemsByOrder.get(it.order_id) ?? [];
      arr.push({ name: it.product_name, qty: Number(it.qty) });
      itemsByOrder.set(it.order_id, arr);
    }
  }
  // One section per ACCOUNT (merge multiple orders for the same restaurant).
  const byAccount = new Map<string, WholesaleSection>();
  for (const o of (wsOrders ?? []) as any[]) {
    const acct = o.wholesale_accounts;
    if (!acct) continue;
    const cid = acct.customer_id ?? o.account_id; // customers.id preferred (wc: key)
    const key = `${WHOLESALE_PREFIX}${cid}`;
    const sec = byAccount.get(key) ?? {
      stop_id: key, customer_id: cid, name: acct.restaurant_name ?? 'Wholesale', items: [], note: null,
      linked: Boolean(acct.customer_id),
    };
    sec.items.push(...(itemsByOrder.get(o.id) ?? []));
    byAccount.set(key, sec);
  }
  wholesaleSections.push(...byAccount.values());
}
const wholesaleByStopId = new Map(wholesaleSections.map((w) => [w.stop_id, w]));
// Interleave: each wholesale section joins the stop flow as a synthetic stop.
for (const w of wholesaleSections) {
  bodyStops.push({
    stop_id: w.stop_id, stop_name: w.name, day_of_week: 'Wed',
    boxes_small: 0, boxes_large: 0,
    addons: { mushroom: 0, bread: 0, cheese: 0, coffee: 0, eggs: 0, unknown: 0 },
    flex_orders: 0, owes_count: 0,
  });
}

/** LEG-then-LOAD sort value (POSITIVE_INFINITY off-route → sorts to the end). */
function stopSortValue(stop: StopTotals): number {
  if (!loadOrder) return INF;
  if (stop.stop_id === `${HOME_SPLIT_PREFIX}unassigned`) return INF;
  if (stop.stop_id.startsWith(HOME_CUST_PREFIX)) {
    return loadOrder.orderValue(`cust:${stop.stop_id.slice(HOME_CUST_PREFIX.length)}`);
  }
  if (stop.stop_id.startsWith(WHOLESALE_PREFIX)) {
    return loadOrder.orderValue(`wc:${stop.stop_id.slice(WHOLESALE_PREFIX.length)}`);
  }
  return loadOrder.orderValue(`pl:${stop.stop_id}`);
}
const orderedStops: StopTotals[] = loadOrder
  ? bodyStops
      .map((s, i) => ({ s, i, k: stopSortValue(s) }))
      .sort((a, b) => {
        if (a.k !== b.k) {
          if (a.k === INF) return 1;
          if (b.k === INF) return -1;
          return a.k - b.k;
        }
        return a.i - b.i;
      })
      .map((x) => x.s)
  : bodyStops;

// Numbered LOAD banner for a stop (null off-route / no saved route). Per-leg.
interface LoadBanner { load: string; sub: string; }
function loadBannerForStop(stop: StopTotals): LoadBanner | null {
  if (!loadOrder) return null;
  const legTag = (leg: string) => (loadOrder!.legCount > 1 ? ` · Route ${leg}` : '');
  if (stop.stop_id.startsWith(HOME_CUST_PREFIX)) {
    const st = loadOrder.home(stop.stop_id.slice(HOME_CUST_PREFIX.length));
    if (!st) return null;
    return { load: `LOAD #${st.loadSeq}`, sub: `home · #${st.routeSeq} of ${st.legTotal}${legTag(st.leg)}` };
  }
  if (stop.stop_id === `${HOME_SPLIT_PREFIX}unassigned`) return null;
  if (stop.stop_id === HOME_DELIVERY_BUCKET_ID) {
    const seqs: number[] = [];
    const legsSeen = new Set<string>();
    for (const m of (cycle.byStop.get(stop.stop_id) ?? [])) {
      const st = loadOrder.home(m.customer_id);
      if (st) { seqs.push(st.loadSeq); legsSeen.add(st.leg); }
    }
    const range = formatLoadRange(seqs);
    if (!range) return null;
    const legLabel = legsSeen.size === 1 ? legTag([...legsSeen][0]) : '';
    return { load: `LOAD ${range}`, sub: `${seqs.length} home stop${seqs.length === 1 ? '' : 's'}${legLabel}` };
  }
  if (stop.stop_id.startsWith(WHOLESALE_PREFIX)) {
    const st = loadOrder.wholesaleCustomer(stop.stop_id.slice(WHOLESALE_PREFIX.length));
    if (!st) return null;
    return { load: `LOAD #${st.loadSeq}`, sub: `wholesale · #${st.routeSeq} of ${st.legTotal}${legTag(st.leg)}` };
  }
  const st = loadOrder.pickup(stop.stop_id);
  if (!st) return null;
  return { load: `LOAD #${st.loadSeq}`, sub: `drive stop ${st.routeSeq} of ${st.legTotal}${legTag(st.leg)}` };
}

// ─── Open MAKE-UP notices due/overdue for the rendered stops ─────────
// THE GAP THIS FIXES: make-up promises ("owed double mushroom", "make-good
// bread + cheese") were wired into /admin/stop-manifest + /admin/pack-check but
// NOT this main pack sheet — so owed add-ons got missed on pack day. We read the
// SAME source of truth (member_notices via lib/notices) so this sheet,
// stop-manifest, and pack-check can never disagree. One bounded query over the
// rendered stops' hints (stop NAME, plus HOME_DELIVERY_HINT for the home
// bucket), filtered to OPEN + due/overdue (overdue make-ups PERSIST until
// fulfilled — isNoticeDueOrOverdue inside the fetch), grouped by hint. Member
// name is joined so the banner reads "Denise Fazio — owed double mushroom".
const noticeHints: string[] = stopOrder.map((s) =>
  s.stop_id === HOME_DELIVERY_BUCKET_ID ? HOME_DELIVERY_HINT : s.stop_name,
);
const dueNotices = await fetchDueNoticesWithMemberForStops(
  supabase, noticeHints, week_starting,
);
const noticesByHint = groupNoticesByHint(dueNotices);
/** The make-up notices to pin for a stop (by its hint). */
function noticesForStop(stop: StopTotals): NoticeWithMember[] {
  const hint = stop.stop_id === HOME_DELIVERY_BUCKET_ID ? HOME_DELIVERY_HINT : stop.stop_name;
  return noticesByHint.get(hint) ?? [];
}
/** Stops (in render order) that actually have ≥1 make-up, for the TOP banner. */
const stopsWithNotices = stopOrder
  .map((s) => ({ stop: s, notices: noticesForStop(s) }))
  .filter((x) => x.notices.length > 0);
const totalMakeups = stopsWithNotices.reduce((a, x) => a + x.notices.length, 0);

/** Short "due Jun 22" / "OVERDUE since Jun 22" tag for a make-up row. */
function dueTag(n: NoticeWithMember): { text: string; overdue: boolean } {
  const overdue = isNoticeOverdue(n.due_week, week_starting);
  if (n.due_week == null) return { text: 'next opportunity', overdue: false };
  const d = new Date(`${n.due_week}T12:00:00Z`);
  const pretty = new Intl.DateTimeFormat('en-US', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
  }).format(d);
  return { text: overdue ? `OVERDUE since ${pretty}` : `due ${pretty}`, overdue };
}

// The path this very sheet renders at — passed to the inline resolve form so
// marking a make-up fulfilled bounces back HERE (not to /admin/notices).
const returnTo = `/admin/pack-sheet/${week_starting}`;

// Pre-fetch flex lines per member for the rendered day.
type FlexLineRow = {
  member_id: string;
  qty: number;
  flex_item: { name: string | null } | null;
};
const flexLinesByMember = new Map<string, Array<{ name: string | null; qty: number }>>();
{
  const memberIds = selectedMembers.map((m) => m.id);
  if (memberIds.length > 0) {
    // Status set MATCHES /admin/pack-check EXACTLY (pending | locked | fulfilled)
    // so the flex-empty EXCLUSION below drops the same members pack-check drops.
    const { data, error } = await supabase
      .from('flex_orders')
      .select('member_id, qty, flex_item:flex_inventory ( name )')
      .eq('cycle_code', 'WEEKLY')
      .eq('week_starting', week_starting)
      .in('status', ['pending', 'locked', 'fulfilled'])
      .in('member_id', memberIds)
      .overrideTypes<FlexLineRow[], { merge: false }>();
    if (!error) {
      for (const r of (data ?? []) as FlexLineRow[]) {
        const arr = flexLinesByMember.get(r.member_id) ?? [];
        arr.push({ name: r.flex_item?.name ?? null, qty: r.qty });
        flexLinesByMember.set(r.member_id, arr);
      }
    }
  }
}
// Flex members WITH an order this week = the "ordered set". A flex member NOT in
// this set ordered nothing → excluded from the pack sheet (change 4a). This is
// the EXACT gate /admin/pack-check uses (flexOrderedMemberIds from flexByMember).
const flexOrderedMemberIds = new Set<string>(flexLinesByMember.keys());

// ─── PER-CUSTOMER CONSOLIDATION (change 4b — density) ────────────────
// The old sheet listed one line per member ROW — so add-on rows printed as
// separate "people" and flex members with no order printed empty lines (Todd:
// "unreadable and unusable"). We collapse to ONE compact line per CUSTOMER:
// the box share names the line; add-on rows fold into abbreviations; flex members
// with no order this week are dropped (same gate as pack-check). Mirrors the
// pack-check packRowsForStop grouping.
const addonRowsByCustomer = new Map<string, CycleMember[]>();
for (const m of cycle.members) {
  if (m.share_type === 'add_on') {
    const arr = addonRowsByCustomer.get(m.customer_id);
    if (arr) arr.push(m); else addonRowsByCustomer.set(m.customer_id, [m]);
  }
}
const SHARE_PRIORITY: Record<string, number> = { summer_veg: 0, spring_veg: 1, flower: 2, flex: 3, add_on: 9 };
const ADDON_ABBR: Record<AddOnType, string> = {
  mushroom: 'Mush', bread: 'Bread', cheese: 'Cheese', coffee: 'Coffee', eggs: 'Eggs', unknown: 'Add-on',
};

function compactSizeLabel(m: CycleMember): string {
  if (m.share_type === 'summer_veg') {
    const raw = (m.share_size ?? '').trim();
    if (raw) return raw.charAt(0).toUpperCase() + raw.slice(1).toLowerCase();
    return m.size_bucket === 'large' ? 'Large' : 'Small';
  }
  if (m.share_type === 'flower') return 'Flower';
  if (m.share_type === 'flex') return 'Flex';
  if (m.share_type === 'spring_veg') return 'Spring';
  return m.share_type;
}

interface CompactRow {
  name: string;
  sizeLabel: string;
  addons: string[];      // e.g. ['Cheese', 'Mush ×2']
  flexCount: number;     // total flex items (qty) for this customer
  allergies: string[];
  owes: boolean;
  flowerOnly: boolean;
}
/** One compact line per customer at a stop (alphabetical). Flex-with-no-order
 *  members are excluded — the EXACT filter pack-check uses. */
function compactRowsForStop(stop: StopTotals): CompactRow[] {
  const members = cycle.byStop.get(stop.stop_id) ?? [];
  const byCustomer = new Map<string, CycleMember[]>();
  for (const m of members) {
    if (m.share_type === 'add_on') continue;
    if (m.share_type === 'flex' && !flexOrderedMemberIds.has(m.id)) continue;
    const arr = byCustomer.get(m.customer_id);
    if (arr) arr.push(m); else byCustomer.set(m.customer_id, [m]);
  }
  const rows: CompactRow[] = [];
  for (const [customerId, boxRows] of byCustomer) {
    const sorted = boxRows.slice().sort((a, b) => (SHARE_PRIORITY[a.share_type] ?? 5) - (SHARE_PRIORITY[b.share_type] ?? 5));
    const primary = sorted[0];
    const addons = addonRowsByCustomer.get(customerId) ?? [];
    const byType = new Map<AddOnType, number>();
    for (const a of addons) byType.set(a.addon_type, (byType.get(a.addon_type) ?? 0) + 1);
    const addonAbbr: string[] = [];
    for (const [type, count] of byType) addonAbbr.push(`${ADDON_ABBR[type]}${count > 1 ? ` ×${count}` : ''}`);
    addonAbbr.sort();
    let flexCount = 0;
    for (const m of [...sorted, ...addons]) {
      const lines = flexLinesByMember.get(m.id);
      if (lines) flexCount += lines.reduce((a, l) => a + (l.qty || 1), 0);
    }
    const owes = [...sorted, ...addons].some(
      (m) => !!(m.payment_status && m.payment_status.trim().toLowerCase() !== 'paid'),
    );
    rows.push({
      name: primary.contact_name,
      sizeLabel: compactSizeLabel(primary),
      addons: addonAbbr,
      flexCount,
      allergies: primary.allergies ?? [],
      owes,
      flowerOnly: primary.share_type === 'flower',
    });
  }
  rows.sort((a, b) => a.name.localeCompare(b.name));
  return rows;
}

const totalBoxes = selectedMembers.filter((m) => m.share_type === 'summer_veg').length;
const totalAddons = selectedMembers.filter((m) => m.share_type === 'add_on').length;
const totalFlexLines = Array.from(flexLinesByMember.values()).reduce(
  (a, lines) => a + lines.length, 0,
);

const dayLabels: Record<'Tue'|'Wed'|'Sat'|'Sun'|'all', string> = {
  Tue: `Tuesday ${prettyShortDate(cycle.distribution_dates.Tue)}`,
  Wed: `Wednesday ${prettyShortDate(cycle.distribution_dates.Wed)}`,
  Sat: `Saturday ${prettyShortDate(cycle.distribution_dates.Sat)}`,
  Sun: `Sunday ${prettyShortDate(cycle.distribution_dates.Sun)}`,
  all: 'All distribution days',
};
---

<AdminShell
  title="Pack sheet"
  subtitle={`${dayLabels[day]} · ${prettyWeekHeader(week_starting)}`}
  pageTitle="Pack sheet — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <button
      type="button"
      onclick="window.print()"
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark"
    >
      🖨 Print
    </button>
  </Fragment>

  {/* ── PRINTED week/day header band (print-only) ─────────────────────
      The AdminShell heading that carries the day + week range is print-hidden,
      so a printed pack sheet used to start with stat cards then the list — with
      NOTHING on paper saying which harvest run (Monday's vs Thursday's) it is.
      This band prints the day + date + canonical WEEK RANGE at the very top,
      mirroring the pick-pack doc-band. Screen-hidden (the AdminShell heading +
      day tabs already carry this on screen). */}
  <div class="ps-print-head hidden print:block">
    <span class="ps-print-title">Pack sheet</span>
    <span class="ps-print-scope">{dayLabels[day]} · {prettyWeekHeader(week_starting)}</span>
  </div>

  {/* ── Day tab strip ─────────────────────────────────────────────── */}
  <nav aria-label="Distribution day" class="flex flex-wrap gap-1 border-b border-ts-border print:hidden">
    {(['Tue', 'Wed', 'Sat', 'Sun', 'all'] as const).map((d) => (
      <a
        href={`/admin/pack-sheet/${week_starting}?day=${d.toLowerCase()}`}
        aria-current={day === d ? 'page' : undefined}
        class={[
          'inline-flex h-10 items-center border-b-2 px-4 text-sm font-semibold transition-colors',
          day === d
            ? 'border-ts-primary text-ts-primary'
            : 'border-transparent text-ts-text-secondary hover:border-ts-border-strong hover:text-ts-text',
        ].join(' ')}
      >
        {d === 'all' ? 'All days' : dayLabels[d]}
      </a>
    ))}
  </nav>

  {/* ── Stat row (screen furniture — hidden on print so page 1 opens on the
        make-ups banner + the list, not ~1.5in of stat cards). ──────────── */}
  <section aria-label="Stats" class="grid grid-cols-2 gap-3 sm:grid-cols-5 print:hidden">
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Total boxes</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalBoxes}</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Add-on members</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalAddons}</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Flex lines</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalFlexLines}</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Stops</div>
      <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{stopOrder.length}</div>
    </Card>
    {/* Make-ups owed this week — additive count so the crew sees, up front,
        how many owed items must be packed on top of the normal boxes. */}
    <Card padding="md" elevation="sm" tone={totalMakeups > 0 ? 'danger' : undefined}>
      <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Make-ups owed</div>
      <div class={[
        'mt-1 font-display text-3xl font-bold tabular-nums',
        totalMakeups > 0 ? 'text-ts-danger' : 'text-ts-text',
      ].join(' ')}>{totalMakeups}</div>
    </Card>
  </section>

  {/* ═══ ⚠ MAKE-UPS — pinned at the very TOP, grouped by stop ═══════════
      The single most important addition: every OPEN make-up promise that's
      due/overdue for this week, so the pack crew packs the owed item BEFORE
      anything else. Overdue (due_week before this Monday) flagged in red.
      Each row has an inline "Mark fulfilled" that POSTs to the existing
      notices/done endpoint and bounces back here (screen-only, no-print —
      the printed make-up reminders ride on /admin/pack-check + stop-manifest).
      Reads the SAME member_notices source as those sheets. */}
  {totalMakeups > 0 && (
    <section
      aria-labelledby="makeups-heading"
      class="makeups-banner rounded-ts-lg border-[3px] p-4 sm:p-5"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="makeups-heading" class="flex items-center gap-2 font-display text-lg font-extrabold uppercase tracking-wide sm:text-xl">
          <span aria-hidden="true">⚠</span>
          Make-ups — pack these until resolved
        </h2>
        <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1 text-sm font-extrabold tabular-nums">
          {totalMakeups} owed
        </span>
      </div>
      <p class="mt-1 text-sm font-medium">
        Owed items the farm promised. Pack each one, then mark it fulfilled. Overdue ones are flagged in red.
      </p>

      <div class="mt-4 flex flex-col gap-4">
        {stopsWithNotices.map(({ stop, notices }) => (
          <div class="makeups-stop rounded-ts-md border-2 bg-white/60 p-3">
            <h3 class="flex items-center gap-2 text-sm font-extrabold uppercase tracking-wide text-ts-text">
              {stop.stop_id === HOME_DELIVERY_BUCKET_ID ? '🏠 ' : '📍 '}{stop.stop_name}
              <span class="rounded-full bg-ts-danger/10 px-2 py-0.5 text-[11px] font-bold tabular-nums text-ts-danger">
                {notices.length}
              </span>
            </h3>
            <ul class="mt-2 flex flex-col divide-y divide-ts-border/50">
              {notices.map((n) => {
                const tag = dueTag(n);
                return (
                  <li class="flex flex-wrap items-start justify-between gap-3 py-2">
                    <div class="min-w-0 flex-1">
                      <p class="text-base font-bold leading-snug text-ts-text">
                        {n.member_name && (
                          <span class="text-ts-text">{n.member_name} — </span>
                        )}
                        {n.title}
                      </p>
                      {n.detail && (
                        <p class="mt-0.5 whitespace-pre-wrap break-words text-sm leading-snug text-ts-text-secondary">
                          {n.detail}
                        </p>
                      )}
                      <span class={[
                        'mt-1 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide',
                        tag.overdue
                          ? 'bg-ts-danger/15 text-ts-danger'
                          : 'bg-ts-bg-muted text-ts-text-secondary',
                      ].join(' ')}>
                        <span aria-hidden="true">🗓</span>{tag.text}
                      </span>
                    </div>
                    <form
                      method="POST"
                      action={`/api/admin/notices/${n.id}/done`}
                      class="m-0 shrink-0"
                    >
                      <input type="hidden" name="action" value="done" />
                      <input type="hidden" name="return_to" value={returnTo} />
                      <button
                        type="submit"
                        class="inline-flex h-9 items-center justify-center rounded-ts-md bg-ts-primary px-3 text-xs font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
                      >
                        ✓ Mark fulfilled
                      </button>
                    </form>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-3 text-xs font-medium text-ts-text-secondary">
        Need to add or edit a make-up? Open the <a href="/admin/notices" class="font-semibold text-ts-primary hover:underline">Notices page</a>.
      </p>
    </section>
  )}

  {!loadOrder && stopOrder.length > 0 && (
    <div class="print:hidden rounded-ts-md border border-ts-border bg-ts-bg-muted/50 px-4 py-3 text-sm text-ts-text-secondary">
      💡 Optimize + save this week's delivery route (Route planner → “Save &amp; send to driver”) to sort these stops into truck-loading order and print a load number on each.
    </div>
  )}

  {/* ── DENSE, CONSOLIDATED pack list (change 4) ─────────────────────
      One compact line per CUSTOMER (name · size · add-on abbreviations · flex
      count), flowing continuously in TWO columns with bold stop headers. NO page
      break per stop — the whole farm fits in 2-3 pages (per-stop, one-sheet-each
      printing lives on /admin/pack-check). Stops are in truck-LOAD order with a
      compact 🚚 banner; home delivery is split into individual stops. */}
  {stopOrder.length === 0 ? (
    <Card tone="muted" padding="lg" elevation="sm">
      <p class="text-center text-sm text-ts-text-secondary">
        No active members for this distribution day.
      </p>
    </Card>
  ) : (
    <div class="ps-doc">
      {orderedStops.map((stop) => {
        // WHOLESALE section: item checklist instead of member rows.
        const ws = wholesaleByStopId.get(stop.stop_id);
        if (ws) {
          const wsBanner = loadBannerForStop(stop);
          return (
            <div class="ps-stop ps-wholesale">
              <div class="ps-stop-head">
                {wsBanner && <span class="ps-load">🚚 {wsBanner.load}</span>}
                <span class="ps-stop-name">🏬 {ws.name}</span>
                <span class="ps-stop-sub">WHOLESALE · {ws.items.length} item{ws.items.length === 1 ? '' : 's'}{wsBanner ? ` · ${wsBanner.sub}` : ''}</span>
                {/* No load number + no customer link = this stop could never be
                    matched to the saved route, so it sank to the bottom of the
                    sheet. Todd hit that on 2026-08-25 with no explanation
                    anywhere. Say it on the sheet. */}
                {!wsBanner && !ws.linked && (
                  <span class="ps-offroute">⚠ not on the saved route — no customer link</span>
                )}
                {!wsBanner && ws.linked && (
                  <span class="ps-offroute">⚠ not on the saved route — re-save the route to place it</span>
                )}
              </div>
              {ws.items.map((it) => (
                <div class="ps-member">
                  <span class="ps-check" aria-hidden="true"></span>
                  <span class="ps-name">{it.name}</span>
                  <span class="ps-size">× {it.qty}</span>
                </div>
              ))}
            </div>
          );
        }
        const rows = compactRowsForStop(stop);
        if (rows.length === 0) return null;
        const loadBanner = loadBannerForStop(stop);
        const isHome = isHomeStop(stop.stop_id);
        return (
          <div class="ps-stop">
            <div class="ps-stop-head">
              {loadBanner && <span class="ps-load">🚚 {loadBanner.load}</span>}
              <span class="ps-stop-name">{isHome ? '🏠 ' : ''}{stop.stop_name}</span>
              <span class="ps-stop-sub">
                {rows.length} {rows.length === 1 ? 'box' : 'boxes'}{loadBanner ? ` · ${loadBanner.sub}` : ''}
              </span>
            </div>
            {rows.map((r) => (
              <div class:list={['ps-member', { 'ps-member-flower': r.flowerOnly }]}>
                <span class="ps-check" aria-hidden="true"></span>
                <span class="ps-name">{r.name}</span>
                <span class="ps-size">{r.sizeLabel}</span>
                {r.flowerOnly && <span class="ps-tag ps-flower">🌸</span>}
                {r.addons.length > 0 && <span class="ps-addon">+ {r.addons.join(', ')}</span>}
                {r.flexCount > 0 && <span class="ps-flex">🎯 {r.flexCount}</span>}
                {r.allergies.length > 0 && <span class="ps-flag">⚠ {r.allergies.join(', ')}</span>}
                {r.owes && <span class="ps-flag">⚠ owes</span>}
              </div>
            ))}
          </div>
        );
      })}
    </div>
  )}
</AdminShell>

<style is:global>
  /* ── ⚠ MAKE-UPS banner — LOUD red so the pack crew packs owed items first.
   *    Fixed hex (not theme tokens) because it must reproduce on paper: a
   *    missed make-up is exactly the failure this banner exists to prevent.
   *    print-color-adjust:exact forces the browser to keep the red. */
  .makeups-banner {
    background: #fee2e2;          /* red-100 band */
    border-color: #dc2626;        /* red-600 frame */
    color: #7f1d1d;               /* red-900 text */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .makeups-banner .makeups-stop {
    border-color: #fca5a5;        /* red-300 inner frame */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* ── DENSE two-column pack list (change 4b) ──────────────────────────
   *  The whole day flows in 2 columns of compact one-line-per-customer rows so
   *  the entire farm fits in 2-3 pages. Stops flow continuously (NO page break
   *  per stop). A stop header uses break-after:avoid so it never orphans at the
   *  foot of a column; each member row avoids breaking mid-row. */
  .ps-doc {
    column-count: 2;
    column-gap: 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .ps-stop { break-inside: auto; margin-bottom: 0.5rem; }

  .ps-stop-head {
    break-inside: avoid;
    break-after: avoid;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.25rem 0 0.2rem;
    margin-top: 0.4rem;
    border-bottom: 2px solid #111827;
  }
  /* WHOLESALE sections — amber band so the crew can't miss restaurant crates
   * in the load flow (Todd 2026-08-12). Fixed hex for print fidelity. */
  .ps-offroute {
  display: block;
  font-size: 10pt;
  font-weight: 700;
  color: #92400e;
}
.ps-wholesale .ps-stop-head {
    background: #fef3c7;          /* amber-100 */
    border-bottom-color: #b45309; /* amber-700 */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .ps-load {
    background: #0f172a; color: #fff;
    border-radius: 4px;
    padding: 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .ps-stop-name { font-size: 1.02rem; font-weight: 800; color: #111827; line-height: 1.1; }
  .ps-stop-sub { font-size: 0.72rem; font-weight: 600; color: #6b7280; margin-left: auto; }

  .ps-member {
    break-inside: avoid;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem 0.45rem;
    padding: 0.16rem 0;
    border-bottom: 1px solid #f1f2f4;
    font-size: 0.82rem;
    line-height: 1.2;
  }
  /* Zebra — this is the most spreadsheet-like list in the portal (one line per
     customer). The 1px hairline is near-invisible on paper, so alternate a soft
     tint. Flower rows keep their pink wash (excluded from zebra), and the tint
     is print-color-adjust:exact so it survives the print pipeline. */
  .ps-member:not(.ps-member-flower):nth-child(even) {
    background: #f4f6f8;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .ps-member-flower {
    background: #fdf2f6;
    box-shadow: inset 3px 0 0 0 #e79cb9;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .ps-check {
    flex-shrink: 0;
    width: 0.85rem; height: 0.85rem;
    border: 1.5px solid #111827;
    border-radius: 3px;
    background: #fff;
    align-self: center;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .ps-name { font-weight: 700; color: #111827; }
  .ps-size {
    font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em;
    color: #334155; background: #e6eaef; border-radius: 999px; padding: 0.02rem 0.4rem;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .ps-addon { font-size: 0.74rem; font-weight: 600; color: #166534; }
  .ps-flex { font-size: 0.74rem; font-weight: 700; color: #b45309; }
  .ps-flag { font-size: 0.72rem; font-weight: 700; color: #b91c1c; }
  .ps-tag.ps-flower { font-size: 0.74rem; }

  /* ── Printed week/day header band (print-only via `hidden print:block`) ──
     Identifies the harvest run on paper (day + date + canonical WEEK RANGE) so
     Monday's and Thursday's printouts can never be confused. */
  .ps-print-head {
    padding-bottom: 0.3rem;
    margin-bottom: 0.5rem;
    border-bottom: 3px solid #111827;
  }
  .ps-print-title { font-size: 15pt; font-weight: 800; color: #111827; margin-right: 0.5rem; }
  .ps-print-scope { font-size: 11.5pt; font-weight: 600; color: #374151; }

  @media print {
    @page { size: Letter portrait; margin: 0.35in; }
    body, html { background: white !important; }
    header[class*="sticky"], nav[aria-label="Admin sections"],
    button[onclick*="print"] { display: none !important; }
    main > div:first-child { padding-top: 0 !important; }

    /* ── ≥11pt body floor (standing rule: compact ≠ cramped) ──────────────
       Screen density stays tight; on PAPER the scanned fields clear 11pt.
       Two columns still fit ~50 rows/page at these sizes. */
    .ps-member { font-size: 11pt; line-height: 1.25; }
    .ps-name, .ps-addon, .ps-flex, .ps-flag, .ps-tag.ps-flower { font-size: 11pt; }
    .ps-size { font-size: 10pt; }
    .ps-stop-name { font-size: 12.5pt; }
    .ps-stop-sub { font-size: 10pt; }

    /* The make-up banner PRINTS (so a printed pack sheet still warns the crew),
       but the inline "Mark fulfilled" buttons are a screen-only affordance —
       hide every form inside the banner on paper. Keep the banner whole. */
    .makeups-banner { break-inside: avoid; page-break-inside: avoid; }
    .makeups-banner form { display: none !important; }
  }
</style>
