---
/**
 * /admin/specials — SPECIALS quick-add (Phase 3, Todd-approved 2026-09-07).
 *
 * One screen turns "we have a flush of X" into a fully-wired offer: creates the
 * week's flex_inventory item and attaches member orders with a payment choice
 * per member. From there the EXISTING pipelines take over — harvest sheet,
 * pack lists, and (separate-container items) per-unit "Name — 1 of N" cells on
 * the Avery 6-up label run. This replaces the hand-run tomato-BONANZA workflow
 * (13 orders entered by scripts over a weekend).
 *
 * Payment per member:
 *   flex    → store credit debited NOW + flex_transactions journal row
 *   invoice → recorded; QB invoice goes out via the usual flow
 *   cash    → recorded (farm pickup, pay on arrival)
 *
 * Members list = ACTIVE members (all share types — flex-only members buy
 * specials too; their container cells print in the no-box block).
 * Auth: middleware gates /admin/*; the API re-checks requireAdmin.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { upcomingMondayET, addWeeksYMD, prettyWeek } from '../../../lib/flex-order';

const supabase = Astro.locals.supabase;

type MemberRow = {
  id: string;
  share_type: string;
  cadence: string | null;
  biweekly_week: string | null;
  pickup_day: string | null;
  customers: { email: string | null; contact_name: string | null } | null;
};
const { data: memberRows } = await supabase
  .from('members')
  .select('id, share_type, cadence, biweekly_week, pickup_day, customers ( email, contact_name )')
  .eq('status', 'active')
  .limit(1000)
  .overrideTypes<MemberRow[], { merge: false }>();

const members = (memberRows ?? [])
  .map((m) => ({
    id: m.id,
    name: m.customers?.contact_name ?? '(no name)',
    email: m.customers?.email ?? '',
    share: m.share_type + (m.cadence === 'biweekly' ? ` · ${m.biweekly_week ?? '?'}-week` : ''),
    day: m.pickup_day ?? '',
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const weeks = [0, 1, 2, 3].map((n) => {
  const ymd = addWeeksYMD(upcomingMondayET(), n);
  return { ymd, label: prettyWeek(ymd) };
});
---

<AdminShell title="Specials" subtitle="One-off offers → orders → labels, in one screen">
  <Card padding="lg" elevation="sm">
    <h2 class="text-lg font-bold text-ts-text">1 · The item</h2>
    <div class="specials-form">
      <label>Week
        <select id="sp-week">
          {weeks.map((w) => <option value={w.ymd}>{w.label}</option>)}
        </select>
      </label>
      <label>Name <input id="sp-name" type="text" placeholder="Bulk Tomatoes — 10 lb flat" maxlength="120" /></label>
      <label>Unit <input id="sp-unit" type="text" placeholder="flat" maxlength="40" /></label>
      <label>Price ($) <input id="sp-price" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="22.50" /></label>
      <label class="sp-check">
        <input id="sp-container" type="checkbox" checked />
        Each unit is its own container → print a “1 of N” label per unit
      </label>
    </div>
  </Card>

  <Card padding="lg" elevation="sm">
    <h2 class="text-lg font-bold text-ts-text">2 · The members</h2>
    <input id="sp-search" type="search" placeholder="Type a name or email to filter…" class="sp-search" />
    <div class="sp-members" id="sp-members">
      {members.map((m) => (
        <div class="sp-member" data-name={m.name.toLowerCase()} data-email={m.email.toLowerCase()}>
          <label class="sp-member-pick">
            <input type="checkbox" data-role="pick" data-member-id={m.id} />
            <span class="sp-member-name">{m.name}</span>
            <span class="sp-member-meta">{m.share}{m.day ? ` · ${m.day}` : ''}</span>
          </label>
          <input type="number" data-role="qty" min="0.5" step="any" value="1" inputmode="decimal" aria-label="Quantity" />
          <select data-role="payment" aria-label="Payment">
            <option value="flex">Flex balance</option>
            <option value="invoice">QB invoice</option>
            <option value="cash">Cash</option>
          </select>
        </div>
      ))}
    </div>
  </Card>

  <Card padding="lg" elevation="sm">
    <button id="sp-submit" type="button" class="sp-submit">Create special + enter orders</button>
    <p id="sp-status" role="status" aria-live="polite"></p>
    <div id="sp-results" hidden>
      <h3 class="text-base font-bold text-ts-text">Results</h3>
      <ul id="sp-results-list"></ul>
      <p class="sp-note">
        Flex rows are PAID (debited + journaled). “invoice” / “cash” rows are
        recorded — collect them the usual way. Labels & pack sheets pick the
        orders up automatically for that week.
      </p>
    </div>
  </Card>
</AdminShell>

<style>
  .specials-form { display: grid; gap: 0.75rem; margin-top: 0.75rem; max-width: 28rem; }
  .specials-form label { display: grid; gap: 0.25rem; font-size: 0.9rem; font-weight: 600; }
  .specials-form input, .specials-form select { min-height: 2.5rem; padding: 0 0.6rem; border: 1px solid var(--ts-border, #d1d5db); border-radius: 8px; }
  .sp-check { display: flex !important; align-items: center; gap: 0.5rem; }
  .sp-check input { min-height: auto; }
  .sp-search { width: 100%; min-height: 2.5rem; margin-top: 0.75rem; padding: 0 0.6rem; border: 1px solid var(--ts-border, #d1d5db); border-radius: 8px; }
  .sp-members { max-height: 24rem; overflow-y: auto; margin-top: 0.75rem; display: grid; gap: 2px; }
  .sp-member { display: grid; grid-template-columns: 1fr 5rem 8rem; gap: 0.5rem; align-items: center; padding: 0.3rem 0.2rem; border-bottom: 1px solid #f1f5f9; }
  .sp-member[data-hidden='1'] { display: none; }
  .sp-member-pick { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; min-width: 0; }
  .sp-member-name { font-weight: 600; }
  .sp-member-meta { color: #6b7280; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-member input[data-role='qty'], .sp-member select { min-height: 2.2rem; border: 1px solid #d1d5db; border-radius: 6px; padding: 0 0.4rem; }
  .sp-submit { min-height: 3rem; padding: 0 1.5rem; font-weight: 800; background: #166534; color: #fff; border: 0; border-radius: 10px; cursor: pointer; }
  .sp-submit[disabled] { opacity: 0.6; cursor: default; }
  #sp-results-list { margin-top: 0.5rem; display: grid; gap: 2px; font-size: 0.9rem; }
  .sp-note { margin-top: 0.75rem; color: #6b7280; font-size: 0.85rem; }
</style>

<script>
  const search = document.getElementById('sp-search') as HTMLInputElement | null;
  const membersBox = document.getElementById('sp-members');
  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    for (const row of Array.from(membersBox?.querySelectorAll<HTMLElement>('.sp-member') ?? [])) {
      const hit = !q || (row.dataset.name ?? '').includes(q) || (row.dataset.email ?? '').includes(q);
      row.dataset.hidden = hit ? '0' : '1';
    }
  });

  const btn = document.getElementById('sp-submit') as HTMLButtonElement | null;
  const statusEl = document.getElementById('sp-status');
  const resultsBox = document.getElementById('sp-results');
  const resultsList = document.getElementById('sp-results-list');

  btn?.addEventListener('click', async () => {
    if (!btn || !statusEl) return;
    const week = (document.getElementById('sp-week') as HTMLSelectElement).value;
    const name = (document.getElementById('sp-name') as HTMLInputElement).value.trim();
    const unit = (document.getElementById('sp-unit') as HTMLInputElement).value.trim();
    const price = Number((document.getElementById('sp-price') as HTMLInputElement).value);
    const separate = (document.getElementById('sp-container') as HTMLInputElement).checked;

    const picked: Array<{ member_id: string; qty: number; payment: string }> = [];
    for (const row of Array.from(membersBox?.querySelectorAll<HTMLElement>('.sp-member') ?? [])) {
      const pick = row.querySelector<HTMLInputElement>('[data-role="pick"]');
      if (!pick?.checked) continue;
      const qty = Number(row.querySelector<HTMLInputElement>('[data-role="qty"]')?.value);
      const payment = row.querySelector<HTMLSelectElement>('[data-role="payment"]')?.value ?? 'invoice';
      picked.push({ member_id: pick.dataset.memberId ?? '', qty, payment });
    }

    if (!name || !unit || !(price > 0)) { statusEl.textContent = '⚠ Fill in name, unit and price.'; return; }
    if (picked.length === 0) { statusEl.textContent = '⚠ Pick at least one member.'; return; }
    if (picked.some((p) => !(p.qty > 0))) { statusEl.textContent = '⚠ Every picked member needs a quantity above zero.'; return; }
    if (!window.confirm(`Create "${name}" for week of ${week} and enter ${picked.length} order(s)? Flex members are debited immediately.`)) return;

    btn.disabled = true;
    statusEl.textContent = 'Working…';
    try {
      const res = await fetch('/api/admin/specials/create', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          week_starting: week,
          name,
          unit,
          price_cents: Math.round(price * 100),
          separate_container: separate,
          members: picked,
        }),
      });
      const data = await res.json().catch(() => null);
      if (!res.ok || !data?.ok) {
        statusEl.textContent = '⚠ ' + (data?.message || data?.error || `Failed (HTTP ${res.status}).`);
        btn.disabled = false;
        return;
      }
      statusEl.textContent = `✓ Done — ${data.results.length} member(s) processed.`;
      if (resultsBox && resultsList) {
        resultsBox.hidden = false;
        resultsList.innerHTML = '';
        for (const r of data.results) {
          const li = document.createElement('li');
          li.textContent = `${r.name ?? r.member_id}: ${r.status}${r.detail ? ` — ${r.detail}` : ''}`;
          if (String(r.status).includes('FAILED') || String(r.status).includes('failed') || r.status === 'flex_insufficient') {
            li.style.color = '#b45309';
            li.style.fontWeight = '700';
          }
          resultsList.appendChild(li);
        }
      }
      btn.disabled = false;
    } catch {
      statusEl.textContent = '⚠ Could not reach the server.';
      btn.disabled = false;
    }
  });
</script>
