---
/**
 * /admin/cooler            → THE COOLER BOARD (move list first, board second).
 * /admin/cooler?lang=es    → same, in Spanish.
 *
 * The pack crew needs to know what's in the coolers and, above all, WHAT TO MOVE
 * and WHERE. The farm is always reorganizing, so this is a MOVE LIST, not a map
 * the crew has to babysit. Design is docs/COOLER_LAYOUT.md ("Design approach for
 * the board (v1)" + the RESOLVED open items + Todd's "Key operating rule").
 *
 * Model (docs/COOLER_LAYOUT.md):
 *   - LOGICAL PALLETS, one per destination (each market / each wholesale order /
 *     CSA / other) — NOT physical slot positions.
 *   - ZONES, not 22 numbered slots: ph_accessible · ph_far · barn · van_overflow
 *     (van overflow = a loose short-term list, no slots).
 *   - Each pallet: label, type, zone, date_in (FIFO clock), optional 🔴 move-it
 *     (+ aging/surplus/customer reason), status active/out.
 *
 * Information hierarchy:
 *   1. THE MOVE LIST — computed, glanceable ("what do I move now, and where?"):
 *      • 🔴 move-it pallets NOT in an accessible zone → restage forward.
 *      • FIFO: the oldest active pallet, when it's stuck in ph_far/barn → send next.
 *      • 🔵 CSA-in-Barn-by-Tuesday (Sun/Mon/Tue, no active CSA pallet in the barn).
 *      • 🟠 Friday reminder (Thu/Fri): keep accessible space for weekend returns.
 *      • 🟢 Weekend sequencing note (Thu–Sun): informational (Sewickley-Sat →
 *        South-Side-Sun is expected, not a blocked-slot alarm).
 *      Calm empty state when nothing needs moving.
 *   2. THE BOARD — active pallets grouped by the 4 zones. Van overflow renders as
 *      a loose list with a "bring back / send out soon" nudge.
 *
 * Actions are one-tap same-origin POSTs (styled inline confirm for mark-out /
 * delete — NEVER native confirm()). All dynamic content is rendered via Astro
 * expressions (auto-escaped); no innerHTML is built from user data.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import Badge from '../../../components/Badge.astro';
import { todayET, todayWeekdayET } from '../../../lib/delivery';
import { prettyShortDate } from '../../../lib/cycle';

export const prerender = false;

const supabase = Astro.locals.supabase;

/* ── Language ────────────────────────────────────────────────────────────── */
type Lang = 'en' | 'es';
function parseLang(v: string | null): Lang {
  return v === 'es' ? 'es' : 'en';
}
const lang = parseLang(Astro.url.searchParams.get('lang'));

const STRINGS = {
  en: {
    pageTitle: 'Cooler board',
    subtitle: 'What to move, and where — coolers at a glance',
    langToggle: 'Español',
    // Move list
    moveHeading: 'Move list',
    moveNone: 'Nothing to move right now',
    moveNoneSub: 'Every pallet is where it needs to be. Check back as the day moves.',
    restageForward: 'Restage forward',
    restageForwardSub: 'flagged move-it but not in an accessible zone',
    oldestNext: 'Oldest — send next',
    oldestNextSub: 'FIFO: the oldest pallet is tucked in the back',
    csaBarnTitle: 'Get the CSA pallet into the Barn cooler before Tuesday pack',
    csaBarnSub: 'Todd’s rule: CSA items must be in the Barn cooler by Tuesday.',
    fridayTitle: 'Keep accessible space open for weekend market returns',
    fridaySub: 'Friday: PH-1/2/3 stay clear for Saturday/Sunday returns to sort Monday.',
    weekendTitle: 'Weekend sequencing — this is expected, not a conflict',
    weekendSub: 'Sewickley leaves Saturday, which clears space for South Side on Sunday.',
    // Board
    boardHeading: 'The board',
    addPallet: '➕ Add pallet',
    addTitle: 'Add a pallet',
    zoneEmpty: 'No pallets here',
    vanNudge: 'Loose overflow — bring these back in or send them out soon.',
    // Pallet card / actions
    inSince: 'in since',
    day: 'day',
    days: 'days',
    moveTo: 'Move to',
    flag: '🔴 Flag move-it',
    moveItChip: 'move-it',
