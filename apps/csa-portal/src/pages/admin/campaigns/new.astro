---
/**
 * /admin/campaigns/new — campaign composer.
 *
 * Three vertical sections + a confirm-modal:
 *
 *   1. Pick recipients  — share-type checkboxes + opt-in toggle, with a
 *                          LIVE count fetched from
 *                          /api/admin/campaigns/recipients-count on
 *                          every change. Defaults: summer_veg+flex,
 *                          opt-in=true (the most common Tonight send).
 *
 *   2. Compose          — name (admin label), subject, preview text,
 *                          body HTML textarea. A "Use template" dropdown
 *                          above the body pre-fills the form with one of
 *                          the seeded CAMPAIGN_TEMPLATES.
 *
 *   3. Actions          — Save draft, Preview (iframe modal), Send test
 *                          to me, Send to all (confirm-typed).
 *
 * All UX matches /admin/weekly-email (CSRF same-origin POST, in-page
 * confirm modal, result toast). The body textarea is plain HTML — Todd's
 * comfortable with that, and a rich-text editor is explicitly out of
 * scope for v1 per spec.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import FormRow from '../../../components/FormRow.astro';
import {
  CAMPAIGN_TEMPLATES,
  TARGETABLE_SHARE_TYPES,
  TEMPLATE_CATEGORIES,
  DEFAULT_RENEWAL_WEEKS_THRESHOLD,
  type CampaignTemplateRow,
} from '../../../lib/campaign';
import { EMAIL_SAFE_FONTS } from '../../../scripts/campaign-editor';

export const prerender = false;

const adminEmail = Astro.locals.user?.email ?? '';
const supabase = Astro.locals.supabase;

// Default renewal-window threshold prefilled into the composer — the admin's
// configured value from portal_settings (migration 0070) wins over the code
// default so the picker matches the armed dashboard banner.
let portalRenewalThreshold = DEFAULT_RENEWAL_WEEKS_THRESHOLD;
{
  const { data: thresholdRows } = await supabase
    .from('portal_settings')
    .select('key, value')
    .eq('key', 'renewal_weeks_threshold');
  const raw = thresholdRows?.[0]?.value;
  const parsed = Number.parseInt(raw ?? '', 10);
  if (Number.isFinite(parsed)) {
    portalRenewalThreshold = Math.min(52, Math.max(1, parsed));
  }
}

// Pretty labels for the share-type checkboxes.
const SHARE_LABELS: Record<(typeof TARGETABLE_SHARE_TYPES)[number], string> = {
  summer_veg: 'Summer Veg',
  flex: 'Flex',
  flower: 'Flower',
  add_on: 'Add-on',
};

// Load the template library from the DB (migration 0034). The composer's
// "Use template" dropdown reads these; "Save as template" writes new
// ones. If the table read fails for any reason, fall back to the
// hard-coded CAMPAIGN_TEMPLATES so the composer is never empty.
const { data: dbTemplates, error: tplErr } = await supabase
  .from('campaign_templates')
  .select('id, name, category, subject, preview_text, body_html, recipient_filter')
  .order('category', { ascending: true })
  .order('name', { ascending: true })
  .limit(500)
  .overrideTypes<CampaignTemplateRow[], { merge: false }>();

if (tplErr) {
  console.error('[admin/campaigns/new] template load failed:', tplErr.message);
}

type ClientFilter = {
  share_types: string[];
  newsletter_opt_in: boolean;
  segment: 'active' | 'renewal_window' | 'lapsed';
  renewal_weeks_threshold: number | null;
};
type ClientTemplate = {
  id: string;
  label: string;
  name: string;
  subject: string;
  preview_text: string;
  body_html: string;
  recipient_filter: ClientFilter;
};

const SEGMENT_VALUES = ['active', 'renewal_window', 'lapsed'] as const;

/** Coerce a JSONB recipient_filter into a safe ClientFilter shape. */
function asClientFilter(raw: unknown): ClientFilter {
  if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
    const o = raw as Record<string, unknown>;
    const shares = Array.isArray(o.share_types)
      ? o.share_types.filter((s): s is string => typeof s === 'string')
      : [];
    const segment = SEGMENT_VALUES.includes(o.segment as (typeof SEGMENT_VALUES)[number])
      ? (o.segment as ClientFilter['segment'])
      : 'active';
    const rwt =
      typeof o.renewal_weeks_threshold === 'number' && Number.isFinite(o.renewal_weeks_threshold)
        ? o.renewal_weeks_threshold
        : null;
    return {
      share_types: shares,
      newsletter_opt_in: o.newsletter_opt_in !== false,
      segment,
      renewal_weeks_threshold: rwt,
    };
  }
  return { share_types: [], newsletter_opt_in: true, segment: 'active', renewal_weeks_threshold: null };
}

const templatesForClient: ClientTemplate[] =
  dbTemplates && dbTemplates.length > 0
    ? dbTemplates.map((t) => ({
        id: t.id,
        label: t.name,
        name: t.name,
        subject: t.subject,
        preview_text: t.preview_text,
        body_html: t.body_html,
        recipient_filter: asClientFilter(t.recipient_filter),
      }))
    : CAMPAIGN_TEMPLATES.map((t) => ({
        id: t.id,
        label: t.label,
        name: t.name,
        subject: t.subject,
        preview_text: t.preview_text,
        body_html: t.body_html,
        recipient_filter: asClientFilter(t.recipient_filter),
      }));

// A ?template=<name> query param (used by the renewal/win-back playbook cards
// on /admin/campaigns) preselects a specific template. Matched by NAME because
// template ids are DB-generated UUIDs not known to the linking page; name is
// UNIQUE (migration 0034) so it's a stable join key.
const requestedTemplateName = Astro.url.searchParams.get('template');
const requestedTemplate = requestedTemplateName
  ? templatesForClient.find((t) => t.name === requestedTemplateName)
  : undefined;

// Default form values = the requested template (deep-link) when present, else
// the Summer/Flex Portal Launch (the documented "most-likely tonight blast"),
// else the first template in the library. We pick it explicitly rather than
// relying on sort order so adding/renaming templates can't silently change the
// landing default.
const defaultTemplate =
  requestedTemplate ??
  templatesForClient.find(
    (t) =>
      t.recipient_filter.share_types.includes('summer_veg') ||
      t.recipient_filter.share_types.includes('flex')
  ) ??
  templatesForClient[0];

// Derived audience defaults for the initial render.
const defaultSegment = defaultTemplate.recipient_filter.segment ?? 'active';
const defaultWeeksThreshold =
  defaultTemplate.recipient_filter.renewal_weeks_threshold ?? portalRenewalThreshold;

const templatesJson = JSON.stringify(templatesForClient);
---

<AdminShell
  title="New campaign"
  subtitle="Compose a portal-wide email. Members will receive it from the farm address with a one-click unsubscribe."
  pageTitle="New campaign — Tiny Seed Admin"
  canonical="https://csa.tinyseedfarm.com/admin/campaigns/new"
>
  <Fragment slot="actions">
    <a
      href="/admin/campaigns"
      class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      ← All campaigns
    </a>
  </Fragment>

  <form id="campaign-form" class="flex flex-col gap-6" novalidate>
    <input type="hidden" name="id" value="" data-field-id />

    {/* ════ 1. Recipients ════ */}
    <section aria-labelledby="recipients-heading" class="flex flex-col gap-3">
      <h2 id="recipients-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
        1. Pick recipients
      </h2>
      <Card padding="lg" elevation="sm">
        <div class="flex flex-col gap-5">
          {/* Audience selector — swaps the controls below. Test accounts are
              always excluded server-side in every mode. */}
          <div class="flex flex-col gap-1.5">
            <label for="segment-pick" class="text-sm font-semibold text-ts-text">Audience</label>
            <select
              id="segment-pick"
              data-segment
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            >
              <option value="active" selected={defaultSegment === 'active'}>Active members — by share type</option>
              <option value="renewal_window" selected={defaultSegment === 'renewal_window'}>Renewal window — active members whose season is ending soon</option>
              <option value="lapsed" selected={defaultSegment === 'lapsed'}>Lapsed members — win-back (had a share, none active now)</option>
            </select>
            <p class="text-xs text-ts-text-muted">Test accounts are always excluded. Renewal and win-back audiences are computed from each member's season.</p>
          </div>

          {/* Share types — 'active' mode only. */}
          <fieldset data-share-types-block>
            <legend class="text-sm font-semibold text-ts-text">Share types</legend>
            <p class="mt-1 text-xs text-ts-text-muted">Members with at least one active share of these types will receive this email.</p>
            <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
              {TARGETABLE_SHARE_TYPES.map((t) => (
                <label class="flex cursor-pointer items-center gap-2 rounded-ts-md border border-ts-border bg-ts-bg-base px-3 py-2 text-sm text-ts-text transition-colors hover:border-ts-primary/40">
                  <input
                    type="checkbox"
                    name="share_types[]"
                    value={t}
                    data-share-type
                    checked={defaultTemplate.recipient_filter.share_types.includes(t)}
                    class="h-4 w-4 rounded border-ts-border text-ts-primary focus:ring-ts-primary"
                  />
                  <span>{SHARE_LABELS[t]}</span>
                </label>
              ))}
            </div>
          </fieldset>

          {/* Renewal window threshold — 'renewal_window' mode only. */}
          <div data-renewal-block class="hidden flex flex-col gap-1.5">
            <label for="weeks-threshold" class="text-sm font-semibold text-ts-text">
              Delivery weeks left (or fewer)
            </label>
            <input
              id="weeks-threshold"
              data-weeks-threshold
              type="number"
              min="1"
              max="52"
              value={defaultWeeksThreshold}
              class="h-11 w-28 rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
            <p class="text-xs text-ts-text-muted">
              Season-derived, inclusive of this week. Early bird ≈ 4, reminder ≈ 2,
              last call ≈ 1. Only members whose season is currently running are counted.
            </p>
          </div>

          {/* Lapsed explainer — 'lapsed' mode only. */}
          <div
            data-lapsed-note
            class="hidden rounded-ts-md border border-ts-border bg-ts-bg-muted/30 px-4 py-3 text-xs leading-relaxed text-ts-text-secondary"
          >
            Former members who currently have no active share — either their status
            was set to lapsed/expired/inactive/cancelled, or their season has ended
            and they haven't renewed. Anyone who unsubscribed is excluded automatically.
          </div>

          {/* Opt-in — 'active' + 'renewal_window' modes (lapsed excludes opt-outs
              by definition). */}
          <label data-optin-block class="inline-flex cursor-pointer items-center gap-2 text-sm text-ts-text">
            <input
              type="checkbox"
              name="newsletter_opt_in"
              value="true"
              data-opt-in
              checked={defaultTemplate.recipient_filter.newsletter_opt_in}
              class="h-4 w-4 rounded border-ts-border text-ts-primary focus:ring-ts-primary"
            />
            <span>Only members who have newsletter opted-in (recommended)</span>
          </label>

          <div
            role="status"
            aria-live="polite"
            class="flex flex-col gap-1 rounded-ts-md border border-ts-primary/20 bg-ts-primary/5 px-4 py-3 text-sm text-ts-text sm:flex-row sm:items-baseline sm:gap-2"
          >
            <span class="font-display text-2xl font-bold text-ts-primary tabular-nums" data-recipient-count>—</span>
            <span class="text-sm text-ts-text-secondary">customers will receive this email <span data-recipient-detail class="text-xs text-ts-text-muted"></span></span>
          </div>
        </div>
      </Card>
    </section>

    {/* ════ 2. Compose ════ */}
    <section aria-labelledby="compose-heading" class="flex flex-col gap-3">
      <h2 id="compose-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
        2. Compose
      </h2>
      <Card padding="lg" elevation="sm">
        <div class="flex flex-col gap-5">
          <FormRow label="Use template" htmlFor="template-pick" help="Pre-fills the form. You can still edit anything below.">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
              <select
                id="template-pick"
                data-template-pick
                class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
              >
                <option value="">— Don't apply a template —</option>
                {templatesForClient.map((t) => (
                  <option value={t.id} selected={t.id === defaultTemplate.id}>{t.label}</option>
                ))}
              </select>
              <a
                href="/admin/campaigns/templates"
                class="inline-flex h-11 shrink-0 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
              >
                Manage templates
              </a>
            </div>
          </FormRow>

          <FormRow label="Campaign name (internal)" htmlFor="field-name" required help="Just for you to find this campaign later — never shown to members.">
            <input
              id="field-name"
              name="name"
              data-field-name
              type="text"
              required
              maxlength="160"
              value={defaultTemplate.name}
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
          </FormRow>

          <FormRow label="Subject" htmlFor="field-subject" required help="What members see in their inbox.">
            <input
              id="field-subject"
              name="subject"
              data-field-subject
              type="text"
              required
              maxlength="200"
              value={defaultTemplate.subject}
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
          </FormRow>

          <FormRow label="Preview text" htmlFor="field-preview" required help="Shows in the inbox alongside the subject, ~80 chars.">
            <input
              id="field-preview"
              name="preview_text"
              data-field-preview
              type="text"
              required
              maxlength="200"
              value={defaultTemplate.preview_text}
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
          </FormRow>

          <FormRow
            label="Body"
            htmlFor="editor-mount"
            required
            help="Format with the toolbar — bold, lists, links, color, images. The farm header + unsubscribe footer are added automatically. Use {{first_name}} where you want the recipient's first name."
          >
            {/* Toolbar */}
            <div
              data-editor-toolbar
              class="flex flex-wrap items-center gap-1 rounded-t-ts-md border border-ts-border bg-ts-bg-muted/40 p-2"
            >
              <button type="button" data-cmd="bold" aria-pressed="false" aria-label="Bold" title="Bold" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm font-bold text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">B</button>
              <button type="button" data-cmd="italic" aria-pressed="false" aria-label="Italic" title="Italic" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm italic text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">I</button>
              <button type="button" data-cmd="underline" aria-pressed="false" aria-label="Underline" title="Underline" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm text-ts-text underline transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">U</button>

              <span class="mx-1 h-6 w-px bg-ts-border" aria-hidden="true"></span>

              <button type="button" data-cmd="h2" aria-pressed="false" aria-label="Heading" title="Heading" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm font-bold text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">H2</button>
              <button type="button" data-cmd="h3" aria-pressed="false" aria-label="Subheading" title="Subheading" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm font-semibold text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">H3</button>

              <span class="mx-1 h-6 w-px bg-ts-border" aria-hidden="true"></span>

              <button type="button" data-cmd="bulletList" aria-pressed="false" aria-label="Bullet list" title="Bullet list" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">• List</button>
              <button type="button" data-cmd="orderedList" aria-pressed="false" aria-label="Numbered list" title="Numbered list" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">1. List</button>

              <span class="mx-1 h-6 w-px bg-ts-border" aria-hidden="true"></span>

              <button type="button" data-cmd="link" aria-pressed="false" aria-label="Add link" title="Add link" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">🔗 Link</button>
              <button type="button" data-cmd="unlink" aria-label="Remove link" title="Remove link" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-sm text-ts-text transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">⛓️‍💥</button>

              <span class="mx-1 h-6 w-px bg-ts-border" aria-hidden="true"></span>

              {/* Text color */}
              <label class="inline-flex h-9 items-center gap-1 rounded-ts-sm px-1 text-sm text-ts-text" title="Text color">
                <span aria-hidden="true">A</span>
                <input
                  type="color"
                  data-color-input
                  aria-label="Text color"
                  value="#166534"
                  class="h-7 w-7 cursor-pointer rounded border border-ts-border bg-transparent p-0"
                />
              </label>
              <button type="button" data-color-clear aria-label="Clear text color" title="Clear color" class="inline-flex h-9 min-w-9 items-center justify-center rounded-ts-sm border border-transparent px-2 text-xs text-ts-text-secondary transition-colors hover:bg-ts-bg-surface focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ts-primary">clear</button>

              <span class="mx-1 h-6 w-px bg-ts-border" aria-hidden="true"></span>

              {/* Font family */}
              <select
                data-font-select
                aria-label="Font family"
                title="Font family"
                class="h-9 rounded-ts-sm border border-ts-border bg-ts-bg-base px-2 text-sm text-ts-text outline-none focus:border-ts-primary"
              >
                {EMAIL_SAFE_FONTS.map((f) => (
                  <option value={f.value}>{f.label}</option>
                ))}
              </select>

              <span class="mx-1 h-6 w-px bg-ts-border" aria-hidden="true"></span>

              {/* Image upload */}
              <label class="inline-flex h-9 cursor-pointer items-center justify-center rounded-ts-sm border border-ts-border bg-ts-bg-surface px-3 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary">
                🖼️ Image
                <input type="file" data-image-input accept="image/png,image/jpeg,image/gif,image/webp" class="sr-only" />
              </label>
              <span data-upload-status class="text-xs text-ts-text-muted" role="status" aria-live="polite"></span>
            </div>

            {/* Editor mount — TipTap renders the contenteditable here. */}
            <div id="editor-mount" data-editor-mount></div>

            {/* Hidden field the form logic reads. Mirrored from the editor
                on every change. set:html primes the initial content the
                editor also receives. */}
            <textarea
              id="field-body"
              name="body_html"
              data-field-body
              required
              class="sr-only"
              tabindex="-1"
              aria-hidden="true"
              set:html={defaultTemplate.body_html}
            />

            <p class="mt-2 text-xs text-ts-text-muted">
              Email apps only support a handful of fonts reliably — that's why
              the font list is short. Anything you pick will fall back to a
              safe font where it's not available.
            </p>
          </FormRow>
        </div>
      </Card>
    </section>

    {/* ════ 3. Actions ════ */}
    <section aria-labelledby="actions-heading" class="flex flex-col gap-3">
      <h2 id="actions-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
        3. Send
      </h2>
      <Card padding="lg" elevation="sm">
        <div class="flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <p class="text-sm leading-relaxed text-ts-text">
              Save your draft, preview it, send a test to yourself first. When
              it looks right, send to all recipients. Every email includes a
              one-click unsubscribe link (CAN-SPAM).
            </p>
            <p class="text-xs text-ts-text-muted">
              Resend free tier: ~100 sends/day. If you have more recipients
              than that, the send will pause and you can resume tomorrow —
              no double-sends.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <button
              type="button"
              data-action-save
              class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary disabled:cursor-not-allowed disabled:opacity-60"
            >
              Save draft
            </button>

            <button
              type="button"
              data-action-preview
              class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary disabled:cursor-not-allowed disabled:opacity-60"
            >
              Preview
            </button>

            <button
              type="button"
              data-action-send-test
              class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary disabled:cursor-not-allowed disabled:opacity-60"
            >
              Send test to me{adminEmail ? ` (${adminEmail})` : ''}
            </button>

            <button
              type="button"
              data-action-save-template
              class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary disabled:cursor-not-allowed disabled:opacity-60"
            >
              Save as template
            </button>

            <button
              type="button"
              data-action-send
              class="inline-flex h-11 items-center justify-center rounded-ts-md bg-ts-primary px-5 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary disabled:cursor-not-allowed disabled:opacity-60"
            >
              Send to all recipients
            </button>
          </div>

          <div
            role="status"
            aria-live="polite"
            data-result
            class="hidden rounded-ts-md border border-ts-border bg-ts-bg-base px-4 py-3 text-sm text-ts-text"
          ></div>
        </div>
      </Card>
    </section>
  </form>

  {/* ════ Preview modal ════ */}
  <div
    id="preview-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
    data-preview-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="preview-heading"
  >
    <div class="flex h-full max-h-[90vh] w-full max-w-3xl flex-col overflow-hidden rounded-ts-xl bg-ts-bg-surface shadow-ts-lg">
      <div class="flex items-center justify-between border-b border-ts-border px-5 py-3">
        <h3 id="preview-heading" class="font-display text-lg font-bold text-ts-text">Email preview</h3>
        <button
          type="button"
          data-preview-close
          class="rounded-ts-md px-3 py-1.5 text-sm font-medium text-ts-text-secondary transition-colors hover:bg-ts-bg-muted hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          Close
        </button>
      </div>
      <iframe
        title="Campaign preview"
        data-preview-iframe
        sandbox=""
        class="h-full w-full flex-1 border-0 bg-white"
      ></iframe>
    </div>
  </div>

  {/* ════ Confirm send modal ════ */}
  <div
    id="confirm-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    data-confirm-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="confirm-heading"
  >
    <div class="w-full max-w-md rounded-ts-xl bg-ts-bg-surface p-6 shadow-ts-lg">
      <h3 id="confirm-heading" class="font-display text-lg font-bold text-ts-text">
        Send to all recipients?
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-ts-text-secondary">
        This will email this campaign to <strong class="text-ts-text tabular-nums" data-confirm-count>0</strong> recipient(s).
        Once sent, this cannot be undone.
      </p>
      <p class="mt-3 text-xs text-ts-text-muted">Type <strong>SEND</strong> to confirm:</p>
      <input
        type="text"
        data-confirm-input
        autocomplete="off"
        class="mt-2 h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
        placeholder="SEND"
      />
      <footer class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button
          type="button"
          data-confirm-cancel
          class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-medium text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          Cancel
        </button>
        <button
          type="button"
          data-confirm-go
          disabled
          class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark disabled:cursor-not-allowed disabled:opacity-60"
        >
          Send now
        </button>
      </footer>
    </div>
  </div>

  {/* ════ Save-as-template modal ════ */}
  <div
    id="save-template-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    data-save-template-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="save-template-heading"
  >
    <div class="w-full max-w-md rounded-ts-xl bg-ts-bg-surface p-6 shadow-ts-lg">
      <h3 id="save-template-heading" class="font-display text-lg font-bold text-ts-text">
        Save as template
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-ts-text-secondary">
        Reuse this campaign's subject, body, and recipient filter later. It'll
        appear in the "Use template" dropdown.
      </p>
      <div class="mt-4 flex flex-col gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="save-tpl-name" class="text-sm font-semibold text-ts-text">Template name</label>
          <input
            id="save-tpl-name"
            data-save-tpl-name
            type="text"
            maxlength="160"
            autocomplete="off"
            class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
          />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="save-tpl-category" class="text-sm font-semibold text-ts-text">Category</label>
          <select
            id="save-tpl-category"
            data-save-tpl-category
            class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
          >
            {TEMPLATE_CATEGORIES.map((cat) => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
        </div>
      </div>
      <footer class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button
          type="button"
          data-save-tpl-cancel
          class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-medium text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          Cancel
        </button>
        <button
          type="button"
          data-save-tpl-go
          class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark disabled:cursor-not-allowed disabled:opacity-60"
        >
          Save template
        </button>
      </footer>
    </div>
  </div>

  {/* Serialized template payload for the client. */}
  <script type="application/json" id="templates-data" set:html={templatesJson} />

  {/* Editor init — bundled module (imports TipTap). Mounts the WYSIWYG
      editor into [data-editor-mount], mirrors HTML into #field-body, and
      exposes window.__campaignEditor so the inline form logic below can
      push template content into the editor. Kept separate from the form
      logic so that logic can stay `is:inline` (CSP 'unsafe-inline'). */}
  <script>
    import { initCampaignEditor } from '../../../scripts/campaign-editor';

    const mount = document.querySelector('[data-editor-mount]');
    const toolbar = document.querySelector('[data-editor-toolbar]');
    const hidden = document.querySelector('[data-field-body]');
    if (mount instanceof HTMLElement && toolbar instanceof HTMLElement && hidden instanceof HTMLTextAreaElement) {
      const handle = initCampaignEditor({
        mount,
        toolbar,
        hiddenField: hidden,
        initialHTML: hidden.value || '',
        imageUploadUrl: '/api/admin/campaigns/image',
      });
      // Expose for the inline form logic (template load → setHTML).
      (window as unknown as { __campaignEditor?: { setHTML(h: string): void } }).__campaignEditor = {
        setHTML: (h: string) => handle.setHTML(h),
      };
    }
  </script>

  <script is:inline>
    (function () {
      // ── Element refs ──────────────────────────────────────────────
      const form = document.getElementById('campaign-form');
      const fieldId = form.querySelector('[data-field-id]');
      const fieldName = form.querySelector('[data-field-name]');
      const fieldSubject = form.querySelector('[data-field-subject]');
      const fieldPreview = form.querySelector('[data-field-preview]');
      const fieldBody = form.querySelector('[data-field-body]');
      const shareInputs = form.querySelectorAll('[data-share-type]');
      const optInInput = form.querySelector('[data-opt-in]');
      const templatePick = document.getElementById('template-pick');

      // Audience-segment controls (Phase 2 Wave 2).
      const segmentSelect = form.querySelector('[data-segment]');
      const weeksThresholdInput = form.querySelector('[data-weeks-threshold]');
      const shareTypesBlock = form.querySelector('[data-share-types-block]');
      const renewalBlock = form.querySelector('[data-renewal-block]');
      const lapsedNote = form.querySelector('[data-lapsed-note]');
      const optInBlock = form.querySelector('[data-optin-block]');

      // Show/hide the audience controls for the chosen segment. Relies on
      // Tailwind's `hidden` (display:none) taking precedence when present, so
      // the display utility on each block resumes when 'hidden' is removed.
      function currentSegment() {
        return segmentSelect ? segmentSelect.value : 'active';
      }
      function applySegmentUI(segment) {
        const isActive = segment === 'active';
        const isRenewal = segment === 'renewal_window';
        const isLapsed = segment === 'lapsed';
        if (shareTypesBlock) shareTypesBlock.classList.toggle('hidden', !isActive);
        if (renewalBlock) renewalBlock.classList.toggle('hidden', !isRenewal);
        if (lapsedNote) lapsedNote.classList.toggle('hidden', !isLapsed);
        // Opt-in applies to active + renewal (lapsed excludes opt-outs anyway).
        if (optInBlock) optInBlock.classList.toggle('hidden', isLapsed);
      }

      // Push body content through the editor (keeps the hidden field in
      // sync). Falls back to writing the field directly if the editor
      // module hasn't attached yet.
      function setBodyContent(html) {
        const ed = window.__campaignEditor;
        if (ed && typeof ed.setHTML === 'function') ed.setHTML(html || '');
        else if (fieldBody) fieldBody.value = html || '';
      }

      const countEl = document.querySelector('[data-recipient-count]');
      const detailEl = document.querySelector('[data-recipient-detail]');

      const btnSave = document.querySelector('[data-action-save]');
      const btnPreview = document.querySelector('[data-action-preview]');
      const btnSendTest = document.querySelector('[data-action-send-test]');
      const btnSend = document.querySelector('[data-action-send]');
      const btnSaveTemplate = document.querySelector('[data-action-save-template]');

      const saveTplModal = document.querySelector('[data-save-template-modal]');
      const saveTplName = document.querySelector('[data-save-tpl-name]');
      const saveTplCategory = document.querySelector('[data-save-tpl-category]');
      const saveTplGo = document.querySelector('[data-save-tpl-go]');
      const saveTplCancel = document.querySelector('[data-save-tpl-cancel]');

      const result = document.querySelector('[data-result]');

      const previewModal = document.querySelector('[data-preview-modal]');
      const previewIframe = document.querySelector('[data-preview-iframe]');
      const previewClose = document.querySelector('[data-preview-close]');

      const confirmModal = document.querySelector('[data-confirm-modal]');
      const confirmInput = document.querySelector('[data-confirm-input]');
      const confirmGo = document.querySelector('[data-confirm-go]');
      const confirmCancel = document.querySelector('[data-confirm-cancel]');
      const confirmCount = document.querySelector('[data-confirm-count]');

      // Parse the inlined templates.
      let templates = [];
      try {
        templates = JSON.parse(document.getElementById('templates-data').textContent || '[]');
      } catch (e) {
        templates = [];
      }

      // ── Helpers ───────────────────────────────────────────────────
      function selectedShareTypes() {
        const out = [];
        shareInputs.forEach((el) => { if (el.checked) out.push(el.value); });
        return out;
      }

      function currentWeeksThreshold() {
        if (!weeksThresholdInput) return undefined;
        const n = parseInt(weeksThresholdInput.value, 10);
        if (!isFinite(n)) return undefined;
        return Math.min(52, Math.max(1, n));
      }

      function currentFilter() {
        return {
          share_types: selectedShareTypes(),
          newsletter_opt_in: !!optInInput.checked,
          segment: currentSegment(),
          renewal_weeks_threshold: currentWeeksThreshold(),
        };
      }

      function showResult(msg, tone) {
        if (!result) return;
        result.classList.remove(
          'hidden',
          'border-ts-danger/30', 'bg-ts-danger/5', 'text-ts-danger',
          'border-ts-primary/30', 'bg-ts-primary/10', 'text-ts-primary'
        );
        if (tone === 'error') {
          result.classList.add('border-ts-danger/30', 'bg-ts-danger/5', 'text-ts-danger');
        } else if (tone === 'success') {
          result.classList.add('border-ts-primary/30', 'bg-ts-primary/10', 'text-ts-primary');
        }
        result.textContent = msg;
      }

      function setBusy(busy) {
        [btnSave, btnPreview, btnSendTest, btnSend, btnSaveTemplate].forEach((b) => {
          if (b) b.disabled = !!busy;
        });
      }

      // Currently-tracked recipient count (for the confirm modal).
      let lastDeliverable = 0;

      // ── Live recipient count ──────────────────────────────────────
      let countCtrl = null;
      let countDebounce = null;
      async function refreshCount() {
        if (countCtrl) countCtrl.abort();
        countCtrl = new AbortController();
        const filter = currentFilter();
        const params = new URLSearchParams({
          share_types: filter.share_types.join(','),
          newsletter_opt_in: filter.newsletter_opt_in ? 'true' : 'false',
          segment: filter.segment,
        });
        if (filter.segment === 'renewal_window' && filter.renewal_weeks_threshold) {
          params.set('weeks_threshold', String(filter.renewal_weeks_threshold));
        }
        try {
          const res = await fetch(`/api/admin/campaigns/recipients-count?${params}`, {
            credentials: 'same-origin',
            headers: { accept: 'application/json' },
            signal: countCtrl.signal,
          });
          if (!res.ok) {
            countEl.textContent = '—';
            detailEl.textContent = '(could not load)';
            lastDeliverable = 0;
            return;
          }
          const body = await res.json();
          if (!body || !body.ok) {
            countEl.textContent = '—';
            detailEl.textContent = '(could not load)';
            lastDeliverable = 0;
            return;
          }
          lastDeliverable = body.deliverable_count ?? 0;
          countEl.textContent = String(lastDeliverable);
          const skipped = (body.count ?? 0) - lastDeliverable;
          detailEl.textContent = skipped > 0
            ? `(${body.count} matched, ${skipped} excluded as test accounts)`
            : '';
        } catch (e) {
          if (e && e.name === 'AbortError') return;
          countEl.textContent = '—';
          detailEl.textContent = '(network error)';
        }
      }

      function scheduleCount() {
        if (countDebounce) clearTimeout(countDebounce);
        countDebounce = setTimeout(refreshCount, 200);
      }

      shareInputs.forEach((el) => el.addEventListener('change', scheduleCount));
      optInInput.addEventListener('change', scheduleCount);
      if (segmentSelect) {
        segmentSelect.addEventListener('change', function () {
          applySegmentUI(currentSegment());
          scheduleCount();
        });
      }
      if (weeksThresholdInput) weeksThresholdInput.addEventListener('input', scheduleCount);

      // Initial audience UI + count.
      applySegmentUI(currentSegment());
      refreshCount();

      // ── Template picker ───────────────────────────────────────────
      templatePick.addEventListener('change', function () {
        const id = templatePick.value;
        if (!id) return;
        const t = templates.find((x) => x.id === id);
        if (!t) return;
        fieldName.value = t.name;
        fieldSubject.value = t.subject;
        fieldPreview.value = t.preview_text;
        setBodyContent(t.body_html);
        // Recipient filter:
        shareInputs.forEach((el) => {
          el.checked = t.recipient_filter.share_types.indexOf(el.value) >= 0;
        });
        optInInput.checked = !!t.recipient_filter.newsletter_opt_in;
        // Audience segment + threshold (Phase 2 Wave 2).
        if (segmentSelect) {
          segmentSelect.value = t.recipient_filter.segment || 'active';
        }
        if (weeksThresholdInput && t.recipient_filter.renewal_weeks_threshold) {
          weeksThresholdInput.value = String(t.recipient_filter.renewal_weeks_threshold);
        }
        applySegmentUI(currentSegment());
        refreshCount();
        showResult(`Loaded template "${t.label}".`, null);
      });

      // ── Save draft ────────────────────────────────────────────────
      async function saveDraft() {
        setBusy(true);
        showResult('Saving draft…', null);
        const payload = {
          id: fieldId.value || null,
          name: fieldName.value,
          subject: fieldSubject.value,
          preview_text: fieldPreview.value,
          body_html: fieldBody.value,
          recipient_filter: currentFilter(),
        };
        try {
          const res = await fetch('/api/admin/campaigns/draft', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify(payload),
          });
          const body = await res.json();
          if (res.ok && body.ok && body.campaign && body.campaign.id) {
            fieldId.value = body.campaign.id;
            showResult('Draft saved.', 'success');
            return body.campaign;
          }
          showResult('Could not save draft: ' + (body.error || 'unknown error') + '.', 'error');
          return null;
        } catch (e) {
          showResult('Network error saving draft.', 'error');
          return null;
        } finally {
          setBusy(false);
        }
      }

      btnSave.addEventListener('click', function () { saveDraft(); });

      // ── Preview ──────────────────────────────────────────────────
      btnPreview.addEventListener('click', async function () {
        setBusy(true);
        showResult('Rendering preview…', null);
        try {
          const res = await fetch('/api/admin/campaigns/preview', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json', accept: 'text/html' },
            body: JSON.stringify({
              body_html: fieldBody.value,
              subject: fieldSubject.value,
              preview_text: fieldPreview.value,
              first_name: 'Todd',
            }),
          });
          if (!res.ok) {
            let err = 'unknown';
            try { const j = await res.json(); err = j.error || err; } catch {}
            showResult('Preview failed: ' + err + '.', 'error');
            return;
          }
          const html = await res.text();
          previewIframe.setAttribute('srcdoc', html);
          previewModal.classList.remove('hidden');
          previewModal.classList.add('flex');
          showResult('', null);
          result.classList.add('hidden');
        } catch (e) {
          showResult('Network error rendering preview.', 'error');
        } finally {
          setBusy(false);
        }
      });
      previewClose.addEventListener('click', function () {
        previewModal.classList.add('hidden');
        previewModal.classList.remove('flex');
      });
      previewModal.addEventListener('click', function (e) {
        if (e.target === previewModal) {
          previewModal.classList.add('hidden');
          previewModal.classList.remove('flex');
        }
      });

      // ── Send test ────────────────────────────────────────────────
      btnSendTest.addEventListener('click', async function () {
        // Save first so the test goes against the draft id (preserves
        // any edits Todd has made since loading the page).
        const saved = await saveDraft();
        if (!saved || !saved.id) return;
        setBusy(true);
        showResult('Sending a test to your inbox…', null);
        try {
          const res = await fetch('/api/admin/campaigns/send-test', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify({ campaign_id: saved.id }),
          });
          const body = await res.json();
          if (res.ok && body.ok) {
            showResult('Test email sent to ' + (body.recipient || 'you') + '. Check your inbox.', 'success');
          } else {
            showResult('Test failed: ' + (body.error || 'unknown error') + '.', 'error');
          }
        } catch (e) {
          showResult('Network error sending test.', 'error');
        } finally {
          setBusy(false);
        }
      });

      // ── Send to all (with confirmation) ──────────────────────────
      function openConfirm() {
        confirmCount.textContent = String(lastDeliverable);
        confirmInput.value = '';
        confirmGo.disabled = true;
        confirmModal.classList.remove('hidden');
        confirmModal.classList.add('flex');
        confirmInput.focus();
      }
      function closeConfirm() {
        confirmModal.classList.add('hidden');
        confirmModal.classList.remove('flex');
      }
      btnSend.addEventListener('click', async function () {
        if (lastDeliverable === 0) {
          showResult('No recipients match the current filter. Pick at least one share type.', 'error');
          return;
        }
        // Save first.
        const saved = await saveDraft();
        if (!saved || !saved.id) return;
        openConfirm();
      });
      confirmCancel.addEventListener('click', closeConfirm);
      confirmModal.addEventListener('click', function (e) {
        if (e.target === confirmModal) closeConfirm();
      });
      confirmInput.addEventListener('input', function () {
        confirmGo.disabled = confirmInput.value.trim().toUpperCase() !== 'SEND';
      });
      confirmGo.addEventListener('click', async function () {
        if (confirmGo.disabled) return;
        confirmGo.disabled = true;
        confirmGo.textContent = 'Sending…';
        showResult('Sending campaign — this may take a few minutes…', null);
        try {
          const res = await fetch('/api/admin/campaigns/send', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify({ campaign_id: fieldId.value }),
          });
          const body = await res.json();
          closeConfirm();
          if (res.ok && body.ok) {
            const parts = ['Sent ' + body.sent + ' of ' + body.total_recipients];
            if (body.failed) parts.push(body.failed + ' failed');
            if (body.remaining) parts.push(body.remaining + ' remaining');
            let msg = parts.join(' · ') + '.';
            if (body.rate_limited || body.status === 'partial') {
              msg += ' Hit the daily cap — click "View" on the campaign detail page and resume tomorrow.';
            }
            showResult(msg, body.failed ? 'error' : 'success');
            setTimeout(function () {
              window.location.href = '/admin/campaigns/' + fieldId.value;
            }, 1800);
          } else {
            showResult('Send failed: ' + (body.error || 'unknown error') + '.', 'error');
          }
        } catch (e) {
          closeConfirm();
          showResult('Network error during send.', 'error');
        } finally {
          confirmGo.textContent = 'Send now';
        }
      });

      // ── Save as template ─────────────────────────────────────────
      function openSaveTpl() {
        if (!saveTplModal) return;
        // Default the template name to the campaign's internal name.
        saveTplName.value = fieldName.value || '';
        saveTplModal.classList.remove('hidden');
        saveTplModal.classList.add('flex');
        saveTplName.focus();
      }
      function closeSaveTpl() {
        if (!saveTplModal) return;
        saveTplModal.classList.add('hidden');
        saveTplModal.classList.remove('flex');
      }
      if (btnSaveTemplate) {
        btnSaveTemplate.addEventListener('click', function () {
          if (!fieldBody.value || !fieldSubject.value) {
            showResult('Add a subject and body before saving a template.', 'error');
            return;
          }
          openSaveTpl();
        });
      }
      if (saveTplCancel) saveTplCancel.addEventListener('click', closeSaveTpl);
      if (saveTplModal) {
        saveTplModal.addEventListener('click', function (e) {
          if (e.target === saveTplModal) closeSaveTpl();
        });
      }
      if (saveTplGo) {
        saveTplGo.addEventListener('click', async function () {
          const name = (saveTplName.value || '').trim();
          if (!name) {
            saveTplName.focus();
            return;
          }
          saveTplGo.disabled = true;
          const orig = saveTplGo.textContent;
          saveTplGo.textContent = 'Saving…';
          try {
            const res = await fetch('/api/admin/campaigns/templates', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'content-type': 'application/json', accept: 'application/json' },
              body: JSON.stringify({
                action: 'save',
                name: name,
                category: saveTplCategory.value,
                subject: fieldSubject.value,
                preview_text: fieldPreview.value,
                body_html: fieldBody.value,
                recipient_filter: currentFilter(),
              }),
            });
            const body = await res.json();
            if (res.ok && body.ok) {
              closeSaveTpl();
              showResult('Saved as template "' + name + '". It\'s now in the dropdown.', 'success');
            } else {
              const msg = body.error === 'name_taken'
                ? 'A template with that name already exists — pick a different name.'
                : 'Could not save template: ' + (body.error || 'unknown error') + '.';
              showResult(msg, 'error');
            }
          } catch (e) {
            showResult('Network error saving template.', 'error');
          } finally {
            saveTplGo.disabled = false;
            saveTplGo.textContent = orig;
          }
        });
      }

      // ESC closes any open modal.
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        if (previewModal && !previewModal.classList.contains('hidden')) {
          previewModal.classList.add('hidden');
          previewModal.classList.remove('flex');
        }
        if (confirmModal && !confirmModal.classList.contains('hidden')) closeConfirm();
        if (saveTplModal && !saveTplModal.classList.contains('hidden')) closeSaveTpl();
      });
    })();
  </script>
</AdminShell>
