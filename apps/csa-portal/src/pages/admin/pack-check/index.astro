---
/**
 * /admin/pack-check — landing page (week + stop selector) for the printable
 * PACK CHECKLIST.
 *
 * The actual printable view lives at /admin/pack-check/[week]/[stop_slug].
 * This page lets the pack lead (1) pick the cycle week and (2) open one stop's
 * checklist — or "Print all stops" (?all=1 on the slug page) renders every
 * stop in one doc with a page break between each (handled by the slug page).
 *
 * Default week matches the other admin pack pages (upcoming Monday).
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { resolveCycle, slugStop, mondayOfWeek, currentDeliveryWeek, prettyWeekHeader } from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';

const supabase = Astro.locals.supabase;

const wkParam = Astro.url.searchParams.get('week') ?? '';
const week_starting = wkParam && /^\d{4}-\d{2}-\d{2}$/.test(wkParam)
  ? mondayOfWeek(wkParam)
  : currentDeliveryWeek();

const cycle = await resolveCycle(supabase, week_starting);
const options = weekOptions();
if (!options.some((o) => o.value === week_starting)) {
  options.unshift({ value: week_starting, label: `Week of ${week_starting} (selected)` });
}

const totalBoxes = cycle.activeStops.reduce((a, s) => a + s.boxes_small + s.boxes_large, 0);

const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};
---

<AdminShell
  title="Pack checklists"
  subtitle={prettyWeekHeader(week_starting)}
  pageTitle="Pack checklists — Tiny Seed Admin"
>
  <Fragment slot="actions">
    {/* Day-explicit print-all buttons — the work is day-scoped, so the print
        job should be too. "Wednesday run" = Tue + Wed + home delivery; "Weekend
        run" = Sat + Sun markets. The whole-week button stays for the rare all-
        at-once case. */}
    <a
      href={`/admin/pack-check/${week_starting}?all=1&day=mon`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      🖨 Print all (Wednesday run)
    </a>
    <a
      href={`/admin/pack-check/${week_starting}?all=1&day=thu`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      🖨 Print all (weekend run)
    </a>
    <a
      href={`/admin/pack-check/${week_starting}?all=1`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      Whole week →
    </a>
  </Fragment>

  {/* ── Week selector ─────────────────────────────────────────────── */}
  <section aria-label="Week selector">
    <form method="GET" action="/admin/pack-check" class="flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Week</span>
        <select
          name="week"
          class="h-10 min-w-[220px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          {options.map((opt) => (
            <option value={opt.value} selected={opt.value === week_starting}>
              {opt.label}
            </option>
          ))}
        </select>
      </label>
      <button
        type="submit"
        class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        Load week
      </button>
    </form>
  </section>

  {/* ── Stops list ────────────────────────────────────────────────── */}
  <section aria-labelledby="pc-stops-heading" class="flex flex-col gap-4">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 id="pc-stops-heading" class="font-display text-xl font-bold text-ts-text">Stops this cycle</h2>
      <p class="text-sm text-ts-text-secondary tabular-nums">
        {totalBoxes} box{totalBoxes === 1 ? '' : 'es'} total
      </p>
    </div>
    {cycle.activeStops.length === 0 ? (
      <Card tone="muted" padding="lg" elevation="sm">
        <div class="text-center text-sm text-ts-text-secondary">
          No active members in this cycle. Try a different week.
        </div>
      </Card>
    ) : (
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
        {cycle.activeStops.map((stop) => {
          const totalBoxesAtStop = stop.boxes_small + stop.boxes_large;
          const totalAddonsAtStop = Object.values(stop.addons).reduce((a, b) => a + b, 0);
          // StopTotals has NO flower field — flowers are tracked as members, so
          // count share_type 'flower' in cycle.byStop (same pattern as the
          // printable checklist). Flowers are a distinct, separately-labeled share.
          const flowersAtStop = (cycle.byStop.get(stop.stop_id) ?? [])
            .filter((m) => m.share_type === 'flower').length;
          const stopSlug = slugStop(stop.stop_name);
          const stopUrl = `/admin/pack-check/${week_starting}/${stopSlug}`;
          return (
            <Card padding="md" elevation="sm" hover>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <a
                    href={stopUrl}
                    class="font-semibold text-ts-text underline-offset-2 hover:text-ts-primary hover:underline"
                  >
                    {stop.stop_name}
                  </a>
                  <p class="mt-0.5 text-xs text-ts-text-muted">
                    {stop.day_of_week ? DAY_LONG[stop.day_of_week] : 'Day TBD'}
                  </p>
                </div>
                <span class="shrink-0 rounded-ts-md bg-ts-primary/10 px-3 py-1 text-base font-bold tabular-nums text-ts-primary">
                  {totalBoxesAtStop}
                </span>
              </div>
              <p class="mt-3 text-xs text-ts-text-secondary tabular-nums">
                {stop.boxes_small} Small · {stop.boxes_large} Large
                {totalAddonsAtStop > 0 && ` · ${totalAddonsAtStop} add-ons`}
                {stop.flex_orders > 0 && ` · ${stop.flex_orders} flex`}
                {flowersAtStop > 0 && ` · 🌸 ${flowersAtStop} flowers`}
              </p>
              <a
                href={stopUrl}
                class="mt-3 inline-flex h-9 items-center justify-center rounded-ts-md bg-ts-primary px-3 text-xs font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark"
              >
                Open checklist →
              </a>
            </Card>
          );
        })}
      </div>
    )}
  </section>

  <Card padding="md" elevation="sm">
    <h2 class="font-display text-lg font-bold text-ts-text">How the pack checklist prints</h2>
    <ul class="mt-3 space-y-1.5 text-sm text-ts-text-secondary">
      <li>• One sheet per stop (page break between stops) — Letter portrait.</li>
      <li>• Each stop has a color-coded band that matches the box labels and driver manifest.</li>
      <li>• One checkbox row per member: name, box size, add-ons as chips, and flex items as a nested checklist.</li>
      <li>• Home-delivery members show their street address. Add-ons ride on the member's row — never as separate people.</li>
      <li>• Print options: Letter, Portrait, default margins, scale 100%.</li>
    </ul>
  </Card>
</AdminShell>
</content>
