---
/**
 * /admin/route-plan — automatic delivery-route optimizer (Todd 2026-06-23).
 *
 * Pick a week + day. The page gathers that day's candidate stops (CSA pickups +
 * home deliveries + wholesale, all geocoded). Each stop is assigned to Route A,
 * Route B, or Off — so Todd can split into two trucks/runs and pull stops off.
 * "Optimize routes" optimizes A and B independently into least-drive-time depot
 * loops (farm → stops → farm), time-window aware (Black Radish by 3 PM). Each
 * result list is DRAG / arrow reorderable — a manual reorder recomputes ETAs +
 * the nav link instantly from the returned drive-time matrix (no re-call).
 * One-tap full-route Google Maps nav per route. Admin-gated by middleware.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { GOOGLE_MAPS_API_KEY } from 'astro:env/server';
import { supabaseAdmin } from '../../../lib/supabase';
import { mondayOfWeek, currentDeliveryWeek, isMonday, prettyWeekHeader } from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';
import { addDaysYMD } from '../../../lib/wholesale-order';
import { gatherDayStops, DEPOT } from '../../../lib/route-optimizer';

export const prerender = false;

const url = new URL(Astro.request.url);
const weekParam = (url.searchParams.get('week') ?? '').trim();
const week_starting = /^\d{4}-\d{2}-\d{2}$/.test(weekParam)
  ? (isMonday(weekParam) ? weekParam : mondayOfWeek(weekParam))
  : currentDeliveryWeek();
const dayRaw = url.searchParams.get('day') ?? 'Wed';
const day = (['Tue', 'Wed', 'Sat'].includes(dayRaw) ? dayRaw : 'Wed') as 'Tue' | 'Wed' | 'Sat';
// Delivery date for this day = the week's Monday + offset (Tue+1, Wed+2, Sat+5).
const route_date = addDaysYMD(week_starting, ({ Tue: 1, Wed: 2, Sat: 5 } as const)[day]);

let stops: any[] = [];
let skipped: string[] = [];
let gatherError: string | null = null;
if (!GOOGLE_MAPS_API_KEY) {
  gatherError = 'Google Maps key is not configured on the server.';
} else {
  try {
    const r = await gatherDayStops(supabaseAdmin, week_starting, day, GOOGLE_MAPS_API_KEY);
    stops = r.stops;
    skipped = r.skipped;
  } catch (e) {
    gatherError = (e as Error)?.message ?? 'Could not load stops for this day.';
  }
}

const options = weekOptions();
const groups = [
  { kind: 'csa', label: '🥬 CSA pickup stops', items: stops.filter((s) => s.kind === 'csa') },
  { kind: 'home', label: '🏠 Home deliveries', items: stops.filter((s) => s.kind === 'home') },
  { kind: 'wholesale', label: '🍽 Wholesale', items: stops.filter((s) => s.kind === 'wholesale') },
];
---

<AdminShell
  title="Route planner"
  subtitle={`${prettyWeekHeader(week_starting)} · ${day} delivery · starts + ends at ${DEPOT.name}`}
  pageTitle="Route planner — Tiny Seed Admin"
>
  <Card padding="md" elevation="sm" class="mb-4">
    <form method="GET" action="/admin/route-plan/" class="flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Week</span>
        <select name="week" onchange="this.form.submit()" class="h-10 min-w-[240px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm">
          {options.map((o) => (<option value={o.value} selected={o.value === week_starting}>{o.label}</option>))}
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Day</span>
        <select name="day" onchange="this.form.submit()" class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm">
          {['Tue', 'Wed', 'Sat'].map((d) => (<option value={d} selected={d === day}>{d}</option>))}
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Leave farm at</span>
        <input id="start-time" type="time" value="09:00" class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
    </form>
  </Card>

  {gatherError && (
    <Card padding="md" elevation="sm" class="mb-4 border border-red-200 bg-red-50">
      <p class="text-sm text-red-700">{gatherError}</p>
    </Card>
  )}

  {!gatherError && (
    <div class="grid gap-4 lg:grid-cols-2">
      <Card padding="md" elevation="sm" as="section">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-semibold text-gray-900">Assign stops · A / B / Off</h2>
          <div class="flex gap-1 text-xs">
            <button type="button" data-all="A" class="rounded bg-emerald-100 px-2 py-1 font-medium text-emerald-700 hover:bg-emerald-200">All → A</button>
            <button type="button" data-all="B" class="rounded bg-indigo-100 px-2 py-1 font-medium text-indigo-700 hover:bg-indigo-200">All → B</button>
            <button type="button" data-all="off" class="rounded bg-gray-100 px-2 py-1 hover:bg-gray-200">All off</button>
          </div>
        </div>
        <p class="mb-3 text-xs text-gray-500">Put each stop on Route <b class="text-emerald-700">A</b>, Route <b class="text-indigo-700">B</b>, or <b>Off</b> (off the truck). Then optimize.</p>
        {stops.length === 0 ? (
          <p class="text-sm text-gray-500">No stops for {day}. Pick a different day/week.</p>
        ) : (
          groups.filter((g) => g.items.length).map((g) => (
            <div class="mb-4">
              <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-400">{g.label} ({g.items.length})</div>
              <ul class="divide-y divide-gray-100">
                {g.items.map((s) => (
                  <li class="flex items-center gap-3 py-2">
                    <div class="route-pick inline-flex overflow-hidden rounded-md border border-gray-200" data-key={s.key}>
                      <button type="button" data-r="off" class="px-2 py-1 text-xs font-medium">Off</button>
                      <button type="button" data-r="A" class="px-2 py-1 text-xs font-bold">A</button>
                      <button type="button" data-r="B" class="px-2 py-1 text-xs font-bold">B</button>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="truncate text-sm font-medium text-gray-900">{s.name}</div>
                      {s.detail && <div class="text-xs text-gray-400">{s.detail}</div>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        )}
        {skipped.length > 0 && (
          <div class="mt-2 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">⚠️ Not routable: {skipped.join(' · ')}</div>
        )}
        <button id="optimize-btn" type="button" class="mt-3 inline-flex h-11 w-full items-center justify-center rounded-ts-md bg-ts-primary px-4 text-base font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark disabled:opacity-60">
          🧭 Optimize routes
        </button>
      </Card>

      <div class="flex flex-col gap-4">
        <Card padding="md" elevation="sm" as="section">
          <h2 class="mb-2 text-lg font-semibold text-emerald-700">Route A</h2>
          <div id="route-A" class="text-sm text-gray-500">Assign stops to A and tap Optimize.</div>
        </Card>
        <Card padding="md" elevation="sm" as="section">
          <h2 class="mb-2 text-lg font-semibold text-indigo-700">Route B</h2>
          <div id="route-B" class="text-sm text-gray-500">Optional second truck/run.</div>
        </Card>
      </div>
    </div>
  )}
</AdminShell>

<script is:inline define:vars={{ allStops: stops, depot: DEPOT, routeDate: route_date }}>
  const byKey = new Map(allStops.map((s) => [s.key, s]));
  const assign = new Map(allStops.map((s) => [s.key, 'A'])); // default everyone on A
  const state = { A: null, B: null }; // per-route { order:[keys], matrix, keys, startSec }

  const fmtClock = (sec) => { const h=Math.floor(sec/3600)%24,m=Math.floor((sec%3600)/60),ap=h>=12?'PM':'AM',h12=((h+11)%12)+1; return `${h12}:${String(m).padStart(2,'0')} ${ap}`; };
  const mins = (s) => Math.round(s/60);

  // paint the A/B/Off segmented control for a stop
  function paint(key) {
    const r = assign.get(key);
    document.querySelectorAll(`.route-pick[data-key="${CSS.escape(key)}"] button`).forEach((b) => {
      const on = b.getAttribute('data-r') === r;
      b.style.background = on ? (r==='A'?'#059669':r==='B'?'#4f46e5':'#6b7280') : '#fff';
      b.style.color = on ? '#fff' : '#374151';
    });
  }
  document.querySelectorAll('.route-pick').forEach((pick) => {
    const key = pick.getAttribute('data-key');
    pick.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { assign.set(key, b.getAttribute('data-r')); paint(key); }));
    paint(key);
  });
  document.querySelectorAll('[data-all]').forEach((b) => b.addEventListener('click', () => {
    const v = b.getAttribute('data-all'); allStops.forEach((s) => { assign.set(s.key, v); paint(s.key); });
  }));

  function mapsUrl(orderedStops) {
    const o = `${depot.lat},${depot.lng}`;
    const wp = orderedStops.map((s) => `${s.lat},${s.lng}`).join('|');
    return `https://www.google.com/maps/dir/?api=1&origin=${o}&destination=${o}&travelmode=driving&waypoints=${encodeURIComponent(wp)}`;
  }

  // recompute ETAs/total for a route's CURRENT order (from its matrix) + render
  function render(letter) {
    const st = state[letter]; const el = document.getElementById('route-' + letter);
    if (!st || st.order.length === 0) { el.innerHTML = '<p class="text-gray-400 text-sm">No stops on this route.</p>'; return; }
    const idx = {}; st.keys.forEach((k, i) => (idx[k] = i));
    let t = st.startSec, prev = 0, drive = 0; const rows = [];
    for (const k of st.order) {
      const i = idx[k]; const leg = st.matrix[prev][i]; drive += leg; t += leg;
      const s = byKey.get(k); const violated = s.windowEndSec != null && t > s.windowEndSec;
      rows.push({ s, leg, arrival: t, violated }); t += s.serviceSec; prev = i;
    }
    drive += st.matrix[prev][0];
    const color = letter === 'A' ? '#059669' : '#4f46e5';
    const li = rows.map((r, i) => `
      <li draggable="true" data-key="${r.s.key}" class="route-row flex items-center gap-2 py-2 ${r.violated?'bg-red-50':''}" style="cursor:grab">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white" style="background:${color}">${i+1}</span>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium text-gray-900 truncate">${r.s.name}</div>
          <div class="text-xs text-gray-500">~${fmtClock(r.arrival)} · +${mins(r.leg)}m drive${r.s.detail?' · '+r.s.detail:''}${r.violated?' · ⚠️ AFTER CUTOFF':''}</div>
        </div>
        <div class="flex shrink-0 flex-col">
          <button data-mv="up" class="px-1 text-gray-400 hover:text-gray-700 leading-none">▲</button>
          <button data-mv="dn" class="px-1 text-gray-400 hover:text-gray-700 leading-none">▼</button>
        </div>
      </li>`).join('');
    el.innerHTML = `
      <div class="mb-2 rounded-ts-md px-3 py-2 text-sm" style="background:${color}1a;color:${color}">
        <strong>${mins(drive)} min drive</strong> (${(drive/3600).toFixed(1)} hr) · ${st.order.length} stops
      </div>
      <ol class="mb-2 divide-y divide-gray-100">
        <li class="py-1 text-xs font-semibold uppercase tracking-wide text-gray-400">START · Farm</li>
        ${li}
        <li class="py-1 text-xs font-semibold uppercase tracking-wide text-gray-400">RETURN · Farm</li>
      </ol>
      <p class="mb-2 text-[11px] text-gray-400">Drag rows or use ▲▼ to reorder — ETAs update live.</p>
      <a href="${mapsUrl(st.order.map((k)=>byKey.get(k)))}" target="_blank" rel="noopener" class="mb-2 inline-flex h-11 w-full items-center justify-center rounded-ts-md bg-blue-600 px-4 text-base font-semibold text-white hover:bg-blue-700">🗺️ Open Route ${letter} in Google Maps</a>
      <button data-save="${letter}" class="inline-flex h-11 w-full items-center justify-center rounded-ts-md bg-gray-800 px-4 text-base font-semibold text-white hover:bg-gray-900">💾 Save &amp; send to driver</button>
      <div data-saveresult="${letter}" class="mt-2 text-sm"></div>`;
    wireReorder(letter);
    el.querySelector(`[data-save="${letter}"]`)?.addEventListener('click', () => saveRoute(letter));
  }

  function wireReorder(letter) {
    const el = document.getElementById('route-' + letter);
    const st = state[letter];
    el.querySelectorAll('[data-mv]').forEach((btn) => btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.closest('.route-row').getAttribute('data-key');
      const i = st.order.indexOf(key); const dir = btn.getAttribute('data-mv') === 'up' ? -1 : 1; const j = i + dir;
      if (j < 0 || j >= st.order.length) return;
      [st.order[i], st.order[j]] = [st.order[j], st.order[i]]; render(letter);
    }));
    let dragKey = null;
    el.querySelectorAll('.route-row').forEach((row) => {
      row.addEventListener('dragstart', () => { dragKey = row.getAttribute('data-key'); row.style.opacity = '0.4'; });
      row.addEventListener('dragend', () => { row.style.opacity = '1'; });
      row.addEventListener('dragover', (e) => e.preventDefault());
      row.addEventListener('drop', (e) => {
        e.preventDefault();
        const overKey = row.getAttribute('data-key'); if (!dragKey || dragKey === overKey) return;
        const from = st.order.indexOf(dragKey); const to = st.order.indexOf(overKey);
        st.order.splice(from, 1); st.order.splice(to, 0, dragKey); render(letter);
      });
    });
  }

  async function saveRoute(letter) {
    const st = state[letter];
    const out = document.querySelector(`[data-saveresult="${letter}"]`);
    if (!st || !st.order.length) { out.innerHTML = '<span class="text-red-600">Nothing to save.</span>'; return; }
    const idx = {}; st.keys.forEach((k, i) => (idx[k] = i));
    let t = st.startSec, prev = 0; const stops = []; let missing = 0;
    for (const k of st.order) {
      const i = idx[k]; t += st.matrix[prev][i]; const s = byKey.get(k);
      if (!s.ref) { missing++; }
      else { const hh = Math.floor(t / 3600) % 24, mm = Math.floor((t % 3600) / 60); stops.push({ ref: s.ref, scheduledTime: `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}:00` }); }
      t += s.serviceSec; prev = i;
    }
    if (!stops.length) { out.innerHTML = '<span class="text-red-600">No saveable stops on this route.</span>'; return; }
    out.innerHTML = '<span class="text-gray-500">Saving…</span>';
    try {
      const res = await fetch('/api/admin/route/save-optimized', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ route_date: routeDate, leg: letter, stops }) });
      const d = await res.json();
      if (!res.ok || d.error) { out.innerHTML = `<span class="text-red-600">Save failed: ${d.detail || d.error || res.status}</span>`; return; }
      const link = location.origin + d.url;
      out.innerHTML = `<div class="rounded bg-green-50 px-3 py-2 text-green-800">✅ Saved Route ${letter} (${d.stops} stops)${missing ? ` · ${missing} skipped (no link)` : ''}. The driver opens this — it auto-updates when you re-save.<br><a href="${d.url}" target="_blank" class="font-semibold underline">Open driver view →</a> <button data-copy="${link}" class="ml-2 rounded border bg-white px-2 py-0.5 text-xs">Copy link</button></div>`;
      out.querySelector('[data-copy]')?.addEventListener('click', (e) => { navigator.clipboard?.writeText(e.target.getAttribute('data-copy')); e.target.textContent = 'Copied!'; });
    } catch (e) { out.innerHTML = `<span class="text-red-600">Error: ${e?.message || e}</span>`; }
  }

  async function optimizeRoute(letter, stops, startSec) {
    const el = document.getElementById('route-' + letter);
    if (stops.length === 0) { state[letter] = null; el.innerHTML = '<p class="text-gray-400 text-sm">No stops on this route.</p>'; return; }
    el.innerHTML = '<p class="text-gray-500 text-sm">Optimizing…</p>';
    const res = await fetch('/api/admin/optimize-route', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ stops, startSec }) });
    const d = await res.json();
    if (!res.ok || d.error) { el.innerHTML = `<p class="text-red-600 text-sm">Couldn't optimize: ${d.detail || d.error || res.status}</p>`; return; }
    state[letter] = { order: d.stops.map((s) => s.key), matrix: d.matrix, keys: d.keys, startSec };
    render(letter);
    if (d.warnings && d.warnings.length) el.insertAdjacentHTML('afterbegin', `<div class="mb-2 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">${d.warnings.join('<br>')}</div>`);
  }

  document.getElementById('optimize-btn')?.addEventListener('click', async () => {
    const [hh, mm] = (document.getElementById('start-time').value || '09:00').split(':').map(Number);
    const startSec = (hh || 9) * 3600 + (mm || 0) * 60;
    const A = allStops.filter((s) => assign.get(s.key) === 'A');
    const B = allStops.filter((s) => assign.get(s.key) === 'B');
    const btn = document.getElementById('optimize-btn'); btn.disabled = true; btn.textContent = '⏳ Optimizing…';
    try { await Promise.all([optimizeRoute('A', A, startSec), optimizeRoute('B', B, startSec)]); }
    finally { btn.disabled = false; btn.textContent = '🧭 Optimize routes'; }
  });
</script>
