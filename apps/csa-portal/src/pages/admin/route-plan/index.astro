---
/**
 * /admin/route-plan — automatic delivery-route optimizer (Todd 2026-06-23).
 *
 * Pick a week + day. The page gathers that day's candidate stops (CSA pickups +
 * home deliveries + wholesale, all geocoded) and lists them with ON/OFF toggles
 * so Todd can pull any stop out of the truck. "Optimize" posts the SELECTED
 * stops to /api/admin/optimize-route, which returns the least-drive-time depot
 * loop (farm → stops → farm), time-window aware (Black Radish by 3 PM), with
 * ETAs + a one-tap full-route Google Maps link. Admin-gated by middleware.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { GOOGLE_MAPS_API_KEY } from 'astro:env/server';
import { supabaseAdmin } from '../../../lib/supabase';
import { mondayOfWeek, currentDeliveryWeek, isMonday, prettyWeekHeader } from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';
import { gatherDayStops, DEPOT } from '../../../lib/route-optimizer';

export const prerender = false;

const url = new URL(Astro.request.url);
const weekParam = (url.searchParams.get('week') ?? '').trim();
const week_starting = /^\d{4}-\d{2}-\d{2}$/.test(weekParam)
  ? (isMonday(weekParam) ? weekParam : mondayOfWeek(weekParam))
  : currentDeliveryWeek();
const dayRaw = url.searchParams.get('day') ?? 'Wed';
const day = (['Tue', 'Wed', 'Sat'].includes(dayRaw) ? dayRaw : 'Wed') as 'Tue' | 'Wed' | 'Sat';

let stops: any[] = [];
let skipped: string[] = [];
let gatherError: string | null = null;
if (!GOOGLE_MAPS_API_KEY) {
  gatherError = 'Google Maps key is not configured on the server.';
} else {
  try {
    const r = await gatherDayStops(supabaseAdmin, week_starting, day, GOOGLE_MAPS_API_KEY);
    stops = r.stops;
    skipped = r.skipped;
  } catch (e) {
    gatherError = (e as Error)?.message ?? 'Could not load stops for this day.';
  }
}

const options = weekOptions();
const groups = [
  { kind: 'csa', label: '🥬 CSA pickup stops', items: stops.filter((s) => s.kind === 'csa') },
  { kind: 'home', label: '🏠 Home deliveries', items: stops.filter((s) => s.kind === 'home') },
  { kind: 'wholesale', label: '🍽 Wholesale', items: stops.filter((s) => s.kind === 'wholesale') },
];
---

<AdminShell
  title="Route planner"
  subtitle={`${prettyWeekHeader(week_starting)} · ${day} delivery · starts + ends at ${DEPOT.name}`}
  pageTitle="Route planner — Tiny Seed Admin"
>
  {/* Week + day picker */}
  <Card padding="md" elevation="sm" class="mb-4">
    <form method="GET" action="/admin/route-plan/" class="flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Week</span>
        <select name="week" onchange="this.form.submit()"
          class="h-10 min-w-[240px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm">
          {options.map((o) => (<option value={o.value} selected={o.value === week_starting}>{o.label}</option>))}
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Day</span>
        <select name="day" onchange="this.form.submit()"
          class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm">
          {['Tue', 'Wed', 'Sat'].map((d) => (<option value={d} selected={d === day}>{d}</option>))}
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Leave farm at</span>
        <input id="start-time" type="time" value="09:00"
          class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
    </form>
  </Card>

  {gatherError && (
    <Card padding="md" elevation="sm" class="mb-4 border border-red-200 bg-red-50">
      <p class="text-sm text-red-700">{gatherError}</p>
    </Card>
  )}

  {!gatherError && (
    <div class="grid gap-4 lg:grid-cols-2">
      {/* LEFT: stop toggles */}
      <Card padding="md" elevation="sm" as="section">
        <div class="mb-2 flex items-center justify-between">
          <h2 class="text-lg font-semibold text-gray-900">Stops on the truck</h2>
          <div class="flex gap-2 text-xs">
            <button type="button" data-all="on" class="rounded bg-gray-100 px-2 py-1 hover:bg-gray-200">All on</button>
            <button type="button" data-all="off" class="rounded bg-gray-100 px-2 py-1 hover:bg-gray-200">All off</button>
          </div>
        </div>
        <p class="mb-3 text-xs text-gray-500">Untick any stop to pull it off this route, then Optimize.</p>
        {stops.length === 0 ? (
          <p class="text-sm text-gray-500">No stops for {day}. Pick a different day/week.</p>
        ) : (
          groups.filter((g) => g.items.length).map((g) => (
            <div class="mb-4">
              <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-400">{g.label} ({g.items.length})</div>
              <ul class="divide-y divide-gray-100">
                {g.items.map((s) => (
                  <li class="flex items-center gap-3 py-2">
                    <input type="checkbox" class="stop-toggle h-5 w-5 rounded accent-emerald-600" data-key={s.key} checked />
                    <div class="min-w-0 flex-1">
                      <div class="truncate text-sm font-medium text-gray-900">{s.name}</div>
                      {s.detail && <div class="text-xs text-gray-400">{s.detail}</div>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        )}
        {skipped.length > 0 && (
          <div class="mt-2 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">
            ⚠️ Not routable (no coordinates): {skipped.join(' · ')}
          </div>
        )}
        <button id="optimize-btn" type="button"
          class="mt-3 inline-flex h-11 w-full items-center justify-center rounded-ts-md bg-ts-primary px-4 text-base font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark disabled:opacity-60">
          🧭 Optimize route
        </button>
      </Card>

      {/* RIGHT: results */}
      <Card padding="md" elevation="sm" as="section">
        <h2 class="mb-2 text-lg font-semibold text-gray-900">Optimized route</h2>
        <div id="route-result" class="text-sm text-gray-500">Pick your stops and tap <strong>Optimize route</strong>.</div>
      </Card>
    </div>
  )}
</AdminShell>

<script is:inline define:vars={{ allStops: stops }}>
  const byKey = new Map(allStops.map((s) => [s.key, s]));

  document.querySelectorAll('[data-all]').forEach((b) =>
    b.addEventListener('click', () => {
      const on = b.getAttribute('data-all') === 'on';
      document.querySelectorAll('.stop-toggle').forEach((c) => { c.checked = on; });
    }),
  );

  function fmtClock(sec) {
    const h24 = Math.floor(sec / 3600) % 24, mm = Math.floor((sec % 3600) / 60);
    const ampm = h24 >= 12 ? 'PM' : 'AM', h12 = ((h24 + 11) % 12) + 1;
    return `${h12}:${String(mm).padStart(2, '0')} ${ampm}`;
  }
  function mins(sec) { return Math.round(sec / 60); }

  const btn = document.getElementById('optimize-btn');
  const out = document.getElementById('route-result');

  btn?.addEventListener('click', async () => {
    const selected = [...document.querySelectorAll('.stop-toggle')]
      .filter((c) => c.checked)
      .map((c) => byKey.get(c.getAttribute('data-key')))
      .filter(Boolean);
    if (selected.length === 0) { out.innerHTML = '<p class="text-red-600">Select at least one stop.</p>'; return; }

    const [hh, mm] = (document.getElementById('start-time').value || '09:00').split(':').map(Number);
    const startSec = (hh || 9) * 3600 + (mm || 0) * 60;

    btn.disabled = true; btn.textContent = '⏳ Optimizing…';
    out.innerHTML = '<p class="text-gray-500">Calculating the best loop…</p>';
    try {
      const res = await fetch('/api/admin/optimize-route', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ stops: selected, startSec }),
      });
      const d = await res.json();
      if (!res.ok || d.error) { out.innerHTML = `<p class="text-red-600">Couldn't optimize: ${d.detail || d.error || res.status}</p>`; return; }

      const rows = d.stops.map((s, i) => `
        <li class="flex items-start gap-3 py-2 ${s.windowViolated ? 'bg-red-50' : ''}">
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-ts-primary text-xs font-bold text-white">${i + 1}</span>
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-gray-900">${s.name}</div>
            <div class="text-xs text-gray-500">arrive ~${fmtClock(s.arrivalSec)} · +${mins(s.legSec)} min drive${s.detail ? ' · ' + s.detail : ''}${s.windowViolated ? ' · ⚠️ AFTER CUTOFF' : ''}</div>
          </div>
        </li>`).join('');

      out.innerHTML = `
        <div class="mb-2 rounded-ts-md bg-emerald-50 px-3 py-2 text-sm text-emerald-800">
          <strong>${mins(d.totalDriveSec)} min drive</strong> (${(d.totalDriveSec/3600).toFixed(1)} hrs) · ${d.stops.length} stops · ~${mins(d.totalServiceSec)} min unloading
        </div>
        ${d.warnings && d.warnings.length ? `<div class="mb-2 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">${d.warnings.join('<br>')}</div>` : ''}
        <ol class="mb-3 divide-y divide-gray-100">
          <li class="py-2 text-xs font-semibold uppercase tracking-wide text-gray-400">START · Farm</li>
          ${rows}
          <li class="py-2 text-xs font-semibold uppercase tracking-wide text-gray-400">RETURN · Farm</li>
        </ol>
        <a href="${d.mapsUrl}" target="_blank" rel="noopener"
           class="inline-flex h-11 w-full items-center justify-center rounded-ts-md bg-blue-600 px-4 text-base font-semibold text-white hover:bg-blue-700">
          🗺️ Open full route in Google Maps
        </a>`;
    } catch (e) {
      out.innerHTML = `<p class="text-red-600">Error: ${e?.message || e}</p>`;
    } finally {
      btn.disabled = false; btn.textContent = '🧭 Optimize route';
    }
  });
</script>
