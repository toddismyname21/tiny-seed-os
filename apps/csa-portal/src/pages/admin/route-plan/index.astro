---
/**
 * /admin/route-plan — automatic delivery-route optimizer (Todd 2026-06-23).
 *
 * Pick a week + day. The page gathers that day's candidate stops (CSA pickups +
 * home deliveries + wholesale, all geocoded). Each stop is assigned to Route A,
 * Route B, or Off — so Todd can split into two trucks/runs and pull stops off.
 * "Optimize routes" optimizes A and B independently into least-drive-time depot
 * loops (farm → stops → farm), time-window aware (Black Radish by 3 PM). Each
 * result list is DRAG / arrow reorderable — a manual reorder recomputes ETAs +
 * the nav link instantly from the returned drive-time matrix (no re-call).
 * One-tap full-route Google Maps nav per route. Admin-gated by middleware.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { GOOGLE_MAPS_API_KEY } from 'astro:env/server';
import { supabaseAdmin } from '../../../lib/supabase';
import { mondayOfWeek, currentDeliveryWeek, isMonday, prettyWeekHeader } from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';
import { addDaysYMD } from '../../../lib/wholesale-order';
import { gatherDayStops, gatherManualStops, DEPOT, type RouteStop } from '../../../lib/route-optimizer';

export const prerender = false;

const url = new URL(Astro.request.url);
const weekParam = (url.searchParams.get('week') ?? '').trim();
const week_starting = /^\d{4}-\d{2}-\d{2}$/.test(weekParam)
  ? (isMonday(weekParam) ? weekParam : mondayOfWeek(weekParam))
  : currentDeliveryWeek();
const dayRaw = url.searchParams.get('day') ?? 'Wed';

// Per-leg OPEN-route end addresses (Todd 2026-08-04: Route A ends at the
// driver's home — she keeps the truck in the city). Editable on this page;
// persisted in portal_settings so the optimize endpoint + future sessions
// pick them up. Blank = classic farm loop.
const { data: endRows } = await supabaseAdmin
  .from('portal_settings')
  .select('key, value')
  .in('key', ['route_end_address_A', 'route_end_address_B']);
const endAddr: Record<string, string> = { A: '', B: '' };
for (const r of (endRows ?? []) as Array<{ key: string; value: string | null }>) {
  const leg = r.key.endsWith('_A') ? 'A' : 'B';
  endAddr[leg] = (r.value ?? '').trim();
}
const day = (['Tue', 'Wed', 'Sat'].includes(dayRaw) ? dayRaw : 'Wed') as 'Tue' | 'Wed' | 'Sat';
// Delivery date for this day = the week's Monday + offset (Tue+1, Wed+2, Sat+5).
const route_date = addDaysYMD(week_starting, ({ Tue: 1, Wed: 2, Sat: 5 } as const)[day]);

let stops: RouteStop[] = [];
let skipped: string[] = [];
let gatherError: string | null = null;
if (!GOOGLE_MAPS_API_KEY) {
  gatherError = 'Google Maps key is not configured on the server.';
} else {
  try {
    const r = await gatherDayStops(supabaseAdmin, week_starting, day, GOOGLE_MAPS_API_KEY);
    stops = r.stops;
    skipped = r.skipped;
  } catch (e) {
    gatherError = (e as Error)?.message ?? 'Could not load stops for this day.';
  }
}

// Manual / not-routable stops — separate read, NEVER fed to the optimizer.
// (a) customers flagged routable=false; (b) wholesale accounts with an address.
let manualStops: Awaited<ReturnType<typeof gatherManualStops>> = [];
try {
  manualStops = await gatherManualStops(supabaseAdmin);
} catch {
  manualStops = [];
}
const manualErrorParam = url.searchParams.get('routable_error');
const manualOkParam = url.searchParams.get('routable_ok');

// ── Ad-hoc MANUAL stops for THIS delivery date (migration 0084) ──────────
// The per-date stops Todd adds by hand on this page (name + address + note,
// Route A or B). Listed with a ✕ remove; they also flow into the gathered stop
// set above (key 'manual:<id>') so they optimize + save + drive + pack like any
// other stop. Separate from the routable/wholesale reference list above.
type AdHocStop = { id: string; leg: string; name: string; address: string; lat: number | null; lng: number | null; note: string | null };
let adHocStops: AdHocStop[] = [];
try {
  const { data } = await supabaseAdmin
    .from('route_manual_stops')
    .select('id, leg, name, address, lat, lng, note')
    .eq('route_date', route_date)
    .eq('is_active', true)
    .order('created_at', { ascending: true });
  adHocStops = (data ?? []) as AdHocStop[];
} catch {
  adHocStops = [];
}

const options = weekOptions();
const groups = [
  { kind: 'csa', label: '🥬 CSA pickup stops', items: stops.filter((s) => s.kind === 'csa') },
  { kind: 'home', label: '🏠 Home deliveries', items: stops.filter((s) => s.kind === 'home') },
  { kind: 'wholesale', label: '🍽 Wholesale', items: stops.filter((s) => s.kind === 'wholesale') },
  { kind: 'manual', label: '📌 Manual stops', items: stops.filter((s) => s.kind === 'manual') },
];
---

<AdminShell
  title="Route planner"
  subtitle={`${prettyWeekHeader(week_starting)} · ${day} delivery · starts + ends at ${DEPOT.name}`}
  pageTitle="Route planner — Tiny Seed Admin"
>
  <Card padding="md" elevation="sm" class="mb-4">
    <form method="GET" action="/admin/route-plan/" class="flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Week</span>
        <select name="week" onchange="this.form.submit()" class="h-10 min-w-[240px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm">
          {options.map((o) => (<option value={o.value} selected={o.value === week_starting}>{o.label}</option>))}
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Day</span>
        <select name="day" onchange="this.form.submit()" class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm">
          {['Tue', 'Wed', 'Sat'].map((d) => (<option value={d} selected={d === day}>{d}</option>))}
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Leave farm at</span>
        <input id="start-time" type="time" value="09:00" class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        <span class="text-ts-text-muted">Route A ends at <span class="text-xs">(blank = back to farm)</span></span>
        <input id="end-addr-A" type="text" value={endAddr.A} placeholder="e.g. 3934 Foster St, Pittsburgh, PA 15201" class="h-10 w-72 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
      <label class="flex flex-col gap-1 text-sm">
        <span class="text-ts-text-muted">Route B ends at <span class="text-xs">(blank = back to farm)</span></span>
        <input id="end-addr-B" type="text" value={endAddr.B} placeholder="blank = return to farm" class="h-10 w-72 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
    </form>
  </Card>

  {gatherError && (
    <Card padding="md" elevation="sm" class="mb-4 border border-red-200 bg-red-50">
      <p class="text-sm text-red-700">{gatherError}</p>
    </Card>
  )}

  {!gatherError && (
    <div class="grid gap-4 lg:grid-cols-2">
      <Card padding="md" elevation="sm" as="section">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-semibold text-gray-900">Assign stops · A / B / Off</h2>
          <div class="flex gap-1 text-xs">
            <button type="button" data-all="A" class="rounded bg-emerald-100 px-2 py-1 font-medium text-emerald-700 hover:bg-emerald-200">All → A</button>
            <button type="button" data-all="B" class="rounded bg-indigo-100 px-2 py-1 font-medium text-indigo-700 hover:bg-indigo-200">All → B</button>
            <button type="button" data-all="off" class="rounded bg-gray-100 px-2 py-1 hover:bg-gray-200">All off</button>
          </div>
        </div>
        <p class="mb-3 text-xs text-gray-500">Put each stop on Route <b class="text-emerald-700">A</b>, Route <b class="text-indigo-700">B</b>, or <b>Off</b> (off the truck). Then optimize.</p>
        {stops.length === 0 ? (
          <p class="text-sm text-gray-500">No stops for {day}. Pick a different day/week.</p>
        ) : (
          groups.filter((g) => g.items.length).map((g) => (
            <div class="mb-4">
              <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-400">{g.label} ({g.items.length})</div>
              <ul class="divide-y divide-gray-100">
                {g.items.map((s) => (
                  <li class="flex items-center gap-3 py-2">
                    <div class="route-pick inline-flex overflow-hidden rounded-md border border-gray-200" data-key={s.key}>
                      <button type="button" data-r="off" class="px-2 py-1 text-xs font-medium">Off</button>
                      <button type="button" data-r="A" class="px-2 py-1 text-xs font-bold">A</button>
                      <button type="button" data-r="B" class="px-2 py-1 text-xs font-bold">B</button>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="truncate text-sm font-medium text-gray-900">{s.name}</div>
                      {s.address && <div class="truncate text-xs text-gray-600">📍 {s.address}</div>}
                      {s.detail && <div class="text-xs text-gray-400">{s.detail}</div>}
                    </div>
                    {/* ACTION button (not a status!). The old label "📌 Not
                        routable" read like a status column — Todd scanned the
                        list on 2026-07-07 and thought every home stop was
                        broken, and one stray tap silently removed a member
                        from the route. Now: verb-labeled + two-tap confirm. */}
                    {g.kind === 'home' && (
                      <form method="POST" action="/api/admin/route/routable" class="shrink-0" data-remove-stop>
                        <input type="hidden" name="customer_id" value={s.key} />
                        <input type="hidden" name="routable" value="false" />
                        <input type="hidden" name="week" value={week_starting} />
                        <input type="hidden" name="day" value={day} />
                        <button
                          type="submit"
                          data-armed="false"
                          class="inline-flex h-8 items-center justify-center rounded-md border border-ts-border bg-ts-bg-surface px-2 text-[11px] font-semibold text-ts-text-muted transition hover:border-amber-400 hover:bg-amber-50 hover:text-amber-800 active:scale-[0.98] data-[armed=true]:border-amber-500 data-[armed=true]:bg-amber-100 data-[armed=true]:text-amber-900"
                          title="Remove from the optimized route — you'll deliver this one by hand (reversible)"
                        >Remove from route…</button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        )}
        {skipped.length > 0 && (
          <div class="mt-2 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">⚠️ Couldn't route (missing address or geocode failed): {skipped.join(' · ')}</div>
        )}
        <button id="optimize-btn" type="button" class="mt-3 inline-flex h-11 w-full items-center justify-center rounded-ts-md bg-ts-primary px-4 text-base font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark disabled:opacity-60">
          🧭 Optimize routes
        </button>
      </Card>

      <div class="flex flex-col gap-4">
        <Card padding="md" elevation="sm" as="section">
          <h2 class="mb-2 text-lg font-semibold text-emerald-700">Route A</h2>
          <div id="route-A" class="text-sm text-gray-500">Assign stops to A and tap Optimize.</div>
          {/* Map renders here after optimize (client-injected). Hidden until then. */}
          <div id="map-A" class="mt-3 hidden overflow-hidden rounded-ts-md border border-gray-200" style="height:360px"></div>
        </Card>
        <Card padding="md" elevation="sm" as="section">
          <h2 class="mb-2 text-lg font-semibold text-indigo-700">Route B</h2>
          <div id="route-B" class="text-sm text-gray-500">Optional second truck/run.</div>
          <div id="map-B" class="mt-3 hidden overflow-hidden rounded-ts-md border border-gray-200" style="height:360px"></div>
        </Card>
      </div>
    </div>
  )}

  {/* ── ➕ Add an ad-hoc MANUAL stop for this delivery date ─────────────
       Todd adds a one-off stop (name + address + optional note) to Route A or
       B. It geocodes server-side, then joins the gathered stop set so it
       optimizes + saves + drives + packs like any other stop. Below the form:
       the day's existing manual stops with a ✕ remove. */}
  <Card padding="md" elevation="sm" as="section" class="mt-6 border border-amber-300">
    <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-lg font-semibold text-amber-800">➕ Add a stop (this {day} · {route_date})</h2>
      <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">{adHocStops.length} added</span>
    </div>
    <p class="mb-3 text-xs text-gray-500">
      A one-off delivery for <b>{route_date}</b> only. It's geocoded, added to the chosen
      route, and flows through optimize → save → driver → pack. Re-optimize after adding.
    </p>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5" id="add-stop-form">
      <label class="flex flex-col gap-1 lg:col-span-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Name</span>
        <input id="ms-name" type="text" placeholder="e.g. Farmers market table" maxlength="120"
          class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
      <label class="flex flex-col gap-1 sm:col-span-2 lg:col-span-2">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Address</span>
        <input id="ms-address" type="text" placeholder="Street, City, State ZIP" maxlength="300"
          class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
      <label class="flex flex-col gap-1 lg:col-span-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Note <span class="normal-case text-gray-400">(optional)</span></span>
        <input id="ms-note" type="text" placeholder="e.g. gate code #1234" maxlength="500"
          class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm" />
      </label>
      <label class="flex flex-col gap-1 lg:col-span-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Route</span>
        <select id="ms-leg" class="h-10 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm">
          <option value="A">Route A</option>
          <option value="B">Route B</option>
        </select>
      </label>
    </div>
    <div class="mt-3 flex items-center gap-3">
      <button id="ms-add-btn" type="button"
        class="inline-flex h-11 items-center justify-center rounded-ts-md bg-amber-600 px-5 text-sm font-semibold text-white shadow-ts-sm transition hover:bg-amber-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 active:scale-[0.98] disabled:opacity-60">
        ➕ Add stop
      </button>
      <span id="ms-add-result" class="text-sm" aria-live="polite"></span>
    </div>

    {adHocStops.length > 0 && (
      <ul class="mt-4 divide-y divide-gray-100 border-t border-gray-100">
        {adHocStops.map((m) => (
          <li class="flex items-center gap-3 py-3" data-manual-row={m.id}>
            <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800">📌 {m.leg}</span>
            <div class="min-w-0 flex-1">
              <div class="truncate text-sm font-medium text-gray-900">{m.name}</div>
              <div class="truncate text-xs text-gray-600">📍 {m.address}{m.lat == null && <span class="ml-1 font-semibold text-red-600">· ⚠️ didn't geocode</span>}</div>
              {m.note && <div class="truncate text-xs text-gray-400">📝 {m.note}</div>}
            </div>
            <button type="button" data-manual-remove={m.id}
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface text-base text-gray-500 transition hover:border-red-400 hover:bg-red-50 hover:text-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 active:scale-[0.95]"
              title="Remove this manual stop" aria-label={`Remove ${m.name}`}>✕</button>
          </li>
        ))}
      </ul>
    )}
  </Card>

  {/* ── Manual / not-routable stops — deliver by hand, NOT optimized ── */}
  <Card padding="md" elevation="sm" as="section" class="mt-6 border border-amber-200">
    <div class="mb-1 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-lg font-semibold text-amber-800">📌 Manual / not-routable stops</h2>
      <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800">{manualStops.length}</span>
    </div>
    <p class="mb-3 text-xs text-gray-500">
      Deliver these by hand — they are <b>NOT</b> sent to the route optimizer. Wholesale
      accounts are off the CSA route by design; flagged customers were taken off by you.
    </p>

    {manualOkParam && (
      <div class="mb-3 rounded bg-green-50 px-3 py-2 text-sm text-green-800">
        ✅ {manualOkParam === 'off' ? 'Customer moved to manual stops (off the optimizer).' : 'Customer restored to the optimizer.'}
      </div>
    )}
    {manualErrorParam && (
      <div class="mb-3 rounded bg-red-50 px-3 py-2 text-sm text-red-700">
        Couldn’t update routable: {manualErrorParam}
      </div>
    )}

    {manualStops.length === 0 ? (
      <div class="rounded-ts-md border border-dashed border-gray-200 px-4 py-8 text-center">
        <div class="mb-1 text-2xl">📭</div>
        <p class="text-sm font-medium text-gray-700">No manual stops</p>
        <p class="text-xs text-gray-500">
          Wholesale accounts with an address and any customer you mark “not routable” will appear here.
        </p>
      </div>
    ) : (
      <ul class="divide-y divide-gray-100">
        {manualStops.map((m) => (
          <li class="flex items-center gap-3 py-3">
            <span class={`shrink-0 rounded-full px-2 py-0.5 text-xs font-semibold ${m.kind === 'wholesale' ? 'bg-orange-100 text-orange-800' : 'bg-sky-100 text-sky-800'}`}>
              {m.kind === 'wholesale' ? '🍽 Wholesale' : '🏠 Home'}
            </span>
            <div class="min-w-0 flex-1">
              <div class="truncate text-sm font-medium text-gray-900">{m.name}</div>
              <div class="truncate text-xs text-gray-600">📍 {m.address}</div>
              {m.phone && (
                <div class="text-xs text-gray-400">
                  📞 <a href={`tel:${m.phone}`} class="hover:underline">{m.phone}</a>
                </div>
              )}
            </div>
            {m.toggleable ? (
              <form method="POST" action="/api/admin/route/routable" class="shrink-0">
                <input type="hidden" name="customer_id" value={m.id} />
                <input type="hidden" name="routable" value="true" />
                <input type="hidden" name="week" value={week_starting} />
                <input type="hidden" name="day" value={day} />
                <button
                  type="submit"
                  class="inline-flex h-10 items-center justify-center rounded-ts-md border border-emerald-300 bg-emerald-50 px-3 text-xs font-semibold text-emerald-700 transition hover:bg-emerald-100 active:scale-[0.98]"
                  title="Put this customer back on the route optimizer"
                >↩︎ Make routable</button>
              </form>
            ) : (
              <span class="shrink-0 text-xs text-gray-400" title="Wholesale accounts are off the CSA optimizer by design">off route by design</span>
            )}
          </li>
        ))}
      </ul>
    )}
  </Card>
</AdminShell>

{/* SECURITY: GOOGLE_MAPS_API_KEY is server-side, but the Maps JavaScript API
    requires the key in the browser, so we inject it via define:vars below. This
    puts the key in the served HTML — acceptable here because the page is
    admin-authed (middleware-gated). The key MUST be HTTP-referrer-restricted in
    Google Cloud Console (restrict to csa.tinyseedfarm.com) so a leaked key can't
    be used from other origins. */}
<script is:inline define:vars={{ allStops: stops, depot: DEPOT, routeDate: route_date, mapsKey: GOOGLE_MAPS_API_KEY }}>
  const byKey = new Map(allStops.map((s) => [s.key, s]));
  // Default everyone to leg A, EXCEPT a manual stop, which starts on the leg
  // Todd chose when he added it (route_manual_stops.leg, carried on the stop).
  const assign = new Map(allStops.map((s) => [s.key, s.kind === 'manual' && (s.leg === 'A' || s.leg === 'B') ? s.leg : 'A']));
  const state = { A: null, B: null }; // per-route { order:[keys], matrix, keys, startSec }

  const fmtClock = (sec) => { const h=Math.floor(sec/3600)%24,m=Math.floor((sec%3600)/60),ap=h>=12?'PM':'AM',h12=((h+11)%12)+1; return `${h12}:${String(m).padStart(2,'0')} ${ap}`; };
  const mins = (s) => Math.round(s/60);

  // Escape untrusted strings before they hit innerHTML. Stop name/address/detail
  // come from member-supplied delivery addresses + Shopify contact names, and
  // save/optimize error strings are API-derived — all could contain markup that
  // would otherwise execute as stored XSS in Todd's admin browser (audit H4/L2).
  const escapeHtml = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
  ));

  // paint the A/B/Off segmented control for a stop
  function paint(key) {
    const r = assign.get(key);
    document.querySelectorAll(`.route-pick[data-key="${CSS.escape(key)}"] button`).forEach((b) => {
      const on = b.getAttribute('data-r') === r;
      b.style.background = on ? (r==='A'?'#059669':r==='B'?'#4f46e5':'#6b7280') : '#fff';
      b.style.color = on ? '#fff' : '#374151';
    });
  }
  document.querySelectorAll('.route-pick').forEach((pick) => {
    const key = pick.getAttribute('data-key');
    pick.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { assign.set(key, b.getAttribute('data-r')); paint(key); }));
    paint(key);
  });
  document.querySelectorAll('[data-all]').forEach((b) => b.addEventListener('click', () => {
    const v = b.getAttribute('data-all'); allStops.forEach((s) => { assign.set(s.key, v); paint(s.key); });
  }));

  function mapsUrl(orderedStops) {
    const o = `${depot.lat},${depot.lng}`;
    const wp = orderedStops.map((s) => `${s.lat},${s.lng}`).join('|');
    return `https://www.google.com/maps/dir/?api=1&origin=${o}&destination=${o}&travelmode=driving&waypoints=${encodeURIComponent(wp)}`;
  }

  // ─── ROUTE MAP VISUAL (BACKLOG #1) ───────────────────────────────────────
  // An interactive Google Map per leg, under its results table: 🚜 depot →
  // numbered stops in drive order → 🏁 end (when an end address is set). Manual
  // stops render amber. A road-following polyline via DirectionsService (chunked
  // past Google's 25-waypoint limit) with a geodesic fallback so the line never
  // vanishes. Additive: render() calls renderMap(letter) after every (re)render,
  // so reorders + re-optimizes redraw automatically.
  const mapState = { loaded: false, loading: null, api: {} }; // Maps JS load status
  // Per-leg live map objects so we can tear down markers/lines on redraw.
  const legMap = { A: { map: null, markers: [], line: null, dir: null }, B: { map: null, markers: [], line: null, dir: null } };
  const MAP_COLOR = { A: '#059669', B: '#4f46e5' };
  // Monotonic per-leg token: a redraw bumps it so a slower in-flight Directions
  // call from a prior renderMap() knows it's stale and won't draw a stale line.
  const mapRenderToken = { A: 0, B: 0 };

  // Load the Maps JavaScript API exactly once, lazily (only when a route first
  // optimizes — never on initial page load). Uses the official inline bootstrap
  // loader so we can `await google.maps.importLibrary(...)`.
  function loadMaps() {
    if (mapState.loaded) return Promise.resolve();
    if (mapState.loading) return mapState.loading;
    if (!mapsKey) return Promise.reject(new Error('Maps key missing'));
    mapState.loading = new Promise((resolve, reject) => {
      // Official inline loader (g.maps.Loader) — dedupes, supports importLibrary.
      (g => { var h, a, k, p = "The Google Maps JavaScript API", c = "google", l = "importLibrary", q = "__ib__", m = document, b = window; b = b[c] || (b[c] = {}); var d = b.maps || (b.maps = {}), r = new Set(), e = new URLSearchParams(), u = () => h || (h = new Promise(async (f, n) => { await (a = m.createElement("script")); e.set("libraries", [...r] + ""); for (k in g) e.set(k.replace(/[A-Z]/g, t => "_" + t[0].toLowerCase()), g[k]); e.set("callback", c + ".maps." + q); a.src = `https://maps.${c}apis.com/maps/api/js?` + e; d[q] = f; a.onerror = () => h = n(Error(p + " could not load.")); a.nonce = m.querySelector("script[nonce]")?.nonce || ""; m.head.append(a); })); d[l] ? console.warn(p + " only loads once. Ignoring:", g) : d[l] = (f, ...n) => r.add(f) && u().then(() => d[l](f, ...n)); })({ key: mapsKey, v: "weekly" });
      (async () => {
        try {
          const [core, maps, marker] = await Promise.all([
            google.maps.importLibrary('core'),
            google.maps.importLibrary('maps'),
            google.maps.importLibrary('marker'),
          ]);
          const routes = await google.maps.importLibrary('routes').catch(() => null);
          mapState.api = { ...core, ...maps, ...marker, routes };
          mapState.loaded = true;
          resolve();
        } catch (err) { reject(err); }
      })();
    });
    return mapState.loading;
  }

  // Tear down a leg's markers/polyline/renderer before drawing fresh ones.
  function clearLegOverlays(letter) {
    const lm = legMap[letter];
    lm.markers.forEach((mk) => { try { mk.map = null; mk.setMap && mk.setMap(null); } catch (_) {} });
    lm.markers = [];
    if (lm.line) { try { lm.line.setMap(null); } catch (_) {} lm.line = null; }
    if (lm.dir) { try { lm.dir.setMap(null); } catch (_) {} lm.dir = null; }
  }

  // Build a marker (AdvancedMarkerElement when available, else classic Marker).
  function makeMarker(letter, position, opts) {
    const g = google.maps;
    const lm = legMap[letter];
    if (g.marker && g.marker.AdvancedMarkerElement) {
      const pin = document.createElement('div');
      pin.style.cssText = `display:flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;font-size:13px;font-weight:700;color:#fff;border:2px solid #fff;box-shadow:0 1px 3px rgba(0,0,0,.4);background:${opts.bg}`;
      pin.textContent = opts.label;
      const mk = new g.marker.AdvancedMarkerElement({ map: lm.map, position, content: pin, title: opts.title });
      lm.markers.push(mk);
      return mk;
    }
    const mk = new g.Marker({
      map: lm.map, position, title: opts.title,
      label: { text: opts.label, color: '#fff', fontSize: '12px', fontWeight: '700' },
      icon: {
        path: g.SymbolPath.CIRCLE, scale: 13, fillColor: opts.bg, fillOpacity: 1,
        strokeColor: '#fff', strokeWeight: 2,
      },
    });
    lm.markers.push(mk);
    return mk;
  }

  // Draw a straight-line (geodesic) fallback so the map is never lineless.
  function drawFallbackLine(letter, path) {
    const g = google.maps;
    const lm = legMap[letter];
    lm.line = new g.Polyline({
      map: lm.map, path, geodesic: true,
      strokeColor: MAP_COLOR[letter], strokeOpacity: 0.85, strokeWeight: 4,
    });
  }

  // Draw a road-following polyline via DirectionsService. Google allows ≤25
  // waypoints (origin + destination + ≤23 intermediate) per request — chunk
  // consecutive segments past that, stitching each chunk's overview path. Any
  // failure → geodesic fallback for that segment.
  async function drawDirections(letter, depotPos, orderedPositions, endTarget) {
    const g = google.maps;
    const lm = legMap[letter];
    const ds = new g.DirectionsService();
    // Full ordered point list: depot → stops… → (end address OR depot).
    // endTarget is a string address (DirectionsService geocodes it) or a LatLng.
    const dest = endTarget != null ? endTarget : depotPos;
    // Chunk the intermediate stops so each request has ≤23 waypoints.
    const MAX_WP = 23;
    const combined = []; // overview path points to stitch into one polyline
    let ok = true;
    // Build chunk boundaries over the ordered stop positions.
    let chunkStart = 0;
    let prevOrigin = depotPos;
    while (chunkStart < orderedPositions.length) {
      const chunkStops = orderedPositions.slice(chunkStart, chunkStart + MAX_WP);
      const isLast = chunkStart + MAX_WP >= orderedPositions.length;
      const chunkDest = isLast ? dest : chunkStops[chunkStops.length - 1];
      const waypoints = (isLast ? chunkStops : chunkStops.slice(0, -1)).map((p) => ({ location: p, stopover: true }));
      try {
        const res = await ds.route({
          origin: prevOrigin, destination: chunkDest, waypoints,
          optimizeWaypoints: false, travelMode: g.TravelMode.DRIVING,
        });
        const path = res.routes?.[0]?.overview_path;
        if (path && path.length) combined.push(...path);
        else { ok = false; break; }
      } catch (_) { ok = false; break; }
      prevOrigin = chunkDest;
      chunkStart += MAX_WP;
    }
    // Empty route (no stops) — single depot→dest request.
    if (orderedPositions.length === 0) {
      try {
        const res = await ds.route({ origin: depotPos, destination: dest, travelMode: g.TravelMode.DRIVING });
        const path = res.routes?.[0]?.overview_path;
        if (path && path.length) combined.push(...path); else ok = false;
      } catch (_) { ok = false; }
    }
    if (ok && combined.length) {
      lm.line = new g.Polyline({
        map: lm.map, path: combined, geodesic: false,
        strokeColor: MAP_COLOR[letter], strokeOpacity: 0.9, strokeWeight: 5,
      });
      return true;
    }
    return false;
  }

  // Render (or re-render) the map for a leg from its current state.order.
  async function renderMap(letter) {
    const container = document.getElementById('map-' + letter);
    const st = state[letter];
    if (!container) return;
    if (!st || !st.order.length) { container.classList.add('hidden'); return; }
    if (!mapsKey) { container.classList.add('hidden'); return; }
    container.classList.remove('hidden');
    const token = ++mapRenderToken[letter]; // this render's identity
    try { await loadMaps(); } catch (_) { container.classList.add('hidden'); return; }
    if (token !== mapRenderToken[letter]) return; // superseded while Maps loaded
    const g = google.maps;
    const lm = legMap[letter];
    // First render for this leg: create the map instance.
    if (!lm.map) {
      lm.map = new g.Map(container, {
        center: { lat: depot.lat, lng: depot.lng }, zoom: 11,
        mapId: 'DEMO_MAP_ID', // required for AdvancedMarkerElement; harmless otherwise
        mapTypeControl: false, streetViewControl: false, fullscreenControl: true,
        gestureHandling: 'cooperative',
      });
    }
    clearLegOverlays(letter);

    const depotPos = { lat: depot.lat, lng: depot.lng };
    // Ordered stop positions (skip any stop missing coords — should be none).
    const orderedStops = st.order.map((k) => byKey.get(k)).filter((s) => s && typeof s.lat === 'number' && typeof s.lng === 'number');
    const orderedPositions = orderedStops.map((s) => ({ lat: s.lat, lng: s.lng }));

    // Markers: depot (🚜 green), numbered stops (manual = amber), end (🏁).
    makeMarker(letter, depotPos, { label: '🚜', bg: '#047857', title: depot.name + ' — start' });
    orderedStops.forEach((s, i) => {
      const manual = s.kind === 'manual';
      makeMarker(letter, { lat: s.lat, lng: s.lng }, {
        label: String(i + 1),
        bg: manual ? '#d97706' : MAP_COLOR[letter],
        title: `${i + 1}. ${s.name}${manual ? ' (manual stop)' : ''}${s.address ? ' — ' + s.address : ''}`,
      });
    });

    // End target: string address if an open-route end is set, else loop to farm.
    let endTarget = null; // string address OR null (=farm loop)
    if (st.end && st.end.address) endTarget = st.end.address;

    // Fit bounds to depot + all stops (end address geocodes async in Directions;
    // bounds still include it once Directions resolves via extend below).
    const bounds = new g.LatLngBounds();
    bounds.extend(depotPos);
    orderedPositions.forEach((p) => bounds.extend(p));
    if (!bounds.isEmpty()) lm.map.fitBounds(bounds, 48);

    // Road-following polyline (chunked); geodesic fallback on any failure.
    const drawn = await drawDirections(letter, depotPos, orderedPositions, endTarget);
    if (token !== mapRenderToken[letter]) {
      // A newer render started while Directions was in flight — drop this line so
      // we don't paint a stale route over the current one.
      if (drawn && lm.line) { try { lm.line.setMap(null); } catch (_) {} lm.line = null; }
      return;
    }
    if (!drawn) {
      // Geodesic fallback: depot → stops → (depot, since we can't resolve the
      // end address without a geocode; the loop keeps the line meaningful).
      const fallbackPath = [depotPos, ...orderedPositions, depotPos];
      drawFallbackLine(letter, fallbackPath);
    } else if (endTarget) {
      // Directions resolved the end address; extend bounds to the drawn line so
      // the 🏁 destination is on-screen.
      const b2 = new g.LatLngBounds();
      lm.line.getPath().forEach((pt) => b2.extend(pt));
      if (!b2.isEmpty()) lm.map.fitBounds(b2, 48);
      // Place a 🏁 marker at the polyline's last point (the geocoded end).
      const pathArr = lm.line.getPath();
      const last = pathArr.getAt(pathArr.getLength() - 1);
      makeMarker(letter, { lat: last.lat(), lng: last.lng() }, { label: '🏁', bg: '#111827', title: 'Ends: ' + st.end.address });
    }
  }

  // recompute ETAs/total for a route's CURRENT order (from its matrix) + render
  function render(letter) {
    const st = state[letter]; const el = document.getElementById('route-' + letter);
    if (!st || st.order.length === 0) { el.innerHTML = '<p class="text-gray-400 text-sm">No stops on this route.</p>'; return; }
    const idx = {}; st.keys.forEach((k, i) => (idx[k] = i));
    let t = st.startSec, prev = 0, drive = 0; const rows = [];
    for (const k of st.order) {
      const i = idx[k]; const leg = st.matrix[prev][i]; drive += leg; t += leg;
      const s = byKey.get(k); const violated = s.windowEndSec != null && t > s.windowEndSec;
      rows.push({ s, leg, arrival: t, violated }); t += s.serviceSec; prev = i;
    }
    const endCol = st.end ? st.matrix.length - 1 : 0;
    const endLeg = st.matrix[prev][endCol];
    drive += endLeg;
    const endEta = t + endLeg;
    const color = letter === 'A' ? '#059669' : '#4f46e5';
    const li = rows.map((r, i) => `
      <li draggable="true" data-key="${r.s.key}" class="route-row flex items-center gap-2 py-2 ${r.violated?'bg-red-50':''}" style="cursor:grab">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white" style="background:${color}">${i+1}</span>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium text-gray-900 truncate">${r.s.kind==='manual'?'<span class="mr-1 rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold uppercase text-amber-800">Manual</span>':''}${escapeHtml(r.s.name)}</div>
          ${r.s.address?`<div class="text-xs text-gray-500 truncate">📍 ${escapeHtml(r.s.address)}</div>`:''}
          <div class="text-xs text-gray-400">~${fmtClock(r.arrival)} · +${mins(r.leg)}m drive${r.s.detail?' · '+escapeHtml(r.s.detail):''}${r.violated?' · ⚠️ AFTER CUTOFF':''}</div>
        </div>
        <div class="flex shrink-0 flex-col">
          <button data-mv="up" class="px-1 text-gray-400 hover:text-gray-700 leading-none">▲</button>
          <button data-mv="dn" class="px-1 text-gray-400 hover:text-gray-700 leading-none">▼</button>
        </div>
      </li>`).join('');
    el.innerHTML = `
      <div class="mb-2 rounded-ts-md px-3 py-2 text-sm" style="background:${color}1a;color:${color}">
        <strong>${mins(drive)} min drive</strong> (${(drive/3600).toFixed(1)} hr) · ${st.order.length} stops
      </div>
      <ol class="mb-2 divide-y divide-gray-100">
        <li class="py-1 text-xs font-semibold uppercase tracking-wide text-gray-400">START · Farm</li>
        ${li}
        ${st.end
          ? `<li class="py-2 text-xs font-semibold uppercase tracking-wide" style="color:${color}">🏁 ENDS · ${escapeHtml(st.end.address)} · ~${fmtClock(endEta)} (+${mins(endLeg)}m)</li>`
          : '<li class="py-1 text-xs font-semibold uppercase tracking-wide text-gray-400">RETURN · Farm</li>'}
      </ol>
      <p class="mb-2 text-[11px] text-gray-400">Drag rows or use ▲▼ to reorder — ETAs update live.</p>
      <a href="${mapsUrl(st.order.map((k)=>byKey.get(k)))}" target="_blank" rel="noopener" class="mb-2 inline-flex h-11 w-full items-center justify-center rounded-ts-md bg-blue-600 px-4 text-base font-semibold text-white hover:bg-blue-700">🗺️ Open Route ${letter} in Google Maps</a>
      <button data-save="${letter}" class="inline-flex h-11 w-full items-center justify-center rounded-ts-md border border-gray-300 bg-white px-4 text-sm font-semibold text-gray-700 hover:border-gray-400 hover:bg-gray-50" title="Optimizing already saved this route — use this only to re-save after a manual reorder">💾 Re-save (after manual reorder)</button>
      <div data-saveresult="${letter}" class="mt-2 text-sm"></div>`;
    wireReorder(letter);
    el.querySelector(`[data-save="${letter}"]`)?.addEventListener('click', () => saveRoute(letter));
    renderMap(letter); // draw / redraw the route map for this leg (additive; safe if Maps not yet loaded)
  }

  function wireReorder(letter) {
    const el = document.getElementById('route-' + letter);
    const st = state[letter];
    el.querySelectorAll('[data-mv]').forEach((btn) => btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.closest('.route-row').getAttribute('data-key');
      const i = st.order.indexOf(key); const dir = btn.getAttribute('data-mv') === 'up' ? -1 : 1; const j = i + dir;
      if (j < 0 || j >= st.order.length) return;
      [st.order[i], st.order[j]] = [st.order[j], st.order[i]]; render(letter);
    }));
    let dragKey = null;
    el.querySelectorAll('.route-row').forEach((row) => {
      row.addEventListener('dragstart', () => { dragKey = row.getAttribute('data-key'); row.style.opacity = '0.4'; });
      row.addEventListener('dragend', () => { row.style.opacity = '1'; });
      row.addEventListener('dragover', (e) => e.preventDefault());
      row.addEventListener('drop', (e) => {
        e.preventDefault();
        const overKey = row.getAttribute('data-key'); if (!dragKey || dragKey === overKey) return;
        const from = st.order.indexOf(dragKey); const to = st.order.indexOf(overKey);
        st.order.splice(from, 1); st.order.splice(to, 0, dragKey); render(letter);
      });
    });
  }

  async function saveRoute(letter) {
    const st = state[letter];
    const out = document.querySelector(`[data-saveresult="${letter}"]`);
    if (!st || !st.order.length) { out.innerHTML = '<span class="text-red-600">Nothing to save.</span>'; return; }
    const idx = {}; st.keys.forEach((k, i) => (idx[k] = i));
    let t = st.startSec, prev = 0; const stops = []; let missing = 0;
    for (const k of st.order) {
      const i = idx[k]; t += st.matrix[prev][i]; const s = byKey.get(k);
      if (!s.ref) { missing++; }
      else { const hh = Math.floor(t / 3600) % 24, mm = Math.floor((t % 3600) / 60); stops.push({ ref: s.ref, scheduledTime: `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}:00` }); }
      t += s.serviceSec; prev = i;
    }
    if (!stops.length) { out.innerHTML = '<span class="text-red-600">No saveable stops on this route.</span>'; return; }
    out.innerHTML = '<span class="text-gray-500">Saving…</span>';
    try {
      const res = await fetch('/api/admin/route/save-optimized', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ route_date: routeDate, leg: letter, stops }) });
      const d = await res.json();
      if (!res.ok || d.error) { out.innerHTML = `<span class="text-red-600">Save failed: ${escapeHtml(d.detail || d.error || res.status)}</span>`; return; }
      const link = location.origin + d.url;
      out.innerHTML = `<div class="rounded bg-green-50 px-3 py-2 text-green-800"><strong>✅ Route ${letter} saved · ${d.stops} stop${d.stops === 1 ? '' : 's'}</strong>${missing ? ` · ${missing} skipped (no link)` : ''}. Labels + pack sheets now follow this load order. The driver link auto-updates when you re-optimize.<br><a href="${d.url}" target="_blank" class="font-semibold underline">Open driver view →</a> <button data-copy="${link}" class="ml-2 rounded border bg-white px-2 py-0.5 text-xs">Copy link</button></div>`;
      out.querySelector('[data-copy]')?.addEventListener('click', (e) => { navigator.clipboard?.writeText(e.target.getAttribute('data-copy')); e.target.textContent = 'Copied!'; });
    } catch (e) { out.innerHTML = `<span class="text-red-600">Error: ${escapeHtml(e?.message || e)}</span>`; }
  }

  async function optimizeRoute(letter, stops, startSec) {
    const el = document.getElementById('route-' + letter);
    if (stops.length === 0) { state[letter] = null; el.innerHTML = '<p class="text-gray-400 text-sm">No stops on this route.</p>'; return; }
    el.innerHTML = '<p class="text-gray-500 text-sm">Optimizing…</p>';
    const endInput = document.getElementById('end-addr-' + letter);
    const endAddress = endInput ? endInput.value.trim() : '';
    const res = await fetch('/api/admin/optimize-route', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ stops, startSec, leg: letter, end_address: endAddress }) });
    const d = await res.json();
    if (!res.ok || d.error) { el.innerHTML = `<p class="text-red-600 text-sm">Couldn't optimize: ${escapeHtml(d.detail || d.error || res.status)}</p>`; return; }
    state[letter] = { order: d.stops.map((s) => s.key), matrix: d.matrix, keys: d.keys, startSec, end: d.end || null };
    render(letter);
    // Warnings can embed a stop's name (home deliveries carry the member's
    // Shopify contact_name) — escape each line, keep the <br> joiner literal.
    if (d.warnings && d.warnings.length) el.insertAdjacentHTML('afterbegin', `<div class="mb-2 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">${d.warnings.map(escapeHtml).join('<br>')}</div>`);
  }

  // OPTIMIZE AUTO-SAVES (Todd 2026-07): optimizing immediately SAVES each leg to
  // the driver route (the same atomic per-leg save-optimized POST the manual
  // button uses), so labels + pack sheets + pack check pick up the new load order
  // right away. Re-optimizing overwrites (that leg's route is deleted+replaced).
  // Each leg saves independently — one leg failing never blocks the other.
  document.getElementById('optimize-btn')?.addEventListener('click', async () => {
    const [hh, mm] = (document.getElementById('start-time').value || '09:00').split(':').map(Number);
    const startSec = (hh || 9) * 3600 + (mm || 0) * 60;
    const A = allStops.filter((s) => assign.get(s.key) === 'A');
    const B = allStops.filter((s) => assign.get(s.key) === 'B');
    const btn = document.getElementById('optimize-btn'); btn.disabled = true; btn.textContent = '⏳ Optimizing + saving…';
    try {
      await Promise.all([
        optimizeRoute('A', A, startSec).then(() => (state.A && state.A.order.length ? saveRoute('A') : undefined)),
        optimizeRoute('B', B, startSec).then(() => (state.B && state.B.order.length ? saveRoute('B') : undefined)),
      ]);
    } finally { btn.disabled = false; btn.textContent = '🧭 Re-optimize + save'; }
  });

  // Two-tap confirm on every "Remove from route…" form: first tap ARMS the
  // button (visual change + explicit text), second tap within 4s submits.
  // Prevents the silent one-tap removals that lost a member from the route
  // on 2026-07-07. Disarms automatically so a stray tap can't linger.
  document.querySelectorAll('form[data-remove-stop]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      const btn = form.querySelector('button[type="submit"]');
      if (!btn) return;
      if (btn.dataset.armed !== 'true') {
        e.preventDefault();
        btn.dataset.armed = 'true';
        btn.textContent = 'Tap again to remove';
        setTimeout(() => {
          btn.dataset.armed = 'false';
          btn.textContent = 'Remove from route…';
        }, 4000);
      }
    });
  });

  // ─── ➕ Add / ✕ remove an ad-hoc MANUAL stop for this delivery date ──
  // POST /api/admin/route-manual-stops geocodes + inserts; DELETE soft-deletes.
  // On success we RELOAD so the page re-gathers the stop set (the new stop
  // appears in the assign list keyed 'manual:<id>' on its chosen leg) and Todd
  // re-optimizes. Reload is simplest + matches how the routable toggle works.
  const addBtn = document.getElementById('ms-add-btn');
  const addResult = document.getElementById('ms-add-result');
  function setAddResult(html, cls) {
    if (!addResult) return;
    addResult.className = 'text-sm ' + (cls || '');
    addResult.innerHTML = html;
  }
  if (addBtn) {
    addBtn.addEventListener('click', async () => {
      const name = (document.getElementById('ms-name')?.value || '').trim();
      const address = (document.getElementById('ms-address')?.value || '').trim();
      const note = (document.getElementById('ms-note')?.value || '').trim();
      const leg = document.getElementById('ms-leg')?.value === 'B' ? 'B' : 'A';
      if (!name) { setAddResult('Enter a stop name.', 'text-red-600'); return; }
      if (!address) { setAddResult('Enter an address.', 'text-red-600'); return; }
      addBtn.disabled = true; setAddResult('Adding + geocoding…', 'text-gray-500');
      try {
        const res = await fetch('/api/admin/route-manual-stops', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ route_date: routeDate, leg, name, address, note }),
        });
        const d = await res.json();
        if (!res.ok || d.error) {
          setAddResult('Failed: ' + escapeHtml(d.detail || d.error || res.status), 'text-red-600');
          addBtn.disabled = false; return;
        }
        setAddResult(d.geocoded ? '✅ Added — reloading…' : '⚠️ Added but didn’t geocode — check the address. Reloading…', d.geocoded ? 'text-green-700' : 'text-amber-700');
        setTimeout(() => window.location.reload(), 500);
      } catch (e) {
        setAddResult('Error: ' + escapeHtml(e?.message || e), 'text-red-600');
        addBtn.disabled = false;
      }
    });
  }

  document.querySelectorAll('[data-manual-remove]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-manual-remove');
      if (!id) return;
      btn.disabled = true; btn.textContent = '…';
      try {
        const res = await fetch('/api/admin/route-manual-stops', {
          method: 'DELETE', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        const d = await res.json();
        if (!res.ok || d.error) { btn.disabled = false; btn.textContent = '✕'; alert('Remove failed: ' + (d.detail || d.error || res.status)); return; }
        window.location.reload();
      } catch (e) { btn.disabled = false; btn.textContent = '✕'; alert('Remove error.'); }
    });
  });
</script>
