---
/**
 * /admin/wholesale/labels — printable WHOLESALE labels. TWO modes:
 *
 *   • mode=order (DEFAULT) — CRATE labels on Avery 5164.
 *     Same label stock + layout as the CSA box labels (/admin/labels) so the
 *     crew prints both on the identical sheet: US Letter portrait, 6 labels per
 *     sheet (2 cols × 3 rows), each 4" × 3.33", side margin 0.156", top margin
 *     0.5", col-gap 0.188" (Avery 5164 spec, verified on the CSA page).
 *     One label per restaurant order for a delivery date. Each label shows:
 *       - Tiny Seed Farm logo + USDA Organic seal (header)
 *       - Restaurant NAME (big) on a green band + delivery date
 *       - Restaurant PHONE (so the driver can call on arrival)
 *       - The item list (qty × product) the crew packs into that crate
 *
 *   • mode=item — per-ITEM labels on Avery 8163.
 *     One label per individual wholesale_order_item, 10 per sheet (2 cols × 5
 *     rows), each 4" wide × 2" high. US Letter portrait, top margin 0.5",
 *     left/right margin 0.156", column gap 0.1875", row gap 0 (vertical pitch
 *     2"). Sorted grouped by restaurant name then product name, so when the
 *     sheet is split each restaurant's item labels stay together. Each label:
 *       - Restaurant NAME on the green band + delivery date
 *       - "{qty}× {product_name} ({unit})" big and prominent (ONE per line item)
 *       - Tiny Seed Farm footer line
 *
 * Both modes reuse the SAME fetched data (orders, acctById, items) — the item
 * mode just flattens it differently. Service-role reads (middleware admin-gated).
 * Defaults to the CURRENT delivery week's Wednesday so on delivery day it shows
 * today's crates, not next week's.
 */
import AdminShell from '../../../../components/AdminShell.astro';
import Card from '../../../../components/Card.astro';
import { supabaseAdmin } from '../../../../lib/supabase';
import { currentDeliveryWednesday, prettyDeliveryDate, isYMD } from '../../../../lib/wholesale-order';
import { formatUSPhone } from '../../../../lib/phone';
import { getLoadOrder } from '../../../../lib/load-order';
import { mondayOfWeek } from '../../../../lib/cycle';

export const prerender = false;

const LOGO_SRC = '/tiny-seed-logo-bw.png';
const USDA_SRC = '/usda-organic-seal.svg';

const url = Astro.url;
const dateParam = url.searchParams.get('date') ?? '';
const deliveryDate = isYMD(dateParam) ? dateParam : currentDeliveryWednesday();

// Mode: 'order' (default = per-order crate labels, Avery 5164) or 'item'
// (per-individual-item labels, Avery 8163). Anything but 'item' falls back to
// 'order' so a typo never produces a blank page.
const modeParam = url.searchParams.get('mode') ?? '';
const mode: 'order' | 'item' = modeParam === 'item' ? 'item' : 'order';
/** Carry the current mode through date links (omit when default). */
const modeQS = mode === 'item' ? '&mode=item' : '';

const { data: orderRows } = await supabaseAdmin
  .from('wholesale_orders')
  .select('id, account_id')
  .eq('delivery_date', deliveryDate)
  .order('created_at', { ascending: true });
const orders = (orderRows ?? []) as Array<{ id: string; account_id: string | null }>;

// Account name + phone for the crate header.
const acctIds = Array.from(new Set(orders.map((o) => o.account_id).filter(Boolean))) as string[];
const acctById = new Map<string, { restaurant_name: string; phone: string | null; customer_id: string | null }>();
if (acctIds.length) {
  const { data: accts } = await supabaseAdmin
    .from('wholesale_accounts')
    .select('id, restaurant_name, phone, customer_id')
    .in('id', acctIds);
  for (const a of accts ?? []) acctById.set((a as any).id, { restaurant_name: (a as any).restaurant_name, phone: (a as any).phone, customer_id: (a as any).customer_id ?? null });
}

// ─── TRUCK LOAD NUMBER (Todd 2026-07) ────────────────────────────────
// Wholesale crate labels are printed on Mondays; the crew needs to know WHERE
// each crate goes on the truck. The week's saved optimized route numbers every
// stop in load order (incl. wholesale) — so we stamp "TRUCK #n" on a crate when
// the route includes that restaurant's stop. A wholesale route stop is keyed by
// the restaurant's linked customers.id (wholesale_accounts.customer_id). Null
// route → no number (fail-soft). The delivery date's Monday is the route week.
const loadOrder = await getLoadOrder(supabaseAdmin, mondayOfWeek(deliveryDate));
/** TRUCK load number for a wholesale account (via its linked customer), or null. */
function truckNoForAccount(accountId: string | null): number | null {
  if (!loadOrder || !accountId) return null;
  const cid = acctById.get(accountId)?.customer_id ?? null;
  if (!cid) return null;
  return loadOrder.wholesaleCustomer(cid)?.loadSeq ?? null;
}

const orderIds = orders.map((o) => o.id);
type Item = { order_id: string; product_name: string | null; qty: number | null; product: { unit: string | null } | null };
let items: Item[] = [];
if (orderIds.length) {
  const { data: r } = await supabaseAdmin
    .from('wholesale_order_items')
    .select('order_id, product_name, qty, product:wholesale_products ( unit )')
    .in('order_id', orderIds);
  items = (r ?? []) as Item[];
}
const itemsByOrder = new Map<string, Item[]>();
for (const it of items) { const a = itemsByOrder.get(it.order_id) ?? []; a.push(it); itemsByOrder.set(it.order_id, a); }

// Date picker options (every date that has orders, current first).
const { data: dateRows } = await supabaseAdmin.from('wholesale_orders').select('delivery_date').order('delivery_date', { ascending: false });
const dates = Array.from(new Set([deliveryDate, ...((dateRows ?? []).map((r: any) => r.delivery_date as string))])).filter(Boolean).sort().reverse();

interface WLabel { name: string; phone: string | null; truckNo: number | null; items: Array<{ qty: number | null; name: string | null; unit: string | null }>; }
const labels: WLabel[] = orders
  .map((o) => {
    const acct = o.account_id ? acctById.get(o.account_id) : undefined;
    return {
      name: acct?.restaurant_name ?? '(no account)',
      phone: acct?.phone ?? null,
      truckNo: truckNoForAccount(o.account_id),
      items: (itemsByOrder.get(o.id) ?? []).map((it) => ({ qty: it.qty, name: it.product_name, unit: it.product?.unit ?? null })),
    };
  })
  .filter((l) => l.items.length)
  .sort((a, b) => a.name.localeCompare(b.name));

// Pad to whole sheets of 6 so each Avery sheet stays aligned.
const totalSheets = Math.max(1, Math.ceil(labels.length / 6));
const padded: (WLabel | null)[] = [...labels];
while (padded.length < totalSheets * 6) padded.push(null);

const pretty = prettyDeliveryDate(deliveryDate);

// ── Item-label mode (Avery 8163, 10-up) ──────────────────────────────────
// Flatten the SAME data into one label per individual wholesale_order_item.
// Grouped by restaurant name (so an order's items stay contiguous) then by
// product name. Pad to whole sheets of 10 so each Avery 8163 sheet aligns.
interface ILabel { name: string; truckNo: number | null; qty: number | null; product: string | null; unit: string | null; }
const itemLabels: ILabel[] = orders
  .flatMap((o) => {
    const acct = o.account_id ? acctById.get(o.account_id) : undefined;
    const name = acct?.restaurant_name ?? '(no account)';
    const truckNo = truckNoForAccount(o.account_id);
    return (itemsByOrder.get(o.id) ?? []).map((it) => ({
      name,
      truckNo,
      qty: it.qty,
      product: it.product_name,
      unit: it.product?.unit ?? null,
    }));
  })
  .sort((a, b) => {
    const byName = a.name.localeCompare(b.name);
    if (byName !== 0) return byName;
    return (a.product ?? '').localeCompare(b.product ?? '');
  });

const ITEMS_PER_SHEET = 10;
const itemSheets = Math.max(1, Math.ceil(itemLabels.length / ITEMS_PER_SHEET));
const paddedItems: (ILabel | null)[] = [...itemLabels];
while (paddedItems.length < itemSheets * ITEMS_PER_SHEET) paddedItems.push(null);

// Active-mode-aware header text.
const subtitle =
  mode === 'item'
    ? `Avery 8163 · Delivery ${pretty} · ${itemLabels.length} item label${itemLabels.length === 1 ? '' : 's'} (${itemSheets} sheet${itemSheets === 1 ? '' : 's'})`
    : `Avery 5164 · Delivery ${pretty} · ${labels.length} label${labels.length === 1 ? '' : 's'} (${totalSheets} sheet${totalSheets === 1 ? '' : 's'})`;
---

<AdminShell
  title={mode === 'item' ? 'Wholesale — Item labels' : 'Wholesale — Crate labels'}
  subtitle={subtitle}
  pageTitle="Wholesale labels — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <button type="button" onclick="window.print()" class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark">🖨 Print {mode === 'item' ? 'item labels' : 'crate labels'}</button>
    <a href="/admin/wholesale" class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary">← Wholesale hub</a>
  </Fragment>

  <Card padding="md" elevation="sm" class="mb-4 no-print">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-sm font-medium text-gray-500">Label type:</span>
      <a
        href={`/admin/wholesale/labels?date=${deliveryDate}`}
        class={`rounded-full px-3 py-1 text-sm font-medium ${mode === 'order' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}
        aria-current={mode === 'order' ? 'true' : undefined}
      >Crate labels (per order · 6-up)</a>
      <a
        href={`/admin/wholesale/labels?date=${deliveryDate}&mode=item`}
        class={`rounded-full px-3 py-1 text-sm font-medium ${mode === 'item' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}
        aria-current={mode === 'item' ? 'true' : undefined}
      >Item labels (per item · 10-up · Avery 8163)</a>
    </div>
  </Card>

  {dates.length > 1 && (
    <Card padding="md" elevation="sm" class="mb-4 no-print">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-medium text-gray-500">Delivery date:</span>
        {dates.map((d) => (
          <a href={`/admin/wholesale/labels?date=${d}${modeQS}`} class={`rounded-full px-3 py-1 text-sm font-medium ${d === deliveryDate ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}>{prettyDeliveryDate(d)}</a>
        ))}
      </div>
    </Card>
  )}

  {mode === 'item' ? (
    itemLabels.length === 0 ? (
      <Card padding="lg" elevation="sm"><p class="text-sm text-gray-500">No wholesale items for {pretty}.</p></Card>
    ) : (
      <Fragment>
        <p class="screen-only mb-3 text-xs text-ts-text-muted">Avery 8163 — print at <em>100% scale</em> on a blank Avery 8163 sheet (10 labels per page).</p>
        <div class="label-doc is-8163">
          {Array.from({ length: itemSheets }, (_, sheetIdx) => {
            const slice = paddedItems.slice(sheetIdx * ITEMS_PER_SHEET, sheetIdx * ITEMS_PER_SHEET + ITEMS_PER_SHEET);
            return (
              <section class="item-label-sheet" aria-label={`Sheet ${sheetIdx + 1} of ${itemSheets}`}>
                {slice.map((l) => (
                  <div class="item-label">
                    {l ? (
                      <div class="item-label-body">
                        <div class="item-label-name-band">
                          <span class="label-name-left">
                            {l.truckNo != null && <span class="label-truck-badge">🚚 #{l.truckNo}</span>}
                            <span class="item-label-name">{l.name}</span>
                          </span>
                          <span class="item-label-date">{pretty}</span>
                        </div>
                        <div class="item-label-product">
                          <b>{l.qty}×</b> {l.product}{l.unit ? <span class="item-label-unit"> ({l.unit})</span> : null}
                        </div>
                        <div class="label-foot">Tiny Seed Farm · 257 Zeigler Rd, Rochester PA · Certified Organic</div>
                      </div>
                    ) : (
                      <div class="label-blank"></div>
                    )}
                  </div>
                ))}
              </section>
            );
          })}
        </div>
      </Fragment>
    )
  ) : labels.length === 0 ? (
    <Card padding="lg" elevation="sm"><p class="text-sm text-gray-500">No wholesale orders for {pretty}.</p></Card>
  ) : (
    <Fragment>
      <p class="screen-only mb-3 text-xs text-ts-text-muted">Avery 5164 — print at <em>100% scale</em> on a blank Avery 5164 sheet (6 labels per page).</p>
      <div class="label-doc">
        {Array.from({ length: totalSheets }, (_, sheetIdx) => {
          const slice = padded.slice(sheetIdx * 6, sheetIdx * 6 + 6);
          return (
            <section class="label-sheet" aria-label={`Sheet ${sheetIdx + 1} of ${totalSheets}`}>
              {slice.map((l) => (
                <div class="label">
                  {l ? (
                    <div class="label-body">
                      <div class="label-hdr">
                        <img class="label-logo" src={LOGO_SRC} alt="" aria-hidden="true" width="630" height="840" />
                        <span class="label-wholesale-mark">WHOLESALE</span>
                        <img class="label-seal" src={USDA_SRC} alt="USDA Organic" width="600" height="620" />
                      </div>
                      <div class="label-name-band">
                        <span class="label-name-left">
                          {l.truckNo != null && <span class="label-truck-badge">🚚 TRUCK #{l.truckNo}</span>}
                          <span class="label-name">{l.name}</span>
                        </span>
                        <span class="label-date">{pretty}</span>
                      </div>
                      {l.phone && <div class="label-phone">📞 {formatUSPhone(l.phone)}</div>}
                      <ul class={`label-items${l.items.length >= 6 ? ' is-two-col' : ''}`}>
                        {l.items.map((it) => (
                          <li class="label-item"><b>{it.qty}×</b> {it.name}{it.unit ? <span class="label-item-unit"> ({it.unit})</span> : null}</li>
                        ))}
                      </ul>
                      <div class="label-foot">Tiny Seed Farm · 257 Zeigler Rd, Rochester PA · Certified Organic</div>
                    </div>
                  ) : (
                    <div class="label-blank"></div>
                  )}
                </div>
              ))}
            </section>
          );
        })}
      </div>
    </Fragment>
  )}
</AdminShell>

<style is:global>
  .label-logo, .label-seal, .label-name-band { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

  .label-doc {
    --label-w: 4in;
    --label-h: 3.33in;
    --sheet-w: 8.5in;
    --sheet-h: 11in;
    --margin-top: 0.5in;
    --margin-side: 0.156in;
    --col-gap: 0.188in;
  }
  .label-sheet {
    box-sizing: border-box;
    width: var(--sheet-w);
    height: var(--sheet-h);
    margin: 0 auto 0.25in;
    padding: var(--margin-top) var(--margin-side) 0;
    display: grid;
    grid-template-columns: var(--label-w) var(--label-w);
    grid-template-rows: repeat(3, var(--label-h));
    column-gap: var(--col-gap);
    background: #fff;
  }
  .label {
    box-sizing: border-box;
    width: var(--label-w);
    height: var(--label-h);
    padding: 0.14in;
    border: 1px dashed #d8d8d8;
    overflow: hidden;
  }
  @media print { .label { border: none; } }
  .label-blank { width: 100%; height: 100%; }
  .label-body { display: flex; flex-direction: column; height: 100%; overflow: hidden; }

  .label-hdr { display: flex; align-items: center; justify-content: space-between; gap: 0.08in; }
  .label-logo { height: 0.5in; width: auto; }
  .label-seal { height: 0.62in; width: auto; }
  .label-wholesale-mark { font-size: 8pt; font-weight: 800; letter-spacing: 0.14em; color: #2d6a4f; }

  .label-name-band {
    margin-top: 0.06in;
    background: #1b4332; color: #fff;
    border-radius: 5px;
    padding: 0.05in 0.1in;
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.1in;
  }
  .label-name-left { display: flex; align-items: baseline; gap: 0.07in; min-width: 0; overflow: hidden; }
  .label-name { font-size: 18pt; font-weight: 800; line-height: 1.05; overflow: hidden; text-overflow: ellipsis; }
  .label-date { font-size: 10pt; font-weight: 700; white-space: nowrap; }

  /* 🚚 TRUCK LOAD NUMBER — white pill on the green name band so the crew can
     place a Monday-printed crate at its truck position. Fixed colors (print);
     never shrinks (the restaurant name ellipsis-clips first). */
  .label-truck-badge {
    flex-shrink: 0;
    background: #ffffff;
    color: #0f172a;
    border-radius: 4px;
    padding: 0 0.06in;
    font-size: 10pt;
    font-weight: 800;
    line-height: 1.3;
    white-space: nowrap;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .label-phone { margin-top: 0.05in; font-size: 12pt; font-weight: 700; color: #111827; }

  .label-items {
    list-style: none; margin: 0.06in 0 0; padding: 0;
    font-size: 10.5pt; color: #1b1b1b; line-height: 1.25;
    overflow: hidden; flex: 1 1 auto;
  }
  .label-items.is-two-col { columns: 2; column-gap: 0.16in; font-size: 9.5pt; }
  .label-item { break-inside: avoid; padding: 1px 0; }
  .label-item b { font-weight: 800; }
  .label-item-unit { color: #555; font-weight: 600; }

  .label-foot { font-size: 6.5pt; color: #6b7280; letter-spacing: 0.02em; padding-top: 0.03in; }

  /* ── Avery 8163 per-item labels (10-up, 4" × 2") ─────────────────────── */
  .item-label-name-band { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

  .label-doc.is-8163 {
    --item-label-w: 4in;
    --item-label-h: 2in;
    --sheet-w: 8.5in;
    --sheet-h: 11in;
    --item-margin-top: 0.5in;
    --item-margin-side: 0.156in;
    --item-col-gap: 0.1875in;
  }
  .item-label-sheet {
    box-sizing: border-box;
    width: var(--sheet-w);
    height: var(--sheet-h);
    margin: 0 auto 0.25in;
    padding: var(--item-margin-top) var(--item-margin-side) 0;
    display: grid;
    grid-template-columns: var(--item-label-w) var(--item-label-w);
    grid-template-rows: repeat(5, var(--item-label-h));
    column-gap: var(--item-col-gap);
    row-gap: 0;
    background: #fff;
  }
  .item-label {
    box-sizing: border-box;
    width: var(--item-label-w);
    height: var(--item-label-h);
    padding: 0.12in;
    border: 1px dashed #d8d8d8;
    overflow: hidden;
  }
  @media print { .item-label { border: none; } }
  .item-label-body { display: flex; flex-direction: column; height: 100%; overflow: hidden; }

  .item-label-name-band {
    background: #1b4332; color: #fff;
    border-radius: 5px;
    padding: 0.05in 0.1in;
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.1in;
  }
  .item-label-name { font-size: 14pt; font-weight: 800; line-height: 1.05; }
  .item-label-date { font-size: 9pt; font-weight: 700; white-space: nowrap; }

  .item-label-product {
    flex: 1 1 auto;
    display: flex; align-items: center;
    margin-top: 0.05in;
    font-size: 18pt; font-weight: 700; line-height: 1.1; color: #111827;
    overflow: hidden;
  }
  .item-label-product b { font-weight: 800; }
  .item-label-unit { color: #555; font-weight: 600; font-size: 13pt; }

  @media print {
    @page { size: Letter portrait; margin: 0; }
    body, html { background: #fff !important; }
    .no-print, .screen-only { display: none !important; }
    .label-sheet { margin: 0 auto; page-break-after: always; }
    .label-sheet:last-child { page-break-after: auto; }
    .item-label-sheet { margin: 0 auto; page-break-after: always; }
    .item-label-sheet:last-child { page-break-after: auto; }
  }
</style>
