---
/**
 * /admin/wholesale/orders — Chef wholesale orders + engagement.
 *
 * WHY (Todd 2026-06-23): chef orders previously landed only in the
 * tinyseedorders@ inbox + the DB — there was no screen to see "who ordered,
 * what, how much" or "which chefs even opened their portal". This view answers
 * both, scoped to a delivery date:
 *
 *   - ORDERS for the date: each restaurant's items, qty, line totals, order
 *     total, status, and when it came in. Feeds the harvest list's wholesale
 *     section, so this is the source of truth Todd eyeballs before pack day.
 *   - ENGAGEMENT funnel across ALL chef accounts we emailed links to:
 *     Emailed (everyone with a token) → Visited (opened /order/<token>) →
 *     Ordered. Visit data accrues from when 0056 shipped (no retro data);
 *     order data is fully accurate all-time.
 *
 * Reads are service-role (page is middleware-guarded to admin/staff). No
 * writes here — purely a read/observe screen.
 */
import AdminShell from '../../../../components/AdminShell.astro';
import Card from '../../../../components/Card.astro';
import Badge from '../../../../components/Badge.astro';
import { supabaseAdmin } from '../../../../lib/supabase';
import { mondayOfWeek as _mow } from '../../../../lib/cycle';
import {
  formatCents, currentDeliveryWednesday, prettyDeliveryDate, isYMD, CUTOFF_LABEL, addDaysYMD,
} from '../../../../lib/wholesale-order';

export const prerender = false;

const url = Astro.url;
const SITE_ORIGIN = url.origin;

// ─── Which delivery date are we looking at? ─────────────────────────
// Default to the CURRENT delivery week's Wednesday (Mon–Sun), NOT
// nextDeliveryWednesday — that rolled to next week after the Tue cutoff, so on
// delivery day this screen showed an empty next-week date and chefs who DID
// order looked like they hadn't (Todd 2026-06-24).
const dateParam = url.searchParams.get('date') ?? '';
const deliveryDate = isYMD(dateParam) ? dateParam : currentDeliveryWednesday();

// ─── All chef accounts we've emailed links to (token = emailed) ─────
type AccountRow = {
  id: string;
  restaurant_name: string;
  contact_name: string | null;
  email: string | null;
  status: string | null;
  portal_visit_count: number | null;
  first_portal_visit_at: string | null;
  last_portal_visit_at: string | null;
  order_token: string | null;
};
const { data: accountsData } = await supabaseAdmin
  .from('wholesale_accounts')
  .select('id, restaurant_name, contact_name, email, status, portal_visit_count, first_portal_visit_at, last_portal_visit_at, order_token')
  .order('restaurant_name', { ascending: true });
const accounts = (accountsData ?? []) as AccountRow[];

// ─── Orders for this delivery date ──────────────────────────────────
type OrderRow = {
  id: string;
  account_id: string | null;
  status: string | null;
  total_amount: number | null;
  total_lbs: number | null;
  notes: string | null;
  source: string | null;
  created_at: string;
};
const { data: ordersData } = await supabaseAdmin
  .from('wholesale_orders')
  .select('id, account_id, status, total_amount, total_lbs, notes, source, created_at')
  .eq('delivery_date', deliveryDate)
  .order('created_at', { ascending: true });
const orders = (ordersData ?? []) as OrderRow[];

// ─── Line items for those orders ────────────────────────────────────
type ItemRow = {
  order_id: string;
  product_id: string | null;
  product_name: string | null;
  /** Unit frozen at write time (migration 20260831083400). Prefer this over
   *  anything derived from the mutable catalog. */
  unit: string | null;
  qty: number | null;
  unit_price_cents: number | null;
  line_total_cents: number | null;
};
const orderIds = orders.map((o) => o.id);
let items: ItemRow[] = [];
if (orderIds.length) {
  const { data: itemsData } = await supabaseAdmin
    .from('wholesale_order_items')
    .select('order_id, product_id, product_name, unit, qty, unit_price_cents, line_total_cents')
    .in('order_id', orderIds);
  items = (itemsData ?? []) as ItemRow[];
}
const itemsByOrder = new Map<string, ItemRow[]>();
for (const it of items) {
  const arr = itemsByOrder.get(it.order_id) ?? [];
  arr.push(it);
  itemsByOrder.set(it.order_id, arr);
}

// ─── THIS-WEEK strip (Todd 2026-07-27: the Tuesday PASS order was "not
// there" — the page defaults to Wednesday and silently hides every other
// delivery day. Now the top of the page lists EVERY delivery date in the
// current cycle week with order counts + totals, one tap to switch.) ──────
const weekMon = _mow(deliveryDate);
type WeekRow = { delivery_date: string; total_amount: number | null; status: string };
const { data: weekRows } = await supabaseAdmin
  .from('wholesale_orders')
  .select('delivery_date, total_amount, status')
  .gte('delivery_date', weekMon)
  .lte('delivery_date', addDaysYMD(weekMon, 6))
  .not('status', 'in', '("cancelled","draft")')
  .overrideTypes<WeekRow[], { merge: false }>();
const weekByDate = new Map<string, { n: number; total: number }>();
for (const r of weekRows ?? []) {
  const e = weekByDate.get(r.delivery_date) ?? { n: 0, total: 0 };
  e.n += 1; e.total += Number(r.total_amount ?? 0);
  weekByDate.set(r.delivery_date, e);
}
const weekStrip = Array.from(weekByDate.entries())
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([d, v]) => ({ date: d, ...v }));

// ─── Distinct delivery dates (for the date picker) ──────────────────
const { data: dateRows } = await supabaseAdmin
  .from('wholesale_orders')
  .select('delivery_date')
  .order('delivery_date', { ascending: false });
const deliveryDates = Array.from(
  new Set([deliveryDate, ...((dateRows ?? []).map((r: any) => r.delivery_date as string))]),
).filter(Boolean).sort().reverse();

// ─── Units ──────────────────────────────────────────────────────────
// wholesale_order_items has NO unit column — the unit lives only on
// wholesale_products. This page used to print "{qty}× {name}" and a hardcoded
// "ea", so 15 lb of eggplant read as "15× Asian Eggplant  $4.25 ea", which is
// not what was sold. A chef or a packer reading that reasonably thinks fifteen
// eggplants (Todd 2026-08-31).
//
// We resolve by product_id where present and fall back to matching the product
// NAME, because 260 of 527 line items carry a NULL product_id (hand-keyed and
// imported orders). Where neither resolves we print no unit at all rather than
// guess — a blank is honest, "ea" is a claim.
const { data: unitRows } = await supabaseAdmin
  .from('wholesale_products')
  .select('id, name, unit');
const unitById = new Map<string, string>();
const unitByName = new Map<string, string>();
for (const p of (unitRows ?? []) as Array<{ id: string; name: string; unit: string | null }>) {
  if (p.unit) {
    unitById.set(p.id, p.unit);
    unitByName.set(p.name.trim().toLowerCase(), p.unit);
  }
}
/** Unit for a line item, or '' when we genuinely cannot tell.
 *  The STORED unit wins — it records what was actually sold. The catalog
 *  lookups below only cover historical rows written before the column existed. */
function unitFor(it: ItemRow): string {
  if (it.unit && it.unit.trim()) return it.unit.trim();
  if (it.product_id && unitById.has(it.product_id)) return unitById.get(it.product_id)!;
  const n = (it.product_name ?? '').trim().toLowerCase();
  if (unitByName.has(n)) return unitByName.get(n)!;
  // Hand-keyed names often read "Slicing Tomatoes — first 50 lb @ $3.75";
  // match on the part before the em dash.
  const base = n.split('—')[0].trim();
  return unitByName.get(base) ?? '';
}

// ─── Stitch accounts ↔ orders ───────────────────────────────────────
// An account can have SEVERAL orders for one delivery date — a standing order
// the cron generates plus anything they add through the portal or we key in
// from email. This used to be `Map.set(account_id, order)`, which silently kept
// only the LAST one: on 2026-08-31 Mediterra's hand-entered $660.50 email order
// vanished behind an auto-generated standing order, and the page showed a total
// that was not what the chef asked for. Nothing was lost in the database — it
// simply could not be seen, which is worse than an error.
//
// We now COMBINE every live order for the account into one view (Todd
// 2026-08-31: "customers should be able to do more than one order; for standing
// order folks their additional orders should be combined with their standing
// orders"). Line items merge by product so 40 lb standing + 60 lb added reads
// as 100 lb to whoever packs it, and the money is the sum of the real rows.
//
// Cancelled orders are excluded — a cancelled duplicate must not inflate the
// pick. They stay in the table for the audit trail.
const liveOrders = orders.filter((o) => o.status !== 'cancelled');
const ordersByAccount = new Map<string, OrderRow[]>();
for (const o of liveOrders) {
  if (!o.account_id) continue;
  const arr = ordersByAccount.get(o.account_id);
  if (arr) arr.push(o);
  else ordersByAccount.set(o.account_id, [o]);
}

/** Merge line items across orders, summing quantity and money per product. */
function combineItems(list: OrderRow[]): ItemRow[] {
  const byProduct = new Map<string, ItemRow>();
  for (const o of list) {
    for (const it of itemsByOrder.get(o.id) ?? []) {
      const key = (it.product_name ?? '').trim().toLowerCase();
      const prev = byProduct.get(key);
      if (prev) {
        prev.qty = (prev.qty ?? 0) + (it.qty ?? 0);
        prev.line_total_cents = (prev.line_total_cents ?? 0) + (it.line_total_cents ?? 0);
      } else {
        byProduct.set(key, { ...it });
      }
    }
  }
  return Array.from(byProduct.values());
}

type Stitched = AccountRow & {
  order: OrderRow | null;
  lineItems: ItemRow[];
  /** Every live order behind the combined view — 1 in the normal case. */
  orders: OrderRow[];
};
const stitched: Stitched[] = accounts.map((a) => {
  const list = (ordersByAccount.get(a.id) ?? []).slice()
    .sort((x, y) => x.created_at.localeCompare(y.created_at));
  if (list.length === 0) return { ...a, order: null, lineItems: [], orders: [] };
  // Single order → pass it straight through, unchanged behaviour.
  if (list.length === 1) {
    return { ...a, order: list[0], lineItems: itemsByOrder.get(list[0].id) ?? [], orders: list };
  }
  // Several → one combined view. Keep the OLDEST order's id so the edit link
  // still targets a real row, and label the source so it is obvious this is a
  // merge rather than a single submission.
  const combined: OrderRow = {
    ...list[0],
    total_amount: list.reduce((sum, o) => sum + (o.total_amount ?? 0), 0),
    total_lbs: list.reduce((sum, o) => sum + (o.total_lbs ?? 0), 0),
    notes: list.map((o) => o.notes).filter(Boolean).join(' · ') || null,
    source: 'combined',
  };
  return { ...a, order: combined, lineItems: combineItems(list), orders: list };
});

// Orphan orders (an order whose account isn't in the accounts list — shouldn't
// happen, but surface it rather than silently drop revenue).
const accountIds = new Set(accounts.map((a) => a.id));
const orphanOrders = orders.filter((o) => !o.account_id || !accountIds.has(o.account_id));

// ─── Buckets ────────────────────────────────────────────────────────
const ordered = stitched.filter((s) => s.order);
const visitedNoOrder = stitched.filter((s) => !s.order && (s.portal_visit_count ?? 0) > 0);
const notOpened = stitched.filter((s) => !s.order && (s.portal_visit_count ?? 0) === 0);

ordered.sort((a, b) => (b.order!.total_amount ?? 0) - (a.order!.total_amount ?? 0));
visitedNoOrder.sort((a, b) => (b.last_portal_visit_at ?? '').localeCompare(a.last_portal_visit_at ?? ''));

const totalRevenue = orders.reduce((s, o) => s + (Number(o.total_amount) || 0), 0);
const totalLbs = orders.reduce((s, o) => s + (Number(o.total_lbs) || 0), 0);

const money = (dollars: number | null | undefined) => `$${(Number(dollars) || 0).toFixed(2)}`;

// Human label for an order's provenance (shown in the per-order footer).
const SOURCE_LABELS: Record<string, string> = {
  combined: '🧾 Combined',
  manual: '✍️ Manually entered',
  chef_portal: '🧑‍🍳 Chef portal',
  market_wagon: '📦 Market Wagon import',
  harvie: '📦 Harvie import',
  email: '✉️ Email order',
};
const sourceLabel = (s: string | null | undefined): string =>
  !s ? 'Order' : (SOURCE_LABELS[s] ?? `📦 Imported (${s})`);
const fmtTime = (iso: string | null) =>
  iso
    ? new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
      }).format(new Date(iso))
    : '—';

const deliveryPretty = prettyDeliveryDate(deliveryDate);
---

<AdminShell
  title="Chef orders"
  subtitle={`Delivery ${deliveryPretty} · cutoff ${CUTOFF_LABEL} · ${accounts.length} chef accounts`}
>
  <Fragment slot="actions">
    <a href={`/admin/wholesale/orders/new?date=${deliveryDate}`} class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-3 text-sm font-semibold text-white shadow-ts-sm transition-transform hover:bg-ts-primary-dark active:scale-[0.98]">➕ New order</a>
    <a href={`/admin/wholesale/pack?date=${deliveryDate}`} class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary">📦 Pack this date</a>
    <a href={`/admin/wholesale/labels?date=${deliveryDate}`} class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary">🏷️ Labels</a>
    <a href="/admin/wholesale" class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary">← Hub</a>
  </Fragment>

  {/* Delivery-date picker */}
    {/* THIS-WEEK strip — every delivery day with orders, one tap to switch.
        Added 2026-07-27: the page defaulted to Wednesday and hid Tuesday's
        PASS order; delivery days are no longer Wednesday-only. */}
  {weekStrip.length > 0 && (
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">This week:</span>
        {weekStrip.map((w) => (
          <a
            href={`/admin/wholesale/orders?date=${w.date}`}
            class:list={[
              'inline-flex h-9 items-center gap-2 rounded-ts-md border px-3 text-sm font-semibold transition-colors',
              w.date === deliveryDate
                ? 'border-ts-primary bg-ts-primary/10 text-ts-primary'
                : 'border-ts-border bg-ts-bg-surface text-ts-text hover:border-ts-primary/40 hover:text-ts-primary',
            ]}
          >
            {prettyDeliveryDate(w.date)}
            <span class="rounded-full bg-ts-bg-muted px-2 py-0.5 text-xs tabular-nums">{w.n} · ${w.total.toFixed(0)}</span>
          </a>
        ))}
      </div>
    )}
  {deliveryDates.length > 1 && (
    <Card padding="md" elevation="sm" as="section" class="mb-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-medium text-gray-500">Delivery date:</span>
        {deliveryDates.map((d) => (
          <a
            href={`/admin/wholesale/orders?date=${d}`}
            class={`rounded-full px-3 py-1 text-sm font-medium ${
              d === deliveryDate
                ? 'bg-emerald-600 text-white'
                : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
            }`}
          >{prettyDeliveryDate(d)}</a>
        ))}
      </div>
    </Card>
  )}

  {/* Engagement summary */}
  <section class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <Card padding="md" elevation="sm">
      <div class="text-2xl font-bold text-emerald-600">{ordered.length}</div>
      <div class="text-xs uppercase tracking-wide text-gray-500">Ordered</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-2xl font-bold text-gray-900">{money(totalRevenue)}</div>
      <div class="text-xs uppercase tracking-wide text-gray-500">Revenue {totalLbs > 0 ? `· ${totalLbs.toFixed(0)} lbs` : ''}</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-2xl font-bold text-amber-600">{visitedNoOrder.length}</div>
      <div class="text-xs uppercase tracking-wide text-gray-500">Visited, no order</div>
    </Card>
    <Card padding="md" elevation="sm">
      <div class="text-2xl font-bold text-gray-400">{notOpened.length}</div>
      <div class="text-xs uppercase tracking-wide text-gray-500">Haven't opened</div>
    </Card>
  </section>

  {/* Orders */}
  <h2 class="mb-2 text-lg font-semibold text-gray-900">Orders · {ordered.length}</h2>
  {ordered.length === 0 && (
    <Card padding="lg" elevation="sm" class="mb-5">
      <p class="text-sm text-gray-500">No orders for {deliveryPretty} yet.</p>
    </Card>
  )}
  {ordered.length > 0 && (
    <div class="mb-6 space-y-3">
      {ordered.map((s) => (
        <Card padding="md" elevation="sm" as="article">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <div class="font-semibold text-gray-900">{s.restaurant_name}</div>
              <div class="text-xs text-gray-500">
                {s.contact_name ? `${s.contact_name} · ` : ''}{s.email ?? ''}
              </div>
            </div>
            <div class="text-right">
              <div class="text-lg font-bold text-emerald-600">{money(s.order!.total_amount)}</div>
              {s.orders.length > 1 && (
                <div class="text-[11px] font-semibold text-amber-700">
                  {s.orders.length} orders combined
                </div>
              )}
              <div class="text-xs text-gray-500">
                <Badge variant={s.order!.status === 'submitted' ? 'green' : 'gray'} size="xs" uppercase>
                  {s.order!.status ?? 'order'}
                </Badge>
                <span class="ml-1">{fmtTime(s.order!.created_at)}</span>
              </div>
            </div>
          </div>
          {s.lineItems.length > 0 && (
            <ul class="mt-3 divide-y divide-gray-100 border-t border-gray-100 pt-1 text-sm">
              {s.lineItems.map((it) => (
                <li class="flex items-center justify-between py-1.5">
                  <span class="text-gray-800">
                    <span class="font-medium">{it.qty}{unitFor(it) ? ` ${unitFor(it)}` : '×'}</span> {it.product_name}
                  </span>
                  <span class="text-gray-500">
                    {formatCents(it.unit_price_cents ?? 0)}{unitFor(it) ? ` / ${unitFor(it)}` : ''} ·{' '}
                    <span class="font-medium text-gray-700">{formatCents(it.line_total_cents ?? 0)}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}
          {s.order!.notes && (
            <p class="mt-2 rounded bg-amber-50 px-2 py-1 text-xs text-amber-800">📝 {s.order!.notes}</p>
          )}
          {/* Footer: Edit is available on EVERY order (accuracy edits, Todd
              2026-07-06). Delete stays MANUAL-ONLY — a chef-portal / import
              order must never be deleted from this path (own lifecycle). */}
          <div class="mt-3 flex flex-wrap items-center justify-end gap-2 border-t border-gray-100 pt-2">
            <span class="mr-auto inline-flex items-center gap-1 text-xs font-medium text-gray-400">{sourceLabel(s.order!.source)}</span>
            <a
              href={`/admin/wholesale/orders/new?edit=${s.order!.id}&date=${deliveryDate}`}
              class="inline-flex h-9 items-center justify-center rounded-ts-md border border-ts-border bg-white px-3 text-xs font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
            >Edit</a>
            {s.order!.source === 'manual' && (
              <span class="del-wrap inline-flex items-center gap-1" data-order-id={s.order!.id} data-label={s.restaurant_name}>
                <button type="button" class="del-start inline-flex h-9 items-center justify-center rounded-ts-md border border-ts-border bg-white px-3 text-xs font-semibold text-gray-500 hover:border-ts-danger/40 hover:text-ts-danger">Delete</button>
                <span class="del-confirm hidden items-center gap-1" hidden>
                  <span class="text-xs font-medium text-ts-danger">Delete this order?</span>
                  <button type="button" class="del-yes inline-flex h-9 items-center justify-center rounded-ts-md bg-ts-danger px-3 text-xs font-semibold text-white hover:opacity-90 active:scale-[0.98]">Yes, delete</button>
                  <button type="button" class="del-no inline-flex h-9 items-center justify-center rounded-ts-md border border-ts-border bg-white px-3 text-xs font-semibold text-gray-500 hover:text-ts-text">Keep</button>
                </span>
              </span>
            )}
          </div>
        </Card>
      ))}
    </div>
  )}

  {orphanOrders.length > 0 && (
    <Card padding="md" elevation="sm" class="mb-6 border border-red-200 bg-red-50">
      <p class="text-sm font-medium text-red-700">
        ⚠️ {orphanOrders.length} order(s) for this date aren't linked to a chef account
        (total {money(orphanOrders.reduce((s, o) => s + (Number(o.total_amount) || 0), 0))}). Check the data.
      </p>
    </Card>
  )}

  {/* Visited, no order */}
  <h2 class="mb-2 text-lg font-semibold text-gray-900">Visited the portal — no order for {deliveryPretty} · {visitedNoOrder.length}</h2>
  {visitedNoOrder.length === 0 ? (
    <Card padding="md" elevation="sm" class="mb-5"><p class="text-sm text-gray-500">None.</p></Card>
  ) : (
    <Card padding="none" elevation="sm" as="section" class="mb-6">
      <ul class="divide-y divide-gray-100">
        {visitedNoOrder.map((s) => (
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 text-sm">
            <div>
              <span class="font-medium text-gray-900">{s.restaurant_name}</span>
              <span class="ml-2 text-xs text-gray-400">{s.email ?? ''}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-right text-xs text-gray-500">
                {s.portal_visit_count} visit{(s.portal_visit_count ?? 0) === 1 ? '' : 's'} · last {fmtTime(s.last_portal_visit_at)}
              </span>
              {s.order_token && (
                <button type="button" data-copy-link={`${SITE_ORIGIN}/order/${s.order_token}`} class="copy-link rounded border border-ts-border bg-white px-2 py-1 text-xs font-medium text-ts-text hover:border-ts-primary/40 hover:text-ts-primary">Copy order link</button>
              )}
            </div>
          </li>
        ))}
      </ul>
    </Card>
  )}

  {/* Haven't opened */}
  <h2 class="mb-2 text-lg font-semibold text-gray-900">Haven't opened their link · {notOpened.length}</h2>
  {notOpened.length === 0 ? (
    <Card padding="md" elevation="sm" class="mb-3"><p class="text-sm text-gray-500">None.</p></Card>
  ) : (
    <Card padding="none" elevation="sm" as="section" class="mb-3">
      <ul class="divide-y divide-gray-100">
        {notOpened.map((s) => (
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2 text-sm">
            <div>
              <span class="font-medium text-gray-700">{s.restaurant_name}</span>
              <span class="ml-2 text-xs text-gray-400">{s.email ?? '—'}</span>
            </div>
            {s.order_token && (
              <button type="button" data-copy-link={`${SITE_ORIGIN}/order/${s.order_token}`} class="copy-link rounded border border-ts-border bg-white px-2 py-1 text-xs font-medium text-ts-text hover:border-ts-primary/40 hover:text-ts-primary">Copy order link</button>
            )}
          </li>
        ))}
      </ul>
    </Card>
  )}

  <script is:inline>
    document.querySelectorAll('.copy-link').forEach((b) => b.addEventListener('click', () => {
      const link = b.getAttribute('data-copy-link');
      navigator.clipboard?.writeText(link).then(() => {
        const t = b.textContent; b.textContent = 'Copied!';
        setTimeout(() => { b.textContent = t; }, 1500);
      });
    }));

    // Inline (no native confirm()) delete for manually-entered orders.
    document.querySelectorAll('.del-wrap').forEach((wrap) => {
      const startBtn = wrap.querySelector('.del-start');
      const confirmBox = wrap.querySelector('.del-confirm');
      const yesBtn = wrap.querySelector('.del-yes');
      const noBtn = wrap.querySelector('.del-no');
      const orderId = wrap.getAttribute('data-order-id');

      function showConfirm(show) {
        confirmBox.hidden = !show;
        confirmBox.classList.toggle('hidden', !show);
        confirmBox.classList.toggle('inline-flex', show);
        startBtn.hidden = show;
      }
      startBtn.addEventListener('click', () => showConfirm(true));
      noBtn.addEventListener('click', () => showConfirm(false));
      yesBtn.addEventListener('click', () => {
        yesBtn.disabled = true; yesBtn.textContent = 'Deleting…';
        fetch('/api/admin/wholesale/orders/delete', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ order_id: orderId }),
        })
          .then((r) => r.json().then((j) => ({ ok: r.ok, j })))
          .then((out) => {
            if (!out.ok || !out.j || !out.j.ok) {
              yesBtn.disabled = false; yesBtn.textContent = 'Yes, delete';
              const msg = (out.j && (out.j.message || out.j.error)) || 'Delete failed.';
              const err = document.createElement('span');
              err.className = 'text-xs font-medium text-ts-danger';
              err.textContent = msg;
              confirmBox.appendChild(err);
              return;
            }
            const card = wrap.closest('article');
            if (card) { card.style.opacity = '0.4'; }
            window.location.reload();
          })
          .catch((e) => {
            yesBtn.disabled = false; yesBtn.textContent = 'Yes, delete';
            const err = document.createElement('span');
            err.className = 'text-xs font-medium text-ts-danger';
            err.textContent = 'Network error: ' + e.message;
            confirmBox.appendChild(err);
          });
      });
    });
  </script>

  <p class="mt-4 text-xs text-gray-400">
    Order data is accurate all-time. Portal-visit tracking began when it shipped (2026-06-23) —
    a chef who opened the link before then shows as “Haven't opened” until their next visit.
  </p>
</AdminShell>
