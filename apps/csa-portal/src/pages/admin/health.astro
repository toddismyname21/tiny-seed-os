---
/**
 * /admin/health — CSA portal trust dashboard.
 *
 * Built 2026-06-04 for the launch. Surfaces six "is the system healthy?"
 * signals as auto-refreshing cards so Todd + Frankie can see at a glance
 * whether the portal is in good shape before sending the launch email.
 *
 * Cards:
 *   1. Sync state            — minutes since last successful Shopify sync
 *   2. NULL pickups          — active members with no pickup AND no
 *                              delivery, on a share that requires one.
 *                              Surfaces the Allison-Park-TBD sub-count
 *                              separately so the "needs action" number
 *                              is the real number.
 *   3. Tag drift             — active veg/flex customers in Supabase
 *                              missing the canonical '2026-summer-csa' tag
 *   4. Wrong tag drift       — customers carrying the misordered tag
 *                              ('csa-2026-summer'). Non-zero means
 *                              Shopify Flow re-applied the bad tag.
 *   5. Last reconciliation   — when the nightly health cron last ran,
 *                              plus the fix-counts it recorded
 *   6. Magic-link delivery   — sent / delivered / bounced in 24h (data
 *                              comes online once Resend webhooks are
 *                              wired in Phase 2)
 *
 * All card data comes from a single GET /api/admin/health/status call
 * (one round-trip, <500ms). The page auto-refreshes every 30 seconds;
 * the refresh pauses while a "Run reconciliation now" request is in
 * flight so the post-run results don't get clobbered.
 *
 * "Run reconciliation now" POSTs to /api/admin/health/run, which proxies
 * to /api/cron/nightly-health server-side (CRON_SECRET stays out of the
 * browser). When the cron endpoint isn't deployed yet (parallel agent
 * still in flight) the proxy returns a friendly 503 the UI shows as
 * "not yet deployed" rather than a generic failure.
 *
 * Auth: middleware gates /admin/*; the status + run APIs additionally
 * call requireAdmin() defensively. CSRF: run POSTs go through
 * isSameOriginPost.
 */
import AdminShell from '../../components/AdminShell.astro';
import Card from '../../components/Card.astro';

// Page loads with no SSR data — every card is hydrated by the JS poll
// below. We DELIBERATELY don't fetch in the frontmatter because:
//   - SSR'd numbers would be stale by the time the auto-refresh hits
//   - the page renders the skeleton instantly (no DB round-trip blocks paint)
//   - the API call goes through the same admin-gate path either way
---

<AdminShell
  title="Health"
  subtitle="Live system health at a glance — refreshes every 30 seconds."
  pageTitle="System health — Tiny Seed Admin"
  canonical="https://csa.tinyseedfarm.com/admin/health"
>
  {/* ════ Top action bar ════ */}
  <Card padding="md" elevation="sm">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <div class="min-w-0">
        <h2 class="font-display text-lg font-bold text-ts-text">Reconciliation</h2>
        <p class="mt-0.5 text-sm text-ts-text-secondary">
          Trigger the nightly health-check cron right now. It fixes NULL
          pickups (best-effort), re-applies canonical Shopify tags, and
          reports its results back into the cards below.
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-3">
        <span
          data-recon-status
          aria-live="polite"
          class="text-sm text-ts-text-muted"
        ></span>
        <button
          type="button"
          data-recon-run
          class="inline-flex h-10 items-center justify-center gap-2 rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary disabled:cursor-not-allowed disabled:opacity-60"
        >
          <span aria-hidden="true">▶</span>
          <span data-recon-label>Run reconciliation now</span>
        </button>
      </div>
    </div>
  </Card>

  {/* ════ The 6 cards ════
       Each card has data-card="<key>" so the poll loop can update it
       without re-rendering the whole grid. */}
  <section
    aria-labelledby="health-cards-heading"
    class="flex flex-col gap-4"
  >
    <div class="flex items-baseline justify-between gap-3">
      <h2 id="health-cards-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
        Today's signals
      </h2>
      <div class="flex items-center gap-2 text-xs text-ts-text-muted">
        <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-ts-primary" aria-hidden="true"></span>
        <span data-last-refresh>Loading…</span>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
      {/* ── 1. Sync state ── */}
      <article data-card="sync" class="health-card">
        <header class="health-card__header">
          <span class="health-card__dot" data-card-dot aria-hidden="true"></span>
          <h3 class="health-card__title">Shopify sync</h3>
        </header>
        <p class="health-card__big" data-card-big>—</p>
        <p class="health-card__sub" data-card-sub>Loading sync watermark…</p>
        <a
          href="/admin/sync"
          class="health-card__link"
        >
          Open sync details <span aria-hidden="true">→</span>
        </a>
      </article>

      {/* ── 2. NULL pickups ── */}
      <article data-card="null_pickups" class="health-card">
        <header class="health-card__header">
          <span class="health-card__dot" data-card-dot aria-hidden="true"></span>
          <h3 class="health-card__title">NULL pickups</h3>
        </header>
        <p class="health-card__big" data-card-big>—</p>
        <p class="health-card__sub" data-card-sub>Counting active members without a pickup…</p>
        <a
          href="/admin/members?pickup_location=home_delivery&status=active"
          class="health-card__link"
        >
          View members <span aria-hidden="true">→</span>
        </a>
      </article>

      {/* ── 3. Tag drift (missing canonical) ── */}
      <article data-card="tags" class="health-card">
        <header class="health-card__header">
          <span class="health-card__dot" data-card-dot aria-hidden="true"></span>
          <h3 class="health-card__title">Missing canonical tag</h3>
        </header>
        <p class="health-card__big" data-card-big>—</p>
        <p class="health-card__sub" data-card-sub>Waiting for the nightly tag scan…</p>
        <p class="health-card__hint">
          Active veg / flex customers in Supabase whose Shopify record
          isn't carrying <code class="health-card__code">2026-summer-csa</code>.
        </p>
      </article>

      {/* ── 4. Wrong tag drift ── */}
      <article data-card="wrong_tags" class="health-card">
        <header class="health-card__header">
          <span class="health-card__dot" data-card-dot aria-hidden="true"></span>
          <h3 class="health-card__title">Wrong tag drift</h3>
        </header>
        <p class="health-card__big" data-card-big>—</p>
        <p class="health-card__sub" data-card-sub>Waiting for the nightly tag scan…</p>
        <p class="health-card__hint">
          Customers carrying the misordered tag
          (<code class="health-card__code">csa-2026-summer</code>).
          If this is non-zero, a Shopify Flow workflow is re-applying it.
        </p>
      </article>

      {/* ── 5. Last reconciliation ── */}
      <article data-card="last_reconciliation" class="health-card">
        <header class="health-card__header">
          <span class="health-card__dot" data-card-dot aria-hidden="true"></span>
          <h3 class="health-card__title">Last reconciliation</h3>
        </header>
        <p class="health-card__big" data-card-big>—</p>
        <p class="health-card__sub" data-card-sub>Looking up the most recent run…</p>
        <p class="health-card__hint" data-card-extra></p>
      </article>

      {/* ── 6. Magic-link delivery (24h) ── */}
      <article data-card="magic_link_24h" class="health-card">
        <header class="health-card__header">
          <span class="health-card__dot" data-card-dot aria-hidden="true"></span>
          <h3 class="health-card__title">Magic-link delivery · 24h</h3>
        </header>
        <p class="health-card__big" data-card-big>—</p>
        <p class="health-card__sub" data-card-sub>Counting magic-link sends in the last 24h…</p>
        <p class="health-card__hint">
          Comes online once Resend webhooks are wired (Phase 2). Until
          then this reads zeros — that's expected, not a failure.
        </p>
      </article>
    </div>
  </section>

  {/* ── Inline modal-ish list shown when the user clicks the
        "View members" link on the NULL-pickups card. We render an
        always-present <dialog> the JS pops open. */}
  <dialog
    data-null-pickup-dialog
    class="fixed inset-0 m-auto max-h-[80vh] w-[min(640px,calc(100vw-2rem))] rounded-ts-xl border border-ts-border bg-ts-bg-surface p-0 shadow-ts-lg backdrop:bg-black/40 backdrop:backdrop-blur-sm"
  >
    <div class="flex items-center justify-between border-b border-ts-border px-5 py-3">
      <h2 class="font-display text-lg font-bold text-ts-text">Members with no pickup</h2>
      <button
        type="button"
        data-null-pickup-close
        class="rounded-ts-sm p-1 text-ts-text-secondary transition-colors duration-150 hover:bg-ts-bg-muted hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        aria-label="Close"
      >
        <span aria-hidden="true" class="text-xl leading-none">×</span>
      </button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto p-5" data-null-pickup-body>
      <p class="text-sm text-ts-text-muted">
        This list is rendered server-side from the same query the card
        counts — open the Members page for the full row-level view.
      </p>
    </div>
    <div class="flex justify-end border-t border-ts-border px-5 py-3">
      <a
        href="/admin/members?pickup_location=home_delivery&status=active"
        class="text-sm font-medium text-ts-primary underline-offset-2 hover:underline"
      >
        Open in Members →
      </a>
    </div>
  </dialog>

  <style>
    .health-card {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1.25rem 1.5rem;
      background: var(--color-ts-bg-surface, #fff);
      border: 1px solid var(--color-ts-border, #e5e7eb);
      border-radius: var(--radius-ts-xl, 1rem);
      box-shadow: var(--shadow-ts-md, 0 2px 6px rgba(0, 0, 0, 0.04));
      transition: border-color 200ms ease;
    }
    .health-card:hover {
      border-color: var(--color-ts-border-strong, #cbd5e1);
    }
    .health-card__header {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    .health-card__dot {
      display: inline-block;
      width: 0.65rem;
      height: 0.65rem;
      border-radius: 9999px;
      background: var(--color-ts-text-muted, #94a3b8);
      flex-shrink: 0;
      transition: background-color 200ms ease;
    }
    .health-card[data-state="green"]  .health-card__dot { background: var(--color-ts-primary, #15803d); }
    .health-card[data-state="yellow"] .health-card__dot { background: var(--color-ts-warning, #d97706); }
    .health-card[data-state="red"]    .health-card__dot { background: var(--color-ts-danger, #b91c1c); }
    .health-card[data-state="unknown"], .health-card[data-state="no_data"], .health-card[data-state="never"] {
      /* default dot color is muted gray — already set above */
    }
    .health-card__title {
      font-family: var(--font-display, inherit);
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--color-ts-text, #0f172a);
      margin: 0;
    }
    .health-card__big {
      margin: 0.5rem 0 0;
      font-family: var(--font-display, inherit);
      font-weight: 700;
      font-size: 2rem;
      line-height: 1.1;
      color: var(--color-ts-text, #0f172a);
      font-variant-numeric: tabular-nums;
    }
    .health-card[data-state="red"]    .health-card__big { color: var(--color-ts-danger, #b91c1c); }
    .health-card[data-state="yellow"] .health-card__big { color: var(--color-ts-warning, #d97706); }
    .health-card[data-state="green"]  .health-card__big { color: var(--color-ts-primary, #15803d); }
    .health-card__sub {
      margin: 0;
      font-size: 0.875rem;
      color: var(--color-ts-text-secondary, #475569);
      line-height: 1.4;
    }
    .health-card__hint {
      margin: 0.25rem 0 0;
      font-size: 0.75rem;
      color: var(--color-ts-text-muted, #94a3b8);
      line-height: 1.4;
    }
    .health-card__code {
      background: var(--color-ts-bg-muted, #f1f5f9);
      padding: 0 0.25rem;
      border-radius: 3px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.7rem;
    }
    .health-card__link {
      margin-top: auto;
      padding-top: 0.5rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-ts-primary, #15803d);
      text-decoration: none;
      align-self: start;
    }
    .health-card__link:hover { text-decoration: underline; text-underline-offset: 2px; }

    /* When the page is loaded but a request is in flight, dim the cards
       to signal "data is being refreshed". */
    [data-refreshing] .health-card { opacity: 0.85; }
  </style>

  <script>
    /**
     * /admin/health client-side controller.
     *
     * Responsibilities:
     *   - Initial fetch + render of all 6 cards (no SSR data).
     *   - 30-second auto-refresh poll.
     *   - "Run reconciliation now" button → POST /api/admin/health/run,
     *     pauses the poll while in flight, re-runs the status fetch
     *     immediately after.
     *   - NULL-pickup card "View list" → opens an in-page dialog so Todd
     *     can scan the names without leaving the dashboard.
     *
     * Fail-soft: any fetch error renders an "—" placeholder + a
     * subtitle line saying what went wrong (visible to admin only —
     * this page is admin-gated). The poll keeps trying.
     */
    interface StatusBody {
      ok: boolean;
      generated_at: string;
      sync: { last_run_at: string | null; newest_order_at: string | null; last_synced_at: string | null; age_minutes: number | null; status: string };
      null_pickups: { total: number; allison_park_tbd: number; actionable: number; status: string };
      tags: { missing_canonical: number | null; last_checked_at: string | null; status: string };
      wrong_tags: { count: number | null; last_checked_at: string | null; status: string };
      last_reconciliation: {
        ran_at: string | null;
        pickups_fixed: number | null;
        tags_fixed: number | null;
        sync_lag_minutes: number | null;
        run_status: string | null;
        error_message: string | null;
        status: string;
      };
      magic_link_24h: { sent: number; delivered: number; bounced: number; bounce_rate: number; status: string };
    }

    const REFRESH_MS = 30_000;

    function $<T extends Element = Element>(sel: string, root: ParentNode = document): T | null {
      return root.querySelector<T>(sel);
    }

    function setCard(
      key: string,
      data: { state: string; big: string; sub: string; extra?: string }
    ) {
      const card = document.querySelector<HTMLElement>(`[data-card="${key}"]`);
      if (!card) return;
      card.dataset.state = data.state;
      const big = card.querySelector<HTMLElement>('[data-card-big]');
      if (big) big.textContent = data.big;
      const sub = card.querySelector<HTMLElement>('[data-card-sub]');
      if (sub) sub.textContent = data.sub;
      const extra = card.querySelector<HTMLElement>('[data-card-extra]');
      if (extra) extra.textContent = data.extra ?? '';
    }

    function fmtAgo(iso: string | null): string {
      if (!iso) return 'never';
      const mins = Math.floor((Date.now() - new Date(iso).getTime()) / 60_000);
      if (mins < 1) return 'just now';
      if (mins < 60) return `${mins} min ago`;
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return `${hrs} hour${hrs === 1 ? '' : 's'} ago`;
      const days = Math.floor(hrs / 24);
      return `${days} day${days === 1 ? '' : 's'} ago`;
    }

    function fmtDateTime(iso: string | null): string {
      if (!iso) return 'never';
      return new Intl.DateTimeFormat('en-US', {
        month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
        timeZone: 'America/New_York',
      }).format(new Date(iso));
    }

    function applyStatus(body: StatusBody) {
      // ── 1. Sync ──
      setCard('sync', {
        state: body.sync.status,
        big: body.sync.age_minutes === null
          ? 'No data'
          : body.sync.age_minutes < 1
            ? 'Ran just now'
            : `Ran ${body.sync.age_minutes} min ago`,
        sub: (body.sync.newest_order_at ?? body.sync.last_synced_at)
          ? `Sync runs every 15 min. Newest order processed: ${fmtDateTime(body.sync.newest_order_at ?? body.sync.last_synced_at)} (this only moves when a NEW order comes in — normal that it sits still).`
          : 'Sync runs every 15 min.',
      });

      // ── 2. NULL pickups ──
      const np = body.null_pickups;
      const npParts: string[] = [];
      if (np.allison_park_tbd > 0) {
        npParts.push(`${np.allison_park_tbd} of those are Allison Park TBD — intentional.`);
      }
      npParts.push(
        np.actionable === 0
          ? 'No active members need a pickup choice.'
          : `${np.actionable} need a pickup before next box.`
      );
      setCard('null_pickups', {
        state: np.status,
        big: `${np.total}`,
        sub: npParts.join(' '),
      });

      // ── 3. Tag drift (missing canonical) ──
      const tg = body.tags;
      setCard('tags', {
        state: tg.status,
        big: tg.missing_canonical === null ? '—' : `${tg.missing_canonical}`,
        sub: tg.missing_canonical === null
          ? 'No nightly scan recorded yet — counts arrive after the next health-check run.'
          : tg.missing_canonical === 0
            ? `All active veg/flex customers carry the canonical tag. Last checked ${fmtAgo(tg.last_checked_at)}.`
            : `${tg.missing_canonical} active veg/flex customer${tg.missing_canonical === 1 ? '' : 's'} missing the canonical tag. Last checked ${fmtAgo(tg.last_checked_at)}.`,
      });

      // ── 4. Wrong tag drift ──
      const wt = body.wrong_tags;
      setCard('wrong_tags', {
        state: wt.status,
        big: wt.count === null ? '—' : `${wt.count}`,
        sub: wt.count === null
          ? 'No nightly scan recorded yet.'
          : wt.count === 0
            ? `No misordered tags found. Last checked ${fmtAgo(wt.last_checked_at)}.`
            : `${wt.count} customer${wt.count === 1 ? '' : 's'} carry the misordered tag — Shopify Flow may be re-applying it.`,
      });

      // ── 5. Last reconciliation ──
      const rc = body.last_reconciliation;
      let rcBig: string, rcSub: string, rcExtra = '';
      if (rc.status === 'never') {
        rcBig = 'Never';
        rcSub = 'The nightly health-check has not run yet. Click "Run reconciliation now" above to fire it manually.';
      } else {
        rcBig = fmtAgo(rc.ran_at);
        const parts: string[] = [];
        if (rc.pickups_fixed !== null) parts.push(`fixed ${rc.pickups_fixed} pickup${rc.pickups_fixed === 1 ? '' : 's'}`);
        if (rc.tags_fixed !== null) parts.push(`${rc.tags_fixed} tag${rc.tags_fixed === 1 ? '' : 's'}`);
        if (rc.sync_lag_minutes !== null) parts.push(`sync lag ${rc.sync_lag_minutes} min`);
        rcSub = `Ran at ${fmtDateTime(rc.ran_at)}.`;
        if (parts.length > 0) rcSub += ` ${parts.join(', ')}.`;
        if (rc.error_message) {
          rcExtra = `Last run reported: ${rc.error_message}`;
        }
      }
      setCard('last_reconciliation', { state: rc.status, big: rcBig, sub: rcSub, extra: rcExtra });

      // ── 6. Magic-link delivery (24h) ──
      const ml = body.magic_link_24h;
      let mlBig: string, mlSub: string;
      if (ml.sent === 0) {
        mlBig = '0 sent';
        mlSub = 'No magic-link sends recorded in the last 24h.';
      } else {
        mlBig = `${ml.sent} sent`;
        const pct = Math.round(ml.bounce_rate * 1000) / 10;
        mlSub = `${ml.delivered} delivered, ${ml.bounced} bounced (${pct}%).`;
      }
      setCard('magic_link_24h', { state: ml.status, big: mlBig, sub: mlSub });

      // Footer refresh stamp.
      const refreshEl = $('[data-last-refresh]');
      if (refreshEl) refreshEl.textContent = `Updated ${fmtDateTime(body.generated_at)}`;
    }

    function setErrorBanner(message: string) {
      const refreshEl = $('[data-last-refresh]');
      if (refreshEl) refreshEl.textContent = `Refresh failed — ${message}`;
    }

    let refreshTimer: number | undefined;
    let reconRunning = false;

    async function fetchStatus(): Promise<void> {
      const main = document.body;
      main.dataset.refreshing = '1';
      try {
        const res = await fetch('/api/admin/health/status', {
          method: 'GET',
          headers: { accept: 'application/json' },
          credentials: 'same-origin',
        });
        if (!res.ok) {
          setErrorBanner(`HTTP ${res.status}`);
          return;
        }
        const body = (await res.json()) as StatusBody;
        if (!body.ok) {
          setErrorBanner('endpoint returned ok=false');
          return;
        }
        applyStatus(body);
      } catch (e) {
        setErrorBanner(e instanceof Error ? e.message : 'network error');
      } finally {
        delete main.dataset.refreshing;
      }
    }

    function scheduleRefresh() {
      if (refreshTimer !== undefined) clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(async () => {
        if (!reconRunning) await fetchStatus();
        scheduleRefresh();
      }, REFRESH_MS);
    }

    async function runReconciliation() {
      if (reconRunning) return;
      const btn = $<HTMLButtonElement>('[data-recon-run]');
      const label = $<HTMLElement>('[data-recon-label]');
      const status = $<HTMLElement>('[data-recon-status]');
      if (!btn) return;
      reconRunning = true;
      btn.disabled = true;
      if (label) label.textContent = 'Running…';
      if (status) status.textContent = 'Triggering /api/cron/nightly-health …';
      try {
        const res = await fetch('/api/admin/health/run', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({}),
        });
        const raw = await res.text();
        let body: { ok?: boolean; error?: string; message?: string; upstream_status?: number; body?: unknown } | null = null;
        try { body = JSON.parse(raw); } catch { /* keep null */ }

        if (res.status === 503 && body?.error === 'cron_not_yet_deployed') {
          if (status) status.textContent = 'Not deployed yet — try again after the cron endpoint ships.';
        } else if (res.ok && body?.ok) {
          if (status) status.textContent = 'Reconciliation complete — refreshing cards…';
          await fetchStatus();
          if (status) status.textContent = 'Reconciliation complete.';
        } else {
          const errCode = body?.error ?? `HTTP ${res.status}`;
          const detail = body?.message ?? raw.slice(0, 200);
          if (status) status.textContent = `Failed: ${errCode} — ${detail}`;
        }
      } catch (e) {
        if (status) status.textContent = `Network error: ${e instanceof Error ? e.message : 'unknown'}`;
      } finally {
        reconRunning = false;
        btn.disabled = false;
        if (label) label.textContent = 'Run reconciliation now';
      }
    }

    // NULL-pickup dialog open/close.
    function wireDialog() {
      const dialog = $<HTMLDialogElement>('[data-null-pickup-dialog]');
      if (!dialog) return;
      // The card itself doesn't have a "open dialog" button by default —
      // the link in the card already routes to /admin/members. We keep
      // the dialog scaffolding here in case a future iteration wants to
      // surface a quick in-page peek; the close button still wires up.
      const closeBtn = $<HTMLButtonElement>('[data-null-pickup-close]', dialog);
      closeBtn?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (ev) => {
        if (ev.target === dialog) dialog.close();
      });
    }

    // ── Boot ──
    $<HTMLButtonElement>('[data-recon-run]')?.addEventListener('click', runReconciliation);
    wireDialog();
    fetchStatus();
    scheduleRefresh();

    // Pause polling when the tab is hidden — saves redundant requests
    // for admins who left the dashboard open in a background tab.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (refreshTimer !== undefined) clearTimeout(refreshTimer);
      } else {
        fetchStatus();
        scheduleRefresh();
      }
    });
  </script>
</AdminShell>
