---
/**
 * /admin/stop-manifest — landing page (week + stop selector).
 *
 * Spec §4.8. Default behavior: render a week picker + the list of
 * active stops for the upcoming cycle. Each stop is a card with the
 * cover totals (boxes, add-ons, flex orders, owes flag) and a CTA
 * "Open manifest" → /admin/stop-manifest/[week]/[stop_slug].
 *
 * Also surfaces a "Print all stops for this week" button → query param
 * ?all=1 on the slug page renders every stop in one printable doc with
 * page-breaks between each (handled by the slug page itself).
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { resolveCycle, slugStop, mondayOfWeek, currentDeliveryWeek, prettyWeekHeader } from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';

const supabase = Astro.locals.supabase;

const wkParam = Astro.url.searchParams.get('week') ?? '';
const week_starting = wkParam && /^\d{4}-\d{2}-\d{2}$/.test(wkParam)
  ? mondayOfWeek(wkParam)
  : currentDeliveryWeek();

const cycle = await resolveCycle(supabase, week_starting);
const options = weekOptions();
// Ensure the selected week is in the dropdown even if it's outside the
// default ±1 range (admin chose a custom week via URL).
if (!options.some((o) => o.value === week_starting)) {
  options.unshift({ value: week_starting, label: `Week of ${week_starting} (selected)` });
}

const totalBoxes = cycle.activeStops.reduce((a, s) => a + s.boxes_small + s.boxes_large, 0);
const totalAddOns = cycle.activeStops.reduce(
  (a, s) => a + s.addons.mushroom + s.addons.bread + s.addons.cheese + s.addons.coffee + s.addons.eggs + s.addons.unknown,
  0,
);
const totalFlex = cycle.activeStops.reduce((a, s) => a + s.flex_orders, 0);
const totalOwes = cycle.activeStops.reduce((a, s) => a + s.owes_count, 0);

const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};
---

<AdminShell
  title="Per-stop manifests"
  subtitle={prettyWeekHeader(week_starting)}
  pageTitle="Per-stop manifests — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <a
      href={`/admin/stop-manifest/${week_starting}?all=1`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      Print all stops for this week →
    </a>
  </Fragment>

  {/* ── Week selector ─────────────────────────────────────────────── */}
  <section aria-label="Week selector">
    <form method="GET" action="/admin/stop-manifest" class="flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Week</span>
        <select
          name="week"
          class="h-10 min-w-[220px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          {options.map((opt) => (
            <option value={opt.value} selected={opt.value === week_starting}>
              {opt.label}
            </option>
          ))}
        </select>
      </label>
      <button
        type="submit"
        class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        Load week
      </button>
    </form>
  </section>

  {/* ── Cover totals for the whole cycle ─────────────────────────── */}
  <section aria-labelledby="cycle-totals" class="flex flex-col gap-3">
    <h2 id="cycle-totals" class="font-display text-xl font-bold text-ts-text">Cycle totals</h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Total boxes</div>
        <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalBoxes}</div>
        <div class="mt-1 text-xs text-ts-text-secondary">{cycle.members.filter((m) => m.share_type === 'summer_veg').length} summer_veg members</div>
      </Card>
      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Add-ons</div>
        <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalAddOns}</div>
        <div class="mt-1 text-xs text-ts-text-secondary">across all vendors</div>
      </Card>
      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Flex orders</div>
        <div class="mt-1 font-display text-3xl font-bold tabular-nums text-ts-text">{totalFlex}</div>
        <div class="mt-1 text-xs text-ts-text-secondary">members with à-la-carte</div>
      </Card>
      <Card padding="md" elevation="sm">
        <div class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Owes balance</div>
        <div class={[
          'mt-1 font-display text-3xl font-bold tabular-nums',
          totalOwes > 0 ? 'text-ts-warning' : 'text-ts-text',
        ].join(' ')}>{totalOwes}</div>
        <div class="mt-1 text-xs text-ts-text-secondary">flagged on manifests</div>
      </Card>
    </div>
    {cycle.excluded_biweekly.length > 0 && (
      <p class="text-xs text-ts-text-muted">
        <strong class="font-semibold">{cycle.excluded_biweekly.length}</strong>
        {' '}biweekly off-week members excluded from this cycle.
        {cycle.excluded_on_hold.length > 0 && (
          <> · <strong class="font-semibold">{cycle.excluded_on_hold.length}</strong> on vacation hold.</>
        )}
      </p>
    )}
  </section>

  {/* ── Stops list ────────────────────────────────────────────────── */}
  <section aria-labelledby="stops-heading" class="flex flex-col gap-4">
    <h2 id="stops-heading" class="font-display text-xl font-bold text-ts-text">Stops this cycle</h2>
    {cycle.activeStops.length === 0 ? (
      <Card tone="muted" padding="lg" elevation="sm">
        <div class="text-center text-sm text-ts-text-secondary">
          No active members in this cycle. Try a different week.
        </div>
      </Card>
    ) : (
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
        {cycle.activeStops.map((stop) => {
          const totalBoxesAtStop = stop.boxes_small + stop.boxes_large;
          const totalAddonsAtStop = Object.values(stop.addons).reduce((a, b) => a + b, 0);
          const stopSlug = slugStop(stop.stop_name);
          const stopUrl = `/admin/stop-manifest/${week_starting}/${stopSlug}`;
          return (
            <Card padding="md" elevation="sm" hover>
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <a
                    href={stopUrl}
                    class="font-semibold text-ts-text underline-offset-2 hover:text-ts-primary hover:underline"
                  >
                    {stop.stop_name}
                  </a>
                  <p class="mt-0.5 text-xs text-ts-text-muted">
                    {stop.day_of_week ? DAY_LONG[stop.day_of_week] : 'Day TBD'}
                  </p>
                </div>
                <span class="shrink-0 rounded-ts-md bg-ts-primary/10 px-3 py-1 text-base font-bold tabular-nums text-ts-primary">
                  {totalBoxesAtStop}
                </span>
              </div>
              <p class="mt-3 text-xs text-ts-text-secondary tabular-nums">
                {stop.boxes_small} Small · {stop.boxes_large} Large
                {totalAddonsAtStop > 0 && ` · ${totalAddonsAtStop} add-ons`}
                {stop.flex_orders > 0 && ` · ${stop.flex_orders} flex`}
              </p>
              {stop.owes_count > 0 && (
                <p class="mt-2 text-xs font-semibold text-ts-warning">
                  ⚠ {stop.owes_count} owes balance
                </p>
              )}
              <a
                href={stopUrl}
                class="mt-3 inline-flex h-9 items-center justify-center rounded-ts-md bg-ts-primary px-3 text-xs font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark"
              >
                Open manifest →
              </a>
            </Card>
          );
        })}
      </div>
    )}
  </section>
</AdminShell>
