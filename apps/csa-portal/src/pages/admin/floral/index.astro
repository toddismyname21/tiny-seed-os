---
/**
 * /admin/floral — week-picker landing for the floral list.
 *
 * Mirrors /admin/harvest/index.astro. The floral list itself lives at
 * /admin/floral/[week] and draws flower-share counts straight from
 * resolveCycle (A/B biweekly + vacation holds + season all applied).
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { currentDeliveryWeek } from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';

const options = weekOptions();
const defaultWeek = currentDeliveryWeek();
---

<AdminShell
  title="Floral list"
  subtitle="Per stop, which bouquets to make for each distribution day."
  pageTitle="Floral list — Tiny Seed Admin"
>
  <section aria-label="Week selector">
    <form id="goto-form" class="flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Cycle week</span>
        <select id="week-select" class="h-10 min-w-[260px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text">
          {options.map((opt) => (
            <option value={opt.value} selected={opt.value === defaultWeek}>{opt.label}</option>
          ))}
        </select>
      </label>
      <button type="submit" class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm hover:bg-ts-primary-dark">
        Open floral list →
      </button>
    </form>
  </section>

  <Card padding="md" elevation="sm">
    <h2 class="font-display text-lg font-bold text-ts-text">How floral days map to distributions</h2>
    <ul class="mt-3 space-y-1.5 text-sm text-ts-text-secondary">
      <li>• <strong class="font-semibold text-ts-text">Monday floral</strong> → Tuesday (Lawrenceville) + Wednesday (all CSA stops + home delivery)</li>
      <li>• <strong class="font-semibold text-ts-text">Thursday floral</strong> → Saturday (Bloomfield + Sewickley markets)</li>
      <li>• Both tabs draw from the same Mon 6 AM cycle. Off-week (A/B biweekly) and on-hold flower members are excluded at the query level — no hand-counting.</li>
      <li>• Flowers are made/packed separately from veg; this is a clean stop-by-stop checklist (petite = small share, full = large share).</li>
    </ul>
  </Card>
</AdminShell>

<script is:inline>
  document.getElementById('goto-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const wk = (document.getElementById('week-select')).value;
    if (wk) window.location.href = `/admin/floral/${wk}?day=mon`;
  });
</script>
