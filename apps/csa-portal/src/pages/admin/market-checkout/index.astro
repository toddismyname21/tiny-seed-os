---
/**
 * /admin/market-checkout — staff tool to DEDUCT a farmers-market purchase
 * from a member's Farm Flex (Shopify store credit) balance on the spot.
 *
 * Mobile-FIRST. A staff member stands at the Tiny Seed table (Bloomfield /
 * Sewickley / South Side), looks up an ACTIVE FLEX member, sees their LIVE
 * balance, enters what they're taking ($ amount + optional items note), and
 * deducts it. THIS MOVES MONEY — see /api/admin/market-checkout.ts for the
 * server-side guards (re-fetch balance, never trust client, idempotency,
 * $500 cap, Shopify debit).
 *
 * Two stages on ONE page, switched on the `customer_id` query param:
 *   (1) no customer_id  → search box + matching active flex members list.
 *   (2) customer_id set → that member's name + stop + LIVE balance + a
 *       deduct form (amount required, optional items). The LIVE balance is
 *       fetched server-side via getFlexBalance(email) so the cap shown is
 *       real; the SERVER re-checks it again at submit.
 *
 * Confirmation: after a successful POST the API redirects back with
 * ?ok=deducted&amount=&name=&new_balance= → a BIG green banner with the new
 * balance. Errors come back as ?error=<code> with a clear red banner and
 * NOTHING deducted.
 *
 * Admin/staff-gated by middleware (covers /admin/*). No hardcoded URLs.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import BottomSheet from '../../../components/BottomSheet.astro';
import { getFlexBalance, formatFlexMoney } from '../../../lib/flex';

export const prerender = false;

const supabase = Astro.locals.supabase;
const params = Astro.url.searchParams;

const rawQ = (params.get('q') ?? '').trim();
const selectedCustomerId = (params.get('customer_id') ?? '').trim();
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

// ─── Confirmation / error banner state (from the POST redirect) ──────────
const okCode = params.get('ok');
const okAmount = params.get('amount');
const okName = params.get('name');
const okNewBalance = params.get('new_balance');
const errorCode = params.get('error');

/** Human-readable error copy. NOTHING was deducted for any of these. */
const ERROR_COPY: Record<string, string> = {
  invalid_input: 'Something was off with that submission. Please try again.',
  invalid_customer: 'That member could not be identified. Search and pick again.',
  invalid_amount: 'Enter a valid dollar amount.',
  amount_too_low: 'The amount must be more than $0.',
  amount_too_high: 'The amount is over the $500 limit. Run two separate charges if needed.',
  member_not_found: 'That member could not be found.',
  not_flex_member: 'That member is not an active Flex member, so there is no balance to deduct.',
  no_shopify_customer: 'No Shopify account found for that member — nothing deducted.',
  insufficient_funds: 'Not enough Farm Flex balance for that amount — nothing was deducted.',
  duplicate: 'That exact charge was just made moments ago — skipped to avoid charging twice.',
  shopify_unconfigured: 'Store credit is not available right now — nothing deducted.',
  shopify_error: "Couldn't reach the balance service — nothing was deducted. Try again.",
  debit_failed: "The deduction didn't go through — nothing was deducted. Try again.",
  network: 'A connection problem stopped the charge — nothing was deducted. Try again.',
};
const errorMessage = errorCode ? (ERROR_COPY[errorCode] ?? ERROR_COPY.invalid_input) : null;
// On error, re-open the selected member's form if we know who it was.
const errorCustomerId = (params.get('customer_id') ?? '').trim();

// ─── Stage 1: ALL active flex members (client-side filtered) ─────────────
// The full active-flex roster is small (~30, capped at 200), so we fetch the
// WHOLE list once on the server and embed it as JSON. A client-side script
// then filters it instantly on every keystroke — no page reload at the market
// table. The legacy `?q=` server path still works as a no-JS fallback: when
// JS is disabled the GET form reloads and we render only the matching rows.
interface FlexMatch {
  customer_id: string;
  name: string;
  email: string;
  stop: string;
}
/** Full active-flex roster (unfiltered) — embedded as JSON for client search. */
let allFlexMembers: FlexMatch[] = [];
let searchError = false;

if (!selectedCustomerId) {
  const { data, error } = await supabase
    .from('members')
    .select(
      `customer_id,
       pickup_location:pickup_locations(name),
       customer:customers!inner(id, contact_name, email)`
    )
    .eq('share_type', 'flex')
    .eq('status', 'active')
    .limit(200)
    .overrideTypes<
      {
        customer_id: string;
        pickup_location: { name: string } | { name: string }[] | null;
        customer:
          | { id: string; contact_name: string; email: string }
          | { id: string; contact_name: string; email: string }[]
          | null;
      }[],
      { merge: false }
    >();

  if (error) {
    console.error('[admin/market-checkout] flex roster load failed:', error.message);
    searchError = true;
  } else {
    const seen = new Set<string>();
    for (const r of data ?? []) {
      const cust = Array.isArray(r.customer) ? r.customer[0] : r.customer;
      if (!cust || !cust.email) continue;
      if (seen.has(r.customer_id)) continue; // one row per customer
      seen.add(r.customer_id);
      const pl = Array.isArray(r.pickup_location) ? r.pickup_location[0] : r.pickup_location;
      allFlexMembers.push({
        customer_id: r.customer_id,
        name: cust.contact_name,
        email: cust.email,
        stop: pl?.name ?? 'No stop set',
      });
    }
    allFlexMembers.sort((a, b) => a.name.localeCompare(b.name));
  }
}

// No-JS fallback: if a ?q= came in, filter the roster server-side so the GET
// form still narrows results without any client script. With JS on, the
// client filters the full embedded list instead (this set is ignored).
const noJsQuery = rawQ.toLowerCase();
const matches: FlexMatch[] =
  noJsQuery.length >= 1
    ? allFlexMembers.filter(
        (m) =>
          m.name.toLowerCase().includes(noJsQuery) ||
          m.email.toLowerCase().includes(noJsQuery)
      )
    : allFlexMembers;

// ─── Stage 2: selected member — name + stop + LIVE balance + deduct form ──
interface SelectedMember {
  customer_id: string;
  name: string;
  email: string;
  stop: string;
  /** Live flex balance (dollars) from Shopify; null when unavailable. */
  balance: number | null;
}
let selected: SelectedMember | null = null;
let selectedNotFound = false;

if (selectedCustomerId && UUID_RE.test(selectedCustomerId)) {
  type Row = {
    customer_id: string;
    pickup_location: { name: string } | { name: string }[] | null;
    customer: { id: string; contact_name: string; email: string } | { id: string; contact_name: string; email: string }[] | null;
  };
  const { data, error } = await supabase
    .from('members')
    .select(
      `customer_id,
       pickup_location:pickup_locations(name),
       customer:customers!inner(id, contact_name, email)`
    )
    .eq('customer_id', selectedCustomerId)
    .eq('share_type', 'flex')
    .eq('status', 'active')
    .limit(1)
    .maybeSingle()
    .overrideTypes<Row, { merge: false }>();

  if (error) {
    console.error('[admin/market-checkout] selected member lookup failed:', error.message);
    selectedNotFound = true;
  } else if (!data) {
    selectedNotFound = true;
  } else {
    const cust = Array.isArray(data.customer) ? data.customer[0] : data.customer;
    const pl = Array.isArray(data.pickup_location) ? data.pickup_location[0] : data.pickup_location;
    if (!cust || !cust.email) {
      selectedNotFound = true;
    } else {
      // LIVE balance — server-fetched. getFlexBalance fail-softs to null.
      const bal = await getFlexBalance(cust.email);
      selected = {
        customer_id: data.customer_id,
        name: cust.contact_name,
        email: cust.email,
        stop: pl?.name ?? 'No stop set',
        balance: bal ? bal.total : null,
      };
    }
  }
}

// A fresh idempotency token for this page render — embedded in the form so a
// double-tap on submit replays the SAME token (the server matches on amount,
// but this also lets us reason about a single logical submit).
const idemToken = crypto.randomUUID();
---

<AdminShell
  title="💳 Market checkout"
  subtitle="Deduct a market purchase from a member's Farm Flex"
  pageTitle="Market checkout — Tiny Seed Admin"
>
  {/* ── Success banner (BIG green) ──────────────────────────────────── */}
  {okCode === 'deducted' && okAmount && (
    <div
      class="mb-4 rounded-ts-lg border-2 border-ts-primary bg-ts-primary/10 p-5 shadow-ts-sm"
      role="status"
      aria-live="polite"
    >
      <div class="flex flex-col gap-1 text-center">
        <span class="text-4xl" aria-hidden="true">✅</span>
        <p class="font-display text-2xl font-extrabold text-ts-primary tabular-nums">
          Deducted ${okAmount}
        </p>
        {okName && (
          <p class="text-sm font-semibold text-ts-text">from {okName}'s Farm Flex</p>
        )}
        {okNewBalance && (
          <p class="mt-1 text-base font-bold text-ts-text tabular-nums">
            New balance: ${okNewBalance}
          </p>
        )}
      </div>
      <div class="mt-4 flex justify-center">
        <a
          href="/admin/market-checkout"
          class="inline-flex h-12 min-h-[44px] items-center justify-center rounded-ts-md bg-ts-primary px-6 text-base font-bold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          Next member →
        </a>
      </div>
    </div>
  )}

  {/* ── Error banner (red, NOTHING deducted) ────────────────────────── */}
  {errorMessage && (
    <div
      class="mb-4 rounded-ts-lg border-2 border-ts-danger bg-ts-danger/10 p-4 shadow-ts-sm"
      role="alert"
      aria-live="assertive"
    >
      <p class="flex items-start gap-2 text-sm font-semibold text-ts-danger">
        <span aria-hidden="true">⚠️</span>
        <span>{errorMessage}</span>
      </p>
      {UUID_RE.test(errorCustomerId) && (
        <div class="mt-3">
          <a
            href={`/admin/market-checkout?customer_id=${encodeURIComponent(errorCustomerId)}`}
            class="inline-flex h-11 min-h-[44px] items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
          >
            ← Back to that member
          </a>
        </div>
      )}
    </div>
  )}

  {selected ? (
    /* ════ STAGE 2: deduct from the selected member ════ */
    <div class="flex flex-col gap-4">
      <a
        href="/admin/market-checkout"
        class="inline-flex h-11 min-h-[44px] w-fit items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
      >
        ← New search
      </a>

      <Card padding="lg" elevation="sm">
        <div class="flex flex-col gap-1">
          <p class="font-display text-2xl font-extrabold text-ts-text">{selected.name}</p>
          <p class="text-sm text-ts-text-secondary">📍 {selected.stop}</p>
          <p class="text-xs text-ts-text-muted">{selected.email}</p>
        </div>

        {/* LIVE balance — the "before" number, big. */}
        <div class="mt-4 rounded-ts-lg border border-ts-border bg-ts-bg-base p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">
            Farm Flex balance
          </p>
          {selected.balance !== null ? (
            <p class="font-display text-3xl font-extrabold text-ts-primary tabular-nums">
              {formatFlexMoney(selected.balance)}
            </p>
          ) : (
            <p class="mt-1 text-sm font-semibold text-ts-danger">
              ⚠️ Balance unavailable right now — can't safely deduct. Try again in a moment.
            </p>
          )}
        </div>

        {selected.balance !== null && selected.balance > 0 ? (
          <form
            method="POST"
            action="/api/admin/market-checkout"
            class="mt-5 flex flex-col gap-4"
            data-checkout-form
            data-balance={selected.balance.toFixed(2)}
            data-name={selected.name}
          >
            <input type="hidden" name="customer_id" value={selected.customer_id} />
            <input type="hidden" name="idem" value={idemToken} />

            <div>
              <label for="amount" class="mb-1 block text-sm font-semibold text-ts-text">
                Amount to deduct
              </label>
              <div class="relative">
                <span
                  class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-lg font-bold text-ts-text-muted"
                  aria-hidden="true"
                >
                  $
                </span>
                <input
                  id="amount"
                  name="amount"
                  type="number"
                  inputmode="decimal"
                  step="0.01"
                  min="0.01"
                  max={Math.min(500, selected.balance).toFixed(2)}
                  required
                  autocomplete="off"
                  placeholder="0.00"
                  class="h-14 w-full rounded-ts-md border border-ts-border bg-ts-bg-surface pl-8 pr-3 text-2xl font-bold tabular-nums text-ts-text focus:border-ts-primary focus:outline-none focus:ring-2 focus:ring-ts-primary/30"
                />
              </div>
              <p class="mt-1 text-xs text-ts-text-muted tabular-nums" data-amount-hint>
                Max {formatFlexMoney(Math.min(500, selected.balance))} · $500 cap per charge
              </p>
            </div>

            <div>
              <label for="note" class="mb-1 block text-sm font-semibold text-ts-text">
                Items <span class="font-normal text-ts-text-muted">(optional)</span>
              </label>
              <input
                id="note"
                name="note"
                type="text"
                maxlength="280"
                autocomplete="off"
                placeholder="e.g. 2 lettuce, 1 garlic, tomatoes"
                class="h-12 w-full rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-base text-ts-text focus:border-ts-primary focus:outline-none focus:ring-2 focus:ring-ts-primary/30"
              />
            </div>

            <button
              type="submit"
              data-submit
              class="inline-flex h-14 min-h-[44px] items-center justify-center gap-2 rounded-ts-md bg-ts-primary px-6 text-lg font-extrabold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary disabled:cursor-not-allowed disabled:opacity-60"
            >
              💳 Deduct from Farm Flex
            </button>
            <p class="text-center text-xs text-ts-text-muted">
              You'll confirm the amount before it's charged.
            </p>
          </form>
        ) : selected.balance === 0 ? (
          <p class="mt-5 rounded-ts-md border border-ts-border bg-ts-bg-base p-4 text-sm font-semibold text-ts-text-secondary">
            This member has $0 in Farm Flex — nothing to deduct. They can add funds in their account.
          </p>
        ) : null}
      </Card>

      {/* ── Confirmation bottom-sheet (replaces window.confirm) ──────────
          Slides up from the bottom on submit. The $ amount + name are
          injected from the live form values at submit time, so they're
          always correct. Confirm → submits the real form (idem token +
          all fields preserved). Cancel / backdrop / Escape → dismiss,
          nothing charged. */}
      {selected.balance !== null && selected.balance > 0 && (
        <BottomSheet id="sheet-confirm-deduct" titleId="sheet-confirm-deduct-title" size="sm">
          <h2
            slot="title"
            id="sheet-confirm-deduct-title"
            class="font-display text-xl font-semibold text-ts-text"
          >
            Confirm deduction
          </h2>
          <p class="text-center text-lg leading-relaxed text-ts-text">
            Deduct
            {' '}<strong class="font-display text-3xl font-extrabold text-ts-danger tabular-nums" data-confirm-amount>$0.00</strong>
            {' '}from
            {' '}<strong class="text-ts-text" data-confirm-name>this member</strong>?
          </p>
          <p class="mt-2 text-center text-sm text-ts-text-secondary">
            This moves real money from their Farm Flex balance.
          </p>
          <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button
              type="button"
              class="inline-flex h-12 min-h-[48px] items-center justify-center rounded-ts-md px-5 text-base font-semibold text-ts-text-secondary transition-colors duration-150 hover:bg-ts-bg-muted hover:text-ts-text active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary [touch-action:manipulation]"
              data-bottom-sheet-close
            >
              Cancel
            </button>
            <button
              type="button"
              class="inline-flex h-12 min-h-[48px] min-w-[10rem] items-center justify-center gap-2 rounded-ts-md bg-ts-danger px-5 text-base font-extrabold text-white shadow-ts-sm transition-all duration-150 hover:brightness-95 active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-danger disabled:cursor-not-allowed disabled:opacity-60 [touch-action:manipulation]"
              data-confirm-deduct
            >
              <span data-confirm-label>💳 Yes, deduct</span>
            </button>
          </div>
        </BottomSheet>
      )}
    </div>
  ) : selectedNotFound ? (
    /* Selected id didn't resolve to an active flex member. */
    <Card tone="warning" padding="lg" elevation="sm">
      <div class="flex flex-col items-center gap-3 py-4 text-center">
        <span class="text-4xl" aria-hidden="true">🔍</span>
        <p class="text-sm text-ts-text-secondary">
          That member isn't an active Flex member (or couldn't be found).
        </p>
        <a
          href="/admin/market-checkout"
          class="inline-flex h-11 min-h-[44px] items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
        >
          ← New search
        </a>
      </div>
    </Card>
  ) : (
    /* ════ STAGE 1: instant client-side search over the full flex roster ════ */
    <div class="flex flex-col gap-4">
      {/* Full active-flex roster, embedded for the client filter script. */}
      <script is:inline type="application/json" id="flex-members" set:html={JSON.stringify(allFlexMembers)} />

      <Card padding="lg" elevation="sm">
        {/* method=GET keeps a no-JS fallback working: submitting reloads the
            page with ?q= and the server filters. With JS on, we filter the
            embedded roster live on `input` and never reload. */}
        <form method="GET" action="/admin/market-checkout" class="flex flex-col gap-3" role="search" data-search-form>
          <label for="q" class="text-sm font-semibold text-ts-text">
            Find a Flex member
          </label>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input
              id="q"
              name="q"
              type="search"
              value={rawQ}
              autocomplete="off"
              autofocus
              placeholder="Name or email…"
              class="h-14 w-full rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-lg text-ts-text focus:border-ts-primary focus:outline-none focus:ring-2 focus:ring-ts-primary/30"
              data-search-input
            />
            {/* Visible only without JS — the live filter makes it redundant. */}
            <noscript>
              <button
                type="submit"
                class="inline-flex h-14 min-h-[44px] shrink-0 items-center justify-center rounded-ts-md bg-ts-primary px-6 text-base font-bold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
              >
                Search
              </button>
            </noscript>
          </div>
          <p class="text-xs text-ts-text-muted">
            Only active Flex members appear here. <span data-search-count>Showing {matches.length} {matches.length === 1 ? 'member' : 'members'}</span>.
          </p>
        </form>
      </Card>

      {searchError ? (
        <Card tone="danger" padding="md" elevation="sm">
          <p class="text-sm font-semibold text-ts-danger">
            ⚠️ Couldn't load the member list. Check your connection and try again.
          </p>
        </Card>
      ) : allFlexMembers.length === 0 ? (
        <Card tone="muted" padding="lg" elevation="sm">
          <div class="flex flex-col items-center gap-3 py-4 text-center">
            <span class="text-4xl" aria-hidden="true">💳</span>
            <p class="text-sm text-ts-text-secondary">
              No active Flex members on file yet.
            </p>
          </div>
        </Card>
      ) : (
        <>
          {/* Live results list (JS filters this in place). Server-rendered with
              the no-JS `matches` so the page is useful even before the script
              runs / when JS is off. */}
          <ul class="flex flex-col gap-3" data-member-list>
            {matches.map((m) => (
              <li
                data-member-row
                data-name={m.name.toLowerCase()}
                data-email={m.email.toLowerCase()}
              >
                <a
                  href={`/admin/market-checkout?customer_id=${encodeURIComponent(m.customer_id)}`}
                  class="flex min-h-[56px] items-center justify-between gap-3 rounded-ts-lg border border-ts-border bg-ts-bg-surface p-4 shadow-ts-sm transition-colors duration-150 hover:border-ts-primary/50 active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
                >
                  <div class="min-w-0">
                    <p class="font-display text-lg font-bold text-ts-text">{m.name}</p>
                    <p class="mt-0.5 truncate text-xs text-ts-text-secondary">
                      📍 {m.stop} · {m.email}
                    </p>
                  </div>
                  <span class="shrink-0 text-2xl text-ts-text-muted" aria-hidden="true">›</span>
                </a>
              </li>
            ))}
          </ul>

          {/* Empty state shown by the client script when a query matches nobody. */}
          <div data-member-empty hidden>
            <Card tone="muted" padding="lg" elevation="sm">
              <div class="flex flex-col items-center gap-3 py-4 text-center">
                <span class="text-4xl" aria-hidden="true">🔍</span>
                <p class="text-sm text-ts-text-secondary">
                  No active Flex members match "<strong class="text-ts-text" data-member-empty-q></strong>".
                </p>
                <p class="text-xs text-ts-text-muted">
                  Try a different spelling, or search by email.
                </p>
              </div>
            </Card>
          </div>
        </>
      )}
    </div>
  )}
</AdminShell>

{/* ── Stage 1: instant client-side member filter ───────────────────────
    Reads the full active-flex roster embedded as JSON, filters it on every
    keystroke (case-insensitive name OR email match), and shows/hides the
    server-rendered rows in place — no page reload. The GET form's submit is
    suppressed so Enter never triggers a reload. Falls back gracefully: if
    this script never runs, the server-rendered list + ?q= GET form work. */}
<script is:inline>
  (function () {
    var input = document.querySelector('[data-search-input]');
    var list = document.querySelector('[data-member-list]');
    if (!input || !list) return;

    var searchForm = document.querySelector('[data-search-form]');
    var countEl = document.querySelector('[data-search-count]');
    var emptyWrap = document.querySelector('[data-member-empty]');
    var emptyQ = document.querySelector('[data-member-empty-q]');

    // Authoritative roster from the embedded JSON — used to render rows that
    // the server may have omitted under a ?q= no-JS fallback. We re-render the
    // full list from JSON so the live filter always has every member.
    var members = [];
    try {
      var raw = document.getElementById('flex-members');
      if (raw && raw.textContent) members = JSON.parse(raw.textContent) || [];
    } catch (err) {
      // If JSON is malformed, leave the server-rendered rows as-is.
      members = null;
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    // Rebuild the list from the authoritative JSON so every member is present
    // even if the server pre-filtered (no-JS path). Skip if JSON failed.
    if (members) {
      var html = '';
      for (var i = 0; i < members.length; i++) {
        var m = members[i];
        html +=
          '<li data-member-row data-name="' +
          escapeHtml((m.name || '').toLowerCase()) +
          '" data-email="' +
          escapeHtml((m.email || '').toLowerCase()) +
          '">' +
          '<a href="/admin/market-checkout?customer_id=' +
          encodeURIComponent(m.customer_id) +
          '" class="flex min-h-[56px] items-center justify-between gap-3 rounded-ts-lg border border-ts-border bg-ts-bg-surface p-4 shadow-ts-sm transition-colors duration-150 hover:border-ts-primary/50 active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary">' +
          '<div class="min-w-0">' +
          '<p class="font-display text-lg font-bold text-ts-text">' +
          escapeHtml(m.name || '') +
          '</p>' +
          '<p class="mt-0.5 truncate text-xs text-ts-text-secondary">📍 ' +
          escapeHtml(m.stop || 'No stop set') +
          ' · ' +
          escapeHtml(m.email || '') +
          '</p></div>' +
          '<span class="shrink-0 text-2xl text-ts-text-muted" aria-hidden="true">›</span>' +
          '</a></li>';
      }
      list.innerHTML = html;
    }

    var rows = Array.prototype.slice.call(list.querySelectorAll('[data-member-row]'));

    function applyFilter() {
      var q = (input.value || '').trim().toLowerCase();
      var shown = 0;
      for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var name = row.getAttribute('data-name') || '';
        var email = row.getAttribute('data-email') || '';
        var match = q === '' || name.indexOf(q) !== -1 || email.indexOf(q) !== -1;
        row.hidden = !match;
        if (match) shown++;
      }
      if (countEl) {
        countEl.textContent = 'Showing ' + shown + (shown === 1 ? ' member' : ' members');
      }
      if (emptyWrap) {
        var noMatches = shown === 0 && rows.length > 0;
        emptyWrap.hidden = !noMatches;
        if (noMatches && emptyQ) emptyQ.textContent = input.value.trim();
      }
    }

    input.addEventListener('input', applyFilter);
    // Suppress GET submit (Enter key) so we never reload while filtering.
    if (searchForm) {
      searchForm.addEventListener('submit', function (e) {
        e.preventDefault();
      });
    }
    // Run once so a server-prefilled ?q= reflows to the full client view.
    applyFilter();
  })();
</script>

{/* ── Stage 2: validation + bottom-sheet confirmation before charging ────
    The button no longer submits directly. On submit we validate the amount,
    then open a design-system bottom sheet (NOT window.confirm). The sheet's
    $ amount + name are read from the LIVE form values at submit time. Confirm
    → submits the real form (idem token + all fields preserved) and disables
    the trigger so a second tap can't double-charge. Cancel / backdrop /
    Escape → dismiss, nothing charged. The server ALSO enforces idempotency +
    balance re-check; this is the client-side belt to the server's suspenders. */}
<script is:inline>
  (function () {
    var form = document.querySelector('[data-checkout-form]');
    if (!form) return;
    var amountEl = form.querySelector('#amount');
    var btn = form.querySelector('[data-submit]');
    var balance = parseFloat(form.getAttribute('data-balance') || '0');
    var name = form.getAttribute('data-name') || 'this member';
    var CAP = 500;

    var sheetId = 'sheet-confirm-deduct';
    var amountSlot = document.querySelector('[data-confirm-amount]');
    var nameSlot = document.querySelector('[data-confirm-name]');
    var confirmBtn = document.querySelector('[data-confirm-deduct]');
    var confirmLabel = document.querySelector('[data-confirm-label]');

    var pendingSubmit = false;

    function actuallySubmit() {
      // Disable the trigger so a second tap can't double-charge, then submit
      // the real form (idem token + all fields intact).
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Charging…';
      }
      pendingSubmit = true;
      form.submit();
    }

    form.addEventListener('submit', function (e) {
      // Allow the programmatic submit from the confirm button to pass through.
      if (pendingSubmit) return;

      e.preventDefault();

      var raw = (amountEl && amountEl.value ? amountEl.value : '').trim();
      var amt = parseFloat(raw);

      if (!isFinite(amt) || amt <= 0) {
        alert('Enter a dollar amount greater than $0.');
        return;
      }
      if (amt > CAP) {
        alert('That is over the $500 limit per charge. Run two separate charges if needed.');
        return;
      }
      // Round to cents for the comparison + display.
      amt = Math.round(amt * 100) / 100;
      if (amt > balance + 0.001) {
        alert(
          'That is more than the balance ($' +
            balance.toFixed(2) +
            '). Lower the amount — nothing has been charged.'
        );
        return;
      }

      // Populate the sheet from the LIVE form values, then open it.
      if (amountSlot) amountSlot.textContent = '$' + amt.toFixed(2);
      if (nameSlot) nameSlot.textContent = name;

      var helper = window.BottomSheet;
      if (helper && typeof helper.open === 'function') {
        helper.open(sheetId, btn || undefined);
      } else {
        // Hard fallback if the sheet helper didn't load: native confirm.
        if (window.confirm('Deduct $' + amt.toFixed(2) + ' from ' + name + "'s Farm Flex balance?")) {
          actuallySubmit();
        }
      }
    });

    if (confirmBtn) {
      confirmBtn.addEventListener('click', function () {
        var helper = window.BottomSheet;
        if (helper && typeof helper.close === 'function') helper.close(sheetId);
        if (confirmLabel) confirmLabel.textContent = 'Charging…';
        confirmBtn.disabled = true;
        actuallySubmit();
      });
    }
  })();
</script>
