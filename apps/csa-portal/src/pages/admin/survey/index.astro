---
/**
 * /admin/survey — 📊 Fall 2026 member survey results.
 *
 * Companion to the public /survey form (Todd 2026-09-23: "send a survey out
 * to the CSA members ... get the updates through this weekend"). This is the
 * read side: summary stats up top (overall + delivery averages, Track My Box
 * awareness, arrival-text consistency — the two delivery tools the survey
 * probes), then every response in full, newest first.
 *
 * Distinct from /admin/feedback (weekly post-pickup box micro-survey on
 * box_feedback) — this reads member_survey_responses, the one-off campaign
 * table. Reads via the cookie-aware client under requireAdmin; the table has
 * no anon policies, so the service path in AdminShell's guard is the gate.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import { supabaseAdmin } from '../../../lib/supabase';

export const prerender = false;

interface Row {
  id: string;
  created_at: string;
  email: string | null;
  overall_rating: number | null;
  working_well: string | null;
  improve: string | null;
  delivery_rating: number | null;
  used_tracker: string | null;
  gets_arrival_texts: string | null;
  tools_helpful: string | null;
  comments: string | null;
}

const { data } = await supabaseAdmin
  .from('member_survey_responses')
  .select('*')
  .order('created_at', { ascending: false });
const rows = (data ?? []) as Row[];

const avg = (vals: (number | null)[]): string => {
  const v = vals.filter((n): n is number => typeof n === 'number');
  return v.length ? (v.reduce((a, b) => a + b, 0) / v.length).toFixed(1) : '—';
};
const count = (key: keyof Row, val: string): number =>
  rows.filter((r) => r[key] === val).length;

const overallAvg = avg(rows.map((r) => r.overall_rating));
const deliveryAvg = avg(rows.map((r) => r.delivery_rating));

const TRACKER_LABELS: Record<string, string> = {
  yes: 'Used it', no: "Haven't used it", didnt_know: "Didn't know it existed",
};
const TEXT_LABELS: Record<string, string> = {
  always: 'Always', sometimes: 'Sometimes', never: 'Never', not_sure: 'Not sure',
};

const fmt = (iso: string): string =>
  new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/New_York', month: 'short', day: 'numeric',
    hour: 'numeric', minute: '2-digit',
  }).format(new Date(iso));
---

<AdminShell
  title="Fall 2026 member survey"
  subtitle={`${rows.length} response${rows.length === 1 ? '' : 's'} · sent 9/23 to 194 households`}
  pageTitle="Survey results — Tiny Seed Admin"
>
  <p class="mb-4 text-sm text-ts-text-secondary">
    <a class="font-semibold text-ts-primary underline" href="/admin/survey/flowers">💐 Flower CSA survey results →</a>
  </p>

  <div class="grid gap-4 sm:grid-cols-4">
    <Card padding="md" elevation="sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Responses</p>
      <p class="mt-1 font-display text-3xl font-bold text-ts-text">{rows.length}</p>
      <p class="text-xs text-ts-text-muted">{Math.round((rows.length / 194) * 100)}% of 194 sent</p>
    </Card>
    <Card padding="md" elevation="sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Overall avg</p>
      <p class="mt-1 font-display text-3xl font-bold text-ts-text">{overallAvg}<span class="text-base font-normal text-ts-text-muted"> / 5</span></p>
    </Card>
    <Card padding="md" elevation="sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Delivery avg</p>
      <p class="mt-1 font-display text-3xl font-bold text-ts-text">{deliveryAvg}<span class="text-base font-normal text-ts-text-muted"> / 5</span></p>
    </Card>
    <Card padding="md" elevation="sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Low overall (≤2)</p>
      <p class={`mt-1 font-display text-3xl font-bold ${rows.some((r) => (r.overall_rating ?? 5) <= 2) ? 'text-ts-danger' : 'text-ts-text'}`}>
        {rows.filter((r) => (r.overall_rating ?? 5) <= 2).length}
      </p>
      <p class="text-xs text-ts-text-muted">follow up within 48h</p>
    </Card>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <Card padding="md" elevation="sm">
      <h2 class="font-display text-base font-bold text-ts-text">📍 Track My Box awareness</h2>
      <ul class="mt-2 space-y-1 text-sm text-ts-text-secondary">
        {Object.entries(TRACKER_LABELS).map(([k, label]) => (
          <li class="flex justify-between">
            <span>{label}</span>
            <span class="font-semibold text-ts-text">{count('used_tracker', k)}</span>
          </li>
        ))}
      </ul>
    </Card>
    <Card padding="md" elevation="sm">
      <h2 class="font-display text-base font-bold text-ts-text">💬 "Do you get an arrival text?"</h2>
      <ul class="mt-2 space-y-1 text-sm text-ts-text-secondary">
        {Object.entries(TEXT_LABELS).map(([k, label]) => (
          <li class="flex justify-between">
            <span>{label}</span>
            <span class="font-semibold text-ts-text">{count('gets_arrival_texts', k)}</span>
          </li>
        ))}
      </ul>
    </Card>
  </div>

  <section class="mt-6" aria-label="All responses">
    <h2 class="mb-3 font-display text-lg font-bold text-ts-text">All responses (newest first)</h2>
    <div class="space-y-3">
      {rows.map((r) => (
        <Card padding="md" elevation="sm">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="text-sm font-semibold text-ts-text">{r.email || 'anonymous'}</p>
            <p class="text-xs text-ts-text-muted">{fmt(r.created_at)}</p>
          </div>
          <p class="mt-1 text-xs text-ts-text-secondary">
            Overall <strong class={(r.overall_rating ?? 5) <= 2 ? 'text-ts-danger' : 'text-ts-text'}>{r.overall_rating ?? '—'}/5</strong>
            &nbsp;·&nbsp; Delivery <strong>{r.delivery_rating ?? '—'}/5</strong>
            &nbsp;·&nbsp; Tracker: {TRACKER_LABELS[r.used_tracker ?? ''] ?? '—'}
            &nbsp;·&nbsp; Texts: {TEXT_LABELS[r.gets_arrival_texts ?? ''] ?? '—'}
          </p>
          {r.working_well && (
            <p class="mt-2 text-sm text-ts-text"><span class="font-semibold text-ts-primary">👍 Working:</span> {r.working_well}</p>
          )}
          {r.improve && (
            <p class="mt-2 text-sm text-ts-text"><span class="font-semibold text-amber-700">🔧 Improve:</span> {r.improve}</p>
          )}
          {r.tools_helpful && (
            <p class="mt-2 text-sm text-ts-text"><span class="font-semibold text-ts-text-secondary">🛠 Tools:</span> {r.tools_helpful}</p>
          )}
          {r.comments && (
            <p class="mt-2 text-sm text-ts-text"><span class="font-semibold text-ts-text-secondary">💭 Comments:</span> {r.comments}</p>
          )}
        </Card>
      ))}
      {rows.length === 0 && (
        <Card padding="md" elevation="sm"><p class="text-sm text-ts-text-secondary">No responses yet.</p></Card>
      )}
    </div>
  </section>
</AdminShell>
