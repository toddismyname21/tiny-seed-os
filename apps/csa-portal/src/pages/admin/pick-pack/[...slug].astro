---
/**
 * /admin/pick-pack/[week]            → OVERALL harvest (tender greens first).
 * /admin/pick-pack/[week]?lang=es    → OVERALL harvest in Spanish.
 * /admin/pick-pack/[week]?view=csa        → CSA box checklist by crop.
 * /admin/pick-pack/[week]?view=wholesale  → Wholesale order checklist by crop.
 * /admin/pick-pack/[week]?view=market&market=<id> → one market's checklist.
 *
 * The Pick & Pack generator. ONE cycle resolution + the market_offerings and
 * wholesale_order_items reads feed a single per-crop demand merge (see
 * lib/pick-pack.ts). Each view is a printable, big, clean, ONE-COLUMN document
 * with tickable "[   ]" boxes — built for the pack floor, not the screen.
 *
 * CSA demand is STRICTLY from resolveCycle (sum of each summer_veg member's
 * resolved box composition). Sum per crop = CSA box demand + market planned_qty
 * (across that crop's offerings) + wholesale order item qty.
 *
 * Print CSS pattern mirrors /admin/pack-check + /admin/route-sheet: AdminShell
 * hides its own chrome via print:hidden, and the @page block forces Letter
 * portrait + keeps each row whole.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import CombinedHarvestRow from '../../../components/CombinedHarvestRow.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY } from 'astro:env/client';
import {
  resolveCycle, prettyWeekHeader, mondayOfWeek, isMonday, addDays,
} from '../../../lib/cycle';
import {
  mergeCropDemand, channelCount, parseLang, normCrop, cropMergeKey, PICK_PACK_STRINGS,
  pickPackLineKey, buildDestinationMatrix, groupBySection, packLbForUnits, fmtLb,
  type CropDemandInput, type DestDemandInput, type DestKind, type MatrixRow,
  type CrewSectionGroup,
} from '../../../lib/pick-pack';
import {
  fetchAllOpenDueNoticesWithMember, isNoticeOverdue, HOME_DELIVERY_HINT,
  type NoticeWithMember,
} from '../../../lib/notices';

/* ── Two clients, deliberately (interactive P&P, migration 0069) ──────────────
 * `db` (service-role) loads the PER-CROP AGGREGATE demand so a CREW user — who
 * does NOT clear the admin RLS bypass — still sees the harvest/pack numbers. It
 * is safe because EVERY pick-pack view renders per-crop aggregates only (crop
 * name + qty + unit + lb + photo) — verified: no member contact_name/email/
 * phone/address is rendered in any view.
 *
 * `supabase` (the cookie-aware RLS client) is kept for the TWO reads that touch
 * member-linked data — the make-ups banner (member_notices, which joins
 * customers.contact_name) and its pickup_locations day map. member_notices RLS
 * is admin/staff-only (notices_staff_all, 0043), so for a crew user these return
 * EMPTY and the make-ups banner never renders — the member names never reach
 * crew. It is ALSO the client for the pick_pack_progress read (is_ops_caller
 * lets crew read the shared board). Admin/staff behavior is unchanged (service-
 * role returns them the same rows their RLS bypass did). */
const supabase = Astro.locals.supabase;
const db = supabaseAdmin;
const slugParam = (Astro.params.slug ?? '') as string;
const segments = slugParam.split('/').filter(Boolean);
const week_input = segments[0] ?? '';
if (!/^\d{4}-\d{2}-\d{2}$/.test(week_input)) {
  return Astro.redirect('/admin/pick-pack', 303);
}
const week_starting = isMonday(week_input) ? week_input : mondayOfWeek(week_input);

const viewRaw = Astro.url.searchParams.get('view') ?? 'overall';
const view: 'overall' | 'csa' | 'wholesale' | 'market' | 'packhouse' | 'printpack' =
  viewRaw === 'csa' || viewRaw === 'wholesale' || viewRaw === 'market'
    || viewRaw === 'packhouse' || viewRaw === 'printpack'
    ? viewRaw : 'overall';
const marketIdParam = Astro.url.searchParams.get('market') ?? '';
const lang = parseLang(Astro.url.searchParams.get('lang'));
const t = PICK_PACK_STRINGS[lang];
// ?print=1 → auto-open the browser print dialog on load (one-tap market prints
// from the Pick & Pack landing). Screen chrome is print:hidden already.
const autoPrint = Astro.url.searchParams.get('print') === '1';

/* ── Harvest-day scope (mirrors /admin/harvest) ─────────────────────
 * ?day=mon → demand for Tue + Wed distributions (Monday harvest)
 * ?day=thu → demand for Sat + Sun distributions (Thursday harvest)
 * ?day=all → the whole week merged (default — current behavior). */
const dayRaw = Astro.url.searchParams.get('day') ?? 'all';
const dayScope: 'mon' | 'thu' | 'all' =
  dayRaw === 'mon' || dayRaw === 'thu' ? dayRaw : 'all';

const cycle = await resolveCycle(db, week_starting);
const weekEnd = addDays(week_starting, 6);

/* ── Day-classification rules — copied verbatim from /admin/harvest so the
 *    combined totals reconcile with the harvest page. ─────────────────── */
/** CSA member → harvest day: Sat/Sun pickup → thu; everything else → mon. */
function harvestTabForMember(day: string | null | undefined): 'mon' | 'thu' {
  return day === 'Sat' || day === 'Sun' ? 'thu' : 'mon';
}
/** DOW (0=Sun…6=Sat) of a YYYY-MM-DD date, parsed as UTC (TZ-safe). */
function dowOfYMD(ymd: string): number {
  const [y, mo, d] = ymd.split('-').map(Number);
  return new Date(Date.UTC(y, (mo || 1) - 1, d || 1)).getUTCDay();
}
/** Wholesale → harvest day: Fri(5)/Sat(6) delivery → thu; else → mon. */
function wholesaleTabFor(deliveryDate: string): 'mon' | 'thu' {
  const dow = dowOfYMD(deliveryDate);
  return dow === 5 || dow === 6 ? 'thu' : 'mon';
}
/** Market → harvest day: Tue → mon; Sat/Sun → thu; else excluded (null). */
function marketTabFor(day: string | null | undefined): 'mon' | 'thu' | null {
  if (day === 'Tue') return 'mon';
  if (day === 'Sat' || day === 'Sun') return 'thu';
  return null;
}
/**
 * True if a member/wholesale row on `tab` is in the current scope.
 * On 'all' everything passes (unchanged whole-week behavior). On mon/thu the
 * row's tab must match. NOTE: market uses `marketInScope` instead, because on
 * 'all' pick-pack keeps EVERY market (incl. untagged), matching prior behavior.
 */
function inScope(tab: 'mon' | 'thu'): boolean {
  return dayScope === 'all' || tab === dayScope;
}
/**
 * True if a market with `day_of_week` is in scope. On 'all' every market is
 * kept (incl. untagged — the prior overall behavior). On mon/thu only markets
 * that map to the selected harvest tab are kept.
 */
function marketInScope(day: string | null | undefined): boolean {
  if (dayScope === 'all') return true;
  return marketTabFor(day) === dayScope;
}

/* ──────────────────────────────────────────────────────────────────
 * 1. CSA box demand by crop — STRICTLY from resolveCycle.
 *    Sum each summer_veg member's resolved composition (default plan +
 *    locked swaps + allergy subs) per crop+unit.
 * ────────────────────────────────────────────────────────────────── */
interface CropAgg { crop: string; unit: string; qty: number; }
// CSA aggregate carries the small/large box split so the pack-house matrix can
// render "12 (8S/4L)" — the crew packs sizes differently. A member is counted
// LARGE iff their size_bucket resolves to 'large' (the SAME rule resolveCycle
// uses to pick the box plan: `size_bucket === 'large' ? 'large' : 'small'`), so
// small + large is a per-SIZE demand total (not a member headcount) and always
// sums to qty.
interface CsaCropAgg extends CropAgg { small: number; large: number; }
const csaMap = new Map<string, CsaCropAgg>(); // key = crop|unit
for (const m of cycle.members) {
  if (m.share_type !== 'summer_veg') continue;
  // Scope to the selected harvest day (Sat/Sun pickup → thu; else → mon).
  if (!inScope(harvestTabForMember(m.pickup_location?.day_of_week))) continue;
  const comp = cycle.boxCompositionByMember.get(m.id);
  if (!comp) continue;
  const isLarge = m.size_bucket === 'large';
  for (const line of comp.items) {
    const key = `${line.crop.toLowerCase()}|${line.unit.toLowerCase()}`;
    const e = csaMap.get(key);
    if (e) {
      e.qty += line.qty;
      if (isLarge) e.large += line.qty; else e.small += line.qty;
    } else {
      csaMap.set(key, {
        crop: line.crop, unit: line.unit, qty: line.qty,
        small: isLarge ? 0 : line.qty, large: isLarge ? line.qty : 0,
      });
    }
  }
}
const csaRows = Array.from(csaMap.values())
  .filter((r) => r.qty > 0)
  .sort((a, b) => a.crop.localeCompare(b.crop, undefined, { sensitivity: 'base' })); // A→Z (crew request 2026-07-13)

/* ──────────────────────────────────────────────────────────────────
 * 2. Library category + photo lookup (for tender-green ordering + thumbs).
 * ────────────────────────────────────────────────────────────────── */
interface LibRow { name: string; photo_url: string | null; category: string | null; pack_weight_lb: number | null; harvest_crop: string | null; }
interface LibEntry { name: string | null; photo: string | null; category: string | null; packWeightLb: number | null; harvestCrop: string | null; }
const { data: libRows } = await db
  .from('product_library')
  .select('name, photo_url, category, pack_weight_lb, harvest_crop')
  .overrideTypes<LibRow[], { merge: false }>();
// Keyed BOTH by exact-lowercase name AND by the merge's normCrop() key, so a
// wholesale row like "King Spring Mix (per lb)" still resolves to the library
// product "King Spring Mix" (same normalization the demand merge uses). Exact
// match wins; the normalized alias fills gaps without clobbering a real row.
const libByName = new Map<string, LibEntry>();
const libByNorm = new Map<string, LibEntry>();
for (const lp of libRows ?? []) {
  const raw = lp.name?.trim();
  if (!raw) continue;
  const entry: LibEntry = { name: raw, photo: lp.photo_url, category: lp.category, packWeightLb: lp.pack_weight_lb, harvestCrop: lp.harvest_crop };
  const exact = raw.toLowerCase();
  if (!libByName.has(exact)) libByName.set(exact, entry);
  const norm = normCrop(raw);
  if (norm && !libByNorm.has(norm)) libByNorm.set(norm, entry);
}
const EMPTY_LIB: LibEntry = { name: null, photo: null, category: null, packWeightLb: null, harvestCrop: null };
function libLookup(crop: string): LibEntry {
  const exact = crop.trim().toLowerCase();
  return libByName.get(exact) ?? libByNorm.get(normCrop(crop)) ?? EMPTY_LIB;
}

/* ── Stop → day_of_week map (for scoping the make-ups banner by harvest day).
 *    A make-up notice's stop_hint is a pickup-stop NAME (or HOME_DELIVERY_HINT).
 *    We map that stop's day_of_week to the SAME harvest tab the crops use:
 *    Sat/Sun pickup → thu; everything else (Tue/Wed) → mon. Home delivery runs
 *    Wed → mon. Case-insensitive on the stored name. ────────────────────── */
interface StopDowRow { name: string; day_of_week: string | null; }
const { data: stopRows } = await supabase
  .from('pickup_locations')
  .select('name, day_of_week')
  .overrideTypes<StopDowRow[], { merge: false }>();
const stopDayByName = new Map<string, string | null>();
for (const s of stopRows ?? []) {
  const key = s.name?.trim().toLowerCase();
  if (key) stopDayByName.set(key, s.day_of_week);
}

/* ──────────────────────────────────────────────────────────────────
 * 3. Market planned_qty by crop — from market_offerings, tagged per market.
 * ────────────────────────────────────────────────────────────────── */
interface MarketOfferingRow {
  id: string;
  name: string | null;
  unit: string;
  planned_qty: number | null;
  market: { id: string; name: string; day_of_week: string | null } | null;
  library: { name: string | null; photo_url: string | null; category: string | null } | null;
}
const { data: offeringRows, error: offeringsErr } = await db
  .from('market_offerings')
  .select(
    'id, name, unit, planned_qty, ' +
    'market:pickup_locations ( id, name, day_of_week ), ' +
    'library:product_library ( name, photo_url, category )',
  )
  .eq('week_starting', week_starting)
  .eq('is_active', true)
  .order('sort_order', { ascending: true })
  .overrideTypes<MarketOfferingRow[], { merge: false }>();
if (offeringsErr) {
  throw new Error(`pick-pack: market_offerings fetch failed: ${offeringsErr.message}`);
}

interface MarketItem { name: string; unit: string; qty: number; photo: string | null; category: string | null; canonical: boolean; sourceName?: string; }
interface MarketGroup { id: string; name: string; day: string | null; items: MarketItem[]; }
const marketGroupMap = new Map<string, MarketGroup>();
// Aggregate ALL markets' planned_qty per crop for the overall list.
interface MarketAllAgg extends CropAgg { category: string | null; canonical: boolean; sourceName?: string; }
const marketAllMap = new Map<string, MarketAllAgg>(); // key = cropMergeKey(canonical)|unit
for (const o of offeringRows ?? []) {
  // CANONICAL IDENTITY: prefer the linked product_library NAME (market_offerings
  // is always library-linked) so a market's display override doesn't fork a real
  // crop into its own row across channels. The offering's own override name is
  // kept as the source spelling when it differs.
  const libName = o.library?.name?.trim() || null;
  const ownName = o.name?.trim() || null;
  const name = (libName ?? ownName ?? 'Untitled product');
  const canonical = !!libName;
  const sourceName = libName && ownName && normCrop(ownName) !== normCrop(libName) ? ownName : undefined;
  const qty = Number(o.planned_qty) || 0;
  const unit = o.unit || 'each';
  const category = o.library?.category ?? null;
  const photo = o.library?.photo_url ?? null;
  // Per-market grouping (for the per-market checklist).
  const mid = o.market?.id ?? 'untagged';
  let group = marketGroupMap.get(mid);
  if (!group) {
    group = { id: mid, name: o.market?.name ?? 'Untagged', day: o.market?.day_of_week ?? null, items: [] };
    marketGroupMap.set(mid, group);
  }
  group.items.push({ name, unit, qty, photo, category, canonical, sourceName });
  // All-markets aggregate (for the overall harvest list), scoped to the
  // selected harvest day. On 'all' every market counts; on mon/thu only the
  // markets that map to that harvest tab (Tue → mon; Sat/Sun → thu).
  if (qty > 0 && marketInScope(o.market?.day_of_week)) {
    const key = `${cropMergeKey(name)}|${unit.toLowerCase()}`;
    const e = marketAllMap.get(key);
    if (e) {
      e.qty += qty;
      if (!e.canonical && canonical) { e.crop = name; e.canonical = true; }
      if (!e.sourceName && sourceName) e.sourceName = sourceName;
    } else {
      marketAllMap.set(key, { crop: name, unit, qty, category, canonical, sourceName });
    }
  }
}

/* ── Defensive header-junk guard for wholesale item names ─────────────────
 * A bad PDF import (ProcurementExpress purchase orders) has leaked a whole
 * page-header line into wholesale_order_items.product_name — e.g. "Page 1 of 2
 * Generated On … by ProcurementExpress.com Item # SKU Description … Rosemary".
 * These signatures NEVER appear in a real product name, so we drop the line from
 * the harvest demand (the underlying rows should also be corrected at the source;
 * this guard keeps a future bad import from re-polluting the pick list). */
const JUNK_NAME_RE = [
  /procurementexpress/i,
  /\bpage\s+\d+\s+of\s+\d+/i,
  /generated on\b[\s\S]*\bby\b/i,
  /\bitem\s*#\s*sku\b/i,
];
function isJunkProductName(name: string): boolean {
  return JUNK_NAME_RE.some((re) => re.test(name));
}

/* ──────────────────────────────────────────────────────────────────
 * 4. Wholesale order demand by crop — submitted orders delivering this week.
 * ────────────────────────────────────────────────────────────────── */
interface WholesaleItemRow {
  product_name: string | null;
  qty: number;
  product: { unit: string | null; photo_url: string | null; library: { name: string | null; photo_url: string | null; category: string | null } | null } | null;
}
interface WholesaleOrderRow { id: string; delivery_date: string; account_id: string | null; items: WholesaleItemRow[] | null; }
const { data: wholesaleOrderRows, error: wholesaleErr } = await db
  .from('wholesale_orders')
  .select(
    'id, delivery_date, account_id, ' +
    'items:wholesale_order_items ( product_name, qty, ' +
      'product:wholesale_products ( unit, photo_url, library:product_library ( name, photo_url, category ) ) )',
  )
  // submitted AND confirmed/packed: manual admin-entered orders default to
  // 'confirmed' (0065) and edits preserve status — an eq('submitted') filter
  // silently dropped them from harvest demand (latent hole found 2026-07-13).
  // Excluded: draft (not real yet), cancelled, delivered (already gone).
  .in('status', ['submitted', 'confirmed', 'packed'])
  .gte('delivery_date', week_starting)
  .lte('delivery_date', weekEnd)
  .overrideTypes<WholesaleOrderRow[], { merge: false }>();
if (wholesaleErr) {
  throw new Error(`pick-pack: wholesale_orders fetch failed: ${wholesaleErr.message}`);
}
interface WsaleAgg { crop: string; unit: string; qty: number; photo: string | null; category: string | null; canonical: boolean; sourceName?: string; }
const wholesaleMap = new Map<string, WsaleAgg>(); // key = cropMergeKey(canonical)|unit
for (const o of wholesaleOrderRows ?? []) {
  // Scope to the selected harvest day by delivery DOW (Fri/Sat → thu; else mon).
  if (!inScope(wholesaleTabFor(o.delivery_date))) continue;
  for (const it of o.items ?? []) {
    const rawName = it.product_name?.trim();   // the vendor's own spelling
    if (!rawName || isJunkProductName(rawName)) continue;
    // CANONICAL IDENTITY: when the order item's wholesale_products row is linked
    // to a product_library product, use the library's NAME as the crop identity
    // so "Wild Dandelion Greens" folds into "Dandelion Greens" across channels.
    const libName = it.product?.library?.name?.trim() || null;
    const crop = libName ?? rawName;
    const canonical = !!libName;
    const sourceName = libName && normCrop(rawName) !== normCrop(libName) ? rawName : undefined;
    const unit = it.product?.unit?.trim() || 'each';
    const qty = Number(it.qty) || 0;
    if (qty <= 0) continue;
    const photo = it.product?.library?.photo_url ?? it.product?.photo_url ?? null;
    const category = it.product?.library?.category ?? null;
    const key = `${cropMergeKey(crop)}|${unit.toLowerCase()}`;
    const e = wholesaleMap.get(key);
    if (e) {
      e.qty += qty;
      if (!e.photo && photo) e.photo = photo;
      if (!e.canonical && canonical) { e.crop = crop; e.canonical = true; }
      if (!e.sourceName && sourceName) e.sourceName = sourceName;
    } else {
      wholesaleMap.set(key, { crop, unit, qty, photo, category, canonical, sourceName });
    }
  }
}
const wholesaleRows = Array.from(wholesaleMap.values())
  .sort((a, b) => a.crop.localeCompare(b.crop, undefined, { sensitivity: 'base' })); // A→Z (crew request 2026-07-13)

/* ──────────────────────────────────────────────────────────────────
 * 4B. Flex à-la-carte demand by crop — flex_orders for THIS week.
 *
 *   Todd's directive: the harvest numbers must INCLUDE flex-committed items so
 *   the crew actually picks them ("so we have them"). flex_orders is flat (one
 *   row per member per item); the item name/unit come from flex_inventory.
 *
 *   Counted statuses = pending / locked / fulfilled — the SAME "real order for
 *   the week" filter every other flex-consuming page uses (labels, pack-load,
 *   host-sheets, route-sheet, stop-manifest, pack-check, harvest). cancelled +
 *   refunded are excluded — you don't pack those. There is NO "skipped" status:
 *   a member skip CANCELS a pending order (see api/account/flex-order/skip.ts),
 *   so a skipped week's order is already `cancelled` and drops out here.
 *
 *   Read via the service-role `db` (like market_offerings + wholesale_orders on
 *   this page) so a CREW user — who does NOT clear the admin RLS bypass — still
 *   sees the flex demand. Safe: only per-crop AGGREGATES are rendered (name +
 *   qty + unit), never a member's name/contact.
 *
 *   Day scope mirrors CSA EXACTLY: a flex order is picked on the same harvest
 *   day as its member's box (Sat/Sun pickup → thu; else → mon), via the shared
 *   harvestTabForMember rule. On 'all' every counted order is included; on
 *   mon/thu only orders whose member maps to that harvest tab. A flex order
 *   whose member_id isn't an active cycle member this week has no resolvable
 *   day, so it counts on 'all' only (never leaked onto a specific day tab —
 *   same rule as the make-up notices above).
 * ────────────────────────────────────────────────────────────────── */
// member_id → harvest tab, from the resolved cycle (Sat/Sun pickup → thu).
const memberFlexTab = new Map<string, 'mon' | 'thu'>();
for (const m of cycle.members) {
  memberFlexTab.set(m.id, harvestTabForMember(m.pickup_location?.day_of_week));
}
interface FlexOrderRow {
  member_id: string;
  qty: number;
  flex_inventory: {
    name: string | null;
    unit: string | null;
    category: string | null;
    library: { name: string | null; category: string | null } | null;
  } | null;
}
// Photo for a flex-only crop line comes from libLookup(crop)/cropPhoto at render
// (product_library by name, same as every other channel). The join pulls the
// library NAME too so a flex item linked to a library product canonicalizes to
// it. category precedence: product_library → flex_inventory.
const { data: flexOrderRows, error: flexErr } = await db
  .from('flex_orders')
  .select(
    'member_id, qty, ' +
    'flex_inventory:flex_inventory ( name, unit, category, ' +
      'library:product_library ( name, category ) )',
  )
  .eq('cycle_code', 'WEEKLY')
  .eq('week_starting', week_starting)
  .in('status', ['pending', 'locked', 'fulfilled'])
  .overrideTypes<FlexOrderRow[], { merge: false }>();
if (flexErr) {
  throw new Error(`pick-pack: flex_orders fetch failed: ${flexErr.message}`);
}
interface FlexAgg { crop: string; unit: string; qty: number; category: string | null; canonical: boolean; sourceName?: string; }
const flexMap = new Map<string, FlexAgg>(); // key = cropMergeKey(canonical)|unit
for (const fo of flexOrderRows ?? []) {
  // Day scope: 'all' keeps every order; mon/thu keeps only orders whose member
  // maps to that harvest tab. An unmapped member (undefined) fails the mon/thu
  // check and so shows on 'all' only.
  if (dayScope !== 'all' && memberFlexTab.get(fo.member_id) !== dayScope) continue;
  const rawName = fo.flex_inventory?.name?.trim();
  if (!rawName) continue;
  // Skip the base share subscription line — it's the box, not a crop to pick.
  if (/CSA Share/i.test(rawName)) continue;
  const qty = Number(fo.qty) || 0;
  if (qty <= 0) continue;
  // CANONICAL IDENTITY: a flex item linked to a product_library product (via
  // flex_inventory.library_id) folds into that crop's line under the library name.
  const libName = fo.flex_inventory?.library?.name?.trim() || null;
  const name = libName ?? rawName;
  const canonical = !!libName;
  const sourceName = libName && normCrop(rawName) !== normCrop(libName) ? rawName : undefined;
  const unit = fo.flex_inventory?.unit?.trim() || 'each';
  const category = fo.flex_inventory?.library?.category ?? fo.flex_inventory?.category ?? null;
  const key = `${cropMergeKey(name)}|${unit.toLowerCase()}`;
  const e = flexMap.get(key);
  if (e) {
    e.qty += qty;
    if (!e.canonical && canonical) { e.crop = name; e.canonical = true; }
    if (!e.sourceName && sourceName) e.sourceName = sourceName;
  } else {
    flexMap.set(key, { crop: name, unit, qty, category, canonical, sourceName });
  }
}
const flexRows = Array.from(flexMap.values())
  .filter((r) => r.qty > 0)
  .sort((a, b) => a.crop.localeCompare(b.crop, undefined, { sensitivity: 'base' })); // A→Z (crew request 2026-07-13)

/* ──────────────────────────────────────────────────────────────────
 * 5. The MERGE — overall per-crop demand across all four channels.
 * ────────────────────────────────────────────────────────────────── */
// CSA box-plan crops carry no library link, but many resolve to a library
// product by name — pull the canonical library name when one exists so a box
// crop merges with the same crop from the linked channels (and gets a category).
const csaDemand: CropDemandInput[] = csaRows.map((r) => {
  const lib = libLookup(r.crop);
  return {
    crop: lib.name ?? r.crop, qty: r.qty, unit: r.unit, category: lib.category,
    canonical: !!lib.name, sourceName: lib.name && normCrop(lib.name) !== normCrop(r.crop) ? r.crop : undefined,
  };
});
const marketDemand: CropDemandInput[] = Array.from(marketAllMap.values()).map((r) => ({
  crop: r.crop, qty: r.qty, unit: r.unit, category: r.category, canonical: r.canonical, sourceName: r.sourceName,
}));
const wholesaleDemand: CropDemandInput[] = wholesaleRows.map((r) => ({
  crop: r.crop, qty: r.qty, unit: r.unit, category: r.category, canonical: r.canonical, sourceName: r.sourceName,
}));
const flexDemand: CropDemandInput[] = flexRows.map((r) => ({
  crop: r.crop, qty: r.qty, unit: r.unit, category: r.category, canonical: r.canonical, sourceName: r.sourceName,
}));
const merged = mergeCropDemand(csaDemand, marketDemand, wholesaleDemand, flexDemand);

/* ══════════════════════════════════════════════════════════════════════════
 * MAKE-UPS — folded INTO the harvest, no more top banner (owner 2026-07-20).
 *
 * The old design surfaced owed make-up promises (member_notices) as a big
 * ⚠ block at the TOP of the harvest sheet. Todd: that wastes space — fold each
 * make-up into the harvest itself so the crew still picks the extra product
 * ("otherwise we won't HAVE it to pack") without the standalone block.
 *
 * How a make-up folds:
 *   • MATCHED — the make-up names a crop the sheet already harvests (a "double
 *     mushroom" when mushrooms are on the list): its quantity is ADDED to that
 *     crop's overall row total and an inline "⚠ +N make-up" note rides on the
 *     row. The harvest number already includes the make-up — nothing lost.
 *   • UNMATCHED — the make-up names no harvest crop (a bread confirm, a store
 *     credit, a mushroom when none is harvested this week). It CAN'T fold into a
 *     crop line, so it rides at the FOOT of the overall list as its own make-up
 *     line — still counted, still checkable, just not a top block.
 *
 * The fold is applied to `overallRows` (a copy of `merged`), so the pack-house
 * distribution matrix — which reuses `merged`'s per-row totals and must keep
 * cells summing to those totals — is untouched. Reads the SAME member_notices
 * source as the pack sheets; member_notices RLS returns EMPTY for a crew user,
 * so crew never see the (member-named) make-ups.
 * ══════════════════════════════════════════════════════════════════════════ */
const allMakeupNotices: NoticeWithMember[] = await fetchAllOpenDueNoticesWithMember(
  supabase, week_starting,
);
/**
 * Harvest tab for a make-up notice, from its stop_hint (a pickup-stop NAME or
 * the HOME_DELIVERY_HINT sentinel), using the SAME rule as the crops:
 *   - HOME_DELIVERY_HINT                  → mon (the home-delivery run is Wed).
 *   - a stop whose day_of_week is Sat/Sun → thu (weekend markets).
 *   - every other stop (Tue/Wed pickup)   → mon.
 *   - stop_hint NULL (general notice) OR an unknown stop → null (no single
 *     harvest day → shows on the whole-week 'all' view only).
 */
function makeupTab(n: NoticeWithMember): 'mon' | 'thu' | null {
  const hint = n.stop_hint?.trim();
  if (!hint) return null;
  if (hint === HOME_DELIVERY_HINT) return 'mon';
  const dow = stopDayByName.get(hint.toLowerCase());
  if (dow === undefined) return null;
  return harvestTabForMember(dow);
}
/** Make-ups in the current day scope (mirrors the crop scoping: a Thursday sheet
 *  never carries a Wed stop's owed make-up; general null-tab make-ups show on
 *  'all' only). */
const makeupNotices: NoticeWithMember[] =
  dayScope === 'all'
    ? allMakeupNotices
    : allMakeupNotices.filter((n) => makeupTab(n) === dayScope);
/** Due/overdue chip text for a make-up. */
function makeupTag(n: NoticeWithMember): { text: string; overdue: boolean } {
  const overdue = isNoticeOverdue(n.due_week, week_starting);
  if (n.due_week == null) return { text: 'next opportunity', overdue: false };
  const d = new Date(`${n.due_week}T12:00:00Z`);
  const pretty = new Intl.DateTimeFormat('en-US', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
  }).format(d);
  return { text: overdue ? `OVERDUE since ${pretty}` : `due ${pretty}`, overdue };
}

/* ── Make-up parsing + crop matching (grounds each make-up to a REAL row) ──── */
const MK_NUM_WORDS: Record<string, number> = {
  one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, double: 2, triple: 3,
};
/** The item text of a make-up = its title WITHOUT the leading "Member Name:"
 *  prefix (so a member named "Rosemary" can't false-match the Rosemary crop). */
function makeupItemText(n: NoticeWithMember): string {
  let text = n.title ?? '';
  const colon = text.indexOf(':');
  if (colon >= 0) text = text.slice(colon + 1);
  else if (n.member_name && text.toLowerCase().startsWith(n.member_name.toLowerCase())) {
    text = text.slice(n.member_name.length);
  }
  return text.trim();
}
/** Quantity owed by a make-up: "double"→2, "triple"→3, a leading integer, a
 *  number word, else 1. */
function makeupQty(itemText: string): number {
  const low = itemText.toLowerCase();
  if (/\btriple\b/.test(low)) return 3;
  if (/\bdouble\b/.test(low)) return 2;
  const digits = low.match(/\b(\d{1,3})\b/);
  if (digits) return Math.max(1, parseInt(digits[1], 10));
  for (const [word, n] of Object.entries(MK_NUM_WORDS)) {
    if (new RegExp(`\\b${word}\\b`).test(low)) return n;
  }
  return 1;
}
/** Words in a make-up/crop string that carry crop identity — drop marketing,
 *  packaging + make-up filler words so "make-good FLOWER bouquet" → ['flower',
 *  'bouquet'] and can match a "Bouquet" row. */
const MK_STOP = new Set<string>([
  'organic', 'local', 'fresh', 'wild', 'certified', 'the', 'and', 'for', 'box',
  'boxes', 'share', 'bunch', 'bunches', 'head', 'heads', 'bulb', 'duo', 'mix',
  'medley', 'each', 'per', 'lb', 'lbs', 'bag', 'bags', 'pint', 'count',
  'make', 'good', 'add', 'addon', 'confirm', 'surprise', 'gift', 'double',
  'triple', 'extra', 'owe', 'owed', 'miss', 'missed', 'week', 'next',
]);
function mkSigWords(s: string): string[] {
  return normCrop(s).split(' ').filter((w) => w.length >= 3 && !MK_STOP.has(w));
}
/** Loose singular/plural stem equality (3+ chars). */
function mkStemEq(a: string, b: string): boolean {
  if (a === b) return true;
  const da = a.replace(/s$/, ''); const db = b.replace(/s$/, '');
  return da.length >= 3 && da === db;
}
// Candidate crops = the pre-fold merged rows (index kept so we can fold in place).
const mkCandidates = merged
  .map((r, idx) => ({ idx, words: mkSigWords(r.crop) }))
  .filter((c) => c.words.length > 0);
/** Index into `merged` of the crop row a make-up belongs to, or null. A row
 *  matches only when EVERY one of its identity words appears (stem-eq) in the
 *  make-up text — so "double mushroom" matches a "Mushrooms" row but "confirm
 *  bread" matches nothing. Ties broken toward the most specific (longest) crop. */
function matchMakeupRow(itemText: string): number | null {
  const words = mkSigWords(itemText);
  if (words.length === 0) return null;
  let bestIdx: number | null = null;
  let bestScore = -1;
  for (const c of mkCandidates) {
    const ok = c.words.every((cw) => words.some((nw) => mkStemEq(cw, nw)));
    if (!ok) continue;
    const score = c.words.reduce((a, w) => a + w.length, 0);
    if (score > bestScore) { bestScore = score; bestIdx = c.idx; }
  }
  return bestIdx;
}

/** An owed make-up folded onto a crop row (inline note on the overall sheet). */
interface MakeupAnnot { qty: number; label: string; overdue: boolean; }
/** overallRows carry an optional makeups[] the crop rendering surfaces inline. */
type OverallRow = (typeof merged)[number] & { makeups?: MakeupAnnot[] };
/** A make-up that matched no harvest crop — rides at the foot of the list. */
interface UnmatchedMakeup {
  key: string; qty: number; item: string; member: string | null;
  detail: string | null; tag: { text: string; overdue: boolean };
}
// Fold make-ups into a COPY of merged (matrix keeps the pristine `merged`).
const overallRows: OverallRow[] = merged.map((r) => ({ ...r }));
const unmatchedMakeups: UnmatchedMakeup[] = [];
for (const n of makeupNotices) {
  const item = makeupItemText(n);
  const qty = makeupQty(item);
  const tag = makeupTag(n);
  const idx = matchMakeupRow(item);
  if (idx != null) {
    const row = overallRows[idx];
    row.totalQty += qty;
    (row.makeups ??= []).push({ qty, label: n.member_name ?? item, overdue: tag.overdue });
  } else {
    unmatchedMakeups.push({
      key: `makeup-${n.id}`, qty, item,
      member: n.member_name, detail: n.detail, tag,
    });
  }
}

// ALPHABETICAL within each section (crew request, Todd 2026-07-13) — the
// team looks crops up dictionary-style inside the Tender / Everything-else
// groups. merged arrives qty-desc; re-sort each section A→Z.
const alphaByCrop = (a: { crop: string }, b: { crop: string }): number =>
  a.crop.localeCompare(b.crop, undefined, { sensitivity: 'base' });
const tenderRows = overallRows.filter((r) => r.tender).sort(alphaByCrop);
const otherRows = overallRows.filter((r) => !r.tender).sort(alphaByCrop);

/** Best photo for a merged/overall crop row. */
function cropPhoto(crop: string): string | null {
  return libLookup(crop).photo;
}

/* ── Pack-weight → total pounds ─────────────────────────────────────────
 * Portioned items (clamshell salad mixes, Big Bagz) are HARVESTED BY WEIGHT.
 * When a crop's library product has pack_weight_lb set, we show the total
 * pounds to pick = summed packed-unit qty × pack_weight_lb, alongside the
 * unit count (the count is still needed for packing; the lb is for harvest).
 *
 * NEVER convert a row whose unit is ALREADY weight (lb/pound/#) — that qty is
 * already pounds, so multiplying would double-count. Only count/portion units
 * (each, clamshell, bag, box, bunch, …) get a lb figure. */
/**
 * Total pounds for `qty` packed units of `crop` on unit `unit`, or null when
 * there's nothing to show — no pack weight set, a weight-based unit (already
 * pounds), or a non-positive qty. Thin wrapper over the pure packLbForUnits
 * (lib/pick-pack) that supplies the crop's pack weight from the library lookup.
 */
function packLb(crop: string, qty: number, unit: string): number | null {
  return packLbForUnits(libLookup(crop).packWeightLb, qty, unit);
}

/* ── Combine package variants into ONE harvest line (total pounds) ────────
 * The crew harvests raw greens BY WEIGHT; clamshell vs "Big Bagz" is a
 * downstream PACK decision. Products that share a non-null library.harvest_crop
 * (e.g. "King Spring Mix" + "King Spring (Big Bagz)" → "King Spring Mix") must
 * appear as ONE harvest line = summed pounds across variants, with the
 * per-packaging breakdown underneath so the pack team can still portion.
 *
 * A group only forms when 2+ IN-SCOPE variants share a harvest_crop; a lone
 * variant renders unchanged as its own normal row. Pounds per variant reuse
 * packLb() (qty x pack_weight_lb; weight-based units are skipped — no
 * double-count), so a variant with no pack weight contributes 0 lb but still
 * shows in the breakdown as a count. */
interface HarvestSourceRow {
  crop: string;
  qty: number;
  unit: string;
  /** Optional pre-computed pounds for this row (the OVERALL view sums pounds
   *  across channels itself; other views leave this undefined and let packLb
   *  derive it from qty x pack_weight_lb). */
  lb?: number | null;
}
interface HarvestVariant { crop: string; qty: number; unit: string; lb: number | null; }
interface CombinedHarvest { harvestCrop: string; totalLb: number; variants: HarvestVariant[]; }
/**
 * From a flat list of in-scope harvest rows, pull out the ones whose library
 * product shares a non-null harvest_crop with ≥1 sibling in the SAME list, and
 * fold each such family into one CombinedHarvest. Returns the combined groups
 * (sorted biggest-pounds first) PLUS the set of source-row indices consumed, so
 * the caller can render the remaining (uncombined) rows unchanged.
 */
function combineHarvest(rows: HarvestSourceRow[]): {
  combined: CombinedHarvest[];
  consumed: Set<number>;
} {
  // Bucket row indices by their harvest_crop (library lookup). Rows with no
  // harvest_crop are never bucketed — they always render as themselves.
  const byHarvestCrop = new Map<string, number[]>();
  rows.forEach((r, i) => {
    const hc = libLookup(r.crop).harvestCrop?.trim();
    if (!hc) return;
    const arr = byHarvestCrop.get(hc);
    if (arr) arr.push(i);
    else byHarvestCrop.set(hc, [i]);
  });
  const combined: CombinedHarvest[] = [];
  const consumed = new Set<number>();
  for (const [hc, idxs] of byHarvestCrop) {
    if (idxs.length < 2) continue; // a lone variant renders unchanged
    const variants: HarvestVariant[] = idxs.map((i) => {
      const r = rows[i];
      // Use the caller's pre-computed lb when given (OVERALL sums channels),
      // else derive it from qty x pack_weight_lb via packLb().
      const lb = r.lb !== undefined ? r.lb : packLb(r.crop, r.qty, r.unit);
      return { crop: r.crop, qty: r.qty, unit: r.unit, lb };
    });
    const totalLb = Math.round(variants.reduce((a, v) => a + (v.lb ?? 0), 0) * 10) / 10;
    // Order variants biggest-pounds first (clamshells before bags, usually).
    variants.sort((a, b) => (b.lb ?? 0) - (a.lb ?? 0) || a.crop.localeCompare(b.crop));
    combined.push({ harvestCrop: hc, totalLb, variants });
    for (const i of idxs) consumed.add(i);
  }
  combined.sort((a, b) => b.totalLb - a.totalLb || a.harvestCrop.localeCompare(b.harvestCrop));
  return { combined, consumed };
}

// Resolve the selected market group for the per-market view.
const DAY_ORDER: Record<string, number> = { Tue: 0, Sat: 1, Sun: 2 };
const marketGroupsSorted = Array.from(marketGroupMap.values()).sort((a, b) => {
  const da = DAY_ORDER[a.day ?? ''] ?? 99;
  const db = DAY_ORDER[b.day ?? ''] ?? 99;
  if (da !== db) return da - db;
  return a.name.localeCompare(b.name);
});
const selectedMarket = view === 'market'
  ? marketGroupsSorted.find((g) => g.id === marketIdParam) ?? marketGroupsSorted[0] ?? null
  : null;

/* ──────────────────────────────────────────────────────────────────
 * PACK HOUSE DISTRIBUTION MATRIX (?view=packhouse) — crop × destination.
 *
 * The overall harvest sheet says "pick this much of each crop." This sheet says
 * "…and here's where every unit of it goes." It is the SAME demand, decomposed
 * back into the physical destinations that already exist in the four loads:
 *   • CSA           — one column (the whole box aggregate for the crop).
 *   • each market   — one column per in-scope market (identity from
 *                     market_offerings → pickup_locations).
 *   • each wholesale account — one column per restaurant (each order is its own
 *                     pallet; multiple orders for one restaurant SUM into its
 *                     column). restaurant_name resolved from wholesale_accounts.
 *   • Flex          — one column (à-la-carte aggregate for the crop).
 *
 * CONSISTENCY: buildDestinationMatrix takes the SAME `merged` rows the overall
 * view renders, so a matrix row REUSES that row's `totalQty` verbatim (no
 * separate math). Every destination cell below is fed from the SAME scoped
 * source + SAME scope filter the merge used (csaRows, the marketInScope
 * offerings, the inScope wholesale items, flexRows), so a row's cells SUM to
 * that same total — CSA + Σmarkets + Σwholesale + Flex — by construction.
 *
 * Built ONLY for this view (it needs one extra read — the account names).
 * ────────────────────────────────────────────────────────────────── */
let packhouseMatrix: ReturnType<typeof buildDestinationMatrix> | null = null;
if (view === 'packhouse' || view === 'printpack') {
  const destInputs: DestDemandInput[] = [];

  // CSA — one column. csaRows is already day-scoped (built via inScope above);
  // summing its per-unit rows into destKey 'csa' reproduces merged.csa.qty. Each
  // row carries its small/large box split so the CSA cell shows "12 (8S/4L)".
  for (const r of csaRows) {
    destInputs.push({
      crop: r.crop, qty: r.qty, unit: r.unit, kind: 'csa', destKey: 'csa', destLabel: t.csaCol,
      sizeSplit: { small: r.small, large: r.large },
    });
  }

  // MARKETS — one column per in-scope market (incl. an "Untagged" bucket, which
  // marketInScope keeps on 'all' and drops on mon/thu, exactly like marketAllMap
  // that feeds merged.market). Ordered by marketGroupsSorted (day, then name).
  for (const g of marketGroupsSorted) {
    if (!marketInScope(g.day)) continue;
    for (const it of g.items) {
      if (!(it.qty > 0)) continue;
      destInputs.push({ crop: it.name, qty: it.qty, unit: it.unit, kind: 'market', destKey: `mkt:${g.id}`, destLabel: g.name });
    }
  }

  // WHOLESALE — one column per account (restaurant). Resolve restaurant_name
  // from wholesale_accounts (mirrors the labels page's account lookup); orders
  // with no account land in a shared "(no account)" column so nothing is lost
  // from the wholesale total. Same delivery-day scope + item gates as
  // wholesaleMap (which feeds merged.wholesale), so Σaccounts = merged.wholesale.
  const wsAcctIds = Array.from(new Set(
    (wholesaleOrderRows ?? []).map((o) => o.account_id).filter(Boolean),
  )) as string[];
  const wsAcctName = new Map<string, string>();
  if (wsAcctIds.length > 0) {
    const { data: acctRows } = await db
      .from('wholesale_accounts')
      .select('id, restaurant_name')
      .in('id', wsAcctIds)
      .overrideTypes<{ id: string; restaurant_name: string }[], { merge: false }>();
    for (const a of acctRows ?? []) wsAcctName.set(a.id, a.restaurant_name);
  }
  const NO_ACCT_KEY = 'ws:none';
  // Order wholesale columns by restaurant name for a predictable sheet.
  const wsOrdered = (wholesaleOrderRows ?? []).slice().sort((a, b) => {
    const na = a.account_id ? (wsAcctName.get(a.account_id) ?? '') : '~';
    const nb = b.account_id ? (wsAcctName.get(b.account_id) ?? '') : '~';
    return na.localeCompare(nb);
  });
  for (const o of wsOrdered) {
    if (!inScope(wholesaleTabFor(o.delivery_date))) continue;
    const acctName = o.account_id ? wsAcctName.get(o.account_id) : undefined;
    const destKey = acctName ? `ws:${o.account_id}` : NO_ACCT_KEY;
    const destLabel = acctName ?? '(no account)';
    for (const it of o.items ?? []) {
      const rawName = it.product_name?.trim();
      if (!rawName || isJunkProductName(rawName)) continue;
      // Use the canonical library name (when linked) so this cell attaches to the
      // SAME merged row the overall sheet built — a library rename that shares no
      // text with the vendor name would otherwise orphan the cell.
      const name = it.product?.library?.name?.trim() || rawName;
      const unit = it.product?.unit?.trim() || 'each';
      const qty = Number(it.qty) || 0;
      if (qty <= 0) continue;
      destInputs.push({ crop: name, qty, unit, kind: 'wholesale', destKey, destLabel });
    }
  }

  // FLEX — one column. flexRows is already day-scoped; destKey 'flex' aggregates
  // to merged.flex.qty.
  for (const r of flexRows) {
    destInputs.push({ crop: r.crop, qty: r.qty, unit: r.unit, kind: 'flex', destKey: 'flex', destLabel: t.flexCol });
  }

  packhouseMatrix = buildDestinationMatrix(merged, destInputs);
}

/* ── Pack-house CATEGORY SECTIONS (owner 2026-07-13) ──────────────────────
 * Group the by-item blocks by crew section (Salad Greens, Bunching Greens,
 * Alliums, Roots, Fruiting & Vegetables, Herbs, Flowers, Other) in CREW_SECTIONS
 * order, items A→Z within — the crew works the sheet by product family. The
 * amber tender flag still marks tender crops within a section; section order
 * drives the layout, not tenderness (that pick-order lives on the overall view).
 * No live check-off here, so regrouping never touches progress keys. */
const packhouseSections: CrewSectionGroup<MatrixRow>[] = packhouseMatrix
  ? groupBySection(packhouseMatrix.rows, (r) => r.category, (r) => r.crop)
  : [];

/** Total harvest pounds for a pack-house matrix row = Σ over its destination
 *  cells of packLb(count × pack_weight_lb). Weight-based cells are already
 *  pounds (packLbForUnits skips them), so they never double-count. null when the
 *  crop has no pack weight (an ordinary counted crop). */
function matrixRowLb(r: MatrixRow): number | null {
  const w = libLookup(r.crop).packWeightLb;
  if (w == null || !(w > 0)) return null;
  let total = 0;
  for (const cell of r.cells.values()) total += packLbForUnits(w, cell.qty, cell.unit) ?? 0;
  return total > 0 ? Math.round(total * 10) / 10 : null;
}

/* ── Destination-kind glyph — a tiny prefix accent on each pack-block line so a
 *    gloved crew reads the destination FAMILY at a glance (🥬 CSA / 🛒 market /
 *    🍽 wholesale / 🌿 flex) without a legend to track. Low-ink: one emoji, no
 *    background. Mirrors the crew's label DNA (small accents, not fills). */
function destGlyph(kind: DestKind): string {
  return kind === 'csa' ? '🥬' : kind === 'market' ? '🛒' : kind === 'wholesale' ? '🍽' : '🌿';
}

/* ── Per-view combined-harvest groups (package variants → one weighed line) ──
 * Built here so the templates stay thin. Each view feeds combineHarvest() the
 * SAME flat row list it renders (in the same order), then renders the returned
 * combined groups on top and the un-consumed rows unchanged below. Every source
 * list is already day-scoped upstream (csaRows / wholesaleRows / merged /
 * selectedMarket.items all respect the day filter), so a variant only counts
 * when it's in scope — nothing extra to gate here. */

/** Total pounds for a merged/overall row, summed across its channels (weight
 *  units are already lb and are skipped by packLb, so no double-count). */
function mergedRowLb(r: (typeof merged)[number]): number | null {
  const total = [r.csa, r.market, r.wholesale, r.flex].reduce((acc, c) => {
    if (!c) return acc;
    return acc + (packLb(r.crop, c.qty, c.unit) ?? 0);
  }, 0);
  return total > 0 ? Math.round(total * 10) / 10 : null;
}

// OVERALL — combine within the whole merged list; qty is the headline totalQty,
// lb is the cross-channel sum. Keeps tender-first ordering for leftovers via the
// original tenderRows/otherRows split (consumed rows drop out of each group).
const overallCombined = combineHarvest(
  overallRows.map((r) => ({ crop: r.crop, qty: r.totalQty, unit: r.csa?.unit ?? r.market?.unit ?? r.wholesale?.unit ?? r.flex?.unit ?? 'each', lb: mergedRowLb(r) })),
);
const overallConsumedCrops = new Set(
  Array.from(overallCombined.consumed).map((i) => overallRows[i].crop),
);
const tenderRowsShown = tenderRows.filter((r) => !overallConsumedCrops.has(r.crop));
const otherRowsShown = otherRows.filter((r) => !overallConsumedCrops.has(r.crop));

/* ── CATEGORY SECTIONS for the "everything else" block (owner 2026-07-13) ──
 * Tender greens stay their own amber pick-first group (pick order matters), but
 * the non-tender remainder is grouped into crew sections (Roots, Alliums,
 * Fruiting & Vegetables, Herbs, Flowers, Other) in CREW_SECTIONS order, A→Z
 * within — so the crew reads the sheet by product family. ppKeys is unchanged
 * (it still enumerates tenderRowsShown + otherRowsShown; grouping only reshapes
 * the render, not the set of lines). */
const otherSections = groupBySection(otherRowsShown, (r) => r.category, (r) => r.crop);
/** The ordered render groups for the overall sheet: the tender pick-first band,
 *  then one band per crew section of the non-tender remainder. */
const overallGroups: { label: string; rows: typeof otherRowsShown; tender: boolean }[] = [
  { label: t.tenderGroup, rows: tenderRowsShown, tender: true },
  ...otherSections.map((s) => ({ label: t.sections[s.section], rows: s.items, tender: false })),
];

/* ── Compact printed OVERALL sheet (owner 2026-07-09: "make the harvest list we
 *    print more compact — down to one sheet"). Count the PRINT rows (combined
 *    groups + tender + other) and switch to a two-column print layout only when a
 *    single column would overflow one Letter page. The floor is legibility, not
 *    density: at the 12pt line height + tight padding below, ~34 whole single-
 *    column rows clear one page; above that, two columns keep everything on the
 *    sheet without shrinking type. Drives PRINT CSS only — screen is unchanged. */
const overallPrintRowCount =
  overallCombined.combined.length + tenderRowsShown.length + otherRowsShown.length
  + unmatchedMakeups.length;
const overallTwoCol = overallPrintRowCount > 34;

// CSA / WHOLESALE — combine within each list; the un-consumed rows render below.
const csaCombine = combineHarvest(csaRows.map((r) => ({ crop: r.crop, qty: r.qty, unit: r.unit })));
const csaRowsShown = csaRows.filter((_, i) => !csaCombine.consumed.has(i));
const wholesaleCombine = combineHarvest(wholesaleRows.map((r) => ({ crop: r.crop, qty: r.qty, unit: r.unit })));
const wholesaleRowsShown = wholesaleRows.filter((_, i) => !wholesaleCombine.consumed.has(i));

// MARKET — combine within the selected market's items (name → crop).
const marketItemsOrdered = selectedMarket ? orderMarketItems(selectedMarket.items) : [];
const marketCombine = combineHarvest(marketItemsOrdered.map((it) => ({ crop: it.name, qty: it.qty, unit: it.unit })));
const marketItemsShown = marketItemsOrdered.filter((_, i) => !marketCombine.consumed.has(i));
// Per-market checklist gets the SAME category treatment as the pack-house +
// overall sheets (owner 2026-07-13): group the non-combined items into crew
// sections (A→Z within). ppKeys is unchanged (same set of items).
const marketSections = groupBySection(marketItemsShown, (it) => it.category, (it) => it.name);
// Order a market's items: tender greens first, then biggest qty.
function orderMarketItems(items: MarketItem[]): MarketItem[] {
  return items.slice().sort((a, b) => {
    const ta = mergeTender(a.name, a.category);
    const tb = mergeTender(b.name, b.category);
    if (ta !== tb) return ta ? -1 : 1;
    return (b.qty || 0) - (a.qty || 0) || a.name.localeCompare(b.name);
  });
}
// Local tender check reusing the lib's classifier via a merged row of one.
function mergeTender(name: string, category: string | null): boolean {
  return mergeCropDemand([{ crop: name, qty: 1, unit: 'x', category }], [], [])[0]?.tender ?? false;
}

/* ── Combined print pack (?view=printpack) — one continuously-printable document
 *    that composes the three sheets the crew already print separately:
 *      1. the OVERALL harvest totals   (reuses the .pp-overall section + its
 *         compact one-sheet print CSS verbatim — via its view guard, extended)
 *      2. the PACK HOUSE by-item sheet (reuses the .packhouse-doc section verbatim)
 *      3. each in-scope MARKET, one per page (reuses the SAME per-market builder
 *         below + the SAME .harvest-group / CombinedHarvestRow markup + print CSS
 *         as the single-market view — so there is no second market renderer to
 *         drift out of sync).
 *    Nothing here ALTERS the standalone views: printpack only re-uses their
 *    builders + classes and adds page breaks (scoped under .pp-printpack). */
interface MarketRender {
  group: MarketGroup;
  itemsOrdered: MarketItem[];
  combine: ReturnType<typeof combineHarvest>;
  itemsShown: MarketItem[];
  sections: CrewSectionGroup<MarketItem>[];
}
/** The SAME per-market derivation the single-market view does at the top level
 *  (orderMarketItems → combineHarvest → drop consumed → groupBySection), packaged
 *  so the combined pack can run it for every in-scope market. Reusing this — not a
 *  copy — is what keeps the two market renderers from diverging. */
function buildMarketRender(group: MarketGroup): MarketRender {
  const itemsOrdered = orderMarketItems(group.items);
  const combine = combineHarvest(itemsOrdered.map((it) => ({ crop: it.name, qty: it.qty, unit: it.unit })));
  const itemsShown = itemsOrdered.filter((_, i) => !combine.consumed.has(i));
  const sections = groupBySection(itemsShown, (it) => it.category, (it) => it.name);
  return { group, itemsOrdered, combine, itemsShown, sections };
}
// In-scope markets for the combined pack: SAME day filter as the harvest merge
// (Tue → mon; Sat/Sun → thu) and SAME sort (day, then name), so Lawrenceville
// (Tue) leads on Monday and the weekend markets lead on Thursday. The untagged
// bucket never gets its own market page.
const printpackMarkets: MarketRender[] = view === 'printpack'
  ? marketGroupsSorted
      .filter((g) => g.id !== 'untagged' && marketInScope(g.day))
      .map(buildMarketRender)
  : [];

/* ── Combined print pack — PALLET-STAGING sections (owner 2026-08-03) ─────────
 *   Todd stages the pack floor by PALLET: build the CSA pallet, build the Flex
 *   pallet, then pack each wholesale order complete onto the wholesale pallet.
 *   The combined pack mirrors that staging with three added checklist sections
 *   (page 1 stays the overall harvest; the pack-house matrix + markets are
 *   unchanged):
 *     • CSA — TOTALS      : the SAME per-crop CSA checklist as ?view=csa (built
 *                           above via csaCombine / csaRowsShown — reused verbatim,
 *                           no new math), so "build the CSA pallet".
 *     • FLEX — TOTALS     : the à-la-carte flex demand for the week aggregated to
 *                           item totals (flexRows — the SAME source the overall
 *                           merge folds in), each a big line + pen checkbox, so
 *                           "build the Flex pallet".
 *     • WHOLESALE — ONE CHECKLIST PER ORDER : one block per order delivering this
 *                           week (same wholesale_orders source + day/status/junk
 *                           gates the pack-house matrix uses), account/restaurant
 *                           name as the heading, its line items each with a pen
 *                           checkbox — "pack each order complete → wholesale pallet".
 *   All three are print/preview artifacts (plain pen checkboxes, no live board),
 *   so no data-pp-line attrs are wired (printpack has no #pp-live-config). */

/** One line inside a per-order wholesale checklist block. */
interface PrintpackWsaleItem { name: string; qty: number; unit: string; sourceName?: string; }
/** One wholesale ORDER staged as its own pallet checklist for the combined pack. */
interface PrintpackWsaleOrder {
  id: string;
  /** Restaurant / account name (or "(no account)" when an order has none). */
  accountName: string;
  /** Delivery-date label, e.g. "Wed, Aug 6" — the crew's deadline for the pallet. */
  deliveryLabel: string;
  items: PrintpackWsaleItem[];
}
/** Pretty a YYYY-MM-DD delivery date as "Wed, Aug 6" on the farm clock (TZ-safe:
 *  parsed as UTC noon so the DOW/day never slip across the timezone boundary). */
function prettyDeliveryDate(ymd: string): string {
  const d = new Date(`${ymd}T12:00:00Z`);
  return new Intl.DateTimeFormat(lang === 'es' ? 'es-US' : 'en-US', {
    weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC',
  }).format(d);
}
let printpackWsaleOrders: PrintpackWsaleOrder[] = [];
if (view === 'printpack') {
  // Resolve restaurant names for the in-scope orders (SAME lookup the pack-house
  // matrix uses); orders with no account fall back to a "(no account)" heading so
  // nothing is lost. Market Wagon is just another account here — no special-case.
  const ppWsAcctIds = Array.from(new Set(
    (wholesaleOrderRows ?? []).map((o) => o.account_id).filter(Boolean),
  )) as string[];
  const ppWsAcctName = new Map<string, string>();
  if (ppWsAcctIds.length > 0) {
    const { data: ppAcctRows } = await db
      .from('wholesale_accounts')
      .select('id, restaurant_name')
      .in('id', ppWsAcctIds)
      .overrideTypes<{ id: string; restaurant_name: string }[], { merge: false }>();
    for (const a of ppAcctRows ?? []) ppWsAcctName.set(a.id, a.restaurant_name);
  }
  const NO_ACCT_LABEL = lang === 'es' ? '(sin cuenta)' : '(no account)';
  for (const o of wholesaleOrderRows ?? []) {
    // SAME delivery-day scope + item gates as wholesaleMap / the matrix, so the
    // per-order blocks carry exactly the demand the totals do.
    if (!inScope(wholesaleTabFor(o.delivery_date))) continue;
    const items: PrintpackWsaleItem[] = [];
    for (const it of o.items ?? []) {
      const rawName = it.product_name?.trim();
      if (!rawName || isJunkProductName(rawName)) continue;
      const qty = Number(it.qty) || 0;
      if (qty <= 0) continue;
      // Show the canonical library name when linked (matches the harvest sheet),
      // with the vendor's own spelling as an "also:" note when it differs — so the
      // crew matches a crate labeled by the vendor.
      const libName = it.product?.library?.name?.trim() || null;
      const name = libName ?? rawName;
      const sourceName = libName && normCrop(rawName) !== normCrop(libName) ? rawName : undefined;
      const unit = it.product?.unit?.trim() || 'each';
      items.push({ name, qty, unit, sourceName });
    }
    if (items.length === 0) continue; // an all-junk / empty order stages nothing
    // Items A→Z within the block (crew reads the pallet top-to-bottom).
    items.sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));
    const accountName = o.account_id ? (ppWsAcctName.get(o.account_id) ?? NO_ACCT_LABEL) : NO_ACCT_LABEL;
    printpackWsaleOrders.push({
      id: o.id, accountName, deliveryLabel: prettyDeliveryDate(o.delivery_date), items,
    });
  }
  // Order blocks alphabetically by account, then by delivery date (a restaurant
  // with two orders this week stages its earlier delivery first).
  printpackWsaleOrders.sort((a, b) =>
    a.accountName.localeCompare(b.accountName, undefined, { sensitivity: 'base' })
    || a.deliveryLabel.localeCompare(b.deliveryLabel));
}

const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};

// Page title + subtitle per view.
let docTitle: string;
if (view === 'csa') docTitle = 'CSA harvest';
else if (view === 'wholesale') docTitle = 'Wholesale harvest';
else if (view === 'market') docTitle = `Market — ${selectedMarket?.name ?? 'market'}`;
else if (view === 'packhouse') docTitle = t.packhouseTitle;
else if (view === 'printpack') docTitle = lang === 'es' ? 'Paquete de impresión completo' : 'Combined print pack';
else docTitle = t.overallTitle;

const totalCsaBoxes = cycle.members.filter(
  (m) => m.share_type === 'summer_veg'
    && inScope(harvestTabForMember(m.pickup_location?.day_of_week)),
).length;

/* ── Day-scope tab strip hrefs — preserve the current lang + view params so
 *    switching the harvest day never drops the drill-down or language. ─── */
function dayHref(day: 'mon' | 'thu' | 'all'): string {
  const params = new URLSearchParams();
  if (view !== 'overall') params.set('view', view);
  if (view === 'market' && marketIdParam) params.set('market', marketIdParam);
  if (lang !== 'en') params.set('lang', lang);
  if (day !== 'all') params.set('day', day);
  const qs = params.toString();
  return `/admin/pick-pack/${week_starting}${qs ? `?${qs}` : ''}`;
}
const dayTabs: { key: 'all' | 'mon' | 'thu'; label: string; hint: string | null }[] = [
  { key: 'all', label: 'All week', hint: null },
  { key: 'mon', label: 'Monday harvest', hint: '→ Tue + Wed' },
  { key: 'thu', label: 'Thursday harvest', hint: '→ Sat + Sun' },
];
/** Human label for the current day scope — printed on the doc band. */
const dayScopeLabel =
  dayScope === 'mon' ? 'Monday harvest · Tue + Wed'
  : dayScope === 'thu' ? 'Thursday harvest · Sat + Sun'
  : 'All week';

/* ── Combined print-pack header text (?view=printpack) ─────────────────────────
 *   The page-1 banner: "Pick & Pack — Monday harvest (Tue + Wed) · Week of … ·
 *   printed <date>". The printpack strings do NOT live in PICK_PACK_STRINGS, so
 *   EN/ES are inlined here. Printed-on date is the farm's clock (America/New_York). */
const printpackScopeLabel =
  dayScope === 'mon' ? (lang === 'es' ? 'Cosecha del lunes (mar + mié)' : 'Monday harvest (Tue + Wed)')
  : dayScope === 'thu' ? (lang === 'es' ? 'Cosecha del jueves (sáb + dom)' : 'Thursday harvest (Sat + Sun)')
  : (lang === 'es' ? 'Toda la semana' : 'All week');
const printpackPrintedOn = new Intl.DateTimeFormat(lang === 'es' ? 'es-US' : 'en-US', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York',
}).format(new Date());
const printpackPrintedLabel = (lang === 'es' ? 'impreso ' : 'printed ') + printpackPrintedOn;

/** View-switcher href that preserves the current day scope + language. */
function viewHref(v: 'overall' | 'csa' | 'wholesale' | 'market' | 'packhouse', marketId?: string): string {
  const p = new URLSearchParams();
  if (v !== 'overall') p.set('view', v);
  if (v === 'market' && marketId) p.set('market', marketId);
  if (lang !== 'en') p.set('lang', lang);
  if (dayScope !== 'all') p.set('day', dayScope);
  const qs = p.toString();
  return `/admin/pick-pack/${week_starting}${qs ? `?${qs}` : ''}`;
}

/* ══════════════════════════════════════════════════════════════════════════
 * LIVE CHECK-OFF (migration 0069) — per-line status + WHO, synced across
 * devices. Answers Todd's "confusion about what has been done, and if someone
 * did it." The DB `section` is 'harvest' for the OVERALL pick view; the other
 * three views are pack sections. The interactive controls are wired CLIENT-SIDE
 * (see the <script> at the foot of the file) from the `data-*` attributes each
 * line carries below; here we only load saved state + compute the summary so the
 * page renders in its current status with no flash.
 * ════════════════════════════════════════════════════════════════════════ */
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
/** Non-market sections (+ an untagged market group) share this sentinel so the
 *  (week,section,scope,market,line) UNIQUE dedupes — matches the 0069 default. */
const SENTINEL_MARKET = '00000000-0000-0000-0000-000000000000';

// The DB `section` for the live check-off. 'harvest' = the OVERALL pick view;
// csa/wholesale/market are the per-channel pack views; 'packhouse' (0083) is the
// by-item distribution sheet, now interactive (Packed toggle + needed_qty + note),
// keyed on its own section so its progress never collides with the overall view.
// For printpack the live board is never wired (no #pp-live-config below), but the
// pack-house SECTION still server-renders its saved need-chips + notes from
// progressMap, so we load the SAME 'packhouse' board the standalone view reads.
const ppSection: 'harvest' | 'csa' | 'wholesale' | 'market' | 'packhouse' =
  view === 'overall' ? 'harvest' : view === 'printpack' ? 'packhouse' : view;
const marketIdForKey =
  view === 'market' && selectedMarket && UUID_RE.test(selectedMarket.id)
    ? selectedMarket.id
    : SENTINEL_MARKET;

// Saved status for every line on THIS sheet (crew can read via is_ops_caller).
// needed_qty + note (0083) are only meaningful for the pack-house sheet but are
// always selected so the pack-house rows can seed their need chip + note.
interface ProgRow { line_key: string; status: string; worked_by: string | null; actual_qty: number | null; needed_qty: number | null; note: string | null; }
const { data: progressRows } = await supabase
  .from('pick_pack_progress')
  .select('line_key, status, worked_by, actual_qty, needed_qty, note')
  .eq('week_date', week_starting)
  .eq('section', ppSection)
  .eq('scope_day', dayScope)
  .eq('market_id', marketIdForKey)
  .overrideTypes<ProgRow[], { merge: false }>();
const progressMap = new Map<string, ProgRow>();
for (const r of progressRows ?? []) progressMap.set(r.line_key, r);

/** Server-render attributes for one interactive line. The browser controller
 *  reads these to build the Harvesting/Done or Packed control and to seed the
 *  optimistic state — it NEVER recomputes line_key, so the key here is the sole
 *  source of truth. `kind`/`name`/`unit` MUST match the summary key list below. */
function lineAttrs(
  kind: 'group' | 'row',
  name: string,
  keyUnit: string | null | undefined,
  target: number | null,
  displayUnit?: string | null,
): Record<string, string> {
  // keyUnit participates in the STABLE key (csa/wholesale/market split the same
  // crop by unit; the overall view passes null so it keys by crop alone — this
  // must mirror the ppKeys list). displayUnit is only shown in the "actual qty"
  // prompt and defaults to keyUnit.
  const key = pickPackLineKey(kind, name, keyUnit);
  const r = progressMap.get(key);
  return {
    'data-pp-line': '',
    'data-line-key': key,
    'data-status': r?.status ?? 'todo',
    'data-worked': r?.worked_by ?? '',
    'data-actual': r?.actual_qty != null ? String(r.actual_qty) : '',
    'data-target': target != null ? String(target) : '',
    'data-unit': (displayUnit ?? keyUnit) ?? '',
  };
}

/** Best single display unit for an OVERALL merged row (blank when channels
 *  disagree) — used only for the "actual qty" prompt, not for the key. */
function overallUnit(r: (typeof merged)[number]): string {
  const units = new Set([r.csa?.unit, r.market?.unit, r.wholesale?.unit, r.flex?.unit].filter(Boolean) as string[]);
  return units.size === 1 ? [...units][0] : '';
}

// The line_key list for the CURRENT view — MUST mirror the template's render
// order + kind/name/unit exactly so the summary counts match the rendered lines.
let ppKeys: string[] = [];
if (view === 'overall') {
  ppKeys = [
    ...overallCombined.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...tenderRowsShown.map((r) => pickPackLineKey('row', r.crop)),
    ...otherRowsShown.map((r) => pickPackLineKey('row', r.crop)),
    ...unmatchedMakeups.map((m) => pickPackLineKey('row', m.key)),
  ];
} else if (view === 'csa') {
  ppKeys = [
    ...csaCombine.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...csaRowsShown.map((r) => pickPackLineKey('row', r.crop, r.unit)),
  ];
} else if (view === 'wholesale') {
  ppKeys = [
    ...wholesaleCombine.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...wholesaleRowsShown.map((r) => pickPackLineKey('row', r.crop, r.unit)),
  ];
} else if (view === 'market') {
  ppKeys = [
    ...marketCombine.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...marketItemsShown.map((it) => pickPackLineKey('row', it.name, it.unit)),
  ];
}
// NOTE: the pack-house view has NO live check-off — it is a clean printable
// distribution TABLE with plain pen checkboxes (Have on hand / Packed), so it
// contributes no ppKeys (ppTotal stays 0 → the live progress bar never renders
// for this view). The other four views keep the interactive board (0069).
// Initial counts (the client keeps these live thereafter).
let ppTodo = 0, ppHarvesting = 0, ppDone = 0, ppPacked = 0, ppFlagged = 0;
for (const k of ppKeys) {
  const pr = progressMap.get(k);
  const st = pr?.status ?? 'todo';
  if (st === 'harvesting') ppHarvesting++;
  else if (st === 'done') ppDone++;
  else if (st === 'packed') ppPacked++;
  else ppTodo++;
  // "Flagged short" = a crop with a positive needed_qty (pack-house only).
  if (pr?.needed_qty != null && pr.needed_qty > 0) ppFlagged++;
}
const ppTotal = ppKeys.length;
const ppComplete = ppSection === 'harvest' ? ppDone : ppPacked;
const ppPct = ppTotal > 0 ? Math.round((ppComplete / ppTotal) * 100) : 0;
---

<AdminShell
  title="Pick & Pack"
  subtitle={`${docTitle} · ${prettyWeekHeader(week_starting)}`}
  pageTitle={`Pick & Pack — ${docTitle} — Tiny Seed Admin`}
>
  <Fragment slot="actions">
    {(view === 'overall' || view === 'packhouse' || view === 'printpack') && (
      <a
        href={(() => {
          // Toggle language while preserving the current view + day scope. The
          // overall + pack-house + combined-pack sheets are the crew-facing docs
          // the ES version exists for.
          const p = new URLSearchParams();
          if (view !== 'overall') p.set('view', view);
          if (lang !== 'es') p.set('lang', 'es'); // en → es; es → (drop = en)
          if (dayScope !== 'all') p.set('day', dayScope);
          const qs = p.toString();
          return `/admin/pick-pack/${week_starting}${qs ? `?${qs}` : ''}`;
        })()}
        class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary"
      >
        🌐 {t.langToggle}
      </a>
    )}
    <button
      type="button"
      onclick="window.print()"
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark"
    >
      🖨 Print
    </button>
    <a
      href={`/admin/pick-pack?week=${week_starting}`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
    >
      ← Pick &amp; Pack
    </a>
  </Fragment>

  {/* ── Screen-only view switcher ──────────────────────────────────── */}
  <nav aria-label="Pick & Pack views" class="screen-only flex flex-wrap gap-2 border-b border-ts-border pb-3">
    {[
      { key: 'overall', label: '🌾 Overall', href: viewHref('overall') },
      { key: 'packhouse', label: `📦 ${t.packhouseTab}`, href: viewHref('packhouse') },
      { key: 'csa', label: '🥬 CSA', href: viewHref('csa') },
      { key: 'wholesale', label: '🍽 Wholesale', href: viewHref('wholesale') },
    ].map((tab) => (
      <a
        href={tab.href}
        aria-current={view === tab.key ? 'page' : undefined}
        class={[
          'inline-flex h-9 items-center rounded-ts-md px-3 text-sm font-semibold transition-colors',
          view === tab.key ? 'bg-ts-primary/10 text-ts-primary' : 'text-ts-text-secondary hover:bg-ts-bg-muted hover:text-ts-text',
        ].join(' ')}
      >{tab.label}</a>
    ))}
    {marketGroupsSorted.filter((g) => g.id !== 'untagged').map((g) => (
      <a
        href={viewHref('market', g.id)}
        aria-current={view === 'market' && selectedMarket?.id === g.id ? 'page' : undefined}
        class={[
          'inline-flex h-9 items-center rounded-ts-md px-3 text-sm font-semibold transition-colors',
          view === 'market' && selectedMarket?.id === g.id ? 'bg-ts-primary/10 text-ts-primary' : 'text-ts-text-secondary hover:bg-ts-bg-muted hover:text-ts-text',
        ].join(' ')}
      >🛒 {g.name}</a>
    ))}
  </nav>

  {/* ── Harvest-day scope tab strip ────────────────────────────────────
      Scopes the combined per-crop demand to a single harvest day. Mon =
      Tue + Wed distributions; Thu = Sat + Sun (weekend markets). "All week"
      is the whole-week merge (default). Mirrors /admin/harvest's tab strip;
      each link preserves the current lang + view drill-down. Screen-only —
      hidden in print (the printed sheet is already scoped by the query). */}
  <nav aria-label="Harvest day" class="screen-only flex flex-wrap gap-2 border-b border-ts-border">
    {dayTabs.map((tab) => (
      <a
        href={dayHref(tab.key)}
        aria-current={dayScope === tab.key ? 'page' : undefined}
        class={[
          'inline-flex h-10 items-center border-b-2 px-4 text-sm font-semibold transition-colors',
          dayScope === tab.key
            ? 'border-ts-primary text-ts-primary'
            : 'border-transparent text-ts-text-secondary hover:border-ts-border-strong hover:text-ts-text',
        ].join(' ')}
      >
        {tab.label}
        {tab.hint && <span class="ml-2 text-xs text-ts-text-muted">{tab.hint}</span>}
      </a>
    ))}
  </nav>

  <div class={['print-doc', view === 'printpack' ? 'pp-printpack' : ''].join(' ')}>
    {/* ═══ COMBINED PRINT PACK — page-1 banner + screen preview note ═══
        printpack composes three sheets into one print job. On screen this is a
        static preview (no live check-off is wired for this view — see the
        pp-live-config guard below), so a short note points the user at Print.
        The banner is the single page-1 header the owner asked for; the overall
        sheet's own compact band is dropped in print (scoped CSS) so page 1 has
        one clean header. */}
    {view === 'printpack' && (
      <>
        <p class="screen-only mb-4 rounded-ts-md border border-ts-border bg-ts-bg-muted/40 px-4 py-3 text-sm text-ts-text-secondary">
          🖨 <strong class="text-ts-text">Combined print pack.</strong> This is a preview — press
          <strong class="text-ts-text"> Print</strong> for the whole document: harvest totals, then the CSA,
          Flex and per-order wholesale pallets, then the pack house by item, then each market on its own page.
        </p>
        <header class="doc-band pp-printpack-header mb-4 rounded-ts-lg px-5 py-4">
          <p class="font-display text-sm font-bold uppercase tracking-wide sm:text-base">
            Pick &amp; Pack — {printpackScopeLabel} · {prettyWeekHeader(week_starting)} · {printpackPrintedLabel}
          </p>
        </header>
      </>
    )}

    {/* Make-ups are no longer a top banner (owner 2026-07-20): matched make-ups
        fold into their crop's overall row total (inline ⚠ note), and unmatched
        ones ride at the FOOT of the overall list — see the pp-makeup-group
        section below. */}

    {/* ══ LIVE CHECK-OFF config + progress summary (migration 0069) ══
        Screen-only. The hidden config element hands the browser controller the
        sheet coordinates + Supabase realtime creds + EN/ES labels; the summary
        gives Todd (and the crew) a live to-go / harvesting / done (or packed)
        readout. Hidden in print so the paper sheet is unchanged.

        NOT rendered for printpack: that view composes three sections (harvest +
        pack-house + markets) whose data-pp-line elements all coexist on one page,
        so wiring the single-section controller would mis-file taps. printpack is a
        print/preview doc — its interactive controls stay off (the data-* attrs are
        inert without this config element).

        NOT rendered for packhouse either: that view is now a clean printable
        distribution TABLE with plain pen checkboxes (no live board), so it has no
        data-pp-line elements to wire. */}
    {view !== 'printpack' && view !== 'packhouse' && (
      <div
        id="pp-live-config"
        class="hidden"
        data-week={week_starting}
        data-section={ppSection}
        data-scope={dayScope}
        data-market={marketIdForKey}
        data-supabase-url={PUBLIC_SUPABASE_URL}
        data-supabase-anon-key={PUBLIC_SUPABASE_ANON_KEY}
        data-i18n={JSON.stringify(t.live)}
      ></div>
    )}

    {ppTotal > 0 && (
      <section class="screen-only mb-4" aria-label={t.live.progress} data-pp-summary>
        <div class="rounded-ts-lg border border-ts-border bg-ts-bg-surface p-4 shadow-ts-sm">
          <div class="flex items-center justify-between gap-3">
            <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ts-text-secondary">{t.live.progress}</h2>
            <div class="flex items-center gap-3">
              {view === 'packhouse' && (
                <button
                  type="button"
                  data-pp-filter-flagged
                  aria-pressed="false"
                  hidden={ppFlagged === 0}
                  class="pp-filter-chip inline-flex min-h-[44px] items-center gap-1.5 rounded-full border border-ts-accent/40 bg-ts-accent/10 px-4 text-xs font-bold text-ts-accent transition-transform duration-100 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-accent"
                >
                  <span aria-hidden="true">⚠</span>
                  <span>{t.live.filterFlagged}</span>
                </button>
              )}
              <p class="text-sm font-bold tabular-nums text-ts-text">
                <span data-pp-complete>{ppComplete}</span><span class="text-ts-text-muted"> / </span><span data-pp-total>{ppTotal}</span>
              </p>
            </div>
          </div>
          <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-ts-bg-muted">
            <div data-pp-bar class="h-full rounded-full bg-ts-primary transition-[width] duration-300 ease-out" style={`width:${ppPct}%`}></div>
          </div>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold tabular-nums">
            <span class="text-ts-text-muted"><span data-pp-count-todo>{ppTodo}</span> {t.live.toGo}</span>
            {ppSection === 'harvest' && (
              <span class="text-ts-accent"><span data-pp-count-harvesting>{ppHarvesting}</span> {t.live.harvesting}</span>
            )}
            {ppSection === 'harvest' ? (
              <span class="text-ts-primary"><span data-pp-count-done>{ppDone}</span> {t.live.done}</span>
            ) : (
              <span class="text-ts-primary"><span data-pp-count-packed>{ppPacked}</span> {t.live.packed}</span>
            )}
            {view === 'packhouse' && (
              <span class="text-ts-accent" data-pp-flagged-wrap hidden={ppFlagged === 0}>
                <span aria-hidden="true">⚠ </span><span data-pp-count-flagged>{ppFlagged}</span> {t.live.flaggedShort}
              </span>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ═══════════════ OVERALL HARVEST ═══════════════
        Also the FIRST page of the combined print pack (view === 'printpack') —
        the SAME .pp-overall section + compact one-sheet print CSS, no fork. */}
    {(view === 'overall' || view === 'printpack') && (
      <section aria-labelledby="pp-heading" class="harvest-doc pp-overall">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">
            {t.overallTitle} · {prettyWeekHeader(week_starting)} · {dayScopeLabel}
          </p>
          <h2 id="pp-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🌾 {t.overallTitle}</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">{t.overallSubtitle}</p>
        </header>

        {overallRows.length === 0 && unmatchedMakeups.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">{t.nothing}</p>
          </Card>
        ) : (
          <div class={['mt-4 flex flex-col gap-6 pp-overall-list', overallTwoCol ? 'pp-2col' : ''].join(' ')}>
            {overallCombined.combined.length > 0 && (
              <section class="harvest-group pp-combined" aria-label="Combined greens — harvest by weight">
                <h3 class="group-head tender-head rounded-ts-md px-4 py-2 font-display text-lg font-bold">
                  Combined greens — weigh once, split after
                </h3>
                <ol class="mt-2 flex flex-col">
                  {overallCombined.combined.map((g) => (
                    <div style="display:contents" {...lineAttrs('group', g.harvestCrop, 'lb', g.totalLb)}>
                      <CombinedHarvestRow harvestCrop={g.harvestCrop} totalLb={g.totalLb} variants={g.variants} fmtLb={fmtLb} />
                    </div>
                  ))}
                </ol>
              </section>
            )}
            {overallGroups.filter((g) => g.rows.length > 0).map((group) => (
              <section class="harvest-group" aria-label={group.label}>
                <h3 class={[
                  'group-head rounded-ts-md px-4 py-2 font-display text-lg font-bold',
                  group.tender ? 'tender-head' : 'category-head',
                ].join(' ')}>{group.label}</h3>
                <ol class="mt-2 flex flex-col">
                  {group.rows.map((r) => {
                    const cc = channelCount(r);
                    const photo = cropPhoto(r.crop);
                    const cell = (c: { qty: number; unit: string } | null, label: string) =>
                      c ? `${label} ${c.qty} ${c.unit}` : '';
                    const parts = [
                      cell(r.csa, t.csaCol), cell(r.market, t.marketCol), cell(r.wholesale, t.wholesaleCol), cell(r.flex, t.flexCol),
                    ].filter(Boolean);
                    // Total pounds to harvest across channels — sum each channel's
                    // count-unit contribution (weight-unit channels are already lb
                    // and are skipped by packLb, so they never double-count).
                    const rowLbTotal = [r.csa, r.market, r.wholesale, r.flex].reduce((acc, c) => {
                      if (!c) return acc;
                      const lb = packLb(r.crop, c.qty, c.unit);
                      return acc + (lb ?? 0);
                    }, 0);
                    const rowLb = rowLbTotal > 0 ? Math.round(rowLbTotal * 10) / 10 : null;
                    return (
                      <li class={`harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3${group.tender ? ' pp-tender' : ''}`} {...lineAttrs('row', r.crop, null, r.totalQty, overallUnit(r))}>
                        <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                        {photo && (
                          <span class="hidden h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-ts-md border border-ts-border bg-ts-bg-surface sm:flex print:hidden">
                            <img src={photo} alt="" width="44" height="44" loading="lazy" class="h-full w-full object-cover" />
                          </span>
                        )}
                        <div class="min-w-0 flex-1 pp-namewrap">
                          <p class="pp-crop text-xl font-bold leading-tight text-ts-text">
                            {r.crop}
                            {cc > 1 && <span class="ml-2 align-middle text-xs font-bold text-ts-primary">×{cc}</span>}
                          </p>
                          {r.altNames.length > 0 && (
                            <p class="pp-alt mt-0.5 text-xs font-medium italic text-ts-text-muted">{t.alsoWord}: {r.altNames.join(' · ')}</p>
                          )}
                          <p class="pp-breakdown mt-0.5 text-sm font-medium text-ts-text-secondary tabular-nums">{parts.join('  ·  ')}</p>
                          {r.makeups && r.makeups.length > 0 && (
                            <p class="pp-makeup mt-0.5 text-sm font-bold text-ts-accent">
                              {r.makeups.map((m, i) => (
                                <span>{i > 0 ? ' · ' : ''}⚠ +{m.qty} make-up{m.label ? ` (${m.label})` : ''}{m.overdue ? ' — overdue' : ''}</span>
                              ))}
                            </p>
                          )}
                        </div>
                        <span class="pp-leader hidden" aria-hidden="true"></span>
                        <div class="shrink-0 text-right pp-amount">
                          {(() => {
                            const units = new Set([r.csa?.unit, r.market?.unit, r.wholesale?.unit, r.flex?.unit].filter(Boolean) as string[]);
                            const oneUnit = units.size === 1 ? [...units][0] : null;
                            return oneUnit
                              ? <><span class="pp-qty font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{r.totalQty.toLocaleString()}</span><span class="ml-1 text-sm font-semibold text-ts-text-secondary">{oneUnit}</span></>
                              : <span class="pp-qty text-xs font-semibold text-ts-text-muted">{t.total}: {r.totalQty.toLocaleString()}<span class="ml-0.5">*</span></span>;
                          })()}
                          {rowLb != null && (
                            <p class="pp-lb mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                              {fmtLb(rowLb)}<span class="pp-lb-label ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                            </p>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))}
            {/* ⚠ MAKE-UPS that matched no harvest crop (bread confirm, store
                credit, a crop not harvested this week) — folded to the FOOT of
                the list so they're still picked/prepped + checkable, never lost
                to the removed top banner. */}
            {unmatchedMakeups.length > 0 && (
              <section class="harvest-group pp-makeup-group" aria-label="Make-ups to prep">
                <h3 class="group-head category-head rounded-ts-md px-4 py-2 font-display text-lg font-bold">
                  ⚠ Make-ups — also prep these
                </h3>
                <ol class="mt-2 flex flex-col">
                  {unmatchedMakeups.map((m) => (
                    <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3" {...lineAttrs('row', m.key, null, m.qty)}>
                      <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                      <div class="min-w-0 flex-1">
                        <p class="text-xl font-bold leading-tight text-ts-text">
                          {m.item}
                          {m.member && <span class="ml-2 text-sm font-semibold text-ts-text-secondary">— {m.member}</span>}
                        </p>
                        {m.detail && (
                          <p class="mt-0.5 whitespace-pre-wrap break-words text-sm leading-snug text-ts-text-secondary">{m.detail}</p>
                        )}
                      </div>
                      <span class={[
                        'shrink-0 self-center rounded-full px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide',
                        m.tag.overdue ? 'bg-ts-danger/15 text-ts-danger' : 'bg-ts-bg-muted text-ts-text-secondary',
                      ].join(' ')}>{m.tag.text}</span>
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </div>
        )}
        <p class="mt-4 text-xs text-ts-text-muted">{t.pickOnce}</p>
      </section>
    )}

    {/* ═══════════════ COMBINED PACK — CSA TOTALS (build the CSA pallet) ═══════════════
        Todd's pallet-staging order (2026-08-03): after the overall harvest, the
        combined pack stages each pallet. This is the SAME per-crop CSA checklist
        as ?view=csa — reusing csaCombine / csaRowsShown verbatim (no new math) —
        started on its own page (.pp-pallet-page). Plain pen checkboxes only (no
        live board on printpack), so the data-pp-line attrs are omitted here. */}
    {view === 'printpack' && (
      <section aria-labelledby="pp-csa-total-heading" class="harvest-doc pp-pallet-page">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">CSA harvest · {prettyWeekHeader(week_starting)} · {dayScopeLabel}</p>
          <h2 id="pp-csa-total-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🥬 CSA — totals (build the CSA pallet)</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">{totalCsaBoxes} boxes · box demand from the cycle resolver</p>
        </header>
        {csaRows.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">No box plan published for this week.</p>
          </Card>
        ) : (
          <ol class="mt-4 flex flex-col">
            {csaCombine.combined.map((g) => (
              <CombinedHarvestRow harvestCrop={g.harvestCrop} totalLb={g.totalLb} variants={g.variants} fmtLb={fmtLb} />
            ))}
            {csaRowsShown.map((r) => {
              const lb = packLb(r.crop, r.qty, r.unit);
              return (
                <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3">
                  <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                  <p class="min-w-0 flex-1 text-xl font-bold leading-tight text-ts-text">{r.crop}</p>
                  <div class="shrink-0 text-right">
                    <span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{r.qty.toLocaleString()}</span>
                    <span class="ml-1 text-sm font-semibold text-ts-text-secondary">{r.unit}</span>
                    {lb != null && (
                      <p class="mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                        {fmtLb(lb)}<span class="ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        )}
        <p class="mt-4 text-xs text-ts-text-muted">
          Box totals reflect each member's resolved composition (default plan + locked swaps + allergy substitutions).
        </p>
      </section>
    )}

    {/* ═══════════════ COMBINED PACK — FLEX TOTALS (build the Flex pallet) ═══════════════
        The à-la-carte flex demand for the week aggregated to item totals — the
        SAME flexRows the overall merge folds in (status pending/locked/fulfilled,
        day-scoped exactly like CSA). Big line + qty + pen checkbox per item, so
        the crew builds the Flex pallet. Own page (.pp-pallet-page). */}
    {view === 'printpack' && (
      <section aria-labelledby="pp-flex-total-heading" class="harvest-doc pp-pallet-page">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">Flex harvest · {prettyWeekHeader(week_starting)} · {dayScopeLabel}</p>
          <h2 id="pp-flex-total-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🌿 Flex — totals (build the Flex pallet)</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">À-la-carte flex orders for the week (pending / locked / fulfilled)</p>
        </header>
        {flexRows.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">No flex à-la-carte orders for this week.</p>
          </Card>
        ) : (
          <ol class="mt-4 flex flex-col">
            {flexRows.map((r) => {
              const lb = packLb(r.crop, r.qty, r.unit);
              return (
                <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3">
                  <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-xl font-bold leading-tight text-ts-text">{r.crop}</p>
                    {r.sourceName && (
                      <p class="mt-0.5 text-xs font-medium italic text-ts-text-muted">{t.alsoWord}: {r.sourceName}</p>
                    )}
                  </div>
                  <div class="shrink-0 text-right">
                    <span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{r.qty.toLocaleString()}</span>
                    <span class="ml-1 text-sm font-semibold text-ts-text-secondary">{r.unit}</span>
                    {lb != null && (
                      <p class="mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                        {fmtLb(lb)}<span class="ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        )}
        <p class="mt-4 text-xs text-ts-text-muted">
          Flex à-la-carte item totals across every member's order for the week — pick these so we have them for the Flex pallet.
        </p>
      </section>
    )}

    {/* ═══════════════ COMBINED PACK — WHOLESALE, ONE CHECKLIST PER ORDER ═══════════════
        Todd: pack each wholesale order COMPLETE, order by order, onto the
        wholesale pallet. One block per order delivering this week (SAME source +
        day/status/junk gates the pack-house matrix uses; Market Wagon is just
        another account), restaurant name as the heading with its delivery date,
        each line item a big line + qty + pen checkbox. Blocks are A→Z by account;
        break-inside: avoid keeps a block whole on a page. Own page group. */}
    {view === 'printpack' && (
      <section aria-labelledby="pp-wsale-total-heading" class="harvest-doc pp-pallet-page pp-wsale-orders">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">Wholesale harvest · {prettyWeekHeader(week_starting)} · {dayScopeLabel}</p>
          <h2 id="pp-wsale-total-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🍽 Wholesale — one checklist per order</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">Pack each order complete → wholesale pallet</p>
        </header>
        {printpackWsaleOrders.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">No wholesale orders delivering this week.</p>
          </Card>
        ) : (
          <div class="mt-4 flex flex-col gap-5">
            {printpackWsaleOrders.map((o) => (
              <section class="pp-wsale-order harvest-group" aria-label={`${o.accountName} — ${o.deliveryLabel}`}>
                <h3 class="group-head category-head rounded-ts-md px-4 py-2 font-display text-lg font-bold">
                  {o.accountName}
                  <span class="ml-2 text-sm font-semibold opacity-80">— deliver {o.deliveryLabel}</span>
                </h3>
                <ol class="mt-2 flex flex-col">
                  {o.items.map((it) => (
                    <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3">
                      <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                      <div class="min-w-0 flex-1">
                        <p class="text-xl font-bold leading-tight text-ts-text">{it.name}</p>
                        {it.sourceName && (
                          <p class="mt-0.5 text-xs font-medium italic text-ts-text-muted">{t.alsoWord}: {it.sourceName}</p>
                        )}
                      </div>
                      <div class="shrink-0 text-right">
                        <span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{it.qty.toLocaleString()}</span>
                        <span class="ml-1 text-sm font-semibold text-ts-text-secondary">{it.unit}</span>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        )}
        <p class="mt-4 text-xs text-ts-text-muted">
          One checklist per wholesale order delivering this week — pack each order complete before it goes on the wholesale pallet.
        </p>
      </section>
    )}

    {/* ═══════════════ CSA CHECKLIST ═══════════════ */}
    {view === 'csa' && (
      <section aria-labelledby="pp-csa-heading" class="harvest-doc">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">CSA harvest · {prettyWeekHeader(week_starting)} · {dayScopeLabel}</p>
          <h2 id="pp-csa-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🥬 CSA boxes — by crop</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">{totalCsaBoxes} boxes · box demand from the cycle resolver</p>
        </header>
        {csaRows.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">
              No box plan published for this week — set it at
              <a href={`/admin/box-contents?week=${week_starting}`} class="ml-1 font-semibold text-ts-primary hover:underline">the box editor</a>.
            </p>
          </Card>
        ) : (
          <ol class="mt-4 flex flex-col">
            {csaCombine.combined.map((g) => (
              <div style="display:contents" {...lineAttrs('group', g.harvestCrop, 'lb', g.totalLb)}>
                <CombinedHarvestRow harvestCrop={g.harvestCrop} totalLb={g.totalLb} variants={g.variants} fmtLb={fmtLb} />
              </div>
            ))}
            {csaRowsShown.map((r) => {
              const lb = packLb(r.crop, r.qty, r.unit);
              return (
                <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3" {...lineAttrs('row', r.crop, r.unit, r.qty)}>
                  <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                  <p class="min-w-0 flex-1 text-xl font-bold leading-tight text-ts-text">{r.crop}</p>
                  <div class="shrink-0 text-right">
                    <span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{r.qty.toLocaleString()}</span>
                    <span class="ml-1 text-sm font-semibold text-ts-text-secondary">{r.unit}</span>
                    {lb != null && (
                      <p class="mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                        {fmtLb(lb)}<span class="ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        )}
        <p class="mt-4 text-xs text-ts-text-muted">
          Box totals reflect each member's resolved composition (default plan + locked swaps + allergy substitutions).
        </p>
      </section>
    )}

    {/* ═══════════════ WHOLESALE CHECKLIST ═══════════════ */}
    {view === 'wholesale' && (
      <section aria-labelledby="pp-wsale-heading" class="harvest-doc">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">Wholesale harvest · {prettyWeekHeader(week_starting)} · {dayScopeLabel}</p>
          <h2 id="pp-wsale-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🍽 Wholesale — by crop</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">Submitted chef orders delivering this week</p>
        </header>
        {wholesaleRows.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">No submitted wholesale orders delivering this week.</p>
          </Card>
        ) : (
          <ol class="mt-4 flex flex-col">
            {wholesaleCombine.combined.map((g) => (
              <div style="display:contents" {...lineAttrs('group', g.harvestCrop, 'lb', g.totalLb)}>
                <CombinedHarvestRow harvestCrop={g.harvestCrop} totalLb={g.totalLb} variants={g.variants} fmtLb={fmtLb} />
              </div>
            ))}
            {wholesaleRowsShown.map((r) => {
              const lb = packLb(r.crop, r.qty, r.unit);
              return (
                <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3" {...lineAttrs('row', r.crop, r.unit, r.qty)}>
                  <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                  <p class="min-w-0 flex-1 text-xl font-bold leading-tight text-ts-text">{r.crop}</p>
                  <div class="shrink-0 text-right">
                    <span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{r.qty.toLocaleString()}</span>
                    <span class="ml-1 text-sm font-semibold text-ts-text-secondary">{r.unit}</span>
                    {lb != null && (
                      <p class="mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                        {fmtLb(lb)}<span class="ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        )}
        <p class="mt-4 text-xs text-ts-text-muted">Real ordered quantities from chef wholesale orders (status submitted) delivering this week.</p>
      </section>
    )}

    {/* ═══════════════ PER-MARKET CHECKLIST ═══════════════ */}
    {view === 'market' && (
      <section aria-labelledby="pp-mkt-heading" class="harvest-doc">
        {selectedMarket ? (
          <>
            <header class="doc-band rounded-ts-lg px-5 py-4">
              <p class="text-xs font-semibold uppercase tracking-wider opacity-90">Market harvest · {prettyWeekHeader(week_starting)}</p>
              <h2 id="pp-mkt-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🛒 {selectedMarket.name}</h2>
              <p class="mt-1 text-sm font-semibold opacity-95">
                {selectedMarket.day ? DAY_LONG[selectedMarket.day] ?? selectedMarket.day : 'Market'} · what to bring (planned qty)
              </p>
            </header>
            {marketItemsOrdered.length === 0 ? (
              <Card tone="muted" padding="lg" elevation="sm">
                <p class="text-center text-sm text-ts-text-secondary">
                  Nothing listed for this market — set the stall list at
                  <a href="/admin/market" class="ml-1 font-semibold text-ts-primary hover:underline">Market list</a>.
                </p>
              </Card>
            ) : (
              <div class="mt-4 flex flex-col gap-5">
                {marketCombine.combined.length > 0 && (
                  <ol class="flex flex-col">
                    {marketCombine.combined.map((g) => (
                      <div style="display:contents" {...lineAttrs('group', g.harvestCrop, 'lb', g.totalLb)}>
                        <CombinedHarvestRow harvestCrop={g.harvestCrop} totalLb={g.totalLb} variants={g.variants} fmtLb={fmtLb} />
                      </div>
                    ))}
                  </ol>
                )}
                {marketSections.map((section) => (
                  <section class="harvest-group" aria-label={t.sections[section.section]}>
                    <h3 class="group-head category-head rounded-ts-md px-4 py-2 font-display text-lg font-bold">{t.sections[section.section]}</h3>
                    <ol class="mt-2 flex flex-col">
                      {section.items.map((it) => {
                        const lb = packLb(it.name, it.qty, it.unit);
                        return (
                          <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3" {...lineAttrs('row', it.name, it.unit, it.qty)}>
                            <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                            <div class="min-w-0 flex-1">
                              <p class="text-xl font-bold leading-tight text-ts-text">{it.name}</p>
                              {it.sourceName && (
                                <p class="mt-0.5 text-xs font-medium italic text-ts-text-muted">{t.alsoWord}: {it.sourceName}</p>
                              )}
                            </div>
                            <div class="shrink-0 text-right">
                              {it.qty > 0
                                ? <><span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{it.qty.toLocaleString()}</span><span class="ml-1 text-sm font-semibold text-ts-text-secondary">{it.unit}</span></>
                                : <span class="text-sm font-semibold text-ts-text-muted">{it.unit}</span>}
                              {lb != null && (
                                <p class="mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                                  {fmtLb(lb)}<span class="ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                                </p>
                              )}
                            </div>
                          </li>
                        );
                      })}
                    </ol>
                  </section>
                ))}
              </div>
            )}
            <p class="mt-4 text-xs text-ts-text-muted">
              Planned qty is the farmer's estimate of what to bring to the {selectedMarket.name} stall this week. Grouped by product family.
              Set the list at <a href="/admin/market" class="font-semibold text-ts-primary hover:underline">Market list</a>.
            </p>
          </>
        ) : (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">
              No active market offerings this week — set the stall list at
              <a href="/admin/market" class="ml-1 font-semibold text-ts-primary hover:underline">Market list</a>.
            </p>
          </Card>
        )}
      </section>
    )}

    {/* ═══════════════ PACK HOUSE — DISTRIBUTION TABLE (crop × destination) ═══════════════
        REDESIGNED (owner 2026-07-20). A CLEAN, READABLE TABLE: one ROW per crop,
        grouped into CREW SECTIONS (bold category band), columns left→right —
          Item │ one column PER DESTINATION (CSA, each market by NAME, each
          wholesale account incl. Market Wagon, Flex) │ TOTAL (bold) │
          Have on hand (☐ + write-in blank) │ Packed (☐).
        Empty destination cells show a faint "·" (not 0). Every row's destination
        cells SUM to TOTAL — the builder guarantees it (Σ CSA + markets + wholesale
        + Flex = merged.totalQty). Because Thursday can have many destination
        columns, this section prints Letter LANDSCAPE (@page pack-landscape).

        The checkboxes are PLAIN PEN BOXES (print blank to tick by hand) on both
        the screen and the print view — the pack-house sheet is a printable
        artifact, so it carries NO live check-off (the other four views keep the
        interactive board). Data is UNCHANGED: buildDestinationMatrix supplies the
        SAME rows + cells (total reused verbatim from `merged`); groupBySection
        only reshapes the render. Portioned products show total harvest pounds
        (matrixRowLb = Σ count × pack_weight_lb) under the TOTAL.

        Also the SECOND section of the combined print pack (view === 'printpack')
        — the SAME .packhouse-doc table verbatim, started on a fresh landscape page. */}
    {(view === 'packhouse' || view === 'printpack') && (
      <section aria-labelledby="pp-pack-heading" class="packhouse-doc">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">{t.packhouseTitle} · {prettyWeekHeader(week_starting)} · {dayScopeLabel}</p>
          <h2 id="pp-pack-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">📦 {t.packhouseTitle}</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">{t.packhouseSubtitle}</p>
        </header>

        {!packhouseMatrix || packhouseMatrix.rows.length === 0 || packhouseMatrix.columns.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">{t.nothing}</p>
          </Card>
        ) : (
          <>
            {/* Instruction line (owner 2026-07-20) — how to use the two pen columns. */}
            <p class="pack-matrix-instruction">{t.packhouseInstruction}</p>
            <div class="pack-matrix-scroll">
              <table class="pack-matrix">
                <thead>
                  <tr>
                    <th scope="col" class="pm-h pm-h-item">{t.itemCol}</th>
                    {packhouseMatrix.columns.map((col) => (
                      <th scope="col" class="pm-h pm-h-dest">
                        <span class="pm-h-glyph" aria-hidden="true">{destGlyph(col.kind)}</span>
                        <span class="pm-h-label">{col.label}</span>
                      </th>
                    ))}
                    <th scope="col" class="pm-h pm-h-total">{t.total}</th>
                    <th scope="col" class="pm-h pm-h-have">{t.haveOnHandCol}</th>
                    <th scope="col" class="pm-h pm-h-packed">{t.packedCol}</th>
                  </tr>
                </thead>
                {packhouseSections.map((section) => (
                  <tbody class="pm-section">
                    <tr class="pm-section-row">
                      <th scope="colgroup" colspan={packhouseMatrix!.columns.length + 4} class="pm-section-head">
                        {t.sections[section.section]}
                      </th>
                    </tr>
                    {section.items.map((r) => {
                      const rowLb = matrixRowLb(r);
                      return (
                        <tr class={['pm-row', r.tender ? 'pm-row-tender' : ''].join(' ')}>
                          <th scope="row" class="pm-item">
                            <span class="pm-item-name">
                              {r.tender && <span class="pm-tender-tag" aria-hidden="true">🌱 </span>}
                              {r.crop}
                            </span>
                            {r.altNames.length > 0 && (
                              <span class="pm-item-alt">{t.alsoWord}: {r.altNames.join(' · ')}</span>
                            )}
                          </th>
                          {packhouseMatrix!.columns.map((col) => {
                            const cell = r.cells.get(col.key);
                            return (
                              <td class={['pm-cell', cell ? '' : 'pm-cell-empty'].join(' ')}>
                                {cell ? (
                                  <>
                                    <span class="pm-cell-qty">{cell.qty.toLocaleString()}</span>
                                    {cell.unit !== r.dominantUnit && <span class="pm-cell-unit">{cell.unit}</span>}
                                    {col.kind === 'csa' && cell.sizeSplit && (cell.sizeSplit.small > 0 || cell.sizeSplit.large > 0) && (
                                      <span class="pm-cell-size">{cell.sizeSplit.small}S/{cell.sizeSplit.large}L</span>
                                    )}
                                  </>
                                ) : (
                                  <span class="pm-dot" aria-hidden="true">·</span>
                                )}
                              </td>
                            );
                          })}
                          <td class="pm-total">
                            <span class="pm-total-qty">{r.totalQty.toLocaleString()}</span>
                            {r.mixedUnits
                              ? <span class="pm-total-star">*</span>
                              : (r.dominantUnit && <span class="pm-total-unit">{r.dominantUnit}</span>)}
                            {rowLb != null && <span class="pm-total-lb">{fmtLb(rowLb)}</span>}
                          </td>
                          {/* Have on hand — pen checkbox + short write-in blank. */}
                          <td class="pm-have">
                            <span class="pm-checkbox" aria-hidden="true"></span>
                            <span class="pm-writein" aria-hidden="true"></span>
                          </td>
                          {/* Packed — pen checkbox. */}
                          <td class="pm-packed">
                            <span class="pm-checkbox" aria-hidden="true"></span>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                ))}
              </table>
            </div>
            <p class="mt-4 text-xs text-ts-text-muted">
              {t.packhouseHint}
              {packhouseMatrix.rows.some((r) => r.mixedUnits) && <span class="ml-1">(<span class="font-bold">*</span> = this crop is measured in more than one unit across destinations; read each cell's own unit.)</span>}
            </p>
          </>
        )}
      </section>
    )}

    {/* ═══════════════ COMBINED PACK — PER-MARKET PAGES (?view=printpack) ═══════════════
        The THIRD section of the combined pack: one page per in-scope market
        (Lawrenceville leads on Monday; the Sat/Sun markets on Thursday). This
        reuses the SAME per-market builder (buildMarketRender) and the EXACT SAME
        .harvest-group / .harvest-row / CombinedHarvestRow markup + print CSS as
        the single-market view above — the only additions are the page-break
        wrapper (.pp-market-page) and per-market heading ids (a single-page view
        can't have those). No live check-off is wired for printpack, so the
        data-pp-line attrs left by lineAttrs are inert. */}
    {view === 'printpack' && printpackMarkets.map((mr) => (
      <section aria-labelledby={`pp-mkt-heading-${mr.group.id}`} class="harvest-doc pp-market-page">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">Market harvest · {prettyWeekHeader(week_starting)}</p>
          <h2 id={`pp-mkt-heading-${mr.group.id}`} class="mt-1 font-display text-3xl font-bold sm:text-4xl">🛒 {mr.group.name}</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">
            {mr.group.day ? DAY_LONG[mr.group.day] ?? mr.group.day : 'Market'} · what to bring (planned qty)
          </p>
        </header>
        {mr.itemsOrdered.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">Nothing listed for this market.</p>
          </Card>
        ) : (
          <div class="mt-4 flex flex-col gap-5">
            {mr.combine.combined.length > 0 && (
              <ol class="flex flex-col">
                {mr.combine.combined.map((g) => (
                  <div style="display:contents" {...lineAttrs('group', g.harvestCrop, 'lb', g.totalLb)}>
                    <CombinedHarvestRow harvestCrop={g.harvestCrop} totalLb={g.totalLb} variants={g.variants} fmtLb={fmtLb} />
                  </div>
                ))}
              </ol>
            )}
            {mr.sections.map((section) => (
              <section class="harvest-group" aria-label={t.sections[section.section]}>
                <h3 class="group-head category-head rounded-ts-md px-4 py-2 font-display text-lg font-bold">{t.sections[section.section]}</h3>
                <ol class="mt-2 flex flex-col">
                  {section.items.map((it) => {
                    const lb = packLb(it.name, it.qty, it.unit);
                    return (
                      <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3" {...lineAttrs('row', it.name, it.unit, it.qty)}>
                        <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                        <div class="min-w-0 flex-1">
                          <p class="text-xl font-bold leading-tight text-ts-text">{it.name}</p>
                          {it.sourceName && (
                            <p class="mt-0.5 text-xs font-medium italic text-ts-text-muted">{t.alsoWord}: {it.sourceName}</p>
                          )}
                        </div>
                        <div class="shrink-0 text-right">
                          {it.qty > 0
                            ? <><span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{it.qty.toLocaleString()}</span><span class="ml-1 text-sm font-semibold text-ts-text-secondary">{it.unit}</span></>
                            : <span class="text-sm font-semibold text-ts-text-muted">{it.unit}</span>}
                          {lb != null && (
                            <p class="mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                              {fmtLb(lb)}<span class="ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                            </p>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))}
          </div>
        )}
      </section>
    ))}
  </div>

  {/* One-tap print: when arrived via a ?print=1 button, open the print dialog
      once the sheet has painted. A short delay lets photos/fonts settle. */}
  {autoPrint && (
    <script is:inline>
      window.addEventListener('load', function () {
        window.setTimeout(function () { window.print(); }, 500);
      });
    </script>
  )}
</AdminShell>

<style is:global>
  /* ── LIVE CHECK-OFF (migration 0069) ────────────────────────────────────
     On SCREEN the crop lines show interactive controls (Harvesting/Done or
     Packed), so the empty "[ ]" tick box is redundant — hide it. It stays in
     PRINT (no @media screen rule applies there) so the printed sheet is byte-
     for-byte the same clean tickable document as before. Scoped to .harvest-doc
     so the make-ups banner's own tick boxes (outside .harvest-doc, admin/staff
     only) are untouched. */
  @media screen {
    .harvest-doc .harvest-check { display: none; }
  }
  /* Injected control container — screen only; the .screen-only rule in the
     @media print block below removes it from the printout. */
  .pp-ctl { min-height: 44px; }

  /* Doc band keeps its color through print (browsers strip backgrounds). */
  .doc-band {
    background: #1f6f54;            /* pine green — matches the pack-day motif */
    color: #ffffff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  /* Group heads: tender = warm alert; other = muted. Print in color. */
  .group-head {
    background: #e6eaef;
    color: #1a2230;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .group-head.tender-head {
    background: #fde68a;           /* amber — pick these FIRST */
    color: #5b3d00;
  }
  /* Category / crew-section bands (Roots, Alliums, …) — a soft pine tint so the
     product-family header reads as a band without heavy ink. Prints in color. */
  .group-head.category-head {
    background: #dfe7e2;
    color: #14231c;
  }
  /* ── PACK HOUSE — DISTRIBUTION TABLE (owner 2026-07-20) ─────────────────────
     A clean, readable spreadsheet: one ROW per crop, grouped into crew-section
     bands, a column per destination, a bold TOTAL, and two pen columns (Have on
     hand + Packed). READABILITY is the priority — big type, clear grid lines,
     generous row height. Because Thursday can carry many destination columns the
     print orientation is Letter LANDSCAPE. Same markup on screen + print. */

  /* Instruction line above the table — plain, legible, prints in color. */
  .pack-matrix-instruction {
    margin: 12px 0 8px;
    font-size: 0.95rem; line-height: 1.4; font-weight: 600;
    color: var(--ts-text-secondary);
  }
  /* Horizontal scroll safety on small SCREENS (print gets landscape instead). */
  .pack-matrix-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  .pack-matrix {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
    font-variant-numeric: tabular-nums;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  /* Clear grid lines everywhere — the crew reads across a row and down a column. */
  .pack-matrix th, .pack-matrix td {
    border: 1px solid #cbd5e1;
    padding: 10px 10px;
    text-align: center;
    vertical-align: middle;
  }

  /* Header row — bold, sticky-ish band, prints in color. */
  .pack-matrix thead th {
    background: #1f6f54;             /* pine green — the pack-day motif */
    color: #ffffff;
    font-family: var(--ts-font-display, inherit);
    font-weight: 800;
    font-size: 0.9rem;
    line-height: 1.15;
    vertical-align: bottom;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .pack-matrix .pm-h-item { text-align: left; min-width: 9rem; }
  .pack-matrix .pm-h-dest { min-width: 4.5rem; }
  .pack-matrix .pm-h-glyph { display: block; font-size: 1rem; }
  .pack-matrix .pm-h-label { display: block; }
  .pack-matrix .pm-h-total { min-width: 5rem; }
  .pack-matrix .pm-h-have { min-width: 6.5rem; }
  .pack-matrix .pm-h-packed { min-width: 4.5rem; }

  /* Crew-section band row spanning the whole table. */
  .pack-matrix .pm-section-head {
    background: #dfe7e2;             /* soft pine tint */
    color: #14231c;
    text-align: left;
    font-family: var(--ts-font-display, inherit);
    font-weight: 800;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 6px 10px;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }

  /* Data rows — generous height; zebra striping so the eye tracks across. */
  .pack-matrix .pm-row { break-inside: avoid; page-break-inside: avoid; }
  .pack-matrix .pm-section tr.pm-row:nth-of-type(even) {
    background: #f4f6f5;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  /* Tender crops get an amber left edge (the pack-day tender DNA). */
  .pack-matrix .pm-row-tender .pm-item { border-left: 4px solid #f59e0b; }
  .pack-matrix .pm-tender-tag { font-size: 0.85rem; }

  /* Item (crop name) cell — left-aligned, the biggest, boldest label. */
  .pack-matrix .pm-item { text-align: left; }
  .pack-matrix .pm-item-name {
    display: block;
    font-family: var(--ts-font-display, inherit);
    font-size: 1.05rem; font-weight: 800; line-height: 1.15;
    color: var(--ts-text); word-break: break-word;
  }
  .pack-matrix .pm-item-alt {
    display: block; margin-top: 2px;
    font-size: 0.72rem; font-weight: 500; font-style: italic; color: var(--ts-text-muted);
  }

  /* Destination cells — the qty going to that outlet; empty = faint dot. */
  .pack-matrix .pm-cell-qty { font-size: 1rem; font-weight: 700; color: var(--ts-text); }
  .pack-matrix .pm-cell-unit { margin-left: 2px; font-size: 0.7rem; font-weight: 600; color: var(--ts-text-secondary); }
  .pack-matrix .pm-cell-size { display: block; font-size: 0.72rem; font-weight: 700; color: var(--ts-text-secondary); }
  .pack-matrix .pm-dot { color: #cbd5e1; font-weight: 700; }

  /* TOTAL cell — bold, the headline "pick this much" number. */
  .pack-matrix .pm-total {
    background: #eef4f1;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .pack-matrix .pm-total-qty {
    font-family: var(--ts-font-display, inherit);
    font-size: 1.2rem; font-weight: 800; color: var(--ts-text);
  }
  .pack-matrix .pm-total-unit { margin-left: 3px; font-size: 0.72rem; font-weight: 600; color: var(--ts-text-secondary); }
  .pack-matrix .pm-total-star { margin-left: 2px; font-size: 0.72rem; font-weight: 700; color: var(--ts-text-muted); vertical-align: super; }
  .pack-matrix .pm-total-lb {
    display: block; margin-top: 2px;
    font-size: 0.82rem; font-weight: 800; color: #166534;
  }

  /* Pen columns — plain printed boxes + a write-in blank (never wired to the
     live board; the crew ticks / writes by hand on paper). */
  .pack-matrix .pm-checkbox {
    display: inline-block;
    width: 1.15rem; height: 1.15rem;
    border: 2px solid #1a2230; border-radius: 3px; background: #fff;
    vertical-align: middle;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .pack-matrix .pm-have { white-space: nowrap; }
  .pack-matrix .pm-writein {
    display: inline-block; width: 3.25rem; margin-left: 8px;
    border-bottom: 1.5px solid #1a2230; vertical-align: middle;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }

  @page pack-landscape { size: Letter landscape; margin: 0.45in; }

  @media print {
    @page { size: Letter portrait; margin: 0.5in; }
    body, html { background: white !important; }

    /* Hide on-screen-only chrome (view switcher). */
    .screen-only { display: none !important; }

    /* Keep a crop row whole on one page. */
    .harvest-row { break-inside: avoid; page-break-inside: avoid; }
    .harvest-group { break-inside: auto; }

    /* Big, legible print type for the pick list. */
    .harvest-row p { font-size: 14pt; }

    /* PACK HOUSE distribution TABLE — LANDSCAPE (fits the many destination
       columns, esp. Thursday), big legible type, clear grid lines, generous row
       height. The <thead> repeats on every page automatically; rows never split. */
    .packhouse-doc { page: pack-landscape; }
    .pack-matrix-scroll { overflow: visible; }        /* no scrollbars on paper */
    .packhouse-doc .pack-matrix-instruction { font-size: 10.5pt; }
    .packhouse-doc .pack-matrix { font-size: 11pt; }
    .packhouse-doc .pack-matrix thead th { font-size: 11pt; }
    .packhouse-doc .pack-matrix thead { display: table-header-group; }
    .packhouse-doc .pack-matrix .pm-row { break-inside: avoid; page-break-inside: avoid; }
    .packhouse-doc .pack-matrix .pm-section-head { font-size: 11pt; }
    .packhouse-doc .pack-matrix .pm-item-name { font-size: 12.5pt; }
    .packhouse-doc .pack-matrix .pm-cell-qty { font-size: 12pt; }
    .packhouse-doc .pack-matrix .pm-total-qty { font-size: 13.5pt; }
    .packhouse-doc .pack-matrix .pm-total-lb { font-size: 10.5pt; }
    .packhouse-doc .pack-matrix th, .packhouse-doc .pack-matrix td { border-color: #94a3b8; padding: 7px 8px; }
    .packhouse-doc .pack-matrix .pm-checkbox { border-color: #000; }
    .packhouse-doc .pack-matrix .pm-writein { border-bottom-color: #000; }

    /* ══ COMPACT PRINTED OVERALL HARVEST SHEET ════════════════════════════════
       Owner 2026-07-09: "make the harvest list we print more compact — down to
       one sheet." Binding rule: compact ≠ cramped. ONE clean line per crop,
       readable at arm's length (12pt floor); we save the page with TIGHT LINES,
       never tiny type. PRINT ONLY + scoped to .pp-overall, so:
         • the loved on-screen view (photos + live check-off) is byte-identical, and
         • the CSA / wholesale / market / pack-house printouts are untouched
           (they share .harvest-doc + CombinedHarvestRow but NOT .pp-overall).
       Line anatomy:  [tick] CROP …dot leaders… QTY UNIT · lb                 ── */

    /* Header band → one compact line. Keep the green band + its small uppercase
       line (it already carries title · week · harvest-day scope); drop the giant
       display title + the subtitle that only matter on screen. */
    .pp-overall .doc-band { padding: 6px 12px; }
    .pp-overall .doc-band h2,
    .pp-overall .doc-band > p:last-child { display: none; }
    .pp-overall .doc-band > p:first-child {
      font-size: 10.5pt; letter-spacing: 0.02em; opacity: 1;
    }

    /* Reclaim the on-screen whitespace between band, groups, and rows. */
    .pp-overall .pp-overall-list { margin-top: 8px; gap: 5px; }
    .pp-overall .harvest-group { margin: 0; }
    .pp-overall .harvest-group + .harvest-group { margin-top: 3px; }
    .pp-overall .pp-overall-list > * { margin-top: 0; }        /* kill mt-* gaps */

    /* Group heads → a thin label, not a bar. Keep it with its rows. */
    .pp-overall .group-head {
      font-size: 9.5pt; line-height: 1.1; padding: 2px 8px; margin-bottom: 2px;
      break-inside: avoid; break-after: avoid; page-break-after: avoid;
    }

    /* ── ONE line per crop ───────────────────────────────────────────────── */
    .pp-overall .harvest-row {
      display: flex; align-items: baseline; gap: 8px;
      padding: 2.5px 4px; border-bottom: 1px solid #e5e7eb;
      break-inside: avoid; page-break-inside: avoid;
    }
    /* Spreadsheet zebra striping (Todd 2026-07-09: "a basic spreadsheet with
       alternating variation on row") — light tint on every other row so the
       eye tracks a line across the page; low-ink; forced to print. */
    .pp-overall .harvest-group li.harvest-row:nth-child(even) {
      background: #f3f4f6;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }
    /* Small pen tick box on the line (kept — the crew ticks crops off). */
    .pp-overall .harvest-check {
      width: 13px; height: 13px; margin: 0; align-self: center;
      border-width: 1.5px;
    }
    /* Name shrinks to its content so the leader can grow between it and the qty. */
    .pp-overall .pp-namewrap { flex: 0 1 auto; min-width: 0; }
    .pp-overall .pp-crop {
      font-size: 12pt; font-weight: 700; line-height: 1.12;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    /* Per-channel chips + any secondary line → OFF in print (the number the crew
       harvests is the TOTAL; channel splits + outlet aliases belong on the
       pack-house sheet, where crates get matched to destinations). */
    .pp-overall .pp-breakdown,
    .pp-overall .pp-alt { display: none; }

    /* Dot leader between name and amount. */
    .pp-overall .pp-leader {
      display: block; flex: 1 1 auto; min-width: 0.35in;
      align-self: baseline;
      border-bottom: 1.5px dotted #9ca3af; transform: translateY(-3px);
    }

    /* Amount → qty + unit + lb on ONE baseline line. */
    .pp-overall .pp-amount {
      flex: 0 0 auto; display: flex; align-items: baseline; gap: 3px;
      margin: 0; white-space: nowrap;
    }
    .pp-overall .pp-amount .pp-qty { font-size: 12.5pt; font-weight: 800; }
    .pp-overall .pp-amount > span { font-size: 12.5pt; line-height: 1.1; }
    .pp-overall .pp-lb {
      display: inline; margin: 0; font-size: 10pt; font-weight: 700; line-height: 1.1;
    }
    .pp-overall .pp-lb::before { content: '· '; color: #6b7280; font-weight: 600; }
    .pp-overall .pp-lb-label { display: none; }                /* "to harvest" */

    /* ── Combined-greens rows: same one-line headline; keep the constituent line
       (it carries the per-package pounds the pack team needs) but tiny + indented.
       No leader here — the "combined" tag + amber flag already read as a group. */
    .pp-overall .pp-combined .harvest-row {
      align-items: baseline; flex-wrap: wrap;
    }
    .pp-overall .pp-combined .pp-namewrap { flex: 1 1 auto; }
    .pp-overall .pp-combined .pp-leader { display: none; }
    .pp-overall .pp-variants {
      display: block; margin: 1px 0 0; font-size: 8.75pt; line-height: 1.15;
      font-weight: 500; color: #4b5563;
    }

    /* Tender marker — no extra height, amber left edge (the pack-day tender DNA).
       Combined greens are tender mixes → same amber flag. */
    .pp-overall .pp-tender,
    .pp-overall .pp-combined .harvest-row {
      border-left: 3px solid #f59e0b; padding-left: 6px;
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }

    /* Two columns ONLY when a single column would overflow (> 34 whole rows). The
       list is a flex column on screen; here it becomes a balanced 2-up multicol
       with rows kept whole (break-inside: avoid) so nothing splits across columns. */
    .pp-overall .pp-overall-list.pp-2col {
      display: block; column-count: 2; column-gap: 0.35in; column-fill: balance;
    }
    .pp-overall .pp-2col .harvest-group,
    .pp-overall .pp-2col .harvest-group > ol { display: block; }
    .pp-overall .pp-2col .harvest-row { break-inside: avoid; page-break-inside: avoid; }

    /* ── COMBINED PRINT PACK (?view=printpack) — page flow ─────────────────────
       printpack composes the overall harvest, the pack-house sheet, and each
       in-scope market into one print job. EVERY rule here is scoped under
       .pp-printpack, so the standalone overall / pack-house / market views print
       byte-for-byte unchanged — printpack composes them, never alters them. */
    /* The page-1 banner IS the combined pack's header, so the overall sheet's own
       compact green band is redundant beneath it — drop just that inner band. */
    .pp-printpack .pp-overall .doc-band { display: none; }
    /* One clean page-1 header. */
    .pp-printpack .pp-printpack-header { padding: 6px 12px; margin-bottom: 8px; }
    .pp-printpack .pp-printpack-header p { font-size: 11pt; letter-spacing: 0.02em; }
    /* Page breaks: harvest totals fill page 1; the pack house starts a fresh page;
       each market starts its own fresh page. break-BEFORE (not after) avoids the
       trailing blank page a break-after on the last market would leave. */
    .pp-printpack .packhouse-doc { break-before: page; page-break-before: always; }
    .pp-printpack .pp-market-page { break-before: page; page-break-before: always; }
    /* Pallet-staging sections (CSA totals, Flex totals, Wholesale per-order) each
       start a fresh page so the crew stages one pallet per sheet. */
    .pp-printpack .pp-pallet-page { break-before: page; page-break-before: always; }
    /* Keep each wholesale ORDER block whole on a page — a restaurant's checklist
       should never split across a page break mid-pallet. */
    .pp-printpack .pp-wsale-order { break-inside: avoid; page-break-inside: avoid; }
  }
</style>

<script>
  /* ══════════════════════════════════════════════════════════════════════════
   * LIVE CHECK-OFF controller (migration 0069). Builds the per-line Harvesting/
   * Done (PICK) or Packed (PACK) controls client-side from each line's server-
   * rendered data-* attributes, POSTs each change to /api/admin/pick-pack/mark
   * (optimistic, revert-on-failure), and subscribes to Supabase realtime so a
   * check-off on ONE phone updates every other device — the summary bar included
   * — without a reload. A 20s reconcile poll (GET /state) covers spotty pack-
   * house wifi when the realtime socket drops. All controls are screen-only, so
   * the printable sheet is untouched. No innerHTML, no native confirm/prompt.
   * ════════════════════════════════════════════════════════════════════════ */
  import { createClient } from '@supabase/supabase-js';

  interface LineI18n {
    progress: string; toGo: string; harvesting: string; done: string;
    packed: string; markPacked: string; undo: string; actualQ: string;
    save: string; cancel: string; by: string; saveFailed: string; retry: string;
    // Pack-house extras (0083).
    flaggedShort: string; filterFlagged: string; needBtn: string; needChip: string;
    needPrompt: string; noteBtn: string; notePrompt: string; clear: string;
  }
  interface Line {
    key: string; li: HTMLElement; control: HTMLElement;
    status: string; worked: string; actual: number | null;
    target: number | null; unit: string;
    // Pack-house only (0083): the crew-editable need + note + their DOM anchors.
    needed?: number | null; note?: string;
    article?: HTMLElement; packSlot?: HTMLElement | null;
    needChipEl?: HTMLElement | null; noteEl?: HTMLElement | null;
  }

  const cfg = document.getElementById('pp-live-config');
  if (cfg) {
    const week = cfg.dataset.week || '';
    const section = cfg.dataset.section || 'harvest';
    const scope = cfg.dataset.scope || 'all';
    const market = cfg.dataset.market || '';
    const supabaseUrl = cfg.dataset.supabaseUrl || '';
    const anonKey = cfg.dataset.supabaseAnonKey || '';
    const isHarvest = section === 'harvest';
    const isPackhouse = section === 'packhouse';
    const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    let t: LineI18n;
    try { t = JSON.parse(cfg.dataset.i18n || '{}') as LineI18n; } catch { t = {} as LineI18n; }

    const BTN = 'pp-btn inline-flex min-h-[44px] items-center justify-center rounded-ts-md px-4 text-sm font-bold transition-transform duration-100 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2';
    const BTN_PRIMARY = BTN + ' bg-ts-primary text-white outline-ts-primary';
    const BTN_ACCENT = BTN + ' bg-ts-accent text-white outline-ts-accent';
    const BTN_GHOST = 'pp-btn inline-flex min-h-[44px] items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm font-semibold text-ts-text-secondary transition-transform duration-100 active:scale-95 hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary';

    const lines = new Map<string, Line>();

    function mkBtn(label: string, cls: string, onClick: () => void): HTMLButtonElement {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = cls;
      b.textContent = label;
      b.addEventListener('click', onClick);
      return b;
    }

    function statusPill(line: Line): HTMLElement {
      const harvesting = line.status === 'harvesting';
      const wrap = document.createElement('span');
      wrap.className = harvesting
        ? 'inline-flex items-center gap-1.5 rounded-full bg-ts-accent/15 px-3 py-1.5 text-sm font-bold text-ts-accent'
        : 'inline-flex items-center gap-1.5 rounded-full bg-ts-primary/10 px-3 py-1.5 text-sm font-bold text-ts-primary';
      const mark = document.createElement('span');
      mark.setAttribute('aria-hidden', 'true');
      mark.textContent = harvesting ? '…' : '✓';
      wrap.appendChild(mark);
      let label = harvesting ? t.harvesting : line.status === 'packed' ? t.packed : t.done;
      if (line.status === 'done' && line.actual != null) {
        label += ' ' + line.actual + (line.unit ? ' ' + line.unit : '');
      }
      const lbl = document.createElement('span');
      lbl.textContent = label;
      wrap.appendChild(lbl);
      if (line.worked) {
        const who = document.createElement('span');
        who.className = 'font-medium text-ts-text-secondary';
        who.textContent = '· ' + (t.by || '') + ' ' + line.worked;
        wrap.appendChild(who);
      }
      return wrap;
    }

    /* ── PACK-HOUSE controls (0083) — Packed toggle + Need + Note ─────────────
     * A pack-house unit gets three independent affordances in its screen-only
     * control row: [✓ Packed] (todo↔packed), [Need more] (edit needed_qty), and
     * [📝 Note]. A compact green ✓ also lands on line 1 (packSlot) so the crew
     * scans done rows at a glance. The need chip + note text are rewritten in
     * their server-rendered slots (which also print), never re-created. */
    function needIsSet(line: Line): boolean {
      return line.needed != null && line.needed > 0;
    }
    function updateNeedChip(line: Line): void {
      if (line.needChipEl) {
        line.needChipEl.textContent = needIsSet(line)
          ? '⚠ ' + (t.needChip || 'need {n} more').replace('{n}', String(line.needed))
          : '';
      }
      if (line.article) line.article.dataset.flagged = needIsSet(line) ? '1' : '0';
    }
    function updateNote(line: Line): void {
      if (!line.noteEl) return;
      const txt = (line.note || '').trim();
      line.noteEl.textContent = txt
        ? '📝 ' + txt + (line.worked ? ' · ' + (t.by || '') + ' ' + line.worked : '')
        : '';
    }
    function appendRetry(line: Line, retry: () => void): void {
      const err = document.createElement('button');
      err.type = 'button';
      err.className = 'inline-flex min-h-[44px] items-center gap-1.5 rounded-ts-md bg-ts-danger/10 px-3 text-sm font-semibold text-ts-danger active:scale-95';
      err.textContent = '⚠ ' + (t.saveFailed || t.retry || 'Retry');
      err.addEventListener('click', () => { err.remove(); retry(); });
      line.control.appendChild(err);
    }

    function renderPackControls(line: Line): void {
      // Line-1 compact done glyph.
      if (line.packSlot) {
        line.packSlot.textContent = '';
        if (line.status === 'packed') {
          const chk = document.createElement('span');
          chk.className = 'mr-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-ts-primary text-xs font-bold text-white';
          chk.setAttribute('aria-hidden', 'true');
          chk.textContent = '✓';
          line.packSlot.appendChild(chk);
        }
      }
      // Control row: Packed toggle, then Need, then Note.
      const c = line.control;
      c.textContent = '';
      if (line.status === 'packed') {
        c.appendChild(statusPill(line));
        c.appendChild(mkBtn(t.undo, BTN_GHOST, () => setStatus(line, 'todo')));
      } else {
        c.appendChild(mkBtn('✓ ' + t.packed, BTN_PRIMARY, () => setStatus(line, 'packed')));
      }
      c.appendChild(mkBtn((needIsSet(line) ? '⚠ ' : '+ ') + t.needBtn, BTN_ACCENT, () => beginNeed(line)));
      c.appendChild(mkBtn('📝 ' + t.noteBtn, BTN_GHOST, () => beginNote(line)));
    }

    /** Inline needed_qty editor — number input + Save + Clear + Cancel. */
    function beginNeed(line: Line): void {
      const c = line.control;
      c.textContent = '';
      const label = document.createElement('span');
      label.className = 'text-sm font-semibold text-ts-text';
      label.textContent = t.needPrompt;
      const input = document.createElement('input');
      input.type = 'number';
      input.min = '0';
      input.step = 'any';
      input.inputMode = 'decimal';
      input.className = 'h-11 w-24 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-base text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-accent';
      if (needIsSet(line)) input.value = String(line.needed);
      const commit = () => {
        const v = parseFloat(input.value);
        setNeeded(line, Number.isFinite(v) && v > 0 ? v : null);
      };
      c.appendChild(label);
      c.appendChild(input);
      if (line.unit) {
        const u = document.createElement('span');
        u.className = 'text-sm font-medium text-ts-text-secondary';
        u.textContent = line.unit;
        c.appendChild(u);
      }
      c.appendChild(mkBtn(t.save, BTN_ACCENT, commit));
      if (needIsSet(line)) c.appendChild(mkBtn(t.clear, BTN_GHOST, () => setNeeded(line, null)));
      c.appendChild(mkBtn(t.cancel, BTN_GHOST, () => renderPackControls(line)));
      input.focus();
      input.select();
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
        else if (e.key === 'Escape') { e.preventDefault(); renderPackControls(line); }
      });
    }

    /** Inline note editor — text input + Save + Clear + Cancel. */
    function beginNote(line: Line): void {
      const c = line.control;
      c.textContent = '';
      const input = document.createElement('input');
      input.type = 'text';
      input.maxLength = 500;
      input.placeholder = t.notePrompt;
      input.className = 'h-11 min-w-0 flex-1 basis-48 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-base text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary';
      input.value = line.note || '';
      const commit = () => setNote(line, input.value);
      c.appendChild(input);
      c.appendChild(mkBtn(t.save, BTN_PRIMARY, commit));
      if ((line.note || '').trim()) c.appendChild(mkBtn(t.clear, BTN_GHOST, () => setNote(line, '')));
      c.appendChild(mkBtn(t.cancel, BTN_GHOST, () => renderPackControls(line)));
      input.focus();
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
        else if (e.key === 'Escape') { e.preventDefault(); renderPackControls(line); }
      });
    }

    async function setNeeded(line: Line, value: number | null): Promise<void> {
      const prev = { needed: line.needed ?? null, worked: line.worked };
      line.needed = value != null && value > 0 ? value : null;
      updateNeedChip(line);
      renderPackControls(line);
      updateSummary();
      try {
        const res = await fetch('/api/admin/pick-pack/mark', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            week_date: week, section, scope_day: scope,
            market_id: marketIdForPost(), line_key: line.key, needed_qty: line.needed,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(String(data.error || 'save_failed'));
        line.worked = data.worked_by || line.worked;
        updateNeedChip(line); updateNote(line); renderPackControls(line); updateSummary();
      } catch {
        line.needed = prev.needed; line.worked = prev.worked;
        updateNeedChip(line); renderPackControls(line); updateSummary();
        appendRetry(line, () => setNeeded(line, value));
      }
    }

    async function setNote(line: Line, text: string): Promise<void> {
      const trimmed = (text || '').trim();
      const prev = { note: line.note ?? '', worked: line.worked };
      line.note = trimmed;
      updateNote(line);
      renderPackControls(line);
      try {
        const res = await fetch('/api/admin/pick-pack/mark', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            week_date: week, section, scope_day: scope,
            market_id: marketIdForPost(), line_key: line.key, note: trimmed,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(String(data.error || 'save_failed'));
        line.worked = data.worked_by || line.worked;
        updateNote(line); renderPackControls(line);
      } catch {
        line.note = prev.note; line.worked = prev.worked;
        updateNote(line); renderPackControls(line);
        appendRetry(line, () => setNote(line, text));
      }
    }

    function renderControl(line: Line): void {
      if (isPackhouse) { renderPackControls(line); return; }
      const c = line.control;
      c.textContent = '';
      const st = line.status;
      if (isHarvest) {
        if (st === 'harvesting') {
          c.appendChild(statusPill(line));
          c.appendChild(mkBtn(t.done, BTN_PRIMARY, () => beginDone(line)));
          c.appendChild(mkBtn(t.undo, BTN_GHOST, () => setStatus(line, 'todo')));
        } else if (st === 'done') {
          c.appendChild(statusPill(line));
          c.appendChild(mkBtn(t.undo, BTN_GHOST, () => setStatus(line, 'todo')));
        } else {
          c.appendChild(mkBtn(t.harvesting, BTN_ACCENT, () => setStatus(line, 'harvesting')));
          c.appendChild(mkBtn(t.done, BTN_PRIMARY, () => beginDone(line)));
        }
      } else {
        if (st === 'packed') {
          c.appendChild(statusPill(line));
          c.appendChild(mkBtn(t.undo, BTN_GHOST, () => setStatus(line, 'todo')));
        } else {
          c.appendChild(mkBtn(t.markPacked, BTN_PRIMARY, () => setStatus(line, 'packed')));
        }
      }
    }

    /** Inline (never native) actual-qty entry before marking a PICK line done. */
    function beginDone(line: Line): void {
      const c = line.control;
      c.textContent = '';
      const label = document.createElement('span');
      label.className = 'text-sm font-semibold text-ts-text';
      label.textContent = t.actualQ;
      const input = document.createElement('input');
      input.type = 'number';
      input.min = '0';
      input.step = 'any';
      input.inputMode = 'decimal';
      input.className = 'h-11 w-24 rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-base text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary';
      const def = line.actual != null ? line.actual : line.target;
      if (def != null) input.value = String(def);
      const commit = () => {
        const v = parseFloat(input.value);
        const qty = Number.isFinite(v) && v >= 0 ? v : (line.target ?? 0);
        setStatus(line, 'done', qty);
      };
      const save = mkBtn(t.save, BTN_PRIMARY, commit);
      const cancel = mkBtn(t.cancel, BTN_GHOST, () => renderControl(line));
      c.appendChild(label);
      c.appendChild(input);
      if (line.unit) {
        const u = document.createElement('span');
        u.className = 'text-sm font-medium text-ts-text-secondary';
        u.textContent = line.unit;
        c.appendChild(u);
      }
      c.appendChild(save);
      c.appendChild(cancel);
      input.focus();
      input.select();
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); commit(); }
        else if (e.key === 'Escape') { e.preventDefault(); renderControl(line); }
      });
    }

    function marketIdForPost(): string | null {
      return section === 'market' && UUID_RE.test(market) ? market : null;
    }

    async function setStatus(line: Line, status: string, actualQty?: number): Promise<void> {
      const prev = { status: line.status, worked: line.worked, actual: line.actual };
      line.status = status;
      if (status === 'done') line.actual = actualQty != null ? actualQty : line.actual;
      else if (status === 'todo') line.actual = null;
      renderControl(line);
      updateSummary();
      try {
        const res = await fetch('/api/admin/pick-pack/mark', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            week_date: week, section, scope_day: scope,
            market_id: marketIdForPost(),
            line_key: line.key, status,
            actual_qty: status === 'done' ? (actualQty != null ? actualQty : line.actual) : null,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(String(data.error || 'save_failed'));
        line.worked = data.worked_by || line.worked;
        renderControl(line);
        updateSummary();
      } catch {
        // Revert the optimistic change and offer a retry — never lose the tap.
        line.status = prev.status; line.worked = prev.worked; line.actual = prev.actual;
        renderControl(line);
        updateSummary();
        const err = document.createElement('button');
        err.type = 'button';
        err.className = 'inline-flex min-h-[44px] items-center gap-1.5 rounded-ts-md bg-ts-danger/10 px-3 text-sm font-semibold text-ts-danger active:scale-95';
        err.textContent = '⚠ ' + (t.saveFailed || t.retry || 'Retry');
        err.addEventListener('click', () => { setStatus(line, status, actualQty); });
        line.control.appendChild(err);
      }
    }

    function setText(sel: string, val: number): void {
      const el = document.querySelector(sel);
      if (el) el.textContent = String(val);
    }
    function updateSummary(): void {
      let todo = 0, harvesting = 0, done = 0, packed = 0, flagged = 0;
      for (const line of lines.values()) {
        if (line.status === 'harvesting') harvesting++;
        else if (line.status === 'done') done++;
        else if (line.status === 'packed') packed++;
        else todo++;
        if (line.needed != null && line.needed > 0) flagged++;
      }
      const total = lines.size;
      const complete = isHarvest ? done : packed;
      setText('[data-pp-count-todo]', todo);
      if (isHarvest) { setText('[data-pp-count-harvesting]', harvesting); setText('[data-pp-count-done]', done); }
      else setText('[data-pp-count-packed]', packed);
      setText('[data-pp-complete]', complete);
      const bar = document.querySelector('[data-pp-bar]') as HTMLElement | null;
      if (bar) bar.style.width = (total > 0 ? Math.round((complete / total) * 100) : 0) + '%';
      // Pack-house: the "N flagged short" readout + the filter chip only surface
      // when something is actually flagged; clearing the last flag also drops an
      // active filter so the crew never lands on an empty, filtered sheet.
      if (isPackhouse) {
        setText('[data-pp-count-flagged]', flagged);
        const wrap = document.querySelector('[data-pp-flagged-wrap]') as HTMLElement | null;
        if (wrap) wrap.hidden = flagged === 0;
        const fb = document.querySelector('[data-pp-filter-flagged]') as HTMLButtonElement | null;
        if (fb) {
          fb.hidden = flagged === 0;
          if (flagged === 0) {
            const pd = document.querySelector('.packhouse-doc');
            if (pd) pd.classList.remove('pp-show-flagged');
            fb.setAttribute('aria-pressed', 'false');
          }
        }
      }
    }

    // Build a control for every server-rendered line. PACK-HOUSE lines are
    // <article>s carrying pre-rendered slots (packed toggle target, need chip,
    // note, and a control row); every other view is a normal <li> (OR a combined
    // row wrapped in a display:contents div — inject into its inner <li>).
    document.querySelectorAll<HTMLElement>('[data-pp-line]').forEach((el) => {
      const key = el.dataset.lineKey || '';
      if (!key) return;
      if (isPackhouse) {
        const ctlSlot = el.querySelector<HTMLElement>('[data-pp-ctlslot]');
        if (!ctlSlot) return;
        const line: Line = {
          key, li: el, control: ctlSlot,
          status: el.dataset.status || 'todo',
          worked: el.dataset.worked || '',
          actual: null,
          target: el.dataset.target ? Number(el.dataset.target) : null,
          unit: el.dataset.unit || '',
          needed: el.dataset.needed ? Number(el.dataset.needed) : null,
          note: el.dataset.note || '',
          article: el,
          packSlot: el.querySelector<HTMLElement>('[data-pp-packslot]'),
          needChipEl: el.querySelector<HTMLElement>('[data-pp-needchip]'),
          noteEl: el.querySelector<HTMLElement>('[data-pp-note]'),
        };
        lines.set(key, line);
        renderControl(line);
        return;
      }
      const li = (el.matches('li') ? el : el.querySelector('li')) as HTMLElement | null;
      if (!li) return;
      li.classList.add('flex-wrap');
      const control = document.createElement('div');
      control.className = 'pp-ctl screen-only mt-2 flex basis-full flex-wrap items-center gap-2';
      li.appendChild(control);
      const line: Line = {
        key, li, control,
        status: el.dataset.status || 'todo',
        worked: el.dataset.worked || '',
        actual: el.dataset.actual ? Number(el.dataset.actual) : null,
        target: el.dataset.target ? Number(el.dataset.target) : null,
        unit: el.dataset.unit || '',
      };
      lines.set(key, line);
      renderControl(line);
    });

    // Wire the "Flagged only" quick-filter chip (pack-house only). It collapses
    // every non-flagged unit so the crew sees just the short crops at a glance.
    const filterBtn = document.querySelector<HTMLButtonElement>('[data-pp-filter-flagged]');
    const packDoc = document.querySelector<HTMLElement>('.packhouse-doc');
    if (filterBtn && packDoc) {
      filterBtn.addEventListener('click', () => {
        const on = packDoc.classList.toggle('pp-show-flagged');
        filterBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }

    updateSummary();

    // Reconcile the whole sheet from the authoritative endpoint (on realtime
    // (re)connect + as a fallback poll). Cookie-scoped, so it returns the true
    // shared state regardless of realtime.
    async function reconcile(): Promise<void> {
      const params = new URLSearchParams({ week, section, scope_day: scope });
      const mid = marketIdForPost();
      if (mid) params.set('market_id', mid);
      try {
        const res = await fetch('/api/admin/pick-pack/state?' + params.toString(), { credentials: 'same-origin' });
        if (!res.ok) return;
        const data = await res.json();
        if (!data || !data.ok || !Array.isArray(data.rows)) return;
        const seen = new Set<string>();
        for (const r of data.rows) {
          seen.add(r.line_key);
          const line = lines.get(r.line_key);
          if (line) {
            line.status = r.status; line.worked = r.worked_by || ''; line.actual = r.actual_qty;
            line.needed = r.needed_qty ?? null; line.note = r.note || '';
            if (isPackhouse) { updateNeedChip(line); updateNote(line); }
            renderControl(line);
          }
        }
        for (const [k, line] of lines) {
          if (!seen.has(k) && (line.status !== 'todo' || (line.needed != null && line.needed > 0) || (line.note || ''))) {
            line.status = 'todo'; line.worked = ''; line.actual = null; line.needed = null; line.note = '';
            if (isPackhouse) { updateNeedChip(line); updateNote(line); }
            renderControl(line);
          }
        }
        updateSummary();
      } catch { /* keep last-known state */ }
    }

    let pollTimer: ReturnType<typeof setInterval> | null = null;
    const startPoll = () => { if (!pollTimer) pollTimer = setInterval(reconcile, 20000); };
    const stopPoll = () => { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } };

    if (supabaseUrl && anonKey && week) {
      try {
        const sb = createClient(supabaseUrl, anonKey, { auth: { persistSession: false, autoRefreshToken: false } });
        const channel = sb.channel('pp:' + week)
          .on(
            'postgres_changes',
            { event: '*', schema: 'public', table: 'pick_pack_progress', filter: 'week_date=eq.' + week },
            (payload: { eventType?: string; new?: Record<string, any>; old?: Record<string, any> }) => {
              const row = (payload.new && Object.keys(payload.new).length ? payload.new : payload.old) || {};
              // Only this sheet's rows (the week filter is server-side; scope +
              // section + market are matched here).
              if (row.section !== section || row.scope_day !== scope || row.market_id !== market) return;
              const line = lines.get(row.line_key);
              if (!line) return;
              if (payload.eventType === 'DELETE') {
                line.status = 'todo'; line.worked = ''; line.actual = null; line.needed = null; line.note = '';
              } else {
                line.status = row.status; line.worked = row.worked_by || ''; line.actual = row.actual_qty ?? null;
                line.needed = row.needed_qty ?? null; line.note = row.note || '';
              }
              if (isPackhouse) { updateNeedChip(line); updateNote(line); }
              renderControl(line);
              updateSummary();
            },
          )
          .subscribe((st: string) => {
            if (st === 'SUBSCRIBED') { stopPoll(); reconcile(); }
            else if (st === 'CHANNEL_ERROR' || st === 'TIMED_OUT' || st === 'CLOSED') { startPoll(); }
          });
        window.addEventListener('beforeunload', () => { try { sb.removeChannel(channel); } catch { /* noop */ } });
      } catch { startPoll(); }
    } else {
      startPoll();
    }

    // Catch up whenever the crew returns to the tab.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') reconcile();
    });
  }
</script>
</content>
