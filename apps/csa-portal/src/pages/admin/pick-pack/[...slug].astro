    {/* ═══════════════ CSA CHECKLIST ═══════════════ */}
    {view === 'csa' && (
      <section aria-labelledby="pp-csa-heading" class="harvest-doc">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">CSA harvest · {prettyWeekHeader(week_starting)} · {dayScopeLabel}</p>
          <h2 id="pp-csa-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🥬 CSA boxes — by crop</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">{totalCsaBoxes} boxes · box demand from the cycle resolver</p>
