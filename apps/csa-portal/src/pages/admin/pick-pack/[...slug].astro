---
/**
 * /admin/pick-pack/[week]            → OVERALL harvest (tender greens first).
 * /admin/pick-pack/[week]?lang=es    → OVERALL harvest in Spanish.
 * /admin/pick-pack/[week]?view=csa        → CSA box checklist by crop.
 * /admin/pick-pack/[week]?view=wholesale  → Wholesale order checklist by crop.
 * /admin/pick-pack/[week]?view=market&market=<id> → one market's checklist.
 *
 * The Pick & Pack generator. ONE cycle resolution + the market_offerings and
 * wholesale_order_items reads feed a single per-crop demand merge (see
 * lib/pick-pack.ts). Each view is a printable, big, clean, ONE-COLUMN document
 * with tickable "[   ]" boxes — built for the pack floor, not the screen.
 *
 * CSA demand is STRICTLY from resolveCycle (sum of each summer_veg member's
 * resolved box composition). Sum per crop = CSA box demand + market planned_qty
 * (across that crop's offerings) + wholesale order item qty.
 *
 * Print CSS pattern mirrors /admin/pack-check + /admin/route-sheet: AdminShell
 * hides its own chrome via print:hidden, and the @page block forces Letter
 * portrait + keeps each row whole.
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import CombinedHarvestRow from '../../../components/CombinedHarvestRow.astro';
import { supabaseAdmin } from '../../../lib/supabase';
import { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY } from 'astro:env/client';
import {
  resolveCycle, prettyWeekHeader, mondayOfWeek, isMonday, addDays,
} from '../../../lib/cycle';
import {
  mergeCropDemand, channelCount, parseLang, normCrop, PICK_PACK_STRINGS,
  pickPackLineKey,
  type CropDemandInput,
} from '../../../lib/pick-pack';
import {
  fetchAllOpenDueNoticesWithMember, isNoticeOverdue, HOME_DELIVERY_HINT,
  type NoticeWithMember,
} from '../../../lib/notices';

/* ── Two clients, deliberately (interactive P&P, migration 0069) ──────────────
 * `db` (service-role) loads the PER-CROP AGGREGATE demand so a CREW user — who
 * does NOT clear the admin RLS bypass — still sees the harvest/pack numbers. It
 * is safe because EVERY pick-pack view renders per-crop aggregates only (crop
 * name + qty + unit + lb + photo) — verified: no member contact_name/email/
 * phone/address is rendered in any view.
 *
 * `supabase` (the cookie-aware RLS client) is kept for the TWO reads that touch
 * member-linked data — the make-ups banner (member_notices, which joins
 * customers.contact_name) and its pickup_locations day map. member_notices RLS
 * is admin/staff-only (notices_staff_all, 0043), so for a crew user these return
 * EMPTY and the make-ups banner never renders — the member names never reach
 * crew. It is ALSO the client for the pick_pack_progress read (is_ops_caller
 * lets crew read the shared board). Admin/staff behavior is unchanged (service-
 * role returns them the same rows their RLS bypass did). */
const supabase = Astro.locals.supabase;
const db = supabaseAdmin;
const slugParam = (Astro.params.slug ?? '') as string;
const segments = slugParam.split('/').filter(Boolean);
const week_input = segments[0] ?? '';
if (!/^\d{4}-\d{2}-\d{2}$/.test(week_input)) {
  return Astro.redirect('/admin/pick-pack', 303);
}
const week_starting = isMonday(week_input) ? week_input : mondayOfWeek(week_input);

const viewRaw = Astro.url.searchParams.get('view') ?? 'overall';
const view: 'overall' | 'csa' | 'wholesale' | 'market' =
  viewRaw === 'csa' || viewRaw === 'wholesale' || viewRaw === 'market' ? viewRaw : 'overall';
const marketIdParam = Astro.url.searchParams.get('market') ?? '';
const lang = parseLang(Astro.url.searchParams.get('lang'));
const t = PICK_PACK_STRINGS[lang];

/* ── Harvest-day scope (mirrors /admin/harvest) ─────────────────────
 * ?day=mon → demand for Tue + Wed distributions (Monday harvest)
 * ?day=thu → demand for Sat + Sun distributions (Thursday harvest)
 * ?day=all → the whole week merged (default — current behavior). */
const dayRaw = Astro.url.searchParams.get('day') ?? 'all';
const dayScope: 'mon' | 'thu' | 'all' =
  dayRaw === 'mon' || dayRaw === 'thu' ? dayRaw : 'all';

const cycle = await resolveCycle(db, week_starting);
const weekEnd = addDays(week_starting, 6);

/* ── Day-classification rules — copied verbatim from /admin/harvest so the
 *    combined totals reconcile with the harvest page. ─────────────────── */
/** CSA member → harvest day: Sat/Sun pickup → thu; everything else → mon. */
function harvestTabForMember(day: string | null | undefined): 'mon' | 'thu' {
  return day === 'Sat' || day === 'Sun' ? 'thu' : 'mon';
}
/** DOW (0=Sun…6=Sat) of a YYYY-MM-DD date, parsed as UTC (TZ-safe). */
function dowOfYMD(ymd: string): number {
  const [y, mo, d] = ymd.split('-').map(Number);
  return new Date(Date.UTC(y, (mo || 1) - 1, d || 1)).getUTCDay();
}
/** Wholesale → harvest day: Fri(5)/Sat(6) delivery → thu; else → mon. */
function wholesaleTabFor(deliveryDate: string): 'mon' | 'thu' {
  const dow = dowOfYMD(deliveryDate);
  return dow === 5 || dow === 6 ? 'thu' : 'mon';
}
/** Market → harvest day: Tue → mon; Sat/Sun → thu; else excluded (null). */
function marketTabFor(day: string | null | undefined): 'mon' | 'thu' | null {
  if (day === 'Tue') return 'mon';
  if (day === 'Sat' || day === 'Sun') return 'thu';
  return null;
}
/**
 * True if a member/wholesale row on `tab` is in the current scope.
 * On 'all' everything passes (unchanged whole-week behavior). On mon/thu the
 * row's tab must match. NOTE: market uses `marketInScope` instead, because on
 * 'all' pick-pack keeps EVERY market (incl. untagged), matching prior behavior.
 */
function inScope(tab: 'mon' | 'thu'): boolean {
  return dayScope === 'all' || tab === dayScope;
}
/**
 * True if a market with `day_of_week` is in scope. On 'all' every market is
 * kept (incl. untagged — the prior overall behavior). On mon/thu only markets
 * that map to the selected harvest tab are kept.
 */
function marketInScope(day: string | null | undefined): boolean {
  if (dayScope === 'all') return true;
  return marketTabFor(day) === dayScope;
}

/* ──────────────────────────────────────────────────────────────────
 * 1. CSA box demand by crop — STRICTLY from resolveCycle.
 *    Sum each summer_veg member's resolved composition (default plan +
 *    locked swaps + allergy subs) per crop+unit.
 * ────────────────────────────────────────────────────────────────── */
interface CropAgg { crop: string; unit: string; qty: number; }
const csaMap = new Map<string, CropAgg>(); // key = crop|unit
for (const m of cycle.members) {
  if (m.share_type !== 'summer_veg') continue;
  // Scope to the selected harvest day (Sat/Sun pickup → thu; else → mon).
  if (!inScope(harvestTabForMember(m.pickup_location?.day_of_week))) continue;
  const comp = cycle.boxCompositionByMember.get(m.id);
  if (!comp) continue;
  for (const line of comp.items) {
    const key = `${line.crop.toLowerCase()}|${line.unit.toLowerCase()}`;
    const e = csaMap.get(key);
    if (e) e.qty += line.qty;
    else csaMap.set(key, { crop: line.crop, unit: line.unit, qty: line.qty });
  }
}
const csaRows = Array.from(csaMap.values())
  .filter((r) => r.qty > 0)
  .sort((a, b) => b.qty - a.qty || a.crop.localeCompare(b.crop));

/* ──────────────────────────────────────────────────────────────────
 * 2. Library category + photo lookup (for tender-green ordering + thumbs).
 * ────────────────────────────────────────────────────────────────── */
interface LibRow { name: string; photo_url: string | null; category: string | null; pack_weight_lb: number | null; harvest_crop: string | null; }
interface LibEntry { photo: string | null; category: string | null; packWeightLb: number | null; harvestCrop: string | null; }
const { data: libRows } = await db
  .from('product_library')
  .select('name, photo_url, category, pack_weight_lb, harvest_crop')
  .overrideTypes<LibRow[], { merge: false }>();
// Keyed BOTH by exact-lowercase name AND by the merge's normCrop() key, so a
// wholesale row like "King Spring Mix (per lb)" still resolves to the library
// product "King Spring Mix" (same normalization the demand merge uses). Exact
// match wins; the normalized alias fills gaps without clobbering a real row.
const libByName = new Map<string, LibEntry>();
const libByNorm = new Map<string, LibEntry>();
for (const lp of libRows ?? []) {
  const raw = lp.name?.trim();
  if (!raw) continue;
  const entry: LibEntry = { photo: lp.photo_url, category: lp.category, packWeightLb: lp.pack_weight_lb, harvestCrop: lp.harvest_crop };
  const exact = raw.toLowerCase();
  if (!libByName.has(exact)) libByName.set(exact, entry);
  const norm = normCrop(raw);
  if (norm && !libByNorm.has(norm)) libByNorm.set(norm, entry);
}
const EMPTY_LIB: LibEntry = { photo: null, category: null, packWeightLb: null, harvestCrop: null };
function libLookup(crop: string): LibEntry {
  const exact = crop.trim().toLowerCase();
  return libByName.get(exact) ?? libByNorm.get(normCrop(crop)) ?? EMPTY_LIB;
}

/* ── Stop → day_of_week map (for scoping the make-ups banner by harvest day).
 *    A make-up notice's stop_hint is a pickup-stop NAME (or HOME_DELIVERY_HINT).
 *    We map that stop's day_of_week to the SAME harvest tab the crops use:
 *    Sat/Sun pickup → thu; everything else (Tue/Wed) → mon. Home delivery runs
 *    Wed → mon. Case-insensitive on the stored name. ────────────────────── */
interface StopDowRow { name: string; day_of_week: string | null; }
const { data: stopRows } = await supabase
  .from('pickup_locations')
  .select('name, day_of_week')
  .overrideTypes<StopDowRow[], { merge: false }>();
const stopDayByName = new Map<string, string | null>();
for (const s of stopRows ?? []) {
  const key = s.name?.trim().toLowerCase();
  if (key) stopDayByName.set(key, s.day_of_week);
}

/* ──────────────────────────────────────────────────────────────────
 * 3. Market planned_qty by crop — from market_offerings, tagged per market.
 * ────────────────────────────────────────────────────────────────── */
interface MarketOfferingRow {
  id: string;
  name: string | null;
  unit: string;
  planned_qty: number | null;
  market: { id: string; name: string; day_of_week: string | null } | null;
  library: { name: string | null; photo_url: string | null; category: string | null } | null;
}
const { data: offeringRows, error: offeringsErr } = await db
  .from('market_offerings')
  .select(
    'id, name, unit, planned_qty, ' +
    'market:pickup_locations ( id, name, day_of_week ), ' +
    'library:product_library ( name, photo_url, category )',
  )
  .eq('week_starting', week_starting)
  .eq('is_active', true)
  .order('sort_order', { ascending: true })
  .overrideTypes<MarketOfferingRow[], { merge: false }>();
if (offeringsErr) {
  throw new Error(`pick-pack: market_offerings fetch failed: ${offeringsErr.message}`);
}

interface MarketItem { name: string; unit: string; qty: number; photo: string | null; category: string | null; }
interface MarketGroup { id: string; name: string; day: string | null; items: MarketItem[]; }
const marketGroupMap = new Map<string, MarketGroup>();
// Aggregate ALL markets' planned_qty per crop for the overall list.
const marketAllMap = new Map<string, CropAgg & { category: string | null }>(); // key = crop|unit
for (const o of offeringRows ?? []) {
  const name = (o.name ?? o.library?.name ?? 'Untitled product').trim();
  const qty = Number(o.planned_qty) || 0;
  const unit = o.unit || 'each';
  const category = o.library?.category ?? null;
  const photo = o.library?.photo_url ?? null;
  // Per-market grouping (for the per-market checklist).
  const mid = o.market?.id ?? 'untagged';
  let group = marketGroupMap.get(mid);
  if (!group) {
    group = { id: mid, name: o.market?.name ?? 'Untagged', day: o.market?.day_of_week ?? null, items: [] };
    marketGroupMap.set(mid, group);
  }
  group.items.push({ name, unit, qty, photo, category });
  // All-markets aggregate (for the overall harvest list), scoped to the
  // selected harvest day. On 'all' every market counts; on mon/thu only the
  // markets that map to that harvest tab (Tue → mon; Sat/Sun → thu).
  if (qty > 0 && marketInScope(o.market?.day_of_week)) {
    const key = `${name.toLowerCase()}|${unit.toLowerCase()}`;
    const e = marketAllMap.get(key);
    if (e) e.qty += qty;
    else marketAllMap.set(key, { crop: name, unit, qty, category });
  }
}

/* ──────────────────────────────────────────────────────────────────
 * 4. Wholesale order demand by crop — submitted orders delivering this week.
 * ────────────────────────────────────────────────────────────────── */
interface WholesaleItemRow {
  product_name: string | null;
  qty: number;
  product: { unit: string | null; photo_url: string | null; library: { photo_url: string | null; category: string | null } | null } | null;
}
interface WholesaleOrderRow { id: string; delivery_date: string; items: WholesaleItemRow[] | null; }
const { data: wholesaleOrderRows, error: wholesaleErr } = await db
  .from('wholesale_orders')
  .select(
    'id, delivery_date, ' +
    'items:wholesale_order_items ( product_name, qty, ' +
      'product:wholesale_products ( unit, photo_url, library:product_library ( photo_url, category ) ) )',
  )
  .eq('status', 'submitted')
  .gte('delivery_date', week_starting)
  .lte('delivery_date', weekEnd)
  .overrideTypes<WholesaleOrderRow[], { merge: false }>();
if (wholesaleErr) {
  throw new Error(`pick-pack: wholesale_orders fetch failed: ${wholesaleErr.message}`);
}
interface WsaleAgg { crop: string; unit: string; qty: number; photo: string | null; category: string | null; }
const wholesaleMap = new Map<string, WsaleAgg>(); // key = crop|unit
for (const o of wholesaleOrderRows ?? []) {
  // Scope to the selected harvest day by delivery DOW (Fri/Sat → thu; else mon).
  if (!inScope(wholesaleTabFor(o.delivery_date))) continue;
  for (const it of o.items ?? []) {
    const name = it.product_name?.trim();
    if (!name) continue;
    const unit = it.product?.unit?.trim() || 'each';
    const qty = Number(it.qty) || 0;
    if (qty <= 0) continue;
    const photo = it.product?.library?.photo_url ?? it.product?.photo_url ?? null;
    const category = it.product?.library?.category ?? null;
    const key = `${name.toLowerCase()}|${unit.toLowerCase()}`;
    const e = wholesaleMap.get(key);
    if (e) { e.qty += qty; if (!e.photo && photo) e.photo = photo; }
    else wholesaleMap.set(key, { crop: name, unit, qty, photo, category });
  }
}
const wholesaleRows = Array.from(wholesaleMap.values())
  .sort((a, b) => b.qty - a.qty || a.crop.localeCompare(b.crop));

/* ──────────────────────────────────────────────────────────────────
 * 5. The MERGE — overall per-crop demand across all three channels.
 * ────────────────────────────────────────────────────────────────── */
const csaDemand: CropDemandInput[] = csaRows.map((r) => ({
  crop: r.crop, qty: r.qty, unit: r.unit, category: libLookup(r.crop).category,
}));
const marketDemand: CropDemandInput[] = Array.from(marketAllMap.values()).map((r) => ({
  crop: r.crop, qty: r.qty, unit: r.unit, category: r.category,
}));
const wholesaleDemand: CropDemandInput[] = wholesaleRows.map((r) => ({
  crop: r.crop, qty: r.qty, unit: r.unit, category: r.category,
}));
const merged = mergeCropDemand(csaDemand, marketDemand, wholesaleDemand);
const tenderRows = merged.filter((r) => r.tender);
const otherRows = merged.filter((r) => !r.tender);

/** Best photo for a merged/overall crop row. */
function cropPhoto(crop: string): string | null {
  return libLookup(crop).photo;
}

/* ── Pack-weight → total pounds ─────────────────────────────────────────
 * Portioned items (clamshell salad mixes, Big Bagz) are HARVESTED BY WEIGHT.
 * When a crop's library product has pack_weight_lb set, we show the total
 * pounds to pick = summed packed-unit qty × pack_weight_lb, alongside the
 * unit count (the count is still needed for packing; the lb is for harvest).
 *
 * NEVER convert a row whose unit is ALREADY weight (lb/pound/#) — that qty is
 * already pounds, so multiplying would double-count. Only count/portion units
 * (each, clamshell, bag, box, bunch, …) get a lb figure. */
const WEIGHT_UNIT_RE = /^(lb|lbs|pound|pounds|#)$/i;
function isWeightUnit(unit: string | null | undefined): boolean {
  return WEIGHT_UNIT_RE.test((unit ?? '').trim());
}
/**
 * Total pounds for `qty` packed units of `crop` on unit `unit`, or null when
 * there's nothing to show — no pack weight set, a weight-based unit (already
 * pounds), or a non-positive qty. Rounded to 1 decimal for the pack floor.
 */
function packLb(crop: string, qty: number, unit: string): number | null {
  const w = libLookup(crop).packWeightLb;
  if (w == null || !(w > 0)) return null;
  if (isWeightUnit(unit)) return null; // already pounds — don't double-count
  if (!(qty > 0)) return null;
  return Math.round(qty * w * 10) / 10;
}
/** "10 lb" / "10.5 lb" — trims a trailing ".0" for whole pounds. */
function fmtLb(lb: number): string {
  const s = Number.isInteger(lb) ? String(lb) : lb.toFixed(1);
  return `${s} lb`;
}

/* ── Combine package variants into ONE harvest line (total pounds) ────────
 * The crew harvests raw greens BY WEIGHT; clamshell vs "Big Bagz" is a
 * downstream PACK decision. Products that share a non-null library.harvest_crop
 * (e.g. "King Spring Mix" + "King Spring (Big Bagz)" → "King Spring Mix") must
 * appear as ONE harvest line = summed pounds across variants, with the
 * per-packaging breakdown underneath so the pack team can still portion.
 *
 * A group only forms when 2+ IN-SCOPE variants share a harvest_crop; a lone
 * variant renders unchanged as its own normal row. Pounds per variant reuse
 * packLb() (qty x pack_weight_lb; weight-based units are skipped — no
 * double-count), so a variant with no pack weight contributes 0 lb but still
 * shows in the breakdown as a count. */
interface HarvestSourceRow {
  crop: string;
  qty: number;
  unit: string;
  /** Optional pre-computed pounds for this row (the OVERALL view sums pounds
   *  across channels itself; other views leave this undefined and let packLb
   *  derive it from qty x pack_weight_lb). */
  lb?: number | null;
}
interface HarvestVariant { crop: string; qty: number; unit: string; lb: number | null; }
interface CombinedHarvest { harvestCrop: string; totalLb: number; variants: HarvestVariant[]; }
/**
 * From a flat list of in-scope harvest rows, pull out the ones whose library
 * product shares a non-null harvest_crop with ≥1 sibling in the SAME list, and
 * fold each such family into one CombinedHarvest. Returns the combined groups
 * (sorted biggest-pounds first) PLUS the set of source-row indices consumed, so
 * the caller can render the remaining (uncombined) rows unchanged.
 */
function combineHarvest(rows: HarvestSourceRow[]): {
  combined: CombinedHarvest[];
  consumed: Set<number>;
} {
  // Bucket row indices by their harvest_crop (library lookup). Rows with no
  // harvest_crop are never bucketed — they always render as themselves.
  const byHarvestCrop = new Map<string, number[]>();
  rows.forEach((r, i) => {
    const hc = libLookup(r.crop).harvestCrop?.trim();
    if (!hc) return;
    const arr = byHarvestCrop.get(hc);
    if (arr) arr.push(i);
    else byHarvestCrop.set(hc, [i]);
  });
  const combined: CombinedHarvest[] = [];
  const consumed = new Set<number>();
  for (const [hc, idxs] of byHarvestCrop) {
    if (idxs.length < 2) continue; // a lone variant renders unchanged
    const variants: HarvestVariant[] = idxs.map((i) => {
      const r = rows[i];
      // Use the caller's pre-computed lb when given (OVERALL sums channels),
      // else derive it from qty x pack_weight_lb via packLb().
      const lb = r.lb !== undefined ? r.lb : packLb(r.crop, r.qty, r.unit);
      return { crop: r.crop, qty: r.qty, unit: r.unit, lb };
    });
    const totalLb = Math.round(variants.reduce((a, v) => a + (v.lb ?? 0), 0) * 10) / 10;
    // Order variants biggest-pounds first (clamshells before bags, usually).
    variants.sort((a, b) => (b.lb ?? 0) - (a.lb ?? 0) || a.crop.localeCompare(b.crop));
    combined.push({ harvestCrop: hc, totalLb, variants });
    for (const i of idxs) consumed.add(i);
  }
  combined.sort((a, b) => b.totalLb - a.totalLb || a.harvestCrop.localeCompare(b.harvestCrop));
  return { combined, consumed };
}

// Resolve the selected market group for the per-market view.
const DAY_ORDER: Record<string, number> = { Tue: 0, Sat: 1, Sun: 2 };
const marketGroupsSorted = Array.from(marketGroupMap.values()).sort((a, b) => {
  const da = DAY_ORDER[a.day ?? ''] ?? 99;
  const db = DAY_ORDER[b.day ?? ''] ?? 99;
  if (da !== db) return da - db;
  return a.name.localeCompare(b.name);
});
const selectedMarket = view === 'market'
  ? marketGroupsSorted.find((g) => g.id === marketIdParam) ?? marketGroupsSorted[0] ?? null
  : null;

/* ── Per-view combined-harvest groups (package variants → one weighed line) ──
 * Built here so the templates stay thin. Each view feeds combineHarvest() the
 * SAME flat row list it renders (in the same order), then renders the returned
 * combined groups on top and the un-consumed rows unchanged below. Every source
 * list is already day-scoped upstream (csaRows / wholesaleRows / merged /
 * selectedMarket.items all respect the day filter), so a variant only counts
 * when it's in scope — nothing extra to gate here. */

/** Total pounds for a merged/overall row, summed across its channels (weight
 *  units are already lb and are skipped by packLb, so no double-count). */
function mergedRowLb(r: (typeof merged)[number]): number | null {
  const total = [r.csa, r.market, r.wholesale].reduce((acc, c) => {
    if (!c) return acc;
    return acc + (packLb(r.crop, c.qty, c.unit) ?? 0);
  }, 0);
  return total > 0 ? Math.round(total * 10) / 10 : null;
}

// OVERALL — combine within the whole merged list; qty is the headline totalQty,
// lb is the cross-channel sum. Keeps tender-first ordering for leftovers via the
// original tenderRows/otherRows split (consumed rows drop out of each group).
const overallCombined = combineHarvest(
  merged.map((r) => ({ crop: r.crop, qty: r.totalQty, unit: r.csa?.unit ?? r.market?.unit ?? r.wholesale?.unit ?? 'each', lb: mergedRowLb(r) })),
);
const overallConsumedCrops = new Set(
  Array.from(overallCombined.consumed).map((i) => merged[i].crop),
);
const tenderRowsShown = tenderRows.filter((r) => !overallConsumedCrops.has(r.crop));
const otherRowsShown = otherRows.filter((r) => !overallConsumedCrops.has(r.crop));

// CSA / WHOLESALE — combine within each list; the un-consumed rows render below.
const csaCombine = combineHarvest(csaRows.map((r) => ({ crop: r.crop, qty: r.qty, unit: r.unit })));
const csaRowsShown = csaRows.filter((_, i) => !csaCombine.consumed.has(i));
const wholesaleCombine = combineHarvest(wholesaleRows.map((r) => ({ crop: r.crop, qty: r.qty, unit: r.unit })));
const wholesaleRowsShown = wholesaleRows.filter((_, i) => !wholesaleCombine.consumed.has(i));

// MARKET — combine within the selected market's items (name → crop).
const marketItemsOrdered = selectedMarket ? orderMarketItems(selectedMarket.items) : [];
const marketCombine = combineHarvest(marketItemsOrdered.map((it) => ({ crop: it.name, qty: it.qty, unit: it.unit })));
const marketItemsShown = marketItemsOrdered.filter((_, i) => !marketCombine.consumed.has(i));
// Order a market's items: tender greens first, then biggest qty.
function orderMarketItems(items: MarketItem[]): MarketItem[] {
  return items.slice().sort((a, b) => {
    const ta = mergeTender(a.name, a.category);
    const tb = mergeTender(b.name, b.category);
    if (ta !== tb) return ta ? -1 : 1;
    return (b.qty || 0) - (a.qty || 0) || a.name.localeCompare(b.name);
  });
}
// Local tender check reusing the lib's classifier via a merged row of one.
function mergeTender(name: string, category: string | null): boolean {
  return mergeCropDemand([{ crop: name, qty: 1, unit: 'x', category }], [], [])[0]?.tender ?? false;
}

const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};

// Page title + subtitle per view.
let docTitle: string;
if (view === 'csa') docTitle = 'CSA harvest';
else if (view === 'wholesale') docTitle = 'Wholesale harvest';
else if (view === 'market') docTitle = `Market — ${selectedMarket?.name ?? 'market'}`;
else docTitle = t.overallTitle;

const totalCsaBoxes = cycle.members.filter(
  (m) => m.share_type === 'summer_veg'
    && inScope(harvestTabForMember(m.pickup_location?.day_of_week)),
).length;

/* ──────────────────────────────────────────────────────────────────
 * MAKE-UPS TO ADD — additive accounting of owed make-up promises.
 *   The harvest list drives WHAT THE CREW PICKS. If the farm owes a member a
 *   double mushroom / make-good bread, the crew must harvest that extra product
 *   — otherwise we won't HAVE it to pack (the owner's exact complaint). We do
 *   NOT fold this into resolveCycle (too invasive/risky); instead we surface a
 *   SEPARATE, clearly-labeled subtotal from member_notices (open + due/overdue,
 *   ALL stops incl. general). Same source of truth as the pack sheets. Shown on
 *   the overall + CSA harvest views (the box-harvest views). [] on error.
 * ────────────────────────────────────────────────────────────────── */
const allMakeupNotices: NoticeWithMember[] = await fetchAllOpenDueNoticesWithMember(
  supabase, week_starting,
);
/**
 * Harvest tab for a make-up notice, from its stop_hint (a pickup-stop NAME or
 * the HOME_DELIVERY_HINT sentinel), using the SAME rule as the crops:
 *   - HOME_DELIVERY_HINT              → mon (the home-delivery run is Wed).
 *   - a stop whose day_of_week is Sat/Sun → thu (weekend markets).
 *   - every other stop (Tue/Wed pickup) → mon.
 *   - stop_hint NULL (general notice) OR an unknown stop → null (no single
 *     harvest day). A general promise still consumes product but isn't tied to a
 *     stop, so it only belongs on the whole-week ('all') view — never leaked
 *     onto a specific day tab.
 */
function makeupTab(n: NoticeWithMember): 'mon' | 'thu' | null {
  const hint = n.stop_hint?.trim();
  if (!hint) return null; // general notice — no stop, no single day
  if (hint === HOME_DELIVERY_HINT) return 'mon'; // Wed home-delivery run
  const dow = stopDayByName.get(hint.toLowerCase());
  if (dow === undefined) return null; // unknown stop → don't force onto a day
  return harvestTabForMember(dow); // Sat/Sun → thu; else → mon
}
/**
 * Make-ups in the current day scope. On 'all' every due make-up shows (the
 * prior whole-week behavior). On mon/thu, keep only make-ups whose mapped
 * harvest tab === the scope; general (null-tab) make-ups NEVER leak onto a
 * specific day tab (they show on 'all' only). This mirrors the crop scoping so
 * a Thursday sheet doesn't wrongly carry a Wed stop's owed make-up.
 */
const makeupNotices: NoticeWithMember[] =
  dayScope === 'all'
    ? allMakeupNotices
    : allMakeupNotices.filter((n) => makeupTab(n) === dayScope);
function makeupTag(n: NoticeWithMember): { text: string; overdue: boolean } {
  const overdue = isNoticeOverdue(n.due_week, week_starting);
  if (n.due_week == null) return { text: 'next opportunity', overdue: false };
  const d = new Date(`${n.due_week}T12:00:00Z`);
  const pretty = new Intl.DateTimeFormat('en-US', {
    month: 'short', day: 'numeric', timeZone: 'UTC',
  }).format(d);
  return { text: overdue ? `OVERDUE since ${pretty}` : `due ${pretty}`, overdue };
}
const showMakeups = (view === 'overall' || view === 'csa') && makeupNotices.length > 0;

/* ── Day-scope tab strip hrefs — preserve the current lang + view params so
 *    switching the harvest day never drops the drill-down or language. ─── */
function dayHref(day: 'mon' | 'thu' | 'all'): string {
  const params = new URLSearchParams();
  if (view !== 'overall') params.set('view', view);
  if (view === 'market' && marketIdParam) params.set('market', marketIdParam);
  if (lang !== 'en') params.set('lang', lang);
  if (day !== 'all') params.set('day', day);
  const qs = params.toString();
  return `/admin/pick-pack/${week_starting}${qs ? `?${qs}` : ''}`;
}
const dayTabs: { key: 'all' | 'mon' | 'thu'; label: string; hint: string | null }[] = [
  { key: 'all', label: 'All week', hint: null },
  { key: 'mon', label: 'Monday harvest', hint: '→ Tue + Wed' },
  { key: 'thu', label: 'Thursday harvest', hint: '→ Sat + Sun' },
];
/** Human label for the current day scope — printed on the doc band. */
const dayScopeLabel =
  dayScope === 'mon' ? 'Monday harvest · Tue + Wed'
  : dayScope === 'thu' ? 'Thursday harvest · Sat + Sun'
  : 'All week';

/** View-switcher href that preserves the current day scope + language. */
function viewHref(v: 'overall' | 'csa' | 'wholesale' | 'market', marketId?: string): string {
  const p = new URLSearchParams();
  if (v !== 'overall') p.set('view', v);
  if (v === 'market' && marketId) p.set('market', marketId);
  if (lang !== 'en') p.set('lang', lang);
  if (dayScope !== 'all') p.set('day', dayScope);
  const qs = p.toString();
  return `/admin/pick-pack/${week_starting}${qs ? `?${qs}` : ''}`;
}

/* ══════════════════════════════════════════════════════════════════════════
 * LIVE CHECK-OFF (migration 0069) — per-line status + WHO, synced across
 * devices. Answers Todd's "confusion about what has been done, and if someone
 * did it." The DB `section` is 'harvest' for the OVERALL pick view; the other
 * three views are pack sections. The interactive controls are wired CLIENT-SIDE
 * (see the <script> at the foot of the file) from the `data-*` attributes each
 * line carries below; here we only load saved state + compute the summary so the
 * page renders in its current status with no flash.
 * ════════════════════════════════════════════════════════════════════════ */
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
/** Non-market sections (+ an untagged market group) share this sentinel so the
 *  (week,section,scope,market,line) UNIQUE dedupes — matches the 0069 default. */
const SENTINEL_MARKET = '00000000-0000-0000-0000-000000000000';

const ppSection: 'harvest' | 'csa' | 'wholesale' | 'market' =
  view === 'overall' ? 'harvest' : view;
const marketIdForKey =
  view === 'market' && selectedMarket && UUID_RE.test(selectedMarket.id)
    ? selectedMarket.id
    : SENTINEL_MARKET;

// Saved status for every line on THIS sheet (crew can read via is_ops_caller).
interface ProgRow { line_key: string; status: string; worked_by: string | null; actual_qty: number | null; }
const { data: progressRows } = await supabase
  .from('pick_pack_progress')
  .select('line_key, status, worked_by, actual_qty')
  .eq('week_date', week_starting)
  .eq('section', ppSection)
  .eq('scope_day', dayScope)
  .eq('market_id', marketIdForKey)
  .overrideTypes<ProgRow[], { merge: false }>();
const progressMap = new Map<string, ProgRow>();
for (const r of progressRows ?? []) progressMap.set(r.line_key, r);

/** Server-render attributes for one interactive line. The browser controller
 *  reads these to build the Harvesting/Done or Packed control and to seed the
 *  optimistic state — it NEVER recomputes line_key, so the key here is the sole
 *  source of truth. `kind`/`name`/`unit` MUST match the summary key list below. */
function lineAttrs(
  kind: 'group' | 'row',
  name: string,
  keyUnit: string | null | undefined,
  target: number | null,
  displayUnit?: string | null,
): Record<string, string> {
  // keyUnit participates in the STABLE key (csa/wholesale/market split the same
  // crop by unit; the overall view passes null so it keys by crop alone — this
  // must mirror the ppKeys list). displayUnit is only shown in the "actual qty"
  // prompt and defaults to keyUnit.
  const key = pickPackLineKey(kind, name, keyUnit);
  const r = progressMap.get(key);
  return {
    'data-pp-line': '',
    'data-line-key': key,
    'data-status': r?.status ?? 'todo',
    'data-worked': r?.worked_by ?? '',
    'data-actual': r?.actual_qty != null ? String(r.actual_qty) : '',
    'data-target': target != null ? String(target) : '',
    'data-unit': (displayUnit ?? keyUnit) ?? '',
  };
}

/** Best single display unit for an OVERALL merged row (blank when channels
 *  disagree) — used only for the "actual qty" prompt, not for the key. */
function overallUnit(r: (typeof merged)[number]): string {
  const units = new Set([r.csa?.unit, r.market?.unit, r.wholesale?.unit].filter(Boolean) as string[]);
  return units.size === 1 ? [...units][0] : '';
}

// The line_key list for the CURRENT view — MUST mirror the template's render
// order + kind/name/unit exactly so the summary counts match the rendered lines.
let ppKeys: string[] = [];
if (view === 'overall') {
  ppKeys = [
    ...overallCombined.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...tenderRowsShown.map((r) => pickPackLineKey('row', r.crop)),
    ...otherRowsShown.map((r) => pickPackLineKey('row', r.crop)),
  ];
} else if (view === 'csa') {
  ppKeys = [
    ...csaCombine.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...csaRowsShown.map((r) => pickPackLineKey('row', r.crop, r.unit)),
  ];
} else if (view === 'wholesale') {
  ppKeys = [
    ...wholesaleCombine.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...wholesaleRowsShown.map((r) => pickPackLineKey('row', r.crop, r.unit)),
  ];
} else if (view === 'market') {
  ppKeys = [
    ...marketCombine.combined.map((g) => pickPackLineKey('group', g.harvestCrop)),
    ...marketItemsShown.map((it) => pickPackLineKey('row', it.name, it.unit)),
  ];
}
// Initial counts (the client keeps these live thereafter).
let ppTodo = 0, ppHarvesting = 0, ppDone = 0, ppPacked = 0;
for (const k of ppKeys) {
  const st = progressMap.get(k)?.status ?? 'todo';
  if (st === 'harvesting') ppHarvesting++;
  else if (st === 'done') ppDone++;
  else if (st === 'packed') ppPacked++;
  else ppTodo++;
}
const ppTotal = ppKeys.length;
const ppComplete = ppSection === 'harvest' ? ppDone : ppPacked;
const ppPct = ppTotal > 0 ? Math.round((ppComplete / ppTotal) * 100) : 0;
---

<AdminShell
  title="Pick & Pack"
  subtitle={`${docTitle} · ${prettyWeekHeader(week_starting)}`}
  pageTitle={`Pick & Pack — ${docTitle} — Tiny Seed Admin`}
>
  <Fragment slot="actions">
    {view === 'overall' && (
      <a
        href={(() => {
          // Toggle language while preserving the current day scope.
          const p = new URLSearchParams();
          if (lang !== 'es') p.set('lang', 'es'); // en → es; es → (drop = en)
          if (dayScope !== 'all') p.set('day', dayScope);
          const qs = p.toString();
          return `/admin/pick-pack/${week_starting}${qs ? `?${qs}` : ''}`;
        })()}
        class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary"
      >
        🌐 {t.langToggle}
      </a>
    )}
    <button
      type="button"
      onclick="window.print()"
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark"
    >
      🖨 Print
    </button>
    <a
      href={`/admin/pick-pack?week=${week_starting}`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text hover:border-ts-primary/40 hover:text-ts-primary"
    >
      ← Pick &amp; Pack
    </a>
  </Fragment>

  {/* ── Screen-only view switcher ──────────────────────────────────── */}
  <nav aria-label="Pick & Pack views" class="screen-only flex flex-wrap gap-2 border-b border-ts-border pb-3">
    {[
      { key: 'overall', label: '🌾 Overall', href: viewHref('overall') },
      { key: 'csa', label: '🥬 CSA', href: viewHref('csa') },
      { key: 'wholesale', label: '🍽 Wholesale', href: viewHref('wholesale') },
    ].map((tab) => (
      <a
        href={tab.href}
        aria-current={view === tab.key ? 'page' : undefined}
        class={[
          'inline-flex h-9 items-center rounded-ts-md px-3 text-sm font-semibold transition-colors',
          view === tab.key ? 'bg-ts-primary/10 text-ts-primary' : 'text-ts-text-secondary hover:bg-ts-bg-muted hover:text-ts-text',
        ].join(' ')}
      >{tab.label}</a>
    ))}
    {marketGroupsSorted.filter((g) => g.id !== 'untagged').map((g) => (
      <a
        href={viewHref('market', g.id)}
        aria-current={view === 'market' && selectedMarket?.id === g.id ? 'page' : undefined}
        class={[
          'inline-flex h-9 items-center rounded-ts-md px-3 text-sm font-semibold transition-colors',
          view === 'market' && selectedMarket?.id === g.id ? 'bg-ts-primary/10 text-ts-primary' : 'text-ts-text-secondary hover:bg-ts-bg-muted hover:text-ts-text',
        ].join(' ')}
      >🛒 {g.name}</a>
    ))}
  </nav>

  {/* ── Harvest-day scope tab strip ────────────────────────────────────
      Scopes the combined per-crop demand to a single harvest day. Mon =
      Tue + Wed distributions; Thu = Sat + Sun (weekend markets). "All week"
      is the whole-week merge (default). Mirrors /admin/harvest's tab strip;
      each link preserves the current lang + view drill-down. Screen-only —
      hidden in print (the printed sheet is already scoped by the query). */}
  <nav aria-label="Harvest day" class="screen-only flex flex-wrap gap-2 border-b border-ts-border">
    {dayTabs.map((tab) => (
      <a
        href={dayHref(tab.key)}
        aria-current={dayScope === tab.key ? 'page' : undefined}
        class={[
          'inline-flex h-10 items-center border-b-2 px-4 text-sm font-semibold transition-colors',
          dayScope === tab.key
            ? 'border-ts-primary text-ts-primary'
            : 'border-transparent text-ts-text-secondary hover:border-ts-border-strong hover:text-ts-text',
        ].join(' ')}
      >
        {tab.label}
        {tab.hint && <span class="ml-2 text-xs text-ts-text-muted">{tab.hint}</span>}
      </a>
    ))}
  </nav>

  <div class="print-doc">
    {/* ═══ ⚠ MAKE-UPS TO ADD — additive subtotal on top of the harvest ═══
        Owed make-up promises that must be harvested THIS week on top of the
        normal box/market/wholesale demand — otherwise the farm won't HAVE the
        product to pack (the owner's complaint). Shown on the box-harvest views
        (overall + CSA). Reads the SAME member_notices source as the pack sheets,
        so the makeup count is consistent across harvest / pick-pack / pack-sheet.
        Overdue make-ups flagged in red. Prints in color. */}
    {showMakeups && (
      <section aria-labelledby="pp-makeups-heading" class="makeups-banner mb-5 rounded-ts-lg border-[3px] p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="pp-makeups-heading" class="flex items-center gap-2 font-display text-lg font-extrabold uppercase tracking-wide sm:text-xl">
            <span aria-hidden="true">⚠</span>
            Make-ups to add — harvest these too
          </h2>
          <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1 text-sm font-extrabold tabular-nums">
            {makeupNotices.length} owed
          </span>
        </div>
        <p class="mt-1 text-sm font-medium">
          Owed items the farm promised members. Add these to the pick — they're on TOP of the box totals below.
        </p>
        <ul class="mt-3 flex flex-col divide-y divide-ts-border/40">
          {makeupNotices.map((n) => {
            const tag = makeupTag(n);
            return (
              <li class="harvest-row flex items-start gap-4 py-2.5">
                <span class="harvest-check inline-block h-6 w-6 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                <div class="min-w-0 flex-1">
                  <p class="text-base font-bold leading-snug text-ts-text">
                    {n.member_name && <span>{n.member_name} — </span>}{n.title}
                  </p>
                  {n.detail && (
                    <p class="mt-0.5 whitespace-pre-wrap break-words text-sm leading-snug text-ts-text-secondary">{n.detail}</p>
                  )}
                </div>
                <span class={[
                  'shrink-0 self-center rounded-full px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide',
                  tag.overdue ? 'bg-ts-danger/15 text-ts-danger' : 'bg-ts-bg-muted text-ts-text-secondary',
                ].join(' ')}>{tag.text}</span>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {/* ══ LIVE CHECK-OFF config + progress summary (migration 0069) ══
        Screen-only. The hidden config element hands the browser controller the
        sheet coordinates + Supabase realtime creds + EN/ES labels; the summary
        gives Todd (and the crew) a live to-go / harvesting / done (or packed)
        readout. Hidden in print so the paper sheet is unchanged. */}
    <div
      id="pp-live-config"
      class="hidden"
      data-week={week_starting}
      data-section={ppSection}
      data-scope={dayScope}
      data-market={marketIdForKey}
      data-supabase-url={PUBLIC_SUPABASE_URL}
      data-supabase-anon-key={PUBLIC_SUPABASE_ANON_KEY}
      data-i18n={JSON.stringify(t.live)}
    ></div>

    {ppTotal > 0 && (
      <section class="screen-only mb-4" aria-label={t.live.progress} data-pp-summary>
        <div class="rounded-ts-lg border border-ts-border bg-ts-bg-surface p-4 shadow-ts-sm">
          <div class="flex items-center justify-between gap-3">
            <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ts-text-secondary">{t.live.progress}</h2>
            <p class="text-sm font-bold tabular-nums text-ts-text">
              <span data-pp-complete>{ppComplete}</span><span class="text-ts-text-muted"> / </span><span data-pp-total>{ppTotal}</span>
            </p>
          </div>
          <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-ts-bg-muted">
            <div data-pp-bar class="h-full rounded-full bg-ts-primary transition-[width] duration-300 ease-out" style={`width:${ppPct}%`}></div>
          </div>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs font-semibold tabular-nums">
            <span class="text-ts-text-muted"><span data-pp-count-todo>{ppTodo}</span> {t.live.toGo}</span>
            {ppSection === 'harvest' && (
              <span class="text-ts-accent"><span data-pp-count-harvesting>{ppHarvesting}</span> {t.live.harvesting}</span>
            )}
            {ppSection === 'harvest' ? (
              <span class="text-ts-primary"><span data-pp-count-done>{ppDone}</span> {t.live.done}</span>
            ) : (
              <span class="text-ts-primary"><span data-pp-count-packed>{ppPacked}</span> {t.live.packed}</span>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ═══════════════ OVERALL HARVEST ═══════════════ */}
    {view === 'overall' && (
      <section aria-labelledby="pp-heading" class="harvest-doc">
        <header class="doc-band rounded-ts-lg px-5 py-4">
          <p class="text-xs font-semibold uppercase tracking-wider opacity-90">
            {t.overallTitle} · {prettyWeekHeader(week_starting)} · {dayScopeLabel}
          </p>
          <h2 id="pp-heading" class="mt-1 font-display text-3xl font-bold sm:text-4xl">🌾 {t.overallTitle}</h2>
          <p class="mt-1 text-sm font-semibold opacity-95">{t.overallSubtitle}</p>
        </header>

        {merged.length === 0 ? (
          <Card tone="muted" padding="lg" elevation="sm">
            <p class="text-center text-sm text-ts-text-secondary">{t.nothing}</p>
          </Card>
        ) : (
          <div class="mt-4 flex flex-col gap-6">
            {overallCombined.combined.length > 0 && (
              <section class="harvest-group" aria-label="Combined greens — harvest by weight">
                <h3 class="group-head tender-head rounded-ts-md px-4 py-2 font-display text-lg font-bold">
                  Combined greens — weigh once, split after
                </h3>
                <ol class="mt-2 flex flex-col">
                  {overallCombined.combined.map((g) => (
                    <div style="display:contents" {...lineAttrs('group', g.harvestCrop, 'lb', g.totalLb)}>
                      <CombinedHarvestRow harvestCrop={g.harvestCrop} totalLb={g.totalLb} variants={g.variants} fmtLb={fmtLb} />
                    </div>
                  ))}
                </ol>
              </section>
            )}
            {[
              { label: t.tenderGroup, rows: tenderRowsShown, tender: true },
              { label: t.otherGroup, rows: otherRowsShown, tender: false },
            ].filter((g) => g.rows.length > 0).map((group) => (
              <section class="harvest-group" aria-label={group.label}>
                <h3 class={[
                  'group-head rounded-ts-md px-4 py-2 font-display text-lg font-bold',
                  group.tender ? 'tender-head' : '',
                ].join(' ')}>{group.label}</h3>
                <ol class="mt-2 flex flex-col">
                  {group.rows.map((r) => {
                    const cc = channelCount(r);
                    const photo = cropPhoto(r.crop);
                    const cell = (c: { qty: number; unit: string } | null, label: string) =>
                      c ? `${label} ${c.qty} ${c.unit}` : '';
                    const parts = [
                      cell(r.csa, t.csaCol), cell(r.market, t.marketCol), cell(r.wholesale, t.wholesaleCol),
                    ].filter(Boolean);
                    // Total pounds to harvest across channels — sum each channel's
                    // count-unit contribution (weight-unit channels are already lb
                    // and are skipped by packLb, so they never double-count).
                    const rowLbTotal = [r.csa, r.market, r.wholesale].reduce((acc, c) => {
                      if (!c) return acc;
                      const lb = packLb(r.crop, c.qty, c.unit);
                      return acc + (lb ?? 0);
                    }, 0);
                    const rowLb = rowLbTotal > 0 ? Math.round(rowLbTotal * 10) / 10 : null;
                    return (
                      <li class="harvest-row flex items-center gap-4 border-b border-ts-border/60 py-3" {...lineAttrs('row', r.crop, null, r.totalQty, overallUnit(r))}>
                        <span class="harvest-check inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black" aria-hidden="true"></span>
                        {photo && (
                          <span class="hidden h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-ts-md border border-ts-border bg-ts-bg-surface sm:flex print:hidden">
                            <img src={photo} alt="" width="44" height="44" loading="lazy" class="h-full w-full object-cover" />
                          </span>
                        )}
                        <div class="min-w-0 flex-1">
                          <p class="text-xl font-bold leading-tight text-ts-text">
                            {r.crop}
                            {cc > 1 && <span class="ml-2 align-middle text-xs font-bold text-ts-primary">×{cc}</span>}
                          </p>
                          <p class="mt-0.5 text-sm font-medium text-ts-text-secondary tabular-nums">{parts.join('  ·  ')}</p>
                        </div>
                        <div class="shrink-0 text-right">
                          {(() => {
                            const units = new Set([r.csa?.unit, r.market?.unit, r.wholesale?.unit].filter(Boolean) as string[]);
                            const oneUnit = units.size === 1 ? [...units][0] : null;
                            return oneUnit
                              ? <><span class="font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{r.totalQty.toLocaleString()}</span><span class="ml-1 text-sm font-semibold text-ts-text-secondary">{oneUnit}</span></>
                              : <span class="text-xs font-semibold text-ts-text-muted">{t.total}: {r.totalQty.toLocaleString()}<span class="ml-0.5">*</span></span>;
                          })()}
                          {rowLb != null && (
                            <p class="mt-0.5 font-display text-base font-extrabold tabular-nums leading-none text-ts-primary">
                              {fmtLb(rowLb)}<span class="ml-1 text-xs font-semibold text-ts-text-secondary">to harvest</span>
                            </p>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </section>
            ))}
          </div>
        )}
        <p class="mt-4 text-xs text-ts-text-muted">{t.pickOnce}</p>
      </section>
