---
/**
 * /admin/pick-pack — landing page (week picker) for the printable
 * PICK & PACK harvest generator.
 *
 * The printable views live at /admin/pick-pack/[week] (overall harvest, with
 * ?view= and ?lang= variants). This page lets the pack lead pick the cycle
 * week and jump straight to the document they want:
 *   • Overall harvest (tender greens first) — English + Spanish (?lang=es)
 *   • Per-market checklists (one card per active farmers-market)
 *   • CSA checklist
 *   • Wholesale checklist
 *
 * Default week is the CURRENT delivery week (matches the other pack pages).
 */
import AdminShell from '../../../components/AdminShell.astro';
import Card from '../../../components/Card.astro';
import {
  resolveCycle, mondayOfWeek, currentDeliveryWeek, prettyWeekHeader, addDays,
} from '../../../lib/cycle';
import { weekOptions } from '../../../lib/cycle-ui';
import { fetchAllOpenDueNoticesWithMember } from '../../../lib/notices';

const supabase = Astro.locals.supabase;

const wkParam = Astro.url.searchParams.get('week') ?? '';
const week_starting = wkParam && /^\d{4}-\d{2}-\d{2}$/.test(wkParam)
  ? mondayOfWeek(wkParam)
  : currentDeliveryWeek();

const cycle = await resolveCycle(supabase, week_starting);
const options = weekOptions();
if (!options.some((o) => o.value === week_starting)) {
  options.unshift({ value: week_starting, label: `Week of ${week_starting} (selected)` });
}

// Active farmers-markets THIS week = markets that have ≥1 active offering.
// We read market_offerings joined to its market location so the per-market
// cards only show markets actually selling this week.
interface MarketCardRow {
  market: { id: string; name: string; day_of_week: string | null } | null;
}
const { data: offeringMarketRows } = await supabase
  .from('market_offerings')
  .select('market:pickup_locations ( id, name, day_of_week )')
  .eq('week_starting', week_starting)
  .eq('is_active', true)
  .overrideTypes<MarketCardRow[], { merge: false }>();

interface MarketCard { id: string; name: string; day: string | null }
const marketCardMap = new Map<string, MarketCard>();
for (const r of offeringMarketRows ?? []) {
  const m = r.market;
  if (!m?.id) continue;
  if (!marketCardMap.has(m.id)) {
    marketCardMap.set(m.id, { id: m.id, name: m.name, day: m.day_of_week ?? null });
  }
}
const DAY_ORDER: Record<string, number> = { Tue: 0, Sat: 1, Sun: 2 };
const marketCards = Array.from(marketCardMap.values()).sort((a, b) => {
  const da = DAY_ORDER[a.day ?? ''] ?? 99;
  const db = DAY_ORDER[b.day ?? ''] ?? 99;
  if (da !== db) return da - db;
  return a.name.localeCompare(b.name);
});

// Submitted wholesale orders delivering this week → does the wholesale card
// have anything to show?
const weekEnd = addDays(week_starting, 6);
const { count: wholesaleCount } = await supabase
  .from('wholesale_orders')
  .select('id', { count: 'exact', head: true })
  .eq('status', 'submitted')
  .gte('delivery_date', week_starting)
  .lte('delivery_date', weekEnd);

const csaBoxes = cycle.members.filter((m) => m.share_type === 'summer_veg').length;

// Open make-ups due/overdue this week — awareness count for the pack-day hub,
// so the pack lead knows owed items exist BEFORE opening a sheet. Same
// member_notices source as the harvest + pack sheets (consistent count).
const makeupsDue = (await fetchAllOpenDueNoticesWithMember(supabase, week_starting)).length;

const DAY_LONG: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};

/** Harvest-day scope a market's checklist should print under, from its day of
 *  week (Tue → Monday harvest; Sat/Sun → Thursday harvest). null when untagged
 *  (prints the whole-week list). Keeps the day-explicit lesson (Todd 2026-07-09:
 *  a day-less print merged Mon + Thu). */
function marketDayScope(day: string | null): 'mon' | 'thu' | null {
  if (day === 'Tue') return 'mon';
  if (day === 'Sat' || day === 'Sun') return 'thu';
  return null;
}
/** One-tap print href for a market checklist: the per-market view, scoped to its
 *  harvest day, auto-opening the print dialog on load. */
function marketPrintHref(id: string, day: string | null): string {
  const scope = marketDayScope(day);
  const params = new URLSearchParams({ view: 'market', market: id });
  if (scope) params.set('day', scope);
  params.set('print', '1');
  return `/admin/pick-pack/${week_starting}?${params.toString()}`;
}

const cardBtnClass =
  'mt-3 inline-flex h-9 items-center justify-center rounded-ts-md bg-ts-primary px-3 text-xs font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark';
const cardBtnGhostClass =
  'mt-3 inline-flex h-9 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-xs font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary';
---

<AdminShell
  title="Pick & Pack"
  subtitle={prettyWeekHeader(week_starting)}
  pageTitle="Pick & Pack — Tiny Seed Admin"
>
  <Fragment slot="actions">
    <a
      href={`/admin/pick-pack/${week_starting}`}
      class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
    >
      Open overall harvest →
    </a>
  </Fragment>

  {/* ── Week selector ─────────────────────────────────────────────── */}
  <section aria-label="Week selector">
    <form method="GET" action="/admin/pick-pack" class="flex flex-col gap-3 sm:flex-row sm:items-end sm:gap-4">
      <label class="flex flex-col gap-1">
        <span class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Week</span>
        <select
          name="week"
          class="h-10 min-w-[220px] rounded-ts-md border border-ts-border bg-ts-bg-surface px-3 text-sm text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          {options.map((opt) => (
            <option value={opt.value} selected={opt.value === week_starting}>
              {opt.label}
            </option>
          ))}
        </select>
      </label>
      <button
        type="submit"
        class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        Load week
      </button>
    </form>
  </section>

  {/* ── ⚠ Make-ups owed this week — pack-day awareness ──────────────
      The pack lead must KNOW owed make-ups exist before harvesting. Reads the
      same member_notices source as the harvest + pack sheets, so the count is
      consistent. Links into the overall harvest where the owed items are listed
      additively (and the pack sheet where they're resolved). */}
  {makeupsDue > 0 && (
    <section aria-labelledby="pp-makeups-heading">
      <Card tone="danger" padding="md" elevation="sm">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="min-w-0">
            <h2 id="pp-makeups-heading" class="flex items-center gap-2 font-display text-base font-extrabold text-ts-danger">
              <span aria-hidden="true">⚠</span>
              {makeupsDue} make-up{makeupsDue === 1 ? '' : 's'} owed this week
            </h2>
            <p class="mt-0.5 text-sm text-ts-text-secondary">
              Owed items the farm promised members — harvest them on top of the box totals, and pack them before closing each stop.
            </p>
          </div>
          <div class="flex shrink-0 flex-wrap gap-2">
            <a href={`/admin/pick-pack/${week_starting}`} class={cardBtnClass}>See in harvest →</a>
            <a href={`/admin/pack-sheet/${week_starting}`} class={cardBtnGhostClass}>Open pack sheet →</a>
          </div>
        </div>
      </Card>
    </section>
  )}

  {/* ── 🖨 PRINT THE WHOLE PACK — one job, all sheets ─────────────────
      Owner-approved consolidation (2026-07-15): instead of printing 3–4 separate
      documents, one button prints the combined pack for a harvest day — harvest
      totals, then the pack house by item, then each in-scope market on its own
      page. Day-explicit (no day-less button — the same lesson as the Pack House
      buttons: a day-less print merged Monday + Thursday). */}
  <section aria-labelledby="pp-wholepack-heading" class="flex flex-col gap-3">
    <h2 id="pp-wholepack-heading" class="font-display text-xl font-bold text-ts-text">Print the whole pack</h2>
    <Card tone="primary" padding="md" elevation="md">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <p class="font-display text-lg font-bold text-ts-text">🖨 One job — every sheet for the day</p>
          <p class="mt-1 text-sm text-ts-text-secondary">
            One print combines it all in order: <strong class="text-ts-text">harvest totals</strong>,
            then the <strong class="text-ts-text">pack house by item</strong>, then
            <strong class="text-ts-text">each market</strong> on its own page. No more printing three or four
            documents — pick the harvest day and print.
          </p>
        </div>
        <span class="shrink-0 rounded-ts-md bg-ts-primary/10 px-3 py-1 text-base font-bold tabular-nums text-ts-primary">🖨</span>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href={`/admin/pick-pack/${week_starting}?view=printpack&day=mon&print=1`}
          class="inline-flex h-11 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >🖨 Print the whole pack — Monday (Tue + Wed) →</a>
        <a
          href={`/admin/pick-pack/${week_starting}?view=printpack&day=thu&print=1`}
          class="inline-flex h-11 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >🖨 Print the whole pack — Thursday (weekend) →</a>
        <a
          href={`/admin/pick-pack/${week_starting}?view=printpack&day=mon&lang=es&print=1`}
          class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >Lunes · Español →</a>
        <a
          href={`/admin/pick-pack/${week_starting}?view=printpack&day=thu&lang=es&print=1`}
          class="inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >Jueves · Español →</a>
      </div>
    </Card>
  </section>

  {/* ── Overall harvest ───────────────────────────────────────────── */}
  <section aria-labelledby="pp-overall-heading" class="flex flex-col gap-3">
    <h2 id="pp-overall-heading" class="font-display text-xl font-bold text-ts-text">Overall harvest</h2>
    <Card padding="md" elevation="sm">
      <p class="text-sm text-ts-text-secondary">
        The whole pick across <strong class="text-ts-text">all channels</strong> — CSA + market + wholesale —
        in one list, <strong class="text-ts-text">tender greens first</strong>, with tickable boxes.
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a href={`/admin/pick-pack/${week_starting}`} class={cardBtnClass}>Overall harvest →</a>
        <a href={`/admin/pick-pack/${week_starting}?lang=es`} class={cardBtnGhostClass}>Español →</a>
      </div>
    </Card>
  </section>

  {/* ── 🏠 Pack House — THE consolidated by-item sheet ────────────────
      The pack crew processes ONE item at a time across every stream, so this is
      the sheet they want: a clean BLOCK per crop (crop name largest, a tick box
      in front) listing where each unit goes — CSA (with small/large split), each
      market, each restaurant, and flex — one destination per line. Portrait, big
      type, low ink. Given prominence (primary card) so it's the obvious pick. */}
  <section aria-labelledby="pp-packhouse-heading" class="flex flex-col gap-3">
    <h2 id="pp-packhouse-heading" class="font-display text-xl font-bold text-ts-text">Pack House — by item</h2>
    <Card tone="primary" padding="md" elevation="md">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <p class="font-display text-lg font-bold text-ts-text">🏠 Pack House — by item</p>
          <p class="mt-1 text-sm text-ts-text-secondary">
            Every crop across <strong class="text-ts-text">all streams</strong> as a clean
            <strong class="text-ts-text">block per item</strong> — crop name big, a tick box in front,
            then one line per destination (CSA with small/large split, each market, each restaurant, flex)
            so the crew packs one thing at a time. Each block totals to the overall harvest number.
          </p>
        </div>
        <span class="shrink-0 rounded-ts-md bg-ts-primary/10 px-3 py-1 text-base font-bold tabular-nums text-ts-primary">📦</span>
      </div>
      {/* DAY-EXPLICIT buttons (Todd 2026-07-09: the crew printed the day-less
          link and got Monday + Thursday harvests COMBINED). The sheet is day-
          dependent: Monday = Tue market + Wed CSA/wholesale; Thursday = weekend
          markets + weekend CSA + Friday wholesale. No day-less button. */}
      <div class="mt-3 flex flex-wrap gap-2">
        <a
          href={`/admin/pick-pack/${week_starting}?view=packhouse&day=mon`}
          class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >🏠 Monday harvest (Tue + Wed) →</a>
        <a
          href={`/admin/pick-pack/${week_starting}?view=packhouse&day=thu`}
          class="inline-flex h-10 items-center justify-center rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >🏠 Thursday harvest (weekend) →</a>
        <a
          href={`/admin/pick-pack/${week_starting}?view=packhouse&day=mon&lang=es`}
          class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >Lunes · Español →</a>
        <a
          href={`/admin/pick-pack/${week_starting}?view=packhouse&day=thu&lang=es`}
          class="inline-flex h-10 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 text-sm font-semibold text-ts-text transition-colors hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >Jueves · Español →</a>
      </div>
    </Card>
  </section>

  {/* ── 🖨 Print a market — ONE-TAP per-market checklists ─────────────
      Owner 2026-07-13: printing a single market (Lawrenceville first) should be
      one tap. Each button opens that market's checklist scoped to its harvest
      day and auto-fires the print dialog. Markets are already sorted Tue → Sat →
      Sun (marketCards), so Lawrenceville (Tue) leads. Only markets with demand
      this week appear. */}
  {marketCards.length > 0 && (
    <section aria-labelledby="pp-printmarket-heading" class="flex flex-col gap-3">
      <h2 id="pp-printmarket-heading" class="font-display text-xl font-bold text-ts-text">Print a market</h2>
      <Card padding="md" elevation="sm">
        <p class="text-sm text-ts-text-secondary">
          One tap prints a single market's harvest checklist — grouped by product family, scoped to its harvest day.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          {marketCards.map((mk) => (
            <a
              href={marketPrintHref(mk.id, mk.day)}
              class="inline-flex h-11 items-center justify-center gap-2 rounded-ts-md bg-ts-primary px-4 text-sm font-semibold text-white shadow-ts-sm transition-colors hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              🖨 {mk.name}
              <span class="rounded-full bg-white/20 px-2 py-0.5 text-xs font-bold">
                {mk.day ? DAY_LONG[mk.day] ?? mk.day : 'All week'}
              </span>
            </a>
          ))}
        </div>
      </Card>
    </section>
  )}

  {/* ── Per-channel checklists ────────────────────────────────────── */}
  <section aria-labelledby="pp-channels-heading" class="flex flex-col gap-4">
    <h2 id="pp-channels-heading" class="font-display text-xl font-bold text-ts-text">Per-channel checklists</h2>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
      {/* CSA */}
      <Card padding="md" elevation="sm" hover>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ts-text">🥬 CSA boxes</p>
            <p class="mt-0.5 text-xs text-ts-text-muted">Box demand by crop (from resolveCycle).</p>
          </div>
          <span class="shrink-0 rounded-ts-md bg-ts-primary/10 px-3 py-1 text-base font-bold tabular-nums text-ts-primary">{csaBoxes}</span>
        </div>
        <a href={`/admin/pick-pack/${week_starting}?view=csa`} class={cardBtnClass}>CSA checklist →</a>
      </Card>

      {/* Wholesale */}
      <Card padding="md" elevation="sm" hover>
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-ts-text">🍽 Wholesale</p>
            <p class="mt-0.5 text-xs text-ts-text-muted">Restaurant orders delivering this week.</p>
          </div>
          <span class="shrink-0 rounded-ts-md bg-ts-primary/10 px-3 py-1 text-base font-bold tabular-nums text-ts-primary">{wholesaleCount ?? 0}</span>
        </div>
        <a href={`/admin/pick-pack/${week_starting}?view=wholesale`} class={cardBtnClass}>Wholesale checklist →</a>
      </Card>

      {/* Per-market cards */}
      {marketCards.map((mk) => (
        <Card padding="md" elevation="sm" hover>
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-ts-text">🛒 {mk.name}</p>
              <p class="mt-0.5 text-xs text-ts-text-muted">{mk.day ? DAY_LONG[mk.day] ?? mk.day : 'Market'}</p>
            </div>
          </div>
          <a href={`/admin/pick-pack/${week_starting}?view=market&market=${mk.id}`} class={cardBtnClass}>Market checklist →</a>
        </Card>
      ))}
    </div>
    {marketCards.length === 0 && (
      <Card tone="muted" padding="md" elevation="sm">
        <p class="text-center text-sm text-ts-text-secondary">
          No active market offerings this week — set the stall list at
          <a href="/admin/market" class="ml-1 font-semibold text-ts-primary hover:underline">Market list</a>.
        </p>
      </Card>
    )}
  </section>

  <Card padding="md" elevation="sm">
    <h2 class="font-display text-lg font-bold text-ts-text">How Pick & Pack works</h2>
    <ul class="mt-3 space-y-1.5 text-sm text-ts-text-secondary">
      <li>• <strong class="text-ts-text">Overall harvest</strong> folds CSA + market + wholesale into one per-crop pick list, tender greens first.</li>
      <li>• <strong class="text-ts-text">CSA demand</strong> comes strictly from the cycle resolver (default plan + locked swaps + allergy subs).</li>
      <li>• <strong class="text-ts-text">Market demand</strong> is the planned harvest qty you set per offering on the Market list.</li>
      <li>• <strong class="text-ts-text">Wholesale demand</strong> is the real ordered qty from submitted chef orders delivering this week.</li>
      <li>• Every list prints big, clean, one column, with tickable boxes — Letter portrait, 100% scale.</li>
    </ul>
  </Card>
</AdminShell>
</content>
