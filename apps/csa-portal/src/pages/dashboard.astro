---
/**
 * /dashboard — logged-in member home.
 *
 * Auth is enforced by middleware.ts: by the time we run, `Astro.locals.user`
 * is non-null. We fetch via `Astro.locals.supabase` (cookie-aware,
 * RLS-scoped) so even if RLS lets a query through, the user can only
 * see their own customer + member rows. We use `supabaseAdmin` ONLY for
 * box_contents (public-read, but we already have the share types we
 * need in hand and want to avoid a second auth check).
 *
 * Data shown:
 *   - "Welcome back, {first_name}!" + logout link
 *   - One Active Share card per member row (status, weeks remaining,
 *     pickup details OR home-delivery address)
 *   - This week's box: items for the upcoming Wednesday matching ANY
 *     of the user's active share_types
 *   - Quick-action strip (vacation hold / preferences / contact farm)
 *
 * If the authenticated user has no customer record → "no share" state.
 * If the user has a customer record but no active member rows → same
 * "no share" state with a slightly different message.
 */
import MemberShell from '../components/MemberShell.astro';
import { supabaseAdmin } from '../lib/supabase';
import EmptyState from '../components/EmptyState.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import ContactFarm from '../components/ContactFarm.astro';
import DeliveryTracker from '../components/DeliveryTracker.astro';
import {
  shouldShowTracker,
  fetchDeliveryStatus,
  type DeliveryStatus,
} from '../lib/delivery';
import {
  getSchedule,
  seasonPhase,
  daysUntilStart,
  currentWeekNumber,
  firstDeliveryPretty,
  type SeasonSchedule,
  type SeasonPhase,
} from '../lib/season';
import {
  resolveMemberSchedule,
  upcomingDeliveries,
  firstMemberDelivery,
  seasonEndDate,
  prettyDeliveryLong,
  prettyDeliveryShort,
  prettyPickupTime,
  pickupDateForWeek,
  type PickupDay,
} from '../lib/schedule';
import FlexWallet from '../components/FlexWallet.astro';
import PickupNudgeBanner from '../components/PickupNudgeBanner.astro';
import PickupCard from '../components/PickupCard.astro';
import { resolveAccountCustomer } from '../lib/account';
import { closeLabel, type PickupDay as FlexPickupDay } from '../lib/flex-order';
import {
  upcomingMonday,
  mondayOfWeek,
  isShareInSeasonForWeek,
  isMemberOnThisWeek,
  holdOverlapsWeek,
} from '../lib/cycle';
import { weekRangeLabel } from '../lib/cycle-ui';
import { shareDisplayLabel } from '../lib/addon';
import ScheduleCard from '../components/ScheduleCard.astro';
import NextDeliveryBanner from '../components/NextDeliveryBanner.astro';

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

// Defensive: middleware should have already handled this, but if a
// page-level type-narrowing slipped through (e.g. a future refactor),
// bounce to login rather than crash.
if (!user || !user.email) {
  return Astro.redirect('/login', 303);
}

// ─────────────────────────────────────────────────────────────────────
// Resolve upcoming Wednesday in America/New_York (matches index.astro)
// ─────────────────────────────────────────────────────────────────────
function upcomingWednesday(now: Date = new Date()): string {
  const fmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    weekday: 'short',
  });
  const parts = fmt.formatToParts(now);
  const get = (t: string): string => parts.find((p) => p.type === t)?.value ?? '';
  const dayIndex: Record<string, number> = {
    Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6,
  };
  const todayIdx = dayIndex[get('weekday')] ?? 0;
  const daysUntilWed = (3 - todayIdx + 7) % 7;
  const todayET = new Date(`${get('year')}-${get('month')}-${get('day')}T00:00:00-05:00`);
  const wed = new Date(todayET.getTime() + daysUntilWed * 86_400_000);
  return new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric', month: '2-digit', day: '2-digit',
  }).format(wed);
}

const targetWeek = upcomingWednesday();

// ─────────────────────────────────────────────────────────────────────
// 1. Resolve the account customer, then fetch its members.
//
//    HOUSEHOLD-SHARING FIX (2026-06-12): we resolve "which customer am I?"
//    via household_owner() (lib/account.resolveAccountCustomer) rather than
//    a `from('customers')` query that relies on customers_self_read. That
//    policy is keyed on the AUTH email, so an INVITED household member (no
//    customers row of their own — migration 0023) got ZERO customer rows and
//    therefore saw NO shares ("can't see our share"). household_owner()
//    resolves to the OWNER's customer for both a primary AND an invited
//    member, and members_self_read (keyed on current_customer_id()) already
//    grants the invited member the owner's member rows — so fetching members
//    directly by the resolved customer_id Just Works for everyone.
// ─────────────────────────────────────────────────────────────────────
type ActiveShare = {
  id: string;
  share_type: string;
  share_size: string | null;
  season: string;
  start_date: string;
  end_date: string;
  total_weeks: number;
  weeks_remaining: number;
  pickup_day: string | null;
  pickup_location_id: string | null;
  delivery_address: string | null;
  status: string;
  swap_credits: number;
  vacation_weeks_used: number;
  biweekly_week: 'A' | 'B' | null;
  notes: string | null;
  pickup_location: {
    name: string;
    address: string | null;
    city: string | null;
    state: string;
    zip: string | null;
    day_of_week: string | null;
    time_start: string | null;
    time_end: string | null;
    is_delivery_zone: boolean;
    pickup_instructions: string | null;
    host_name: string | null;
    host_phone: string | null;
  } | null;
};

type CustomerWithShares = {
  id: string;
  contact_name: string;
  email: string;
  phone: string | null;
  members: ActiveShare[];
};

// Resolve the account owner (works for a primary AND an invited household
// member). Returns null when the caller has no account at all.
const account = await resolveAccountCustomer(supabase);

// Fetch the resolved account's shares directly. members_self_read RLS is
// keyed on current_customer_id(), so this returns the owner's member rows for
// both a primary and an invited member. We filter by the resolved customer_id
// as belt-and-suspenders (RLS already scopes it to exactly that account).
let shareRows: ActiveShare[] = [];
if (account) {
  const { data: memberRows, error: membersError } = await supabase
    .from('members')
    .select(
      `
      id,
      share_type,
      share_size,
      season,
      start_date,
      end_date,
      total_weeks,
      weeks_remaining,
      pickup_day,
      pickup_location_id,
      delivery_address,
      status,
      swap_credits,
      vacation_weeks_used,
      biweekly_week,
      notes,
      pickup_location:pickup_locations (
        name,
        address,
        city,
        state,
        zip,
        day_of_week,
        time_start,
        time_end,
        is_delivery_zone,
        pickup_instructions,
        host_name,
        host_phone
      )
    `
    )
    .eq('customer_id', account.id)
    .overrideTypes<ActiveShare[], { merge: false }>();

  if (membersError) {
    console.error('[dashboard] members fetch failed:', membersError.message);
  }
  shareRows = memberRows ?? [];
}

// The caller's OWN phone (for the next-delivery banner's phone prompt). RLS
// (customers_self_read) scopes this to the caller's own row: a primary gets
// their phone; an invited member has no own customers row → null (their phone
// prompt is handled by their own onboarding, not the shared owner's number).
let callerPhone: string | null = null;
if (account && user.email) {
  const { data: ownRow } = await supabase
    .from('customers')
    .select('phone')
    .eq('email', user.email)
    .maybeSingle()
    .overrideTypes<{ phone: string | null }, { merge: false }>();
  callerPhone = ownRow?.phone ?? null;
}

// Synthesize the `customer` shape the rest of the page expects. `phone` is the
// CALLER's own phone (see above); identity fields come from the resolved owner.
const customer: CustomerWithShares | null = account
  ? {
      id: account.id,
      contact_name: account.contactName,
      email: account.email,
      phone: callerPhone,
      members: shareRows,
    }
  : null;
const allShares = customer?.members ?? [];

// Show only "live" shares — status in {'active','paused','onboarding'}.
// Anything else (cancelled, lapsed, expired, inactive) is historical
// and is hidden on the dashboard.
const liveStatuses = new Set(['active', 'paused', 'onboarding']);

// SEASON-AWARENESS (2026-06-16, BUG 3). A share is only the member's
// CURRENT share when this week falls inside its configured season window.
// The spring_veg season ended Wed 2026-05-27, but a member's spring_veg row
// can still read status='active' — so a status-only filter wrongly presented
// the out-of-season Spring share as the member's active share. We additionally
// gate on isShareInSeasonForWeek (the same season-window rule the admin pack
// logic uses): summer_veg (in season now) shows; an ended spring_veg is
// hidden as "active". Share types WITHOUT a configured schedule (flex,
// add_on, fall_veg) have NO window → isShareInSeasonForWeek returns true, so
// add-ons + flex are always preserved exactly as before.
//
// `cycleMonday` is the Monday-anchored key the season-window math expects
// (derived from the upcoming-Wednesday targetWeek).
const cycleMonday = mondayOfWeek(targetWeek);
const isLiveShare = (s: ActiveShare): boolean =>
  liveStatuses.has(s.status) && isShareInSeasonForWeek(s.share_type, cycleMonday);

// The member's CURRENT (in-season) live shares — what the dashboard presents.
// (The pickup-forcing nudge below keys off raw 'active' status via
// dashboardActiveShares, so it's unaffected by this season gate.)
const activeShares = allShares.filter(isLiveShare);

// Flex-share members get a prominent "This week's order" CTA (FIX 1,
// 2026-06-08) + the bottom-nav "Order" tab. Same signal the /account hub
// uses: a live (active/paused/onboarding) member row with share_type='flex'.
// This is the ORDERING entry (/account/flex-order), distinct from the
// FlexWallet balance card (/account/flex). flexCloseLabel mirrors the
// order-window cadence in lib/flex-order.ts.
const isFlexMember = activeShares.some((s) => s.share_type === 'flex');
const flexCloseLabel = isFlexMember ? closeLabel(upcomingMonday()) : '';

// ─────────────────────────────────────────────────────────────────────
// Pickup forcing-nudge (FIX 1, 2026-05-24, gap P0). The ~191 migrated CSA
// members are status='active' but never chose a pickup at checkout, and the
// middleware onboarding funnel only catches status='onboarding' — so they're
// never prompted. Show a persistent top banner until they pick a pickup or
// home delivery. We compute it from the share rows already in hand (which
// carry pickup_location_id + delivery_address + status) to avoid a second
// DB round-trip: needs a choice iff there's ≥1 ACTIVE share AND none of the
// active shares has a pickup OR a delivery address. (Mirrors the shared
// memberNeedsPickupChoice helper, which the /box + /account hubs use.)
const dashboardActiveShares = allShares.filter((s) => s.status === 'active');
const needsPickup =
  dashboardActiveShares.length > 0 &&
  !dashboardActiveShares.some(
    (s) =>
      s.pickup_location_id != null ||
      (typeof s.delivery_address === 'string' && s.delivery_address.trim().length > 0)
  );

// First name extraction: take first whitespace-separated token.
const firstName = (customer?.contact_name ?? user.email!.split('@')[0])
  .trim()
  .split(/\s+/)[0];

// ─────────────────────────────────────────────────────────────────────
// Season awareness (2026-05-20). Among the member's active shares, pick
// the controlling schedule: the one whose share_type HAS a configured
// SEASON_SCHEDULE and the EARLIEST firstDelivery. That share's phase
// drives the dashboard's "this week's box" section:
//
//   before    → countdown banner, NO box query (kills the false
//               "box for <next Wednesday>" message before the season).
//   active    → existing box behavior (query box_contents for the
//               upcoming Wednesday) + a "Week N of TOTAL" label.
//   complete  → "that's a wrap" card, NO box query.
//
// If NO active share has a configured schedule (e.g. a flower-only member
// while flower is still TBD), we fall back to the legacy always-on box
// behavior so non-summer members are completely unaffected.
// ─────────────────────────────────────────────────────────────────────
let controllingSchedule: SeasonSchedule | null = null;
for (const s of activeShares) {
  const sched = getSchedule(s.share_type);
  if (!sched) continue;
  if (
    !controllingSchedule ||
    sched.firstDelivery < controllingSchedule.firstDelivery
  ) {
    controllingSchedule = sched;
  }
}

// Phase drives the box section. With no configured schedule we behave as
// if the season is 'active' (legacy always-show-box behavior).
const phase: SeasonPhase = controllingSchedule
  ? seasonPhase(controllingSchedule)
  : 'active';

const daysToStart = controllingSchedule ? daysUntilStart(controllingSchedule) : 0;
const seasonWeekNumber = controllingSchedule
  ? currentWeekNumber(controllingSchedule)
  : 0;
const firstDeliveryLabel = controllingSchedule
  ? firstDeliveryPretty(controllingSchedule)
  : '';

// "N days until Week One" copy. 0 → "starts today", 1 → "1 day".
const countdownHeadline =
  daysToStart === 0
    ? 'Your CSA starts today!'
    : daysToStart === 1
      ? '1 day until Week One'
      : `${daysToStart} days until Week One`;

// Only query + render the box during the active phase.
const showBoxSection = phase === 'active';

// ─────────────────────────────────────────────────────────────────────
// Delivery tracker gate (Day 9). Show <DeliveryTracker> at the TOP of
// the dashboard ONLY when:
//   1. The member has an ACTIVE share (paused/onboarding don't qualify).
//   2. Today is the share's pickup day in America/New_York.
//   3. Pickup is NOT the farm self-pickup (Rochester) — those members
//      walk up to the farm; no driver is involved.
// We check across ALL active shares — a multi-share member (Spring Veg
// + Flower) gets the widget if ANY share's pickup day is today. We
// SSR the initial status from Apps Script so the widget renders with
// real state (not a loading skeleton) — the client then polls for updates.
// ─────────────────────────────────────────────────────────────────────
const trackerEligibleShare = activeShares.find((s) => {
  if (s.status !== 'active') return false;
  const isHomeDelivery = !s.pickup_location_id && Boolean(s.delivery_address);
  return shouldShowTracker({
    pickup_day: s.pickup_day,
    pickup_location_name: s.pickup_location?.name ?? null,
    pickup_location_day: s.pickup_location?.day_of_week ?? null,
    is_home_delivery: isHomeDelivery,
    is_active_status: true,
  });
});

let initialDeliveryStatus: DeliveryStatus | null = null;
if (trackerEligibleShare) {
  // Server-side initial fetch. V2 (Day 9, 2026-05-11): reads native
  // Supabase tables via the RLS-scoped cookie client. Fail-soft — any
  // error path returns { state: 'none', ... } and the widget hides.
  initialDeliveryStatus = await fetchDeliveryStatus(supabase);
}

// Pretty "Wed May 14" for the "packed for ___" copy. Always today in
// ET — the widget only renders on a pickup day, so "today" is always
// the relevant delivery date.
const deliveryDateLabel = trackerEligibleShare
  ? new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    }).format(new Date())
  : '';

// ─────────────────────────────────────────────────────────────────────
// 2. Box contents for upcoming Wednesday × this user's share types.
// ─────────────────────────────────────────────────────────────────────
type BoxItem = {
  share_type: string;
  product_name: string;
  variety: string | null;
  quantity: number;
  unit: string;
  is_swappable: boolean;
  // Photo comes purely from the linked product_library row (box_contents has
  // no own photo column). Nullable link; null → text-only line, as before.
  library_id: string | null;
  library: { photo_url: string | null } | null;
};

const userShareTypes = Array.from(new Set(activeShares.map((s) => s.share_type)));

let boxItems: BoxItem[] = [];
// Skip the box query entirely outside the active phase — before the
// season there's no box to plan; after it the season is done.
if (showBoxSection && userShareTypes.length > 0) {
  const { data: boxRows, error: boxError } = await supabaseAdmin
    .from('box_contents')
    .select(
      'share_type, product_name, variety, quantity, unit, is_swappable, library_id, ' +
      'library:product_library ( photo_url )'
    )
    .eq('week_date', targetWeek)
    .in('share_type', userShareTypes)
    .order('share_type', { ascending: true })
    .order('product_name', { ascending: true })
    .overrideTypes<BoxItem[], { merge: false }>();
  if (boxError) {
    console.error('[dashboard] box contents fetch failed:', boxError);
  }
  boxItems = boxRows ?? [];
}

// Group items by share_type so a multi-share member sees them split.
const itemsByShareType = new Map<string, BoxItem[]>();
for (const item of boxItems) {
  if (!itemsByShareType.has(item.share_type)) {
    itemsByShareType.set(item.share_type, []);
  }
  itemsByShareType.get(item.share_type)!.push(item);
}

// ─────────────────────────────────────────────────────────────────────
// Display helpers
// ─────────────────────────────────────────────────────────────────────
const SHARE_TYPE_LABELS: Record<string, string> = {
  spring_veg: 'Spring Vegetable Share',
  summer_veg: 'Summer Vegetable Share',
  fall_veg: 'Fall Vegetable Share',
  flower: 'Flower Share',
  flex: 'Flex Share',
  add_on: 'Add-On',
  wholesale_csa: 'Wholesale CSA',
};

// Size → display label. CANONICAL terms per CSA_GLOSSARY_OF_TRUTH §3:
//   • Summer Veg → "Large" / "Small" ONLY.
//   • Flower     → "Petite" / "Full" ONLY.
// The glossary BANS "family / regular / light" (stale Summer-Veg labels). Those
// legacy DB values are remapped here to their canonical BUCKET label (per
// lib/share-buckets: regular/family → large bucket; light → small bucket) so a
// member NEVER sees a banned term — even before the DB data is migrated.
// (petite/full are NOT banned — they are the canonical Flower sizes — so they
// keep their own labels.) The remaining sizes have no glossary rule; kept as-is
// so a known enum never falls through to its raw value.
const BANNED_LEGACY_SIZES = new Set(['regular', 'family', 'light']);
const SHARE_SIZE_LABELS: Record<string, string> = {
  // Canonical
  small: 'Small', large: 'Large', petite: 'Petite', full: 'Full',
  // Banned Summer-Veg legacy values → canonical bucket label
  regular: 'Large', family: 'Large', light: 'Small',
  // Other legacy enum values (no glossary rule)
  half: 'Half', quarter: 'Quarter', single: 'Single', double: 'Double',
};

// Track the data-migration debt: if any live share still carries a banned
// legacy size value, log it (server-side) so the cleanup can be followed. The
// member still sees the correct canonical label above — this is diagnostic only.
const bannedSizeInUse = activeShares
  .map((s) => s.share_size)
  .filter((sz): sz is string => typeof sz === 'string' && BANNED_LEGACY_SIZES.has(sz));
if (bannedSizeInUse.length > 0) {
  console.warn(
    `[dashboard] banned legacy share_size values in use (remapped to canonical for display): ${Array.from(new Set(bannedSizeInUse)).join(', ')}`,
  );
}

type BadgeVariant = 'green' | 'amber' | 'sky' | 'gray';
const STATUS_PILL: Record<string, { label: string; variant: BadgeVariant }> = {
  active:     { label: 'Active',     variant: 'green' },
  paused:     { label: 'Paused',     variant: 'amber' },
  onboarding: { label: 'Onboarding', variant: 'sky' },
};

const dayLong: Record<string, string> = {
  Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday',
};

function formatTimeRange(start: string | null, end: string | null): string {
  if (!start || !end) return '';
  const fmt = (t: string): string => {
    const [hStr, mStr] = t.split(':');
    let h = Number(hStr);
    const m = Number(mStr);
    const period = h >= 12 ? 'PM' : 'AM';
    h = h % 12 === 0 ? 12 : h % 12;
    return m === 0 ? `${h} ${period}` : `${h}:${mStr.padStart(2, '0')} ${period}`;
  };
  return `${fmt(start)}–${fmt(end)}`;
}

const targetWeekPretty = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric',
  timeZone: 'America/New_York',
}).format(new Date(`${targetWeek}T12:00:00-04:00`));

// ─────────────────────────────────────────────────────────────────────
// PICKUP + SCHEDULE CARDS (2026-06-05). Members were emailing that they
// couldn't find/change their pickup, or understand their delivery cadence.
// We surface both prominently on the dashboard, computed from the same
// active-share rows the rest of the page already uses.
//
// `primaryShare` = the first active share that drives a box (NOT flex —
// flex is a wallet model with its own FlexWallet card — and we prefer a
// veg/flower share over an add-on for the pickup/schedule summary). If the
// member is flex-only, primaryShare is null and neither card renders.
// ─────────────────────────────────────────────────────────────────────
const primaryShare =
  activeShares.find((s) => s.share_type !== 'flex' && s.share_type !== 'add_on') ??
  activeShares.find((s) => s.share_type !== 'flex') ??
  null;

// ── Pickup card props ──
type PickupCardMode = 'pickup' | 'delivery' | 'unset';
let pickupCardMode: PickupCardMode = 'unset';
let pickupLocationName: string | null = null;
let pickupDayLong: string | null = null;
let pickupTimeRange: string | null = null;
let pickupCity: string | null = null;
let pickupAddress: string | null = null;
let pickupState: string | null = null;
let pickupZip: string | null = null;
let pickupDeliveryAddress: string | null = null;
// Member-facing per-site instructions for the primary stop (DISTINCT from the
// admin-only `notes`). Null/blank → PickupCard shows no instructions block.
let pickupInstructions: string | null = null;
// Member-facing host name/phone for the primary stop (DISTINCT from the
// admin-only `notes`). Null → PickupCard shows no "Your host" block.
let pickupHostName: string | null = null;
let pickupHostPhone: string | null = null;

if (primaryShare) {
  const isHomeDelivery =
    !primaryShare.pickup_location_id &&
    typeof primaryShare.delivery_address === 'string' &&
    primaryShare.delivery_address.trim().length > 0;
  if (isHomeDelivery) {
    pickupCardMode = 'delivery';
    pickupDeliveryAddress = primaryShare.delivery_address;
  } else if (primaryShare.pickup_location) {
    pickupCardMode = 'pickup';
    pickupLocationName = primaryShare.pickup_location.name;
    pickupAddress = primaryShare.pickup_location.address;
    pickupState = primaryShare.pickup_location.state ?? null;
    pickupZip = primaryShare.pickup_location.zip;
    pickupInstructions =
      typeof primaryShare.pickup_location.pickup_instructions === 'string' &&
      primaryShare.pickup_location.pickup_instructions.trim().length > 0
        ? primaryShare.pickup_location.pickup_instructions.trim()
        : null;
    pickupHostName =
      typeof primaryShare.pickup_location.host_name === 'string' &&
      primaryShare.pickup_location.host_name.trim().length > 0
        ? primaryShare.pickup_location.host_name.trim()
        : null;
    pickupHostPhone =
      typeof primaryShare.pickup_location.host_phone === 'string' &&
      primaryShare.pickup_location.host_phone.trim().length > 0
        ? primaryShare.pickup_location.host_phone.trim()
        : null;
    pickupDayLong = primaryShare.pickup_location.day_of_week
      ? dayLong[primaryShare.pickup_location.day_of_week] ?? primaryShare.pickup_location.day_of_week
      : null;
    pickupTimeRange = formatTimeRange(
      primaryShare.pickup_location.time_start,
      primaryShare.pickup_location.time_end,
    ) || null;
    pickupCity = primaryShare.pickup_location.city;
  } else {
    pickupCardMode = 'unset';
  }
}

// Show the calmer pickup card only when the hard forcing-nudge banner is
// NOT showing (avoid a duplicate "choose your pickup" ask) and we have a
// box-bearing share to describe.
const showPickupCard = Boolean(primaryShare) && !needsPickup;

// ── Schedule card props ──
// Resolve the member's delivery calendar from the primary share's season
// schedule + its biweekly_week. Only render when the season IS configured
// (so the dates are real) AND not yet complete. For a flex-only member
// there's no schedule.
const primarySchedule = primaryShare ? getSchedule(primaryShare.share_type) : null;

let scheduleCadence: 'weekly' | 'biweekly' = 'weekly';
let scheduleBiweeklyWeek: 'A' | 'B' | null = null;
let scheduleFirstLong = '';
let scheduleSeasonEndShort = '';
let scheduleUpcomingShort: string[] = [];

// Next-delivery date for the top-of-dashboard banner. The member's NEXT
// on-week delivery (weekly = next week; biweekly A/B = their next parity
// week; flex members carry an A/B too). Empty once the season is over.
let nextDeliveryLong = '';

if (primaryShare && primarySchedule) {
  const resolved = resolveMemberSchedule({
    schedule: primarySchedule,
    biweeklyWeek: primaryShare.biweekly_week,
  });
  scheduleCadence = resolved.cadence;
  scheduleBiweeklyWeek = primaryShare.biweekly_week;
  const firstDate = firstMemberDelivery(resolved);
  scheduleFirstLong = firstDate ? prettyDeliveryLong(firstDate) : '';
  scheduleSeasonEndShort = prettyDeliveryShort(seasonEndDate(resolved, primarySchedule));
  // The member's pickup weekday. pickup_locations.day_of_week is the canonical
  // signal; home-delivery members have no pickup_location → null → the date
  // math treats them as the Wednesday anchor (home delivery IS Wednesday).
  const primaryPickupDay = (primaryShare.pickup_location?.day_of_week ?? null) as
    | PickupDay
    | null;
  // Next 4 upcoming dates (only used by the biweekly card's chip list). These
  // are the cycle Wednesdays; the schedule card frames cadence, not a specific
  // pickup time, so they stay on the anchor (the chips are "every other week"
  // markers, not "go to your stop on" instructions).
  scheduleUpcomingShort = upcomingDeliveries(resolved, 4).map(prettyDeliveryShort);
  // Next single delivery (banner). upcomingDeliveries is inclusive of today,
  // so a box being packed TODAY still reads as the next delivery. SHIFT the
  // cycle Wednesday to the member's ACTUAL pickup day so the banner date +
  // weekday word match their stop (e.g. a Saturday-market member's Jun 17
  // cycle reads "Saturday, June 20", not "Wednesday, June 17"). This was the
  // member-reported bug. prettyDeliveryLong derives the weekday from the date
  // string itself, so shifting the date fixes the weekday word automatically.
  const nextDate = upcomingDeliveries(resolved, 1)[0] ?? null;
  const nextPickupDate = nextDate
    ? pickupDateForWeek(nextDate, primaryPickupDay)
    : null;
  nextDeliveryLong = nextPickupDate ? prettyDeliveryLong(nextPickupDate) : '';
}

// ─────────────────────────────────────────────────────────────────────
// BOX-SWAP CUTOFF LABEL (FIX 1.3 / audit M-03).
// The empty-box copy must state the member's REAL swap cutoff, which is
// pickup-day-aware: Sat/Sun-market members (weekend run) lock Thursday 7 AM;
// everyone else (Tue market / Wed CSA / home delivery) locks Monday 7 AM. We
// derive it from the SAME source of truth the swap endpoint enforces —
// lib/flex-order `closeLabel` (which lib/box `isCutoffPassed` also delegates
// to) — so the copy can never disagree with what the API actually gates on.
// The old hardcoded "Tuesday 8 AM" was wrong for weekend-market members AND
// stale for everyone else.
// ─────────────────────────────────────────────────────────────────────
const boxPickupDay = (primaryShare?.pickup_location?.day_of_week ?? null) as FlexPickupDay;
const boxCutoffLabel = closeLabel(cycleMonday, boxPickupDay);

// ─────────────────────────────────────────────────────────────────────
// GO / NO-BOX STATUS for the resolved delivery week (FIX 1.4 / audit M-09).
// One impossible-to-miss banner answering the #1 support question: "am I
// getting a box this week?". Determined with the EXACT backend rules so the
// dashboard can never disagree with what actually packs:
//   • vacation hold  → holdOverlapsWeek() (cycle.ts) — the same overlap
//     resolveCycle uses to SUPPRESS a member's box.
//   • biweekly parity → isMemberOnThisWeek() (cycle.ts) — the same A/B gate
//     resolveCycle uses to INCLUDE / EXCLUDE a member.
// Precedence: a hold the member scheduled is the most specific signal, then
// biweekly off-week, else they have a box. Only shown for a box-bearing
// (primary) share during the ACTIVE season; flex-only members and the
// before/after-season states keep their own banners.
// ─────────────────────────────────────────────────────────────────────
type BoxWeekStatus = 'box' | 'off_week' | 'on_hold';
let boxWeekStatus: BoxWeekStatus | null = null;
if (showBoxSection && primaryShare) {
  let holdOverlaps = false;
  const memberIds = activeShares.map((s) => s.id);
  if (memberIds.length > 0) {
    // active + scheduled holds only (matches the resolver's exclusion set).
    const { data: holdRows, error: holdErr } = await supabase
      .from('vacation_holds')
      .select('member_id, start_date, end_date, status')
      .in('member_id', memberIds)
      .in('status', ['active', 'scheduled']);
    if (holdErr) {
      console.error('[dashboard] vacation_holds fetch failed:', holdErr.message);
    }
    for (const h of (holdRows ?? []) as Array<{ start_date: string; end_date: string; status: string }>) {
      if (holdOverlapsWeek(h, cycleMonday)) { holdOverlaps = true; break; }
    }
  }
  if (holdOverlaps) {
    boxWeekStatus = 'on_hold';
  } else if (!isMemberOnThisWeek({ biweekly_week: primaryShare.biweekly_week }, cycleMonday)) {
    boxWeekStatus = 'off_week';
  } else {
    boxWeekStatus = 'box';
  }
}
// The single canonical week label ("Week of Jun 22 – Jun 28") for the banner.
const boxWeekRange = weekRangeLabel(cycleMonday);
// For the off-week case, the member's NEXT on-parity box date (already computed
// parity-aware above as their next actual delivery). Empty → omit the clause.
const boxWeekNextBox = nextDeliveryLong;

// ── Next-delivery banner props (2026-06-05, Todd directive) ──
// The #1 thing a member sees: a warm "your next delivery is ___" line at the
// very top. Shows only when we can name a real upcoming date (configured
// schedule + a future delivery) AND the member HAS a pickup/delivery to name
// (so it never overlaps the hard "choose your pickup" forcing-nudge). The
// pickup-vs-delivery shape mirrors the PickupCard's mode.
type NextDeliveryMode = 'pickup' | 'delivery';
let nextDeliveryMode: NextDeliveryMode = 'pickup';
let nextDeliveryStopName: string | null = null;
let nextDeliveryPickupTime: string | null = null;
// Full pickup window ("9 AM–1 PM") when the stop has BOTH a start + end time —
// reuses the same formatTimeRange the PickupCard already shows, so the banner
// and the card never disagree. The banner renders "9 AM–1 PM" when this is set,
// and falls back to "after <nextDeliveryPickupTime>" when it's null (a stop
// with only a start time, or none).
let nextDeliveryPickupWindow: string | null = null;
let nextDeliveryAddress: string | null = null;

if (pickupCardMode === 'delivery') {
  nextDeliveryMode = 'delivery';
  nextDeliveryAddress = pickupDeliveryAddress;
} else if (pickupCardMode === 'pickup') {
  nextDeliveryMode = 'pickup';
  nextDeliveryStopName = pickupLocationName;
  // Single pickup time ("after 2 PM"). Falls back to DEFAULT_PICKUP_TIME
  // inside the helper when the stop has no time_start.
  nextDeliveryPickupTime = prettyPickupTime(
    primaryShare?.pickup_location?.time_start ?? null,
  );
  // pickupTimeRange was computed above from the SAME formatTimeRange the
  // PickupCard uses (non-empty only when both time_start + time_end exist).
  // Prefer the real window over the vaguer "after 9 AM" so a market member
  // sees "9 AM–1 PM".
  nextDeliveryPickupWindow = pickupTimeRange;
}

// customers.phone present? Drives the prominent "Update your phone number"
// button (missing) vs. the subtle inline "Update" link (present).
const hasPhone =
  typeof customer?.phone === 'string' && customer.phone.trim().length > 0;

// Render the banner only when: we have a real next-delivery date, the member
// is NOT in the hard pickup-nudge state, the season is configured + not
// complete, and we can describe a pickup OR delivery (not the 'unset' card).
const showNextDeliveryBanner =
  Boolean(primaryShare && primarySchedule) &&
  phase !== 'complete' &&
  !needsPickup &&
  nextDeliveryLong !== '' &&
  (pickupCardMode === 'pickup' || pickupCardMode === 'delivery');

// Hide the schedule card once the season is fully complete (the "that's a
// wrap" card covers that state instead).
const showScheduleCard =
  Boolean(primaryShare && primarySchedule) && phase !== 'complete';

const scheduleShareLabel = primaryShare
  ? SHARE_TYPE_LABELS[primaryShare.share_type] ?? primaryShare.share_type
  : undefined;

// ─────────────────────────────────────────────────────────────────────
// Farm Flex wallet (2026-05-22, Phase 1 — read-only). NON-BLOCKING as of
// 2026-05-24 (gap analysis P0-1): the balance comes from a live Shopify
// GraphQL call, so we NO LONGER await it during SSR — that gated first
// paint on Shopify latency for every member on every load. The
// <FlexWallet> island renders a loading shell immediately and fetches
// /api/account/flex-balance after paint. Same fail-soft behavior: the
// card hides when there's no positive balance (or on any error).
// ─────────────────────────────────────────────────────────────────────

// One-time welcome banner shown immediately after onboarding activation
// (set by /api/onboarding/activate redirecting to /dashboard?welcome=1).
// We only render the banner when the URL flag is present — a simple
// page reload drops it.
const justActivated = Astro.url.searchParams.get('welcome') === '1';

// Banner: non-admin user tried to access /admin/*. The middleware
// redirects them here with ?error=admin_only. Same URL-flag-only
// pattern as the welcome banner.
const adminOnlyError = Astro.url.searchParams.get('error') === 'admin_only';

// Page title — personalized
const title = `Welcome back, ${firstName} — Tiny Seed Farm CSA`;
---

<MemberShell
  title={title}
  canonical="https://csa.tinyseedfarm.com/dashboard"
  userEmail={user.email}
  active="home"
  isFlexMember={isFlexMember}
  mainClass="mx-auto flex w-full max-w-3xl flex-col gap-8 px-5 py-8 sm:gap-10 sm:px-6 sm:py-12"
>
      {/* ═════════════════════════════════════════════════════════════
          NEXT-DELIVERY BANNER (2026-06-05, Todd directive)
          The #1 thing a member sees — pinned above everything. "Your next
          delivery is <date>" + pickup/delivery details + a phone-number
          prompt (to collect/verify numbers ahead of SMS going live).
          Mutually exclusive with the forcing-nudge below (that handles the
          "no pickup chosen" case); hidden once the season is complete.
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && showNextDeliveryBanner && (
        <NextDeliveryBanner
          mode={nextDeliveryMode}
          nextDeliveryLong={nextDeliveryLong}
          stopName={nextDeliveryStopName}
          pickupTime={nextDeliveryPickupTime}
          pickupWindow={nextDeliveryPickupWindow}
          deliveryAddress={nextDeliveryAddress}
          hasPhone={hasPhone}
        />
      )}

      {/* ═════════════════════════════════════════════════════════════
          PICKUP FORCING-NUDGE (FIX 1, 2026-05-24)
          Pinned to the very top — active members who never chose a pickup
          at checkout MUST pick one before their first box (June 10). Shows
          until a pickup/delivery is set; not dismissible (data-driven).
          ═════════════════════════════════════════════════════════════ */}
      {needsPickup && <PickupNudgeBanner />}

      {/* ═════════════════════════════════════════════════════════════
          WEEK-ONE COUNTDOWN (2026-05-20)
          Shown only in the 'before' phase, for members whose controlling
          share has a configured season schedule. Pinned to the very top
          so it's the first thing a member sees before the season starts.
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && phase === 'before' && controllingSchedule && (
        <section
          role="status"
          aria-live="polite"
          class="overflow-hidden rounded-ts-xl border border-ts-primary/30 bg-ts-primary/5 p-5 shadow-ts-sm sm:p-6"
          data-countdown-banner
        >
          <div class="flex items-center gap-4">
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ts-primary/15 text-2xl"
              aria-hidden="true"
            >
              🌱
            </span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-xl font-bold tracking-tight text-ts-text sm:text-2xl">
                {countdownHeadline}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ts-text-secondary">
                {daysToStart === 0
                  ? <>Your first box arrives today — {firstDeliveryLabel}.</>
                  : <>Your first box arrives {firstDeliveryLabel}.</>}
              </p>
            </div>
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          DELIVERY TRACKER (Day 9 — Phase 1 Apps Script bridge)
          Only renders on pickup days for active members whose pickup
          is NOT the farm self-pickup. State updates by polling
          /api/delivery-status (60s default, 15s when driver en route,
          paused when tab is hidden).
          ═════════════════════════════════════════════════════════════ */}
      {trackerEligibleShare && initialDeliveryStatus && (
        <DeliveryTracker
          initialStatus={initialDeliveryStatus}
          pickupDateLabel={deliveryDateLabel}
        />
      )}

      {/* ═════════════════════════════════════════════════════════════
          ADMIN-ONLY DENIAL BANNER (one-time, ?error=admin_only)
          Shown when a non-admin lands here after trying /admin/*.
          ═════════════════════════════════════════════════════════════ */}
      {adminOnlyError && (
        <section
          role="alert"
          aria-live="polite"
          class="rounded-ts-xl border border-ts-warning/30 bg-ts-warning/5 p-5 shadow-ts-sm sm:p-6"
          data-admin-only-banner
        >
          <div class="flex items-start gap-4">
            <div
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ts-warning/15 text-xl"
              aria-hidden="true"
            >
              🔒
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="font-display text-lg font-semibold text-ts-text">
                Admin access required
              </h2>
              <p class="mt-1 text-sm leading-relaxed text-ts-text-secondary">
                The admin dashboard is for farm staff only. Email
                <a href="mailto:todd@tinyseedfarmpgh.com" class="font-medium text-ts-primary underline-offset-2 hover:underline">
                  todd@tinyseedfarmpgh.com
                </a>
                if you think this is a mistake.
              </p>
            </div>
            <button
              type="button"
              class="-mr-1 -mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ts-text-muted transition-colors duration-150 hover:bg-ts-warning/10 hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-warning"
              data-admin-only-dismiss
              aria-label="Dismiss banner"
            >
              <span aria-hidden="true">×</span>
            </button>
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          POST-ACTIVATION WELCOME BANNER (one-time, ?welcome=1)
          ═════════════════════════════════════════════════════════════ */}
      {justActivated && (
        <section
          role="status"
          aria-live="polite"
          class="rounded-ts-xl border border-ts-primary/30 bg-ts-primary/5 p-5 shadow-ts-sm sm:p-6"
          data-welcome-banner
        >
          <div class="flex items-start gap-4">
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ts-primary/15 text-2xl"
              aria-hidden="true"
            >
              🌱
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="font-display text-xl font-semibold text-ts-text">
                You're in. Welcome to the farm.
              </h2>
              <p class="mt-1.5 text-sm leading-relaxed text-ts-text-secondary">
                Your share is active. We'll send a box preview the day before each
                pickup, and you can swap items, request a vacation hold, or update
                preferences anytime from this dashboard.
              </p>
            </div>
            <button
              type="button"
              class="-mr-1 -mt-1 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ts-text-muted transition-colors duration-150 hover:bg-ts-primary/10 hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
              data-welcome-dismiss
              aria-label="Dismiss welcome banner"
            >
              <span aria-hidden="true">×</span>
            </button>
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          GREETING
          ═════════════════════════════════════════════════════════════ */}
      <section aria-labelledby="greeting-heading">
        <h1
          id="greeting-heading"
          class="font-display text-3xl leading-tight font-bold tracking-tight text-ts-text sm:text-4xl"
        >
          Welcome back, {firstName}.
        </h1>
        <p class="mt-2 text-base text-ts-text-secondary">
          Here's what's happening with your share — {boxWeekRange}.
        </p>
      </section>

      {/* ═════════════════════════════════════════════════════════════
          GO / NO-BOX STATUS (FIX 1.4 / audit M-09)
          The single "am I getting a box this week?" answer, impossible to
          miss at the top of the dashboard. Resolved server-side with the
          SAME rules the backend packs from (isMemberOnThisWeek +
          holdOverlapsWeek). Colour-coded: green = box coming, gold = on
          hold, muted = biweekly off-week. Date-range labelled per glossary.
          ═════════════════════════════════════════════════════════════ */}
      {boxWeekStatus && (
        <section
          role="status"
          aria-label="Your box status for this delivery week"
          class:list={[
            'flex items-center gap-4 rounded-ts-xl border p-5 shadow-ts-sm sm:p-6',
            boxWeekStatus === 'box'
              ? 'border-ts-primary/40 bg-ts-primary/5'
              : boxWeekStatus === 'on_hold'
                ? 'border-ts-accent/40 bg-ts-accent/5'
                : 'border-ts-border bg-ts-bg-muted/50',
          ]}
        >
          <span
            aria-hidden="true"
            class:list={[
              'flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-2xl',
              boxWeekStatus === 'box'
                ? 'bg-ts-primary/15'
                : boxWeekStatus === 'on_hold'
                  ? 'bg-ts-accent/15'
                  : 'bg-ts-bg-muted',
            ]}
          >
            {boxWeekStatus === 'box' ? '📦' : boxWeekStatus === 'on_hold' ? '🌴' : '🗓️'}
          </span>
          <div class="min-w-0">
            <p
              class:list={[
                'font-display text-lg font-bold sm:text-xl',
                boxWeekStatus === 'box'
                  ? 'text-ts-primary'
                  : boxWeekStatus === 'on_hold'
                    ? 'text-ts-accent'
                    : 'text-ts-text',
              ]}
            >
              {boxWeekStatus === 'box'
                ? 'You have a box coming'
                : boxWeekStatus === 'on_hold'
                  ? 'Your box is on hold'
                  : 'No box this cycle'}
            </p>
            <p class="mt-0.5 text-sm text-ts-text-secondary">
              {boxWeekRange}{boxWeekStatus === 'off_week' && boxWeekNextBox
                ? ` — your next box is ${boxWeekNextBox}`
                : boxWeekStatus === 'on_hold'
                  ? ' — you scheduled a vacation hold'
                  : ''}
            </p>
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          THIS WEEK'S ORDER — flex members (FIX 1, 2026-06-08)
          A flex member's #1 weekly action: order their extras. Prominent
          primary CTA → /account/flex-order (the ORDERING page), distinct
          from the FlexWallet balance card below (→ /account/flex). Hidden
          for non-flex members.
          ═════════════════════════════════════════════════════════════ */}
      {isFlexMember && (
        <section
          aria-labelledby="dash-order-cta-heading"
          class="overflow-hidden rounded-ts-xl border border-ts-primary/40 bg-ts-primary/5 p-5 shadow-ts-sm sm:p-6"
        >
          <div class="flex items-center gap-3">
            <span
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ts-primary/15 text-2xl"
              aria-hidden="true"
            >
              🧺
            </span>
            <div class="min-w-0 flex-1">
              <h2
                id="dash-order-cta-heading"
                class="font-display text-xl font-bold tracking-tight text-ts-text sm:text-2xl"
              >
                This week's order
              </h2>
              <p class="mt-0.5 text-sm leading-snug text-ts-text-secondary">
                Build your box from the weekly list with your Farm Flex balance.
              </p>
            </div>
          </div>
          <p class="mt-3 text-sm font-medium text-ts-warning">
            The Flex list goes live Thursday — order by {flexCloseLabel}. Your balance carries forward.
          </p>
          <a
            href="/account/flex-order"
            class="mt-4 inline-flex h-12 w-full items-center justify-center gap-2 rounded-ts-md bg-ts-primary px-5 text-base font-semibold tracking-tight text-white shadow-ts-sm transition-all duration-150 ease-[var(--ease-ts)] hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary [touch-action:manipulation] sm:w-auto"
          >
            Order your items <span aria-hidden="true">→</span>
          </a>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          PICKUP CARD (2026-06-05)
          Surfaces the member's CURRENT pickup stop / home delivery with an
          obvious "Change pickup location" action (≤2 taps from landing).
          Hidden when the forcing-nudge banner is already asking them to
          choose (avoids a duplicate ask), and for flex-only members.
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && showPickupCard && (
        <PickupCard
          mode={pickupCardMode}
          locationName={pickupLocationName}
          dayLong={pickupDayLong}
          timeRange={pickupTimeRange}
          city={pickupCity}
          address={pickupAddress}
          state={pickupState}
          zip={pickupZip}
          deliveryAddress={pickupDeliveryAddress}
          pickupInstructions={pickupInstructions}
          hostName={pickupHostName}
          hostPhone={pickupHostPhone}
        />
      )}

      {/* ═════════════════════════════════════════════════════════════
          SCHEDULE CARD (2026-06-05)
          Plain-language "when do I get a box?" — weekly vs. Week A / Week B,
          with the member's actual upcoming delivery dates. Computed from
          season.ts + cycle.ts parity (lib/schedule.ts). Skipped for
          flex-only members + once the season is complete.
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && showScheduleCard && (
        <ScheduleCard
          cadence={scheduleCadence}
          biweeklyWeek={scheduleBiweeklyWeek}
          firstDeliveryLong={scheduleFirstLong}
          seasonEndShort={scheduleSeasonEndShort}
          upcomingShort={scheduleUpcomingShort}
          shareLabel={scheduleShareLabel}
        />
      )}

      {/* ═════════════════════════════════════════════════════════════
          FARM FLEX WALLET (2026-05-22 — Phase 1, read-only)
          NON-BLOCKING (2026-05-24, gap P0-1): the <FlexWallet> island
          renders a loading shell immediately, then fetches
          /api/account/flex-balance after first paint — Shopify latency no
          longer gates the dashboard render. The card sits above the share
          cards, below the countdown banner. It hides itself (fail-soft)
          when there's no positive balance or on any error, identical to
          the old SSR behavior. Total leads; "Your funds" (principal) +
          "Bonus 🎁" break it out; Add Funds links to /account/flex.
          ═════════════════════════════════════════════════════════════ */}
      <FlexWallet variant="dashboard" />

      {/* ═════════════════════════════════════════════════════════════
          NO SHARE — fallback when customer record is missing OR
          there are no live member rows
          ═════════════════════════════════════════════════════════════ */}
      {(!customer || activeShares.length === 0) && (
        <EmptyState
          title="No active share on file"
          icon="🌱"
          tone="default"
          dashed={false}
        >
          {customer
            ? "We have you on file as a Tiny Seed customer, but you don't have a CSA share signed up for this season yet."
            : <>We didn't find a customer record for <span class="font-medium text-ts-text">{user.email}</span>.</>
          }
          {' '}Browse our shares or get in touch — we'd love to have you for the season.
          <Fragment slot="action">
            <Button
              href="https://tinyseedfarm.com/collections/tiny-seed-farm-csa"
              variant="primary"
              size="md"
              rel="noopener noreferrer"
              target="_blank"
            >
              Browse CSA shares <span aria-hidden="true">→</span>
            </Button>
            <Button
              href="mailto:todd@tinyseedfarmpgh.com?subject=CSA%20share%20question"
              variant="secondary"
              size="md"
            >
              Contact the farm
            </Button>
          </Fragment>
        </EmptyState>
      )}

      {/* ═════════════════════════════════════════════════════════════
          ACTIVE SHARE CARDS
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && (
        <section aria-labelledby="shares-heading" class="flex flex-col gap-4">
          <h2 id="shares-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
            Your share{activeShares.length > 1 ? 's' : ''}
          </h2>

          <div class="flex flex-col gap-4">
            {activeShares.map((share) => {
              // BUG 2 (2026-06-16): add-on shares carry their specific type
              // (Cheese / Mushroom / Bread / Coffee / Egg) only in notes —
              // shareDisplayLabel derives a clean name so two add-ons no
              // longer both read just "Add-On". Non-add-on shares fall back to
              // the SHARE_TYPE_LABELS lookup.
              const shareLabel = shareDisplayLabel(
                share.share_type,
                share.notes,
                SHARE_TYPE_LABELS[share.share_type] ?? share.share_type,
              );
              const sizeLabel = share.share_size ? SHARE_SIZE_LABELS[share.share_size] ?? share.share_size : null;
              const pill = STATUS_PILL[share.status] ?? STATUS_PILL.active;
              const weeksUsed = Math.max(0, share.total_weeks - share.weeks_remaining);
              const progressPct = share.total_weeks > 0
                ? Math.round((weeksUsed / share.total_weeks) * 100)
                : 0;
              const isHomeDelivery =
                !share.pickup_location_id && Boolean(share.delivery_address);

              // ── BUG 1 (2026-06-16): "Week 0 of N" ──────────────────────
              // weeksUsed = total_weeks - weeks_remaining is 0 for the many
              // migrated members whose weeks_remaining still equals total_weeks
              // (no consumption tracked) — producing a meaningless "Week 0 of N".
              // Prefer the SEASON week number (current week of the share's
              // season), which is reliably knowable from season.ts:
              //   • configured + active season → "Week {n} of {total}".
              //   • configured but before/after season, or no schedule
              //     (add_on/flex/fall_veg), where we can't name a running week:
              //     show the member's NEXT delivery date instead of "Week 0".
              //   • If even that can't be derived, omit the week line entirely
              //     (the "N weeks remaining" line still conveys progress).
              const cardSchedule = getSchedule(share.share_type);
              const cardPhase = cardSchedule ? seasonPhase(cardSchedule) : null;
              let cardWeekLabel: string | null = null;
              let cardNextDeliveryShort: string | null = null;
              if (cardSchedule && cardPhase === 'active') {
                cardWeekLabel = `Week ${currentWeekNumber(cardSchedule)} of ${cardSchedule.totalWeeks}`;
              } else if (weeksUsed > 0) {
                // Real consumption data → trust the per-share counter.
                cardWeekLabel = `Week ${weeksUsed} of ${share.total_weeks}`;
              } else {
                // Can't name a running week → surface the next delivery date so
                // the member sees something meaningful, not "Week 0".
                const sched = cardSchedule;
                if (sched && cardPhase !== 'complete') {
                  const resolved = resolveMemberSchedule({
                    schedule: sched,
                    biweeklyWeek: share.biweekly_week,
                  });
                  const nextDate = upcomingDeliveries(resolved, 1)[0] ?? null;
                  const pickupDay = (share.pickup_location?.day_of_week ?? null) as
                    | PickupDay
                    | null;
                  cardNextDeliveryShort = nextDate
                    ? prettyDeliveryShort(pickupDateForWeek(nextDate, pickupDay))
                    : null;
                }
              }

              return (
                <article
                  class="rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-md transition-shadow duration-200 hover:shadow-ts-lg sm:p-6"
                >
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2">
                        <h3 class="font-display text-lg font-semibold text-ts-text sm:text-xl">
                          {shareLabel}
                        </h3>
                        {sizeLabel && (
                          <span class="text-sm text-ts-text-muted">· {sizeLabel}</span>
                        )}
                      </div>
                      <p class="mt-1 text-sm text-ts-text-muted">{share.season}</p>
                    </div>
                    <Badge variant={pill.variant} size="sm" uppercase dot>
                      {pill.label}
                    </Badge>
                  </div>

                  {/* Progress */}
                  <div class="mt-5">
                    <div class="flex items-baseline justify-between text-sm">
                      <span class="font-medium text-ts-text">
                        {cardWeekLabel
                          ? cardWeekLabel
                          : cardNextDeliveryShort
                            ? <>Next delivery {cardNextDeliveryShort}</>
                            : <>&nbsp;</>}
                      </span>
                      <span class="text-ts-text-muted tabular-nums">
                        {share.weeks_remaining} {share.weeks_remaining === 1 ? 'week' : 'weeks'} remaining
                      </span>
                    </div>
                    <div
                      class="mt-2 h-2 w-full overflow-hidden rounded-full bg-ts-bg-muted"
                      role="progressbar"
                      aria-valuenow={progressPct}
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-label={`Share progress: ${progressPct}% complete`}
                    >
                      <div
                        class="h-full rounded-full bg-ts-primary transition-all duration-300"
                        style={`width: ${progressPct}%`}
                      ></div>
                    </div>
                  </div>

                  {/* Pickup / delivery */}
                  <div class="mt-5 border-t border-ts-border pt-4">
                    {isHomeDelivery ? (
                      <div class="flex items-start gap-3">
                        <span class="mt-0.5 text-lg" aria-hidden="true">🏡</span>
                        <div class="min-w-0">
                          <p class="text-sm font-medium text-ts-text">Home delivery</p>
                          <p class="mt-0.5 text-sm leading-snug text-ts-text-secondary">
                            {share.delivery_address}
                          </p>
                        </div>
                      </div>
                    ) : share.pickup_location ? (
                      <div class="flex items-start gap-3">
                        <span class="mt-0.5 text-lg" aria-hidden="true">📍</span>
                        <div class="min-w-0">
                          <p class="text-sm font-medium text-ts-text">
                            {share.pickup_location.name}
                          </p>
                          <p class="mt-0.5 text-sm leading-snug text-ts-text-secondary">
                            {share.pickup_location.day_of_week
                              ? dayLong[share.pickup_location.day_of_week] ?? share.pickup_location.day_of_week
                              : 'Day TBD'}
                            {share.pickup_location.time_start && share.pickup_location.time_end && (
                              <>
                                {' '}·{' '}
                                <span class="tabular-nums">
                                  {formatTimeRange(share.pickup_location.time_start, share.pickup_location.time_end)}
                                </span>
                              </>
                            )}
                          </p>
                          {(share.pickup_location.address || share.pickup_location.city) && (
                            <p class="mt-0.5 text-xs text-ts-text-muted">
                              {[share.pickup_location.address, share.pickup_location.city, share.pickup_location.state]
                                .filter(Boolean)
                                .join(', ')}
                            </p>
                          )}
                        </div>
                      </div>
                    ) : (
                      <div class="flex items-start gap-3">
                        <span class="mt-0.5 text-lg" aria-hidden="true">📍</span>
                        <p class="text-sm text-ts-text-muted">
                          Pickup details coming — we'll email you once your stop is set.
                        </p>
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          SEASON COMPLETE (phase 'complete') — replaces the box section
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && phase === 'complete' && (
        <section aria-labelledby="season-done-heading" class="flex flex-col gap-4">
          <div
            class="rounded-ts-xl border border-ts-primary/30 bg-ts-primary/5 p-6 text-center shadow-ts-sm sm:p-8"
          >
            <span class="text-4xl" aria-hidden="true">🌾</span>
            <h2
              id="season-done-heading"
              class="mt-3 font-display text-xl font-bold text-ts-text sm:text-2xl"
            >
              That's a wrap on the 2026 season — thank you!
            </h2>
            <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-ts-text-secondary">
              It was a joy growing for you. We'll be in touch about next season —
              keep an eye on your inbox.
            </p>
          </div>
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          THIS WEEK'S BOX (phase 'active' only)
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && showBoxSection && (
        <section aria-labelledby="box-heading" class="flex flex-col gap-4">
          <div class="flex items-baseline justify-between gap-4">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 id="box-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
                Your box
              </h2>
              {controllingSchedule && seasonWeekNumber > 0 && (
                <span class="text-sm font-medium text-ts-text-muted">
                  Week {seasonWeekNumber} of {controllingSchedule.totalWeeks}
                </span>
              )}
            </div>
            <span class="text-sm text-ts-text-muted tabular-nums">{boxWeekRange}</span>
          </div>

          {boxItems.length === 0 ? (
            <div
              class="rounded-ts-xl border border-dashed border-ts-border bg-ts-bg-muted/40 p-6 text-center"
            >
              <p class="text-base text-ts-text-secondary">
                Your box for {targetWeekPretty} is being planned.
              </p>
              <p class="mt-1 text-sm text-ts-text-muted">
                Once it's posted, open it before your swap cutoff — {boxCutoffLabel} — to see what's coming and make swaps.
              </p>
            </div>
          ) : (
            <div class="flex flex-col gap-4">
              {Array.from(itemsByShareType.entries()).map(([shareType, items]) => (
                <article
                  class="rounded-ts-xl border border-ts-border bg-ts-bg-surface shadow-ts-sm"
                >
                  {itemsByShareType.size > 1 && (
                    <header class="border-b border-ts-border px-5 py-3 sm:px-6">
                      <h3 class="text-sm font-semibold uppercase tracking-wide text-ts-text-secondary">
                        {SHARE_TYPE_LABELS[shareType] ?? shareType}
                      </h3>
                    </header>
                  )}
                  <ul class="divide-y divide-ts-border/60">
                    {items.map((item) => (
                      <li class="flex items-center gap-3 px-5 py-3 sm:px-6">
                        {item.library?.photo_url && (
                          <img
                            src={item.library.photo_url}
                            alt=""
                            width="40"
                            height="40"
                            loading="lazy"
                            class="h-10 w-10 shrink-0 rounded-ts-md border border-ts-border object-cover"
                          />
                        )}
                        <div class="min-w-0 flex-1">
                          <span class="font-medium text-ts-text">{item.product_name}</span>
                          {item.variety && (
                            <span class="ml-1.5 text-sm text-ts-text-muted">
                              ({item.variety})
                            </span>
                          )}
                          {item.is_swappable && (
                            <Badge variant="sky" size="xs" uppercase class="ml-2">
                              Swappable
                            </Badge>
                          )}
                        </div>
                        <span class="shrink-0 text-sm text-ts-text-secondary tabular-nums">
                          {item.quantity} {item.unit}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <footer class="border-t border-ts-border px-5 py-3 sm:px-6">
                    <a
                      href="/box"
                      class="inline-flex items-center gap-1 text-sm font-medium text-ts-primary underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
                      aria-label={`View full details for ${SHARE_TYPE_LABELS[shareType] ?? shareType}`}
                    >
                      View full details
                      <span aria-hidden="true">→</span>
                    </a>
                  </footer>
                </article>
              ))}
            </div>
          )}
        </section>
      )}

      {/* ═════════════════════════════════════════════════════════════
          QUICK ACTIONS
          ═════════════════════════════════════════════════════════════ */}
      {customer && activeShares.length > 0 && (
        <section aria-labelledby="actions-heading" class="flex flex-col gap-3">
          <h2 id="actions-heading" class="sr-only">Quick actions</h2>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <a
              href="/account/vacation"
              class="group flex flex-col items-start gap-2 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              <span class="text-2xl" aria-hidden="true">🏖️</span>
              <span class="font-semibold text-ts-text">Vacation hold</span>
              <span class="text-sm leading-snug text-ts-text-secondary">
                Pause delivery while you're away.
              </span>
            </a>
            <a
              href="/account/preferences"
              class="group flex flex-col items-start gap-2 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              <span class="text-2xl" aria-hidden="true">🥬</span>
              <span class="font-semibold text-ts-text">Preferences</span>
              <span class="text-sm leading-snug text-ts-text-secondary">
                Tell us what you don't eat — we'll never put it in your box.
              </span>
            </a>

            {/* Stop Notes (chat Phase 0, 2026-05-24). Read-only logistics
                board for the member's pickup stop(s). Shown only when ≥1 active
                share HAS a pickup location set — otherwise the page would be
                empty/no-stop, so we don't surface a dead-end card. Links to the
                dedicated /stop-notes page (we keep the bottom nav at 4 items
                per the spec, so this card is the entry point). */}
            {activeShares.some((s) => s.pickup_location_id != null) && (
              <a
                href="/stop-notes"
                class="group flex flex-col items-start gap-2 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary sm:col-span-2"
              >
                <span class="text-2xl" aria-hidden="true">📍</span>
                <span class="font-semibold text-ts-text">Stop Notes</span>
                <span class="text-sm leading-snug text-ts-text-secondary">
                  Logistics updates from the farm for your pickup —
                  gate codes, tent changes, weather moves.
                </span>
              </a>
            )}
          </div>

          {/* Contact: copyable email + mailto (always works without a mail app). */}
          <ContactFarm subject="CSA question" />
        </section>
      )}

  <Fragment slot="overlays">
  <script>
    // Dismiss the post-activation welcome banner. Removes the `?welcome=1`
    // flag from the URL via `history.replaceState` so a refresh doesn't
    // re-show the banner.
    const banner = document.querySelector<HTMLElement>('[data-welcome-banner]');
    const dismissBtn = document.querySelector<HTMLButtonElement>('[data-welcome-dismiss]');
    if (banner && dismissBtn) {
      dismissBtn.addEventListener('click', () => {
        banner.remove();
        const url = new URL(window.location.href);
        url.searchParams.delete('welcome');
        window.history.replaceState({}, '', url.toString());
      });
    }

    // Same dismiss pattern for the admin-only denial banner.
    const adminBanner = document.querySelector<HTMLElement>('[data-admin-only-banner]');
    const adminBannerDismiss = document.querySelector<HTMLButtonElement>('[data-admin-only-dismiss]');
    if (adminBanner && adminBannerDismiss) {
      adminBannerDismiss.addEventListener('click', () => {
        adminBanner.remove();
        const url = new URL(window.location.href);
        url.searchParams.delete('error');
        window.history.replaceState({}, '', url.toString());
      });
    }
  </script>
  </Fragment>
</MemberShell>
