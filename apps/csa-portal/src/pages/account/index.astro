---
/**
 * /account — member account hub.
 *
 * Cards link to:
 *   - /account/profile      (self-service name / phone / mailing address)
 *   - /account/household    (shared access — invite a partner/roommate)
 *   - /account/preferences  (dietary + contact prefs)
 *   - /account/pickup       (pickup location / home delivery)
 *   - /account/vacation     (vacation hold list + scheduler)
 *
 * The Profile card shows name + email + phone with an "Edit profile"
 * action linking to /account/profile (self-service editing, 2026-05-22).
 * Email stays read-only there — it's the auth identity.
 *
 * Sign-out is a POST to /logout (same as /dashboard).
 */
import MemberShell from '../../components/MemberShell.astro';
import Card from '../../components/Card.astro';
import FlexWallet from '../../components/FlexWallet.astro';
import PickupNudgeBanner from '../../components/PickupNudgeBanner.astro';
import { closeLabel } from '../../lib/flex-order';
import { upcomingMonday, isShareInSeasonForWeek } from '../../lib/cycle';
import { shareDisplayLabel } from '../../lib/addon';
import { getSchedule, seasonPhase } from '../../lib/season';
import {
  memberIsBiweekly,
  resolveMemberSchedule,
  upcomingDeliveries,
  prettyDeliveryLong,
  pickupDateForWeek,
  type PickupDay,
} from '../../lib/schedule';
import { resolveAccountCustomer } from '../../lib/account';

const user = Astro.locals.user;
if (!user || !user.email) {
  return Astro.redirect('/login', 303);
}
const supabase = Astro.locals.supabase;

// Farm Flex balance is loaded NON-BLOCKING (2026-05-24, gap P0-1): the
// <FlexWallet variant="hub"> island fetches /api/account/flex-balance
// after first paint instead of awaiting a live Shopify call during SSR.
// The hub card always links to /account/flex; the balance number appears
// once it loads (and stays hidden, showing the tagline, if total <= 0).

// ─── Pull customer + members + prefs + holds in one go ───────────────
type AccountMember = {
  id: string;
  share_type: string;
  share_size: string | null;
  season: string;
  total_weeks: number;
  vacation_weeks_used: number;
  status: string;
  pickup_location_id: string | null;
  delivery_address: string | null;
  biweekly_week: 'A' | 'B' | null;
  notes: string | null;
  pickup_location: {
    name: string;
    city: string | null;
    day_of_week: string | null;
  } | null;
  member_preferences: {
    dislikes: string[];
    allergies: string[];
    contact_preference: 'email' | 'sms' | 'both' | 'none';
    newsletter_opt_in: boolean;
  } | null;
};

type CustomerWithAccount = {
  id: string;
  contact_name: string;
  email: string;
  phone: string | null;
  members: AccountMember[];
};

// HOUSEHOLD-SHARING FIX (2026-06-12): resolve "which customer am I?" via
// household_owner() so an INVITED household member (no customers row of their
// own — migration 0023) resolves to the OWNER's account. A direct
// `from('customers')` query relies on customers_self_read (keyed on the auth
// email), which returns ZERO rows for an invited member → they saw no shares.
// members_self_read (keyed on current_customer_id()) grants them the owner's
// member rows + nested prefs, so fetching members directly by the resolved
// customer_id works for both a primary and an invited member.
const account = await resolveAccountCustomer(supabase);

let accountMembers: AccountMember[] = [];
if (account) {
  const { data: memberRows, error: customerError } = await supabase
    .from('members')
    .select(
      `
      id,
      share_type,
      share_size,
      season,
      total_weeks,
      vacation_weeks_used,
      status,
      pickup_location_id,
      delivery_address,
      biweekly_week,
      notes,
      pickup_location:pickup_locations (
        name,
        city,
        day_of_week
      ),
      member_preferences (
        dislikes,
        allergies,
        contact_preference,
        newsletter_opt_in
      )
    `
    )
    .eq('customer_id', account.id)
    .overrideTypes<AccountMember[], { merge: false }>();
  if (customerError) {
    console.error('[account] members fetch failed:', customerError.message);
  }
  accountMembers = memberRows ?? [];
}

// The caller's OWN phone (for the profile card). RLS scopes this to the
// caller's own customers row: a primary gets their phone; an invited member
// has no own row → null ("Not set"), and self-service profile editing targets
// their own row anyway.
let callerPhone: string | null = null;
if (account && user.email) {
  const { data: ownRow } = await supabase
    .from('customers')
    .select('phone')
    .eq('email', user.email)
    .maybeSingle()
    .overrideTypes<{ phone: string | null }, { merge: false }>();
  callerPhone = ownRow?.phone ?? null;
}

const customer: CustomerWithAccount | null = account
  ? {
      id: account.id,
      contact_name: account.contactName,
      email: account.email,
      phone: callerPhone,
      members: accountMembers,
    }
  : null;
const liveStatuses = new Set(['active', 'paused', 'onboarding']);
const allMembers = customer?.members ?? [];

// SEASON-AWARENESS (2026-06-16, BUG 3). A status='active' share can be
// OUT of season (the spring_veg season ended Wed 2026-05-27 but those rows
// can still read 'active'). The account hub's "Active share" + summary copy
// must reflect the member's CURRENT (in-season) share — summer_veg now — not
// a stale spring one. isShareInSeasonForWeek gates on the same season-window
// rule the admin pack logic uses: summer_veg (in season) passes; an ended
// spring_veg is excluded. Share types with NO configured window (flex,
// add_on, fall_veg) always pass → preserved exactly as before.
const cycleMonday = upcomingMonday();
const liveMembers = allMembers.filter(
  (m) => liveStatuses.has(m.status) && isShareInSeasonForWeek(m.share_type, cycleMonday),
);

// Flex-share members get the weekly "extras" ordering entry point. Traditional
// CSA members never see it (Phase 1: no extras/swaps for them).
const isFlexMember = liveMembers.some((m) => m.share_type === 'flex');

// Flex order-window close label for the entry-point teaser. Week 1
// ('2026-06-08') closes Tue 6 PM; standing weeks close Tue 7 AM. Mirrors
// the close-time cadence in lib/flex-order.ts (Todd 2026-06-08).
const flexCloseLabel = isFlexMember ? closeLabel(upcomingMonday()) : '';

// Pickup forcing-nudge (FIX 1, 2026-05-24, gap P0). Same rule as the
// dashboard / shared memberNeedsPickupChoice helper: an ACTIVE member who
// never chose a pickup at checkout must pick one before June 10. Computed
// from the rows already in hand (carry pickup_location_id + delivery_address
// + status) — no extra DB round-trip.
const accountActiveMembers = allMembers.filter((m) => m.status === 'active');
const needsPickup =
  accountActiveMembers.length > 0 &&
  !accountActiveMembers.some(
    (m) =>
      m.pickup_location_id != null ||
      (typeof m.delivery_address === 'string' && m.delivery_address.trim().length > 0)
  );

// Pick a "primary" member for summary copy. Prefer a box-bearing share
// (a veg/flower share over a flex or add-on) so the "Active share" line and
// the pickup/schedule summary describe the member's actual produce share,
// not an Add-On, when they have both (BUG 2/3, 2026-06-16). liveMembers is
// already season-filtered above, so an ended spring share can never be
// primary. Falls back to the first live share when there's no veg/flower one
// (e.g. a flex-only or add-on-only member).
const primary =
  liveMembers.find((m) => m.share_type !== 'flex' && m.share_type !== 'add_on') ??
  liveMembers.find((m) => m.share_type !== 'flex') ??
  liveMembers[0] ??
  null;

const SHARE_TYPE_LABELS: Record<string, string> = {
  spring_veg: 'Spring Vegetable Share',
  summer_veg: 'Summer Vegetable Share',
  fall_veg: 'Fall Vegetable Share',
  flower: 'Flower Share',
  flex: 'Flex Share',
  add_on: 'Add-On',
  wholesale_csa: 'Wholesale CSA',
};

const dayLong: Record<string, string> = {
  Sun: 'Sunday', Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday',
};

const firstName = (customer?.contact_name ?? user.email!.split('@')[0])
  .trim()
  .split(/\s+/)[0];

const totalVacationLeft =
  primary != null
    ? Math.max(0, primary.total_weeks - primary.vacation_weeks_used)
    : 0;

const prefsCount =
  (primary?.member_preferences?.dislikes?.length ?? 0) +
  (primary?.member_preferences?.allergies?.length ?? 0);

const pickupSummary: string = (() => {
  if (!primary) return '';
  if (!primary.pickup_location_id && primary.delivery_address) {
    return `Home delivery — ${primary.delivery_address}`;
  }
  if (primary.pickup_location) {
    const day = primary.pickup_location.day_of_week
      ? dayLong[primary.pickup_location.day_of_week] ?? primary.pickup_location.day_of_week
      : null;
    const where = primary.pickup_location.city
      ? `${primary.pickup_location.name}, ${primary.pickup_location.city}`
      : primary.pickup_location.name;
    return day ? `${where} · ${day}s` : where;
  }
  return 'No pickup location set';
})();

// ─── Delivery cadence (weekly vs bi-weekly) ──────────────────────────
// CANONICAL RULE (matches lib/schedule.ts + the dashboard ScheduleCard):
// a member with biweekly_week === null is WEEKLY (a box every week), UNLESS
// they were sold a reduced-week biweekly plan but haven't picked A/B yet
// (memberIsBiweekly resolves that ambiguity via total_weeks). A true weekly
// member must NEVER see "biweekly" / "Week A/B" framing — that was the bug
// (Jason Smith, weekly, was shown "Not yet assigned"). The bi-weekly card is
// only rendered for members who are ACTUALLY on a bi-weekly share.
const primarySchedule = primary ? getSchedule(primary.share_type) : null;
const primaryIsBiweekly = primary
  ? memberIsBiweekly({
      biweeklyWeek: primary.biweekly_week,
      totalWeeks: primary.total_weeks,
      schedule: primarySchedule,
    })
  : false;

const biweeklySummary: string = (() => {
  if (!primary || !primaryIsBiweekly) return '';
  if (primary.biweekly_week === 'A') return 'Week A — every other Wednesday';
  if (primary.biweekly_week === 'B') return 'Week B — every other Wednesday';
  return 'Not yet assigned — pick a week or let the farm decide';
})();

// ─── Next-box one-liner (A2, 2026-06-12) ─────────────────────────────
// Members didn't know WHEN their next box arrives (Week A/B confusion caused
// wasted trips). Surface the same "Your next box: <date> at <stop>" line the
// dashboard pins at the top, here near the top of the account hub. Computed
// from the primary share's season schedule + biweekly_week so weekly and
// Week A / Week B land on the right Wednesday. Empty (hidden) when there's no
// configured schedule, the season is complete, or there's no upcoming date.
let nextBoxDateLong = '';
let nextBoxWhere = '';
if (primary && primarySchedule && seasonPhase(primarySchedule) !== 'complete') {
  const resolved = resolveMemberSchedule({
    schedule: primarySchedule,
    biweeklyWeek: primary.biweekly_week,
  });
  const nextDate = upcomingDeliveries(resolved, 1)[0] ?? null;
  if (nextDate) {
    // Shift the cycle Wednesday to the member's ACTUAL pickup day so the date
    // + weekday word match their stop (a Saturday-market member's Jun 17 cycle
    // reads "Saturday, June 20", not "Wednesday, June 17"). Home delivery has
    // no pickup_location → null → the anchor Wednesday (home delivery IS Wed).
    const primaryPickupDay = (primary.pickup_location?.day_of_week ?? null) as
      | PickupDay
      | null;
    nextBoxDateLong = prettyDeliveryLong(pickupDateForWeek(nextDate, primaryPickupDay));
    // Where: home delivery, a named stop, or nothing (omit the "at ___").
    if (!primary.pickup_location_id && primary.delivery_address) {
      nextBoxWhere = 'home delivery';
    } else if (primary.pickup_location?.name) {
      nextBoxWhere = primary.pickup_location.name;
    }
  }
}
const showNextBox = nextBoxDateLong !== '';
---

<MemberShell
  title="Account — Tiny Seed Farm CSA"
  description="Manage your CSA account: pickup location, dietary preferences, and vacation holds."
  canonical="https://csa.tinyseedfarm.com/account"
  userEmail={user.email}
  active="account"
  isFlexMember={isFlexMember}
  back={{ href: '/dashboard', label: 'Dashboard' }}
>
      <section aria-labelledby="account-heading">
        <h1 id="account-heading" class="font-display text-3xl font-bold tracking-tight text-ts-text sm:text-4xl">
          Your account
        </h1>
        <p class="mt-2 text-base text-ts-text-secondary">
          Hi {firstName} — manage your share, preferences, and pickup details.
        </p>
      </section>

      {/* NEXT-BOX ONE-LINER (A2, 2026-06-12) — mirrors the dashboard's
          next-delivery banner so a member who lands on /account still sees
          WHEN their next box arrives (Week A/B confusion caused wasted trips).
          Hidden when there's no configured schedule / upcoming date. */}
      {showNextBox && (
        <p
          class="flex items-center gap-2 rounded-ts-xl border border-ts-primary/30 bg-ts-primary/5 px-4 py-3 text-sm text-ts-text-secondary sm:text-base"
          data-next-box-line
        >
          <span class="text-lg" aria-hidden="true">📦</span>
          <span>
            Your next box:{' '}
            <span class="font-semibold text-ts-text">{nextBoxDateLong}</span>
            {nextBoxWhere && (
              <>
                {' '}at <span class="font-semibold text-ts-text">{nextBoxWhere}</span>
              </>
            )}.
          </span>
        </p>
      )}

      {/* PICKUP FORCING-NUDGE (FIX 1, 2026-05-24) — active members who never
          chose a pickup at checkout must pick one before June 10. Shown at
          the top of the hub until set (data-driven, not dismissible). */}
      {needsPickup && <PickupNudgeBanner />}

      {/* ════ THIS WEEK'S ORDER — flex members, PROMOTED to top (FIX 1, 2026-06-08)
          Flex members order their weekly extras here. This is the ORDERING
          entry (/account/flex-order) — distinct from the Farm Flex wallet
          below, which is the BALANCE (/account/flex). Promoted from a buried
          low card to a prominent primary CTA so a flex member can't miss it. */}
      {isFlexMember && (
        <section
          aria-labelledby="order-cta-heading"
          class="overflow-hidden rounded-ts-xl border border-ts-primary/40 bg-ts-primary/5 p-5 shadow-ts-sm sm:p-6"
        >
          <div class="flex items-center gap-3">
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ts-primary/15 text-2xl"
              aria-hidden="true"
            >
              🧺
            </span>
            <div class="min-w-0 flex-1">
              <h2
                id="order-cta-heading"
                class="font-display text-xl font-bold tracking-tight text-ts-text sm:text-2xl"
              >
                This week's order
              </h2>
              <p class="mt-0.5 text-sm leading-snug text-ts-text-secondary">
                Browse the weekly list and build your box with your Farm Flex balance.
              </p>
            </div>
          </div>
          <p class="mt-3 text-sm font-medium text-ts-warning">
            Order by {flexCloseLabel} — your balance carries forward.
          </p>
          <a
            href="/account/flex-order"
            class="mt-4 inline-flex h-12 w-full items-center justify-center gap-2 rounded-ts-md bg-ts-primary px-5 text-base font-semibold tracking-tight text-white shadow-ts-sm transition-all duration-150 ease-[var(--ease-ts)] hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary [touch-action:manipulation] sm:w-auto"
          >
            Order your items <span aria-hidden="true">→</span>
          </a>
        </section>
      )}

      {/* PROFILE — self-service editing via /account/profile */}
      <Card padding="md" elevation="sm" class="text-sm">
        <header class="mb-3 flex items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-ts-text">Profile</h2>
          <a
            href="/account/profile"
            class="inline-flex items-center gap-1 rounded-ts-md px-2.5 py-1.5 text-sm font-semibold text-ts-primary transition-colors duration-150 hover:bg-ts-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            Edit profile
            <span aria-hidden="true">→</span>
          </a>
        </header>
        <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-ts-text-muted">Name</dt>
            <dd class="mt-1 text-ts-text">{customer?.contact_name ?? '—'}</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-ts-text-muted">Email</dt>
            <dd class="mt-1 break-all text-ts-text">{user.email}</dd>
          </div>
          <div>
            <dt class="text-xs font-medium uppercase tracking-wide text-ts-text-muted">Phone</dt>
            <dd class="mt-1 text-ts-text">{customer?.phone ?? <span class="text-ts-text-muted">Not set</span>}</dd>
          </div>
          {primary && (
            <div>
              <dt class="text-xs font-medium uppercase tracking-wide text-ts-text-muted">Active share</dt>
              <dd class="mt-1 text-ts-text">
                {shareDisplayLabel(
                  primary.share_type,
                  primary.notes,
                  SHARE_TYPE_LABELS[primary.share_type] ?? primary.share_type,
                )}
                <span class="text-ts-text-muted"> · {primary.season}</span>
              </dd>
            </div>
          )}
        </dl>
        <p class="mt-4 text-xs text-ts-text-muted">
          Your email is how you sign in, so it's edited separately — pick
          <a href="/account/profile" class="font-medium text-ts-primary underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary">Edit profile</a> to update your name, phone, or address.
        </p>
      </Card>

      {/* FARM FLEX WALLET (always available — independent of an active veg
          share). This is the BALANCE card (→ /account/flex), deliberately
          distinct from the "This week's order" CTA above (→ /account/flex-order):
          wallet = money, order = items. Non-blocking island (2026-05-24): the
          card renders + links immediately; the balance fills in after paint. */}
      <FlexWallet variant="hub" />

      {/* SHARED ACCESS (account-level — independent of an active veg share) */}
      <a
        href="/account/household"
        class="group flex items-start gap-4 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        <span class="text-3xl" aria-hidden="true">👥</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ts-text">Shared access</h3>
          <p class="mt-1 text-sm leading-snug text-ts-text-secondary">
            Share your account with a partner or roommate
          </p>
          <p class="mt-1 text-xs text-ts-text-muted">Invite someone to manage the box with you</p>
        </div>
        <span class="self-center text-ts-text-muted transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>

      {/* REFER A FRIEND (account-level — independent of an active veg share) */}
      <a
        href="/account/refer"
        class="group flex items-start gap-4 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        <span class="text-3xl" aria-hidden="true">🎁</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-ts-text">Refer a friend — earn $25</h3>
          <p class="mt-1 text-sm leading-snug text-ts-text-secondary">
            They get $25 off their first CSA order; you earn $25 in Farm Flex
          </p>
          <p class="mt-1 text-xs text-ts-text-muted">Share your code — unlimited referrals</p>
        </div>
        <span class="self-center text-ts-text-muted transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>

      {/* CARDS */}
      {primary ? (
        <section aria-labelledby="settings-heading" class="flex flex-col gap-3">
          <h2 id="settings-heading" class="sr-only">Settings</h2>

          {/* PICKUP */}
          <a
            href="/account/pickup"
            class="group flex items-start gap-4 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            <span class="text-3xl" aria-hidden="true">📍</span>
            <div class="min-w-0 flex-1">
              <h3 class="text-base font-semibold text-ts-text">Pickup location</h3>
              <p class="mt-1 text-sm leading-snug text-ts-text-secondary">{pickupSummary}</p>
              <p class="mt-1 text-xs text-ts-text-muted">Change stop or switch to home delivery</p>
            </div>
            <span class="self-center text-ts-text-muted transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>

          {/* DELIVERY SCHEDULE — cadence-aware (FIX 2026-06-08).
              BI-WEEKLY members get a link to pick/change Week A vs Week B.
              WEEKLY members (biweekly_week null, full season weeks) must NEVER
              see "biweekly" / "Week A/B" framing — they get a calm, link-less
              "Every week" confirmation card instead. */}
          {primaryIsBiweekly ? (
            <a
              href="/account/biweekly-schedule"
              class="group flex items-start gap-4 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              <span class="text-3xl" aria-hidden="true">🗓</span>
              <div class="min-w-0 flex-1">
                <h3 class="text-base font-semibold text-ts-text">Bi-weekly schedule</h3>
                <p class="mt-1 text-sm leading-snug text-ts-text-secondary">{biweeklySummary}</p>
                <p class="mt-1 text-xs text-ts-text-muted">Week A or Week B — change any time</p>
              </div>
              <span class="self-center text-ts-text-muted transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </a>
          ) : (
            <div class="flex items-start gap-4 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm">
              <span class="text-3xl" aria-hidden="true">📦</span>
              <div class="min-w-0 flex-1">
                <h3 class="text-base font-semibold text-ts-text">Delivery schedule</h3>
                <p class="mt-1 text-sm leading-snug text-ts-text-secondary">You get a box <span class="font-medium text-ts-text">every week</span>.</p>
                <p class="mt-1 text-xs text-ts-text-muted">Your dashboard shows your upcoming box dates</p>
              </div>
            </div>
          )}

          {/* PREFERENCES */}
          <a
            href="/account/preferences"
            class="group flex items-start gap-4 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            <span class="text-3xl" aria-hidden="true">🥬</span>
            <div class="min-w-0 flex-1">
              <h3 class="text-base font-semibold text-ts-text">Preferences</h3>
              <p class="mt-1 text-sm leading-snug text-ts-text-secondary">
                {prefsCount === 0
                  ? 'No dietary notes on file. Add dislikes or allergies.'
                  : `${prefsCount} dietary ${prefsCount === 1 ? 'note' : 'notes'} on file`}
              </p>
              <p class="mt-1 text-xs text-ts-text-muted">Dislikes, allergies, delivery notes, contact preference</p>
            </div>
            <span class="self-center text-ts-text-muted transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>

          {/* VACATION */}
          <a
            href="/account/vacation"
            class="group flex items-start gap-4 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm transition-all duration-200 hover:border-ts-primary/40 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            <span class="text-3xl" aria-hidden="true">🏖️</span>
            <div class="min-w-0 flex-1">
              <h3 class="text-base font-semibold text-ts-text">Vacation holds</h3>
              <p class="mt-1 text-sm leading-snug text-ts-text-secondary">
                {totalVacationLeft} of {primary.total_weeks} {primary.total_weeks === 1 ? 'week' : 'weeks'} available
              </p>
              <p class="mt-1 text-xs text-ts-text-muted">Pause delivery while you're away</p>
            </div>
            <span class="self-center text-ts-text-muted transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">→</span>
          </a>
        </section>
      ) : (
        <Card padding="md" elevation="sm">
          <p class="text-sm text-ts-text-secondary">
            We don't have an active CSA share on your account yet. Once Todd activates your share you can manage your pickup, preferences, and vacation holds here.
          </p>
        </Card>
      )}

</MemberShell>
