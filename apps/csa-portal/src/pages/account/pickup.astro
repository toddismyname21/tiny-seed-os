---
/**
 * /account/pickup — choose a pickup LOCATION, or REQUEST home delivery.
 *
 * Home delivery is PAID ($15/week) + ADMIN-APPROVED, so members can NOT
 * self-select it (that was a revenue leak — migration 0030 gates the RPC).
 * This page therefore offers:
 *   - A pickup-stop SELECT (members switch stop ↔ stop freely).
 *   - A "Request home delivery — $15/week, subject to approval" action that
 *     captures the desired address and routes it to staff WITHOUT setting
 *     delivery or charging (POST /api/account/request-delivery).
 *
 * Three member states drive the view:
 *   - on a pickup stop / no choice yet → stop chooser + request-delivery CTA
 *   - request already pending           → "request received" state (no spam)
 *   - already on home delivery (the ~12 already-paid members) → READ-ONLY
 *     "Home delivery — <address>" + "contact us to change" (change is now
 *     admin-gated, so they can't self-edit it).
 *
 * Auth: middleware. RLS scopes member lookup; pickup_locations is
 * public-read for authenticated users.
 */
import MemberShell from '../../components/MemberShell.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import EmptyState from '../../components/EmptyState.astro';
import Select from '../../components/Select.astro';
import FormRow from '../../components/FormRow.astro';
import HostNote from '../../components/HostNote.astro';
import { PICKUP_ERROR_COPY } from '../../lib/account';
import { contactMailto } from '../../lib/contact';

const user = Astro.locals.user;
if (!user || !user.email) {
  return Astro.redirect('/login', 303);
}
const supabase = Astro.locals.supabase;

// ─── Member context ─────────────────────────────────────────────────
type MemberRow = {
  id: string;
  share_type: string;
  status: string;
  pickup_location_id: string | null;
  delivery_address: string | null;
  home_delivery_requested_at: string | null;
  home_delivery_requested_address: string | null;
  pickup_location: {
    id: string;
    name: string;
    address: string | null;
    city: string | null;
    state: string | null;
    zip: string | null;
    day_of_week: string | null;
    time_start: string | null;
    time_end: string | null;
    is_delivery_zone: boolean;
    pickup_instructions: string | null;
    host_name: string | null;
    host_phone: string | null;
  } | null;
};

const { data: memberRows, error: memberErr } = await supabase
  .from('members')
  .select(
    `
    id,
    share_type,
    status,
    pickup_location_id,
    delivery_address,
    home_delivery_requested_at,
    home_delivery_requested_address,
    pickup_location:pickup_locations (
      id, name, address, city, state, zip, day_of_week, time_start, time_end, is_delivery_zone, pickup_instructions, host_name, host_phone
    )
  `
  )
  .in('status', ['active', 'paused', 'onboarding'])
  .order('start_date', { ascending: false })
  .overrideTypes<MemberRow[], { merge: false }>();

if (memberErr) {
  console.error('[account/pickup] member fetch failed:', memberErr.message);
}

const primary = (memberRows ?? [])[0] ?? null;

// Member-facing per-site pickup instructions for the member's CURRENT stop
// (pickup_locations.pickup_instructions — DISTINCT from the admin-only
// `notes`). Null/blank → no instructions block (falls back to the day/time
// summary already shown). Never shown for home delivery.
const currentInstructions =
  primary?.pickup_location?.pickup_instructions != null &&
  primary.pickup_location.pickup_instructions.trim().length > 0
    ? primary.pickup_location.pickup_instructions.trim()
    : null;

// Member-facing host name/phone for the member's CURRENT stop
// (pickup_locations.host_name / host_phone — DISTINCT from the admin-only
// `notes`). Null → no "Your host" block. Never shown for home delivery.
const currentHostName =
  primary?.pickup_location?.host_name != null &&
  primary.pickup_location.host_name.trim().length > 0
    ? primary.pickup_location.host_name.trim()
    : null;
const currentHostPhone =
  primary?.pickup_location?.host_phone != null &&
  primary.pickup_location.host_phone.trim().length > 0
    ? primary.pickup_location.host_phone.trim()
    : null;

// ─── All available pickup locations (excluding the delivery zones) ──
type LocationRow = {
  id: string;
  name: string;
  city: string | null;
  day_of_week: string | null;
  time_start: string | null;
  time_end: string | null;
  max_capacity: number | null;
  is_active: boolean;
  is_delivery_zone: boolean;
};

// Show ALL active pickup locations. `is_delivery_zone` is a ROUTING flag
// (does the farm drive boxes to this host's porch) — it must NOT gate the
// customer's pickup choice. All 16 stops (porches, markets, farm) are valid
// pickup options; home delivery is a separate flow (delivery_address), not
// a pickup_location. The old `.eq('is_delivery_zone', false)` hid 11 real
// stops (Allison Park, Mt. Lebanon, North Park, Zelienople, Squirrel Hill…).
const { data: locationRows, error: locErr } = await supabase
  .from('pickup_locations')
  .select('id, name, city, day_of_week, time_start, time_end, max_capacity, is_active, is_delivery_zone')
  .eq('is_active', true)
  .order('day_of_week', { ascending: true })
  .order('name', { ascending: true })
  .overrideTypes<LocationRow[], { merge: false }>();

if (locErr) {
  console.error('[account/pickup] location fetch failed:', locErr.message);
}
const locations = locationRows ?? [];

// ─── Flash ──────────────────────────────────────────────────────────
const errorParam = Astro.url.searchParams.get('error');
const okParam = Astro.url.searchParams.get('ok');
const errorMsg = errorParam ? PICKUP_ERROR_COPY[errorParam] ?? PICKUP_ERROR_COPY.invalid_input : null;
const okMsg =
  okParam === 'saved'
    ? 'Pickup location updated. Effective next Wednesday.'
    : okParam === 'requested'
      ? "Request received — we'll confirm your home delivery and the $15/week fee. Until then, your pickup stays as it is."
      : null;

const dayLong: Record<string, string> = {
  Sun: 'Sunday', Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday',
  Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday',
};

function formatTimeRange(start: string | null, end: string | null): string {
  if (!start || !end) return '';
  const fmt = (t: string): string => {
    const [hStr, mStr] = t.split(':');
    let h = Number(hStr);
    const m = Number(mStr);
    const period = h >= 12 ? 'PM' : 'AM';
    h = h % 12 === 0 ? 12 : h % 12;
    return m === 0 ? `${h} ${period}` : `${h}:${mStr.padStart(2, '0')} ${period}`;
  };
  return `${fmt(start)}–${fmt(end)}`;
}

function locationLabel(loc: LocationRow): string {
  const parts: string[] = [loc.name];
  if (loc.city) parts.push(loc.city);
  const head = parts.join(', ');
  const day = loc.day_of_week ? dayLong[loc.day_of_week] ?? loc.day_of_week : null;
  const time = formatTimeRange(loc.time_start, loc.time_end);
  const tail = [day, time].filter(Boolean).join(' ');
  return tail ? `${head} — ${tail}` : head;
}

// ─── Member state ───────────────────────────────────────────────────
// A member is "on home delivery" when they have a delivery_address (the ~12
// already-paid delivery members). That state is READ-ONLY here — changing it
// is admin-gated, so we show "contact us to change" instead of an editor.
const isHomeDelivery =
  primary != null && !!primary.delivery_address && primary.delivery_address.trim().length > 0;

// A home-delivery REQUEST is pending across ANY active share when a request
// timestamp is set AND the member isn't already on delivery (i.e. an admin
// hasn't approved + set it yet). We check all rows so a multi-share member
// reads "pending" no matter which row is primary.
const deliveryRequestRow = (memberRows ?? []).find(
  (m) =>
    m.home_delivery_requested_at != null &&
    !(typeof m.delivery_address === 'string' && m.delivery_address.trim().length > 0)
);
const hasPendingRequest = !isHomeDelivery && deliveryRequestRow != null;
const pendingAddress = deliveryRequestRow?.home_delivery_requested_address ?? null;

// Pre-fill the request textarea with the customer's address on file if we
// have it (nice-to-have; falls back to empty).
const contactChangeHref = contactMailto(
  'Change my home delivery',
  'Hi Tiny Seed — I\'d like to change my home delivery details. Here\'s what I need:'
);
---

<MemberShell
  title="Pickup location — Tiny Seed Farm CSA"
  description="Choose your CSA pickup location, or request home delivery ($15/week, subject to approval)."
  canonical="https://csa.tinyseedfarm.com/account/pickup"
  userEmail={user.email}
  active="account"
  back={{ href: "/account", label: "Account" }}
  mainClass="mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 py-8 sm:px-6 sm:py-12"
>
      <section aria-labelledby="pickup-heading">
        <h1 id="pickup-heading" class="font-display text-3xl font-bold tracking-tight text-ts-text sm:text-4xl">
          Your pickup location
        </h1>
        <p class="mt-2 text-base text-ts-text-secondary">
          This is where you'll pick up your box each week. Choose a different
          stop below — or request home delivery ($15/week, subject to approval).
        </p>
      </section>

      {/* Flash banners (shared across all states) */}
      {errorMsg && (
        <div
          role="alert"
          aria-live="polite"
          class="rounded-ts-lg border border-ts-danger/30 bg-ts-danger/5 px-4 py-3 text-sm leading-relaxed text-ts-danger"
        >
          {errorMsg}
        </div>
      )}
      {okMsg && (
        <div
          role="status"
          aria-live="polite"
          class="rounded-ts-lg border border-ts-primary/30 bg-ts-primary/5 px-4 py-3 text-sm leading-relaxed text-ts-primary"
        >
          {okMsg}
        </div>
      )}

      {!primary ? (
        <EmptyState title="No active share" icon="🌱" tone="default" dashed={false}>
          You'll be able to change pickup details once your CSA share is active.
          <Fragment slot="action">
            <Button href="/account" variant="secondary" size="md">Back to account</Button>
          </Fragment>
        </EmptyState>
      ) : isHomeDelivery ? (
        /* ─── Already on home delivery (the already-paid delivery members).
              READ-ONLY — changing delivery is admin-gated now. ─── */
        <Card padding="md" elevation="sm" tone="muted">
          <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Current</p>
          <div class="mt-2 flex items-start gap-3">
            <span class="mt-0.5 text-lg" aria-hidden="true">🏡</span>
            <div class="min-w-0">
              <p class="text-sm font-medium text-ts-text">Home delivery</p>
              <p class="mt-0.5 whitespace-pre-line text-sm text-ts-text-secondary">{primary.delivery_address}</p>
            </div>
          </div>
          <div class="mt-4 rounded-ts-md border border-ts-border bg-ts-bg-surface px-4 py-3">
            <p class="text-sm leading-relaxed text-ts-text-secondary">
              You're set up for <span class="font-medium text-ts-text">home delivery</span>.
              Need to update your address or switch to a pickup stop?
              <a
                href={contactChangeHref}
                class="font-semibold text-ts-primary underline decoration-ts-primary/40 underline-offset-2 hover:decoration-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
              >Contact us</a> and we'll take care of it.
            </p>
          </div>
          <div class="mt-4">
            <Button href="/account" variant="secondary" size="md">Back to account</Button>
          </div>
        </Card>
      ) : (
        <>
          {/* CURRENT (pickup stop, or not set yet) — prominent so the
              member instantly sees where they pick up today. */}
          <Card padding="md" elevation="sm" tone={primary.pickup_location ? 'primary' : 'muted'}>
            <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">
              Where you pick up now
            </p>
            {primary.pickup_location ? (
              <div class="mt-2 flex items-start gap-3">
                <span class="mt-0.5 text-2xl" aria-hidden="true">📍</span>
                <div class="min-w-0">
                  <p class="font-display text-lg font-bold tracking-tight text-ts-text sm:text-xl">
                    {primary.pickup_location.name}
                  </p>
                  <p class="mt-0.5 text-sm text-ts-text-secondary">
                    {primary.pickup_location.day_of_week
                      ? dayLong[primary.pickup_location.day_of_week] ?? primary.pickup_location.day_of_week
                      : 'Day TBD'}
                    {primary.pickup_location.time_start && primary.pickup_location.time_end && (
                      <>
                        {' '}·{' '}
                        <span class="tabular-nums">
                          {formatTimeRange(primary.pickup_location.time_start, primary.pickup_location.time_end)}
                        </span>
                      </>
                    )}
                  </p>
                  {primary.pickup_location.address && (
                    <p class="mt-0.5 text-sm text-ts-text-secondary">
                      {primary.pickup_location.address}
                      <br />
                      {`${[primary.pickup_location.city, primary.pickup_location.state].filter(Boolean).join(', ')} ${primary.pickup_location.zip ?? ''}`.trim()}
                    </p>
                  )}
                  {primary.pickup_location.address && (
                    <a
                      href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([primary.pickup_location.name, primary.pickup_location.address, primary.pickup_location.city, primary.pickup_location.state, primary.pickup_location.zip].filter(Boolean).join(', '))}`}
                      target="_blank"
                      rel="noopener"
                      class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-ts-primary underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
                    >
                      🧭 Get directions
                    </a>
                  )}
                </div>
              </div>
            ) : (
              <p class="mt-2 text-sm text-ts-text-muted">No pickup set yet — pick one below.</p>
            )}

            {/* Member-facing per-site pickup instructions for the current
                stop. Rendered only when present (else the day/time above is
                enough) and never for home delivery. */}
            {primary.pickup_location && currentInstructions && (
              <div class="mt-4 rounded-ts-lg border border-ts-primary/30 bg-ts-primary/5 px-4 py-3">
                <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-ts-primary">
                  <span aria-hidden="true">📋</span>
                  Pickup instructions
                </p>
                <p class="mt-1.5 whitespace-pre-line text-sm leading-relaxed text-ts-text">
                  {currentInstructions}
                </p>
              </div>
            )}

            {/* Your host + respect-your-host note (host'd pickup stops only —
                renders nothing when there's no host_name). Never for delivery
                (this branch is the non-delivery card). */}
            {primary.pickup_location && (
              <HostNote hostName={currentHostName} hostPhone={currentHostPhone} class="mt-4" />
            )}
          </Card>

          {/* ─── Choose a pickup stop ─── */}
          <Card padding="md" elevation="sm">
            <h2 class="text-base font-semibold text-ts-text">
              {primary.pickup_location ? 'Change your pickup stop' : 'Choose your pickup stop'}
            </h2>
            <form
              method="POST"
              action="/api/account/pickup-location"
              class="mt-4 flex flex-col gap-5"
              data-pickup-form
            >
              <input type="hidden" name="member_id" value={primary.id} />
              <FormRow
                label="Pickup at a stop"
                htmlFor="pickup_location_id"
                help="We'll switch your pickup starting next Wednesday. If your stop is full, we'll show an error."
              >
                <Select
                  id="pickup_location_id"
                  name="pickup_location_id"
                  value={primary.pickup_location_id ?? ''}
                  placeholder="Select a pickup location…"
                  options={locations.map((l) => ({ value: l.id, label: locationLabel(l) }))}
                  required
                />
              </FormRow>
              <p class="-mt-1 text-xs text-ts-text-muted">
                Heads up: changes take effect <span class="font-medium text-ts-text">next Wednesday</span>.
                This week's box is already in motion.
              </p>
              <div class="flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
                <Button href="/account" variant="secondary" size="md">Cancel</Button>
                <Button type="submit" variant="primary" size="md" data-submit-btn>
                  <span data-submit-label>Save pickup</span>
                </Button>
              </div>
            </form>
          </Card>

          {/* ─── Prefer home delivery? Request it ($15/wk, approval). ─── */}
          {hasPendingRequest ? (
            <Card padding="md" elevation="sm">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 text-lg" aria-hidden="true">⏳</span>
                <div class="min-w-0">
                  <h2 class="text-base font-semibold text-ts-text">Home delivery request received</h2>
                  <p class="mt-1 text-sm leading-relaxed text-ts-text-secondary">
                    We'll confirm your home delivery and the <span class="font-medium text-ts-text">$15/week</span> fee.
                    Until then, your pickup above stays as it is.
                  </p>
                  {pendingAddress && (
                    <p class="mt-2 text-sm text-ts-text-secondary">
                      <span class="font-medium text-ts-text">Requested address:</span>{' '}
                      <span class="whitespace-pre-line">{pendingAddress}</span>
                    </p>
                  )}
                  <p class="mt-3 text-xs text-ts-text-muted">
                    Need to update the request?{' '}
                    <a
                      href={contactChangeHref}
                      class="font-semibold text-ts-primary underline decoration-ts-primary/40 underline-offset-2 hover:decoration-ts-primary"
                    >Contact us</a>.
                  </p>
                </div>
              </div>
            </Card>
          ) : (
            <Card padding="md" elevation="sm">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 text-lg" aria-hidden="true">🏡</span>
                <div class="min-w-0 flex-1">
                  <h2 class="text-base font-semibold text-ts-text">
                    Home delivery — $15/week, subject to approval
                  </h2>
                  <p class="mt-1 text-sm leading-relaxed text-ts-text-secondary">
                    Prefer delivery to your door? Tell us your address and we'll review it.
                    Home delivery is <span class="font-medium text-ts-text">$15/week</span>, paid through
                    our store after we confirm you're in our delivery area. Submitting won't change
                    your pickup or charge you anything yet.
                  </p>
                </div>
              </div>

              <form
                method="POST"
                action="/api/account/request-delivery"
                class="mt-4 flex flex-col gap-4"
                data-request-form
              >
                <FormRow
                  label="Delivery address"
                  htmlFor="delivery_address"
                  help="Street, city, ZIP. We deliver Wednesdays between 11 AM and 4 PM."
                >
                  <textarea
                    id="delivery_address"
                    name="delivery_address"
                    rows="3"
                    minlength="8"
                    maxlength="500"
                    required
                    placeholder="123 Main St, Pittsburgh, PA 15206"
                    class="w-full resize-y rounded-ts-md border border-ts-border bg-ts-bg-base px-4 py-3 text-base text-ts-text placeholder:text-ts-text-muted shadow-inner transition-colors duration-150 focus:border-ts-primary focus:outline-none focus:ring-2 focus:ring-ts-primary/30"
                  ></textarea>
                </FormRow>
                <div class="flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-center sm:justify-end">
                  <Button type="submit" variant="secondary" size="md" data-request-btn>
                    <span data-request-label>Request home delivery</span>
                  </Button>
                </div>
              </form>
            </Card>
          )}
        </>
      )}
  <Fragment slot="overlays">
  <script>
    /**
     * Submit feedback for the two forms on this page:
     *   - the pickup-stop change form  → "Saving…"
     *   - the request-home-delivery form → "Sending…"
     * Pure progressive enhancement — both forms work without JS.
     */
    function wireSubmit(
      formSel: string,
      btnSel: string,
      labelSel: string,
      busyText: string
    ): void {
      const form = document.querySelector<HTMLFormElement>(formSel);
      const btn = document.querySelector<HTMLButtonElement>(btnSel);
      const label = document.querySelector<HTMLElement>(labelSel);
      if (!form || !btn || !label) return;
      form.addEventListener('submit', () => {
        // Let native validation run first; only show busy state on a valid form.
        if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;
        btn.disabled = true;
        label.textContent = busyText;
      });
    }

    wireSubmit('[data-pickup-form]', '[data-submit-btn]', '[data-submit-label]', 'Saving…');
    wireSubmit('[data-request-form]', '[data-request-btn]', '[data-request-label]', 'Sending…');
  </script>
  </Fragment>
</MemberShell>
