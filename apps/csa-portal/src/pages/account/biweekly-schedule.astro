---
/**
 * /account/biweekly-schedule — member picks Week A, Week B, or "no preference".
 *
 * Bi-weekly schedule explainer:
 *   - Week A = 1st & 3rd Wednesday of each month
 *   - Week B = 2nd & 4th Wednesday of each month
 *
 * The picker is a radio-card UI (matches /account/pickup's mode toggle).
 * A 3rd option lets the member defer the choice; admin will auto-assign
 * later via /api/admin/biweekly/auto-assign.
 *
 * If a customer has multiple live members (Summer Veg + Flower), the
 * POST handler updates ALL of them in one go — same schedule for the
 * household.
 *
 * Auth: middleware. RLS scopes member lookup.
 */
import MemberShell from '../../components/MemberShell.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import EmptyState from '../../components/EmptyState.astro';
import { BIWEEKLY_ERROR_COPY } from '../../lib/account';

const user = Astro.locals.user;
if (!user || !user.email) {
  return Astro.redirect('/login', 303);
}
const supabase = Astro.locals.supabase;

// ─── Pull live members ──────────────────────────────────────────────
// We use the FIRST live member as the source of truth for the
// currently-selected week. If a household has multiple shares we
// assume they're already in sync (the POST handler keeps them so);
// if they're somehow out of sync we surface a small notice.
type MemberRow = {
  id: string;
  share_type: string;
  status: string;
  biweekly_week: 'A' | 'B' | null;
};

const { data: memberRows, error: memberErr } = await supabase
  .from('members')
  .select('id, share_type, status, biweekly_week')
  .in('status', ['active', 'paused', 'onboarding'])
  .order('start_date', { ascending: false })
  .overrideTypes<MemberRow[], { merge: false }>();

if (memberErr) {
  console.error('[account/biweekly-schedule] member fetch failed:', memberErr.message);
}

const liveMembers = memberRows ?? [];
const primary = liveMembers[0] ?? null;

// Detect cross-member drift (rare, but possible after admin overrides).
const distinctWeeks = new Set(liveMembers.map((m) => m.biweekly_week));
const isMixed = distinctWeeks.size > 1;

const currentWeek: 'A' | 'B' | null = primary?.biweekly_week ?? null;

// ─── Flash ──────────────────────────────────────────────────────────
const errorParam = Astro.url.searchParams.get('error');
const okParam = Astro.url.searchParams.get('ok');
const errorMsg = errorParam
  ? BIWEEKLY_ERROR_COPY[errorParam] ?? BIWEEKLY_ERROR_COPY.invalid_input
  : null;
const okMsg = okParam === 'saved' ? 'Schedule saved. Your next box will follow this week.' : null;

// The radio-card initial UI state. We default to the current week if
// set, else 'unassigned' so the user can leave it for admin.
const initialChoice: 'A' | 'B' | 'unassigned' =
  currentWeek === 'A' ? 'A' :
  currentWeek === 'B' ? 'B' :
  'unassigned';

// ─── Static option metadata ─────────────────────────────────────────
const CHOICES: Array<{
  value: 'A' | 'B' | 'unassigned';
  label: string;
  schedule: string;
  hint: string;
  icon: string;
}> = [
  {
    value: 'A',
    label: 'Week A',
    schedule: '1st & 3rd Wednesdays',
    hint: 'You\'ll get a box on the first and third Wednesday of each month.',
    icon: '🗓',
  },
  {
    value: 'B',
    label: 'Week B',
    schedule: '2nd & 4th Wednesdays',
    hint: 'You\'ll get a box on the second and fourth Wednesday of each month.',
    icon: '🗓',
  },
  {
    value: 'unassigned',
    label: "I don't have a preference",
    schedule: 'Farm will choose',
    hint: 'We\'ll assign you a week that keeps your pickup location balanced.',
    icon: '🌱',
  },
];
---

<MemberShell
  title="Bi-weekly schedule — Tiny Seed Farm CSA"
  description="Choose whether you'd like to get your CSA box on Week A (1st & 3rd Wednesdays) or Week B (2nd & 4th Wednesdays)."
  canonical="https://csa.tinyseedfarm.com/account/biweekly-schedule"
  userEmail={user.email}
  active="account"
  back={{ href: "/account", label: "Account" }}
  mainClass="mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 py-8 sm:px-6 sm:py-12"
>
      <section aria-labelledby="biweekly-heading">
        <h1 id="biweekly-heading" class="font-display text-3xl font-bold tracking-tight text-ts-text sm:text-4xl">
          Bi-weekly schedule
        </h1>
        <p class="mt-2 text-base text-ts-text-secondary">
          Tiny Seed runs bi-weekly — you get a box every other Wednesday. Pick the
          rhythm that fits your kitchen.
        </p>
      </section>

      {!primary ? (
        <EmptyState title="No active share" icon="🌱" tone="default" dashed={false}>
          You'll be able to set your bi-weekly schedule once your CSA share is active.
          <Fragment slot="action">
            <Button href="/account" variant="secondary" size="md">Back to account</Button>
          </Fragment>
        </EmptyState>
      ) : (
        <>
          {/* CURRENT */}
          <Card padding="md" elevation="sm" tone="muted">
            <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">Current</p>
            <div class="mt-2 flex items-start gap-3">
              <span class="mt-0.5 text-lg" aria-hidden="true">🗓</span>
              <div class="min-w-0">
                {currentWeek === 'A' ? (
                  <>
                    <p class="text-sm font-medium text-ts-text">Week A</p>
                    <p class="mt-0.5 text-sm text-ts-text-secondary">
                      1st &amp; 3rd Wednesdays of each month
                    </p>
                  </>
                ) : currentWeek === 'B' ? (
                  <>
                    <p class="text-sm font-medium text-ts-text">Week B</p>
                    <p class="mt-0.5 text-sm text-ts-text-secondary">
                      2nd &amp; 4th Wednesdays of each month
                    </p>
                  </>
                ) : (
                  <>
                    <p class="text-sm font-medium text-ts-text">Not yet assigned</p>
                    <p class="mt-0.5 text-sm text-ts-text-secondary">
                      Pick a week below, or leave it to the farm.
                    </p>
                  </>
                )}
              </div>
            </div>
            {isMixed && (
              <p class="mt-3 rounded-ts-md border border-ts-warning/30 bg-ts-warning/5 px-3 py-2 text-xs leading-relaxed text-ts-warning">
                Your shares are currently on different weeks. Saving below
                will line them up.
              </p>
            )}
          </Card>

          {errorMsg && (
            <div
              role="alert"
              aria-live="polite"
              class="rounded-ts-lg border border-ts-danger/30 bg-ts-danger/5 px-4 py-3 text-sm leading-relaxed text-ts-danger"
            >
              {errorMsg}
            </div>
          )}
          {okMsg && (
            <div
              role="status"
              aria-live="polite"
              class="rounded-ts-lg border border-ts-primary/30 bg-ts-primary/5 px-4 py-3 text-sm leading-relaxed text-ts-primary"
            >
              {okMsg}
            </div>
          )}

          <form
            method="POST"
            action="/api/account/biweekly-schedule"
            class="flex flex-col gap-6"
            novalidate
            data-biweekly-form
          >
            <Card padding="md" elevation="sm">
              <fieldset class="m-0 border-0 p-0">
                <legend class="mb-3 text-sm font-semibold text-ts-text">Which week works for you?</legend>
                <div role="radiogroup" aria-label="Bi-weekly schedule" class="grid grid-cols-1 gap-2">
                  {CHOICES.map((c) => (
                    <label
                      class={[
                        'group relative flex cursor-pointer items-start gap-3 rounded-ts-md border p-4 transition-all duration-150',
                        initialChoice === c.value
                          ? 'border-ts-primary bg-ts-primary/5'
                          : 'border-ts-border bg-ts-bg-surface hover:border-ts-primary/40',
                      ].join(' ')}
                    >
                      <input
                        type="radio"
                        name="week"
                        value={c.value}
                        checked={initialChoice === c.value}
                        class="mt-1 h-4 w-4 shrink-0 accent-ts-primary"
                        data-choice-radio={c.value}
                        required
                      />
                      <span class="flex-1">
                        <span class="flex items-baseline justify-between gap-3">
                          <span class="block text-sm font-semibold text-ts-text">
                            <span class="mr-1" aria-hidden="true">{c.icon}</span>
                            {c.label}
                          </span>
                          <span class="shrink-0 text-xs font-medium text-ts-text-secondary">
                            {c.schedule}
                          </span>
                        </span>
                        <span class="mt-1 block text-xs leading-snug text-ts-text-muted">
                          {c.hint}
                        </span>
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </Card>

            {/* Informational details about what bi-weekly means */}
            <Card padding="md" elevation="sm" tone="muted">
              <p class="text-xs font-semibold uppercase tracking-wide text-ts-text-muted">
                What does this mean?
              </p>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ts-text-secondary">
                <li class="flex gap-2">
                  <span aria-hidden="true">·</span>
                  <span>
                    <strong class="font-medium text-ts-text">Week A members</strong>
                    {' '}get a box on the 1st and 3rd Wednesday of each month.
                  </span>
                </li>
                <li class="flex gap-2">
                  <span aria-hidden="true">·</span>
                  <span>
                    <strong class="font-medium text-ts-text">Week B members</strong>
                    {' '}get a box on the 2nd and 4th Wednesday of each month.
                  </span>
                </li>
                <li class="flex gap-2">
                  <span aria-hidden="true">·</span>
                  <span>
                    If you don't pick, we'll assign you a week that keeps your
                    pickup location balanced — you can change it any time.
                  </span>
                </li>
              </ul>
            </Card>

            <p class="-mt-2 text-xs text-ts-text-muted">
              Changes take effect <span class="font-medium text-ts-text">next Wednesday</span>.
              This week's box is already in motion.
            </p>

            <div class="flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
              <Button href="/account" variant="secondary" size="md">Cancel</Button>
              <Button type="submit" variant="primary" size="md" data-submit-btn>
                <span data-submit-label>Save schedule</span>
              </Button>
            </div>
          </form>
        </>
      )}
  <Fragment slot="overlays">
  <script>
    // Re-style the parent <label> when a radio is selected so the
    // visual highlight follows the user's pick. We already
    // server-rendered the initial selection — this just keeps the
    // highlight in sync as the user toggles.
    const radios = document.querySelectorAll<HTMLInputElement>('[data-choice-radio]');
    function reflectLabels(): void {
      radios.forEach((r) => {
        const parent = r.closest('label');
        if (!parent) return;
        if (r.checked) {
          parent.classList.add('border-ts-primary', 'bg-ts-primary/5');
          parent.classList.remove('border-ts-border', 'bg-ts-bg-surface');
        } else {
          parent.classList.remove('border-ts-primary', 'bg-ts-primary/5');
          parent.classList.add('border-ts-border', 'bg-ts-bg-surface');
        }
      });
    }
    radios.forEach((r) => r.addEventListener('change', reflectLabels));

    // Submit-state feedback.
    const form = document.querySelector<HTMLFormElement>('[data-biweekly-form]');
    const submitBtn = document.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const submitLabel = document.querySelector<HTMLElement>('[data-submit-label]');
    if (form && submitBtn && submitLabel) {
      form.addEventListener('submit', () => {
        submitBtn.disabled = true;
        submitLabel.textContent = 'Saving…';
      });
    }
  </script>
  </Fragment>
</MemberShell>
