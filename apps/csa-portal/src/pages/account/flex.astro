---
/**
 * /account/flex — Farm Flex wallet detail.
 *
 * Auth is enforced by middleware.ts (`/account` is a PROTECTED_PREFIX).
 * The defensive redirect below is belt-and-suspenders.
 *
 * Shows:
 *   - Total balance (big), with "Your funds" + Bonus 🎁 sub-breakdown.
 *     ("Your funds" is the member-facing label for the `principal` field;
 *      the field stays named principal in code — see lib/flex.ts.)
 *   - A short never-expires explainer.
 *   - Transaction history (newest first, up to 25) or a friendly empty
 *     state.
 *   - Add Funds top-up tiles (Phase 2a).
 *
 * NON-BLOCKING balance (2026-05-24, gap P0-1): the big balance card is the
 * <FlexWallet variant="detail"> island, which fetches the live Shopify
 * balance from /api/account/flex-balance AFTER first paint instead of
 * blocking SSR. Transaction history is a Supabase read and stays SSR. When
 * the island reports total <= 0 with no history, it reveals a calm "no
 * Farm Flex yet" state rather than a zeroed-out wallet (coordinated via the
 * `flex:resolved` event — see the inline script at the bottom).
 */
import MemberShell from '../../components/MemberShell.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import EmptyState from '../../components/EmptyState.astro';
import FlexWallet from '../../components/FlexWallet.astro';
import {
  getFlexTransactions,
  formatFlexMoney,
  isCreditType,
  flexBonusAmount,
  flexBonusRate,
  flexTopUpCartUrl,
  FLEX_TOPUP_VARIANTS,
  FLEX_TOPUP_PRODUCT_READY,
  FLEX_SHOPIFY_STORE_DEFAULT,
  type FlexTransaction,
} from '../../lib/flex';
import { SHOPIFY_STORE_NAME } from 'astro:env/server';

const user = Astro.locals.user;
if (!user || !user.email) {
  return Astro.redirect('/login', 303);
}

// Storefront subdomain for the cart permalinks. Prefer the runtime env
// (correct across environments); fall back to the known production store.
const shopifyStore = SHOPIFY_STORE_NAME || FLEX_SHOPIFY_STORE_DEFAULT;

// Precompute the Add-Funds tiles: principal, bonus dollars/rate, and the
// Shopify cart-permalink (null until the product's variant ids are wired).
const topUpTiles = FLEX_TOPUP_VARIANTS.map((tier) => ({
  amount: tier.amount,
  highlight: tier.highlight === true,
  bonus: flexBonusAmount(tier.amount),
  bonusPct: Math.round(flexBonusRate(tier.amount) * 100),
  cartUrl: flexTopUpCartUrl(tier, shopifyStore),
}));

// ─────────────────────────────────────────────────────────────────────
// The live BALANCE is loaded NON-BLOCKING (2026-05-24, gap P0-1): the
// <FlexWallet variant="detail"> island fetches /api/account/flex-balance
// after first paint instead of SSR-awaiting the Shopify call. Transaction
// HISTORY is a Supabase read (fast, no Shopify) so it stays SSR. The
// store is USD-only, so we format history + top-up tiles in USD (matches
// the value getFlexBalance always returned).
// ─────────────────────────────────────────────────────────────────────
const transactions: FlexTransaction[] = await getFlexTransactions(user.email);
const currency = 'USD';

// Whether to show the activity section at all (independent of the live
// balance — a member who spent down to $0 still has history to see).
const hasTransactions = transactions.length > 0;

// Pretty date for the history list: "May 21, 2026".
function prettyDate(iso: string): string {
  try {
    return new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(new Date(iso));
  } catch {
    return iso;
  }
}

// Human label for a transaction row when no reason is recorded.
const TYPE_FALLBACK_LABEL: Record<FlexTransaction['type'], string> = {
  credit: 'Credit added',
  debit: 'Spent',
  refund: 'Refund',
  transfer: 'Transfer',
  adjustment: 'Adjustment',
};
---

<MemberShell
  title="Farm Flex — Tiny Seed Farm CSA"
  description="Your Farm Flex balance: prepaid credit you can spend on extras and add-ons. Your balance never expires."
  canonical="https://csa.tinyseedfarm.com/account/flex"
  userEmail={user.email}
  active="account"
  back={{ href: "/account", label: "Account" }}
>
      {/* HEADER */}
      <section aria-labelledby="flex-heading">
        <div class="flex items-center gap-3">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ts-primary/15 text-2xl"
            aria-hidden="true"
          >
            🌿
          </span>
          <h1 id="flex-heading" class="font-display text-3xl font-bold tracking-tight text-ts-text sm:text-4xl">
            Farm Flex
          </h1>
        </div>
        <p class="mt-3 max-w-prose text-base leading-relaxed text-ts-text-secondary">
          Farm Flex is prepaid credit you can spend on extras and add-ons.
          Your balance never expires.
        </p>
      </section>

      {/* ═══════════════════════════════════════════════════════════════
          BALANCE — non-blocking island (2026-05-24, gap P0-1). Renders a
          loading shell immediately, fetches /api/account/flex-balance
          after first paint, then fills in total + "Your funds" + bonus.
          Self-hides (fail-soft) when total <= 0 / on error — and dispatches
          `flex:resolved` so the empty-state / activity blocks below can
          pick the right state once the real balance is known.
          ═══════════════════════════════════════════════════════════════ */}
      <FlexWallet variant="detail" />

      {/* ═══════════════════════════════════════════════════════════════
          ACTIVITY (transaction history) — Supabase read, SSR. Shown
          whenever there ARE transactions (independent of the live
          balance: a member who spent down to $0 still has history). When
          there are none, the "No activity yet" card is held hidden and
          revealed only if the resolved balance is > 0 (credit on Shopify
          with no flex_transactions row). If balance resolves to 0 with no
          history, the whole section stays hidden and the "No Farm Flex"
          state below shows instead.
          ═══════════════════════════════════════════════════════════════ */}
      {hasTransactions ? (
        <section aria-labelledby="history-heading" class="flex flex-col gap-3">
          <h2 id="history-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
            Activity
          </h2>
          <Card padding="none" elevation="sm" as="section">
            <ul role="list" class="divide-y divide-ts-border">
              {transactions.map((tx) => {
                const credit = isCreditType(tx.type);
                const label = tx.reason?.trim() || TYPE_FALLBACK_LABEL[tx.type];
                const sign = credit ? '+' : '−';
                const amountClass = credit ? 'text-ts-primary' : 'text-ts-text';
                return (
                  <li class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium text-ts-text">{label}</p>
                      <p class="mt-0.5 text-xs text-ts-text-muted">{prettyDate(tx.date)}</p>
                    </div>
                    <span class={`shrink-0 font-display text-base font-bold tabular-nums ${amountClass}`}>
                      {sign}{formatFlexMoney(Math.abs(tx.amount), currency)}
                    </span>
                  </li>
                );
              })}
            </ul>
          </Card>
        </section>
      ) : (
        <section
          aria-labelledby="history-heading"
          class="hidden flex-col gap-3"
          data-flex-activity-empty
        >
          <h2 id="history-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
            Activity
          </h2>
          <EmptyState
            title="No activity yet"
            icon="🧾"
            tone="default"
            dashed={true}
          >
            When you add funds or spend your Farm Flex, it'll show up here.
          </EmptyState>
        </section>
      )}

      {/* NO FLEX BALANCE — calm, non-erroring state. Hidden until the
          balance resolves to <= 0 AND there's no transaction history. */}
      {!hasTransactions && (
        <div class="hidden" data-flex-no-balance>
          <EmptyState
            title="No Farm Flex on file yet"
            icon="🌿"
            tone="primary"
            dashed={false}
          >
            You don't have a Farm Flex balance right now. Farm Flex lets you keep
            prepaid credit on hand for extras and add-ons — and it never expires.
            {FLEX_TOPUP_PRODUCT_READY
              ? ' Add funds below to get started — and earn a bonus while you do.'
              : " We'll be opening up Add Funds soon."}
            <Fragment slot="action">
              <Button href="/account" variant="secondary" size="md">
                Back to account
              </Button>
            </Fragment>
          </EmptyState>
        </div>
      )}

      {/* ═══════════════════════════════════════════════════════════════
          ADD FUNDS — Phase 2a (preset top-up tiles → Shopify checkout).
          Page-level (not gated on balance) so a member with $0 can start
          a wallet, and a member with a balance can top it up. Deep-link
          target #add-funds (the dashboard wallet "Add funds" CTA).
          ═══════════════════════════════════════════════════════════════ */}
      <section id="add-funds" aria-labelledby="add-funds-heading" class="scroll-mt-6 flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <h2 id="add-funds-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
            Add funds
          </h2>
          {!FLEX_TOPUP_PRODUCT_READY && (
            <Badge variant="amber" size="xs" uppercase>Coming soon</Badge>
          )}
        </div>

        {FLEX_TOPUP_PRODUCT_READY ? (
          <Card padding="lg" elevation="sm" as="div">
            <p class="max-w-prose text-sm leading-relaxed text-ts-text-secondary">
              Preload your wallet and earn a loyalty bonus on top — the more
              you add, the bigger the thank-you. Pick an amount to check out
              on our farm store.
            </p>

            {/* TILES */}
            <ul role="list" class="mt-5 grid grid-cols-2 gap-3 sm:gap-4">
              {topUpTiles.map((tile) => (
                <li>
                  <a
                    href={tile.cartUrl ?? '#'}
                    class:list={[
                      'group relative flex h-full flex-col items-center justify-center gap-1 rounded-ts-xl border p-5 text-center transition-all duration-200 ease-[var(--ease-ts)]',
                      'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary',
                      'hover:-translate-y-0.5 hover:shadow-ts-md active:scale-[0.98]',
                      '[touch-action:manipulation] min-h-[7.5rem]',
                      tile.highlight
                        ? 'border-ts-primary bg-ts-primary/5 hover:border-ts-primary'
                        : 'border-ts-border bg-ts-bg-surface hover:border-ts-primary/40',
                    ]}
                    aria-label={`Add ${formatFlexMoney(tile.amount, currency)} — earn a ${formatFlexMoney(tile.bonus, currency)} bonus`}
                  >
                    {tile.highlight && (
                      <span class="absolute -top-2.5 left-1/2 -translate-x-1/2">
                        <Badge variant="green" size="xs" uppercase>Most popular</Badge>
                      </span>
                    )}
                    <span class="font-display text-3xl font-bold tabular-nums tracking-tight text-ts-text">
                      {formatFlexMoney(tile.amount, currency)}
                    </span>
                    <span class="text-sm font-medium text-ts-primary">
                      <span aria-hidden="true">🎁</span> +{formatFlexMoney(tile.bonus, currency)} bonus
                    </span>
                    <span class="text-xs text-ts-text-muted">
                      {tile.bonusPct}% back · wallet gets {formatFlexMoney(tile.amount + tile.bonus, currency)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>

            <p class="mt-5 flex items-start gap-2 text-xs leading-relaxed text-ts-text-muted">
              <span aria-hidden="true" class="mt-px">⏳</span>
              <span>
                Funds (plus your bonus) land in your wallet within ~15 minutes
                of checkout. You'll complete payment on our farm store — sign in
                with the same email so your credit lands here.
              </span>
            </p>
          </Card>
        ) : (
          /* Product not yet created in Shopify — calm placeholder. */
          <Card padding="md" elevation="sm" as="div">
            <p class="max-w-prose text-sm leading-relaxed text-ts-text-secondary">
              Top up your Farm Flex and earn a loyalty bonus — under $250 adds
              5%, $250+ adds 10%, and $500+ adds 12%. We're putting the
              finishing touches on checkout — check back soon.
            </p>
          </Card>
        )}
      </section>

      {/* FOOTER */}

  {/* ─────────────────────────────────────────────────────────────────
      Resolve the deferred empty states once the FlexWallet island reports
      the real balance via the `flex:resolved` CustomEvent. Only runs the
      no-history branch (when there ARE transactions, the Activity list is
      SSR'd and neither hidden block exists). CSP allows inline scripts
      (script-src 'unsafe-inline'), so define:vars is fine here.
      ───────────────────────────────────────────────────────────────── */}
  {!hasTransactions && (
    <script is:inline define:vars={{ hasTransactions }}>
      (function () {
        var activityEmpty = document.querySelector('[data-flex-activity-empty]');
        var noBalance = document.querySelector('[data-flex-no-balance]');
        var done = false;
        function onResolved(e) {
          if (done) return;
          done = true;
          var total = e && e.detail ? Number(e.detail.total) : 0;
          // No transactions on file:
          //   balance > 0  → credit exists with no recorded activity → "No activity yet"
          //   balance <= 0 → genuinely no wallet → "No Farm Flex on file yet"
          if (total > 0) {
            if (activityEmpty) {
              activityEmpty.classList.remove('hidden');
              activityEmpty.classList.add('flex');
            }
          } else {
            if (noBalance) noBalance.classList.remove('hidden');
          }
        }
        document.addEventListener('flex:resolved', onResolved, { once: true });
      })();
    </script>
  )}
</MemberShell>
