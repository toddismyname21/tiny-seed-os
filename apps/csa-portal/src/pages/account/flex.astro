---
/**
 * /account/flex — Farm Flex wallet detail (Phase 1, read-only).
 *
 * Auth is enforced by middleware.ts (`/account` is a PROTECTED_PREFIX).
 * The defensive redirect below is belt-and-suspenders.
 *
 * Shows:
 *   - Total balance (big), with "Your funds" + Bonus 🎁 sub-breakdown.
 *     ("Your funds" is the member-facing label for the `principal` field;
 *      the field stays named principal in code — see lib/flex.ts.)
 *   - A short never-expires explainer.
 *   - Transaction history (newest first, up to 25) or a friendly empty
 *     state.
 *   - A disabled "Add Funds" placeholder — Phase 2a wires it up.
 *
 * If the member has no flex balance at all (getFlexBalance → null), we
 * still render the page (they reached it intentionally) but show a calm
 * "no Farm Flex yet" state rather than a zeroed-out wallet.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import EmptyState from '../../components/EmptyState.astro';
import {
  getFlexBalance,
  getFlexTransactions,
  formatFlexMoney,
  isCreditType,
  type FlexBalance,
  type FlexTransaction,
} from '../../lib/flex';

const user = Astro.locals.user;
if (!user || !user.email) {
  return Astro.redirect('/login', 303);
}

// Read-only data. Both fail-soft (null / []), so the page never errors out.
const balance: FlexBalance | null = await getFlexBalance(user.email);
const transactions: FlexTransaction[] = await getFlexTransactions(user.email);

const hasBalance = balance != null && balance.total > 0;
const currency = balance?.currency ?? 'USD';

// Pretty date for the history list: "May 21, 2026".
function prettyDate(iso: string): string {
  try {
    return new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(new Date(iso));
  } catch {
    return iso;
  }
}

// Human label for a transaction row when no reason is recorded.
const TYPE_FALLBACK_LABEL: Record<FlexTransaction['type'], string> = {
  credit: 'Credit added',
  debit: 'Spent',
  refund: 'Refund',
  transfer: 'Transfer',
  adjustment: 'Adjustment',
};
---

<BaseLayout
  title="Farm Flex — Tiny Seed Farm CSA"
  description="Your Farm Flex balance: prepaid credit you can spend on extras and add-ons. Your balance never expires."
  canonical="https://csa.tinyseedfarm.com/account/flex"
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-ts-md focus:bg-ts-primary focus:px-4 focus:py-2 focus:text-white focus:shadow-ts-md"
  >
    Skip to main content
  </a>

  <div class="min-h-screen bg-ts-bg-base">
    {/* TOP BAR */}
    <header class="border-b border-ts-border bg-ts-bg-surface/80 backdrop-blur-sm">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-4 sm:px-6 sm:py-5">
        <a
          href="/dashboard"
          class="flex items-center gap-2 rounded-ts-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ts-primary"
          aria-label="Tiny Seed Farm CSA dashboard home"
        >
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-ts-primary" aria-hidden="true"></span>
          <span class="font-display text-lg font-bold tracking-tight text-ts-text">Tiny Seed Farm</span>
        </a>

        <form method="POST" action="/logout" class="m-0">
          <button
            type="submit"
            class="rounded-ts-md px-3 py-2 text-sm font-medium text-ts-text-secondary transition-colors duration-150 hover:bg-ts-bg-muted hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            Sign out
          </button>
        </form>
      </div>
    </header>

    <main
      id="main"
      class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 py-8 sm:gap-8 sm:px-6 sm:py-12"
    >
      {/* BREADCRUMB / BACK */}
      <nav aria-label="Breadcrumb" class="text-sm">
        <a
          href="/account"
          class="inline-flex items-center gap-1 text-ts-text-secondary transition-colors hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          <span aria-hidden="true">←</span>
          <span>Account</span>
        </a>
      </nav>

      {/* HEADER */}
      <section aria-labelledby="flex-heading">
        <div class="flex items-center gap-3">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ts-primary/15 text-2xl"
            aria-hidden="true"
          >
            🌿
          </span>
          <h1 id="flex-heading" class="font-display text-3xl font-bold tracking-tight text-ts-text sm:text-4xl">
            Farm Flex
          </h1>
        </div>
        <p class="mt-3 max-w-prose text-base leading-relaxed text-ts-text-secondary">
          Farm Flex is prepaid credit you can spend on extras and add-ons.
          Your balance never expires.
        </p>
      </section>

      {hasBalance && balance ? (
        <>
          {/* BALANCE BREAKDOWN */}
          <Card tone="primary" padding="lg" elevation="md" as="section">
            <p class="text-sm font-semibold uppercase tracking-wide text-ts-primary">
              Available balance
            </p>
            <p class="mt-1 font-display text-5xl font-bold tabular-nums tracking-tight text-ts-text sm:text-6xl">
              {formatFlexMoney(balance.total, currency)}
            </p>

            {/* "Your funds" (principal) + Bonus sub-breakdown */}
            <dl class="mt-6 grid grid-cols-1 gap-px overflow-hidden rounded-ts-lg border border-ts-border bg-ts-border sm:grid-cols-2">
              <div class="bg-ts-bg-surface p-4">
                <dt class="text-xs font-medium uppercase tracking-wide text-ts-text-muted">
                  Your funds
                </dt>
                <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-ts-text">
                  {formatFlexMoney(balance.principal, currency)}
                </dd>
                <p class="mt-1 text-xs text-ts-text-muted">Never expires</p>
              </div>
              <div class="bg-ts-bg-surface p-4">
                <dt class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-ts-text-muted">
                  <span>Loyalty bonus</span>
                  <span aria-hidden="true">🎁</span>
                </dt>
                <dd class="mt-1 font-display text-2xl font-bold tabular-nums text-ts-primary">
                  {formatFlexMoney(balance.bonus, currency)}
                </dd>
                <p class="mt-1 text-xs text-ts-text-muted">
                  {balance.bonus > 0 ? 'A thank-you from Tiny Seed' : 'Earn bonuses when you add funds'}
                </p>
              </div>
            </dl>
          </Card>

          {/* TRANSACTION HISTORY */}
          <section aria-labelledby="history-heading" class="flex flex-col gap-3">
            <h2 id="history-heading" class="font-display text-xl font-bold text-ts-text sm:text-2xl">
              Activity
            </h2>

            {transactions.length > 0 ? (
              <Card padding="none" elevation="sm" as="section">
                <ul role="list" class="divide-y divide-ts-border">
                  {transactions.map((tx) => {
                    const credit = isCreditType(tx.type);
                    const label = tx.reason?.trim() || TYPE_FALLBACK_LABEL[tx.type];
                    const sign = credit ? '+' : '−';
                    const amountClass = credit ? 'text-ts-primary' : 'text-ts-text';
                    return (
                      <li class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
                        <div class="min-w-0">
                          <p class="truncate text-sm font-medium text-ts-text">{label}</p>
                          <p class="mt-0.5 text-xs text-ts-text-muted">{prettyDate(tx.date)}</p>
                        </div>
                        <span class={`shrink-0 font-display text-base font-bold tabular-nums ${amountClass}`}>
                          {sign}{formatFlexMoney(Math.abs(tx.amount), currency)}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </Card>
            ) : (
              <EmptyState
                title="No activity yet"
                icon="🧾"
                tone="default"
                dashed={true}
              >
                When you add funds or spend your Farm Flex, it'll show up here.
              </EmptyState>
            )}
          </section>

          {/* ADD FUNDS (coming soon — Phase 2a) */}
          <Card padding="md" elevation="sm" as="section">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h2 class="font-display text-lg font-semibold text-ts-text">Add funds</h2>
                  <Badge variant="amber" size="xs" uppercase>Coming soon</Badge>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-ts-text-secondary">
                  Top up your Farm Flex and earn a loyalty bonus. We're putting
                  the finishing touches on this — check back soon.
                </p>
              </div>
              <div class="shrink-0">
                <Button variant="primary" size="md" disabled>
                  Add funds
                </Button>
              </div>
            </div>
          </Card>
        </>
      ) : (
        /* NO FLEX BALANCE — calm, non-erroring state */
        <EmptyState
          title="No Farm Flex on file yet"
          icon="🌿"
          tone="primary"
          dashed={false}
        >
          You don't have a Farm Flex balance right now. Farm Flex lets you keep
          prepaid credit on hand for extras and add-ons — and it never expires.
          We'll be opening up Add Funds soon.
          <Fragment slot="action">
            <Button href="/account" variant="secondary" size="md">
              Back to account
            </Button>
          </Fragment>
        </EmptyState>
      )}

      {/* FOOTER */}
      <footer class="mt-auto border-t border-ts-border pt-6 text-center text-xs text-ts-text-muted">
        <p>Signed in as <span class="font-medium text-ts-text-secondary">{user.email}</span></p>
        <p class="mt-1">Tiny Seed Farm · 257 Zeigler Rd, Rochester, PA · Certified Organic</p>
      </footer>
    </main>
  </div>
</BaseLayout>
