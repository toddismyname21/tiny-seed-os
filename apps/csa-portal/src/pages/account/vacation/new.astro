---
/**
 * /account/vacation/new — schedule a new vacation hold.
 *
 * Single-form page. Validates client-side via the native date input
 * `min` attribute + a small live-preview of weeks-to-be-used. Server
 * is the source of truth.
 *
 * Auth: middleware. RLS scopes member lookup to the user's own rows.
 */
import MemberShell from '../../../components/MemberShell.astro';
import Button from '../../../components/Button.astro';
import Card from '../../../components/Card.astro';
import EmptyState from '../../../components/EmptyState.astro';
import DateRangePicker from '../../../components/DateRangePicker.astro';
import FormRow from '../../../components/FormRow.astro';
import ContactFarm from '../../../components/ContactFarm.astro';
import Select from '../../../components/Select.astro';
import { todayET, VACATION_ERROR_COPY } from '../../../lib/account';
import { validMoveTargetWeeksForShare, mondayOfWeek, addDays } from '../../../lib/cycle';
import { prettyDeliveryLong, resolveMemberSchedule, memberIsBiweekly } from '../../../lib/schedule';
import { getSchedule } from '../../../lib/season';

const user = Astro.locals.user;
if (!user || !user.email) {
  return Astro.redirect('/login', 303);
}
const supabase = Astro.locals.supabase;

// ─── Member context ─────────────────────────────────────────────────
type MemberRow = {
  id: string;
  share_type: string;
  total_weeks: number;
  vacation_weeks_used: number;
  biweekly_week: 'A' | 'B' | null;
  status: string;
};

const { data: memberRows, error: memberErr } = await supabase
  .from('members')
  .select('id, share_type, total_weeks, vacation_weeks_used, biweekly_week, status')
  .in('status', ['active', 'paused', 'onboarding'])
  .order('start_date', { ascending: false })
  .overrideTypes<MemberRow[], { merge: false }>();

if (memberErr) {
  console.error('[account/vacation/new] member fetch failed:', memberErr.message);
}

const members = memberRows ?? [];
const primary = members[0] ?? null;
const totalAvailable = primary != null
  ? Math.max(0, primary.total_weeks - primary.vacation_weeks_used)
  : 0;

// ─── Preserve form state on validation errors ────────────────────────
const errorParam = Astro.url.searchParams.get('error');
const presetStart = Astro.url.searchParams.get('start_date') ?? '';
const presetEnd = Astro.url.searchParams.get('end_date') ?? '';
const presetReason = Astro.url.searchParams.get('reason') ?? '';
const presetDisposition = (() => {
  const d = Astro.url.searchParams.get('disposition');
  return d === 'move' || d === 'donate' ? d : 'skip';
})();
const presetMoveToWeek = Astro.url.searchParams.get('move_to_week') ?? '';

// ─── Valid move-target weeks (migration 0041) ────────────────────────
// Future in-season delivery weeks the member may MOVE a held box onto.
// Server-resolved by share_type so a hand-crafted POST can't smuggle a
// bogus week. The dropdown SUBMITS the Monday (week_starting) but LABELS
// the Wednesday delivery date the member recognises.
const moveTargets = primary
  ? validMoveTargetWeeksForShare(primary.share_type)
  : [];
const moveTargetOptions = moveTargets.map((t) => ({
  value: t.week_starting,
  label: `Week ${t.week_number} — ${prettyDeliveryLong(t.delivery_date)}`,
}));
const canMove = moveTargetOptions.length > 0;

// ─── Delivery weeks for the live preview (matches the RPC accounting) ────
// The live "this hold will use N weeks" preview must count the member's
// ACTUAL delivery weeks the range overlaps — season + biweekly-parity aware —
// identical to vacationWeeksUsed / the schedule_vacation_hold RPC. We project
// the member's delivery dates server-side (so a hand-crafted client can't
// inflate the budget; the server re-validates regardless) and ship each
// delivery's Monday→Sunday window to the script. The browser then counts
// windows the picked range overlaps. Empty for shares with no season (flex /
// add_on) → the preview shows 0 weeks, matching the RPC.
const previewSchedule = primary ? getSchedule(primary.share_type) : null;
const deliveryWeeks: Array<{ monday: string; sunday: string }> = (() => {
  if (!primary || !previewSchedule) return [];
  const biweekly = memberIsBiweekly({
    biweeklyWeek: primary.biweekly_week,
    totalWeeks: primary.total_weeks,
    schedule: previewSchedule,
  });
  const resolved = resolveMemberSchedule({
    schedule: previewSchedule,
    biweeklyWeek: biweekly ? (primary.biweekly_week ?? 'A') : null,
  });
  return resolved.allDeliveries.map((d) => {
    const monday = mondayOfWeek(d);
    return { monday, sunday: addDays(monday, 6) };
  });
})();

// Surface server error inline. The DateRangePicker lights up red on the
// relevant field if the error is about dates; otherwise we show a
// banner above the form.
const dateErrorCodes = new Set([
  'start_date_in_past',
  'invalid_date_range',
  'overlapping_hold',
  'insufficient_vacation_weeks',
]);

const startError =
  errorParam === 'start_date_in_past'
    ? VACATION_ERROR_COPY.start_date_in_past
    : null;
const endError =
  errorParam === 'invalid_date_range'
    ? VACATION_ERROR_COPY.invalid_date_range
    : null;

const bannerError =
  errorParam && !dateErrorCodes.has(errorParam)
    ? VACATION_ERROR_COPY[errorParam] ?? VACATION_ERROR_COPY.invalid_input
    : errorParam === 'overlapping_hold' || errorParam === 'insufficient_vacation_weeks'
      ? VACATION_ERROR_COPY[errorParam]
      : null;

const today = todayET();
const SHARE_TYPE_LABELS: Record<string, string> = {
  spring_veg: 'Spring Vegetable Share',
  summer_veg: 'Summer Vegetable Share',
  fall_veg: 'Fall Vegetable Share',
  flower: 'Flower Share',
  flex: 'Flex Share',
  add_on: 'Add-On',
  wholesale_csa: 'Wholesale CSA',
};
---

<MemberShell
  title="Schedule a vacation hold — Tiny Seed Farm CSA"
  description="Pause your CSA box while you're away."
  canonical="https://csa.tinyseedfarm.com/account/vacation/new"
  userEmail={user.email}
  active="account"
  back={{ href: "/account", label: "Account" }}
  mainClass="mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 py-8 sm:px-6 sm:py-12"
>
      <section aria-labelledby="new-heading">
        <h1 id="new-heading" class="font-display text-3xl font-bold tracking-tight text-ts-text sm:text-4xl">
          Schedule a vacation hold
        </h1>
        <p class="mt-2 text-base text-ts-text-secondary">
          We'll skip your box during these dates. Your weeks roll over to extend the season.
        </p>
      </section>

      {!primary ? (
        <EmptyState title="No active share" icon="🌱" tone="default" dashed={false}>
          You'll be able to schedule a vacation hold once your CSA share is active.
          <Fragment slot="action">
            <Button href="/account" variant="secondary" size="md">Back to account</Button>
          </Fragment>
        </EmptyState>
      ) : totalAvailable === 0 ? (
        <>
          <EmptyState title="No vacation weeks left this season" icon="🏖️" tone="warning" dashed={false}>
            You've used all {primary.total_weeks} of your vacation weeks. If you need to make a change, please email us.
            <Fragment slot="action">
              <Button href="/account/vacation" variant="secondary" size="md">Back</Button>
            </Fragment>
          </EmptyState>
          <ContactFarm
            label="Email Todd about your vacation holds"
            subject="Vacation hold question"
          />
        </>
      ) : (
        <>
          {/* CONTEXT */}
          <Card padding="md" elevation="sm" tone="muted">
            <p class="text-sm text-ts-text">
              <span class="font-semibold">{SHARE_TYPE_LABELS[primary.share_type] ?? primary.share_type}</span>
              {' '}—{' '}
              <span class="tabular-nums">{totalAvailable}</span> {totalAvailable === 1 ? 'week' : 'weeks'} available
              <span class="text-ts-text-muted">{' '}of {primary.total_weeks}</span>
            </p>
          </Card>

          {bannerError && (
            <div
              role="alert"
              aria-live="polite"
              class="rounded-ts-lg border border-ts-danger/30 bg-ts-danger/5 px-4 py-3 text-sm leading-relaxed text-ts-danger"
            >
              {bannerError}
            </div>
          )}

          <form
            method="POST"
            action="/api/account/vacation/schedule"
            class="flex flex-col gap-6"
            novalidate
            data-vacation-form
          >
            <input type="hidden" name="member_id" value={primary.id} />

            <Card padding="md" elevation="sm">
              <fieldset class="m-0 border-0 p-0">
                <legend class="mb-3 text-sm font-semibold text-ts-text">Dates</legend>
                <DateRangePicker
                  startName="start_date"
                  endName="end_date"
                  startId="start_date"
                  endId="end_date"
                  startValue={presetStart || null}
                  endValue={presetEnd || null}
                  minDate={today}
                  required
                  startError={startError}
                  endError={endError}
                />
                <p class="mt-3 text-xs text-ts-text-muted">
                  Earliest start: <span class="tabular-nums">{today}</span> (no retroactive holds).
                </p>
              </fieldset>

              {/* LIVE PREVIEW */}
              <div
                class="mt-5 rounded-ts-md border border-dashed border-ts-border bg-ts-bg-muted/50 p-4 text-sm"
                data-preview
                aria-live="polite"
              >
                <p class="text-ts-text-secondary">
                  <span class="font-medium text-ts-text">Pick your dates</span> to see how many weeks this hold will use.
                </p>
              </div>
            </Card>

            {/* DISPOSITION PICKER (migration 0041) ─────────────────── */}
            <Card padding="md" elevation="sm">
              <fieldset class="m-0 border-0 p-0" data-disposition-group>
                <legend class="mb-1 text-sm font-semibold text-ts-text">What should happen to those boxes?</legend>
                <p class="mb-3 text-xs text-ts-text-muted">
                  Choose one. You can always change it before the hold starts.
                </p>

                <div class="flex flex-col gap-2.5">
                  {/* SKIP */}
                  <label class="flex cursor-pointer items-start gap-3 rounded-ts-md border border-ts-border bg-ts-bg-base p-4 transition-colors duration-150 hover:border-ts-primary/40 has-[:checked]:border-ts-primary has-[:checked]:bg-ts-primary/5 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ts-primary/30">
                    <input
                      type="radio"
                      name="disposition"
                      value="skip"
                      checked={presetDisposition === 'skip'}
                      class="mt-0.5 h-4 w-4 shrink-0 accent-ts-primary"
                      data-disposition-radio
                    />
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-ts-text">Skip these weeks</span>
                      <span class="mt-0.5 block text-xs leading-relaxed text-ts-text-secondary">
                        We just won't pack a box. Your unused weeks roll over to extend your season.
                      </span>
                    </span>
                  </label>

                  {/* MOVE */}
                  <label class={[
                    'flex items-start gap-3 rounded-ts-md border border-ts-border bg-ts-bg-base p-4 transition-colors duration-150',
                    canMove
                      ? 'cursor-pointer hover:border-ts-primary/40 has-[:checked]:border-ts-primary has-[:checked]:bg-ts-primary/5 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ts-primary/30'
                      : 'cursor-not-allowed opacity-60',
                  ].join(' ')}>
                    <input
                      type="radio"
                      name="disposition"
                      value="move"
                      checked={canMove && presetDisposition === 'move'}
                      disabled={!canMove}
                      class="mt-0.5 h-4 w-4 shrink-0 accent-ts-primary"
                      data-disposition-radio
                    />
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-semibold text-ts-text">Move to another week</span>
                      <span class="mt-0.5 block text-xs leading-relaxed text-ts-text-secondary">
                        {canMove
                          ? "Get that box on a different week instead — pick the week below."
                          : "No upcoming delivery weeks are available to move to right now."}
                      </span>

                      {canMove && (
                        <div class="mt-3" data-move-week-wrap hidden={presetDisposition !== 'move'}>
                          <label for="move_to_week" class="mb-1.5 block text-xs font-medium text-ts-text">
                            Deliver my box on:
                          </label>
                          <Select
                            id="move_to_week"
                            name="move_to_week"
                            value={presetDisposition === 'move' ? (presetMoveToWeek || null) : null}
                            placeholder="Choose a week…"
                            options={moveTargetOptions}
                            ariaDescribedBy="move-week-help"
                          />
                          <p id="move-week-help" class="mt-1.5 text-xs text-ts-text-muted">
                            Only upcoming in-season weeks are listed.
                          </p>
                        </div>
                      )}
                    </span>
                  </label>

                  {/* DONATE */}
                  <label class="flex cursor-pointer items-start gap-3 rounded-ts-md border border-ts-border bg-ts-bg-base p-4 transition-colors duration-150 hover:border-ts-primary/40 has-[:checked]:border-ts-primary has-[:checked]:bg-ts-primary/5 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ts-primary/30">
                    <input
                      type="radio"
                      name="disposition"
                      value="donate"
                      checked={presetDisposition === 'donate'}
                      class="mt-0.5 h-4 w-4 shrink-0 accent-ts-primary"
                      data-disposition-radio
                    />
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold text-ts-text">Donate these boxes 💚</span>
                      <span class="mt-0.5 block text-xs leading-relaxed text-ts-text-secondary">
                        We'll pack your box and give it to a family in need. Your weeks are still used.
                      </span>
                    </span>
                  </label>
                </div>
              </fieldset>
            </Card>

            <Card padding="md" elevation="sm">
              <FormRow
                label="Reason"
                htmlFor="reason"
                help="Optional. Helps us if there's an issue with your delivery."
              >
                <textarea
                  id="reason"
                  name="reason"
                  rows="3"
                  maxlength="500"
                  class="w-full resize-y rounded-ts-md border border-ts-border bg-ts-bg-base px-4 py-3 text-base text-ts-text placeholder:text-ts-text-muted shadow-inner transition-colors duration-150 focus:border-ts-primary focus:outline-none focus:ring-2 focus:ring-ts-primary/30"
                  placeholder="e.g. Italy trip, July 8 to 22"
                >{presetReason}</textarea>
              </FormRow>
            </Card>

            <div class="flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
              <Button href="/account/vacation" variant="secondary" size="md">
                Cancel
              </Button>
              <Button type="submit" variant="primary" size="md" data-submit-btn>
                <span data-submit-label>Schedule hold</span>
                <span aria-hidden="true">→</span>
              </Button>
            </div>
          </form>
        </>
      )}
  <Fragment slot="overlays">
  <script define:vars={{ totalAvailable, today, deliveryWeeks }}>
    /**
     * Live preview: as the user picks dates, show "This hold will use
     * N of your X weeks". Falls back gracefully on no-JS — server
     * still validates (and re-counts authoritatively in the RPC).
     */
    const startEl = document.getElementById('start_date');
    const endEl = document.getElementById('end_date');
    const previewEl = document.querySelector('[data-preview]');
    const submitBtn = document.querySelector('[data-submit-btn]');

    function weeksInRange(start, end) {
      // Count the member's ACTUAL delivery weeks the inclusive range overlaps
      // — season + biweekly-parity aware — mirroring vacationWeeksUsed and the
      // schedule_vacation_hold RPC. `deliveryWeeks` is the member's projected
      // delivery weeks (each a Monday→Sunday window); a delivery week counts
      // when its window overlaps [start, end]. Lexicographic ISO-date compare.
      if (end < start) return 0;
      let n = 0;
      for (const w of deliveryWeeks) {
        if (w.monday <= end && w.sunday >= start) n += 1;
      }
      return n;
    }

    function update() {
      if (!startEl || !endEl || !previewEl || !submitBtn) return;
      const s = startEl.value;
      const e = endEl.value;
      if (!s || !e) {
        previewEl.innerHTML = '<p class="text-ts-text-secondary"><span class="font-medium text-ts-text">Pick your dates</span> to see how many weeks this hold will use.</p>';
        submitBtn.disabled = false;
        return;
      }
      if (e < s) {
        previewEl.innerHTML = '<p class="text-ts-danger">End date must be after the start date.</p>';
        submitBtn.disabled = true;
        return;
      }
      if (s < today) {
        previewEl.innerHTML = '<p class="text-ts-danger">Start date can\'t be in the past.</p>';
        submitBtn.disabled = true;
        return;
      }
      const n = weeksInRange(s, e);
      const overBudget = n > totalAvailable;
      const noun = n === 1 ? 'week' : 'weeks';
      if (overBudget) {
        previewEl.innerHTML =
          '<p class="text-ts-danger">This hold needs <span class="font-semibold tabular-nums">' + n + '</span> ' + noun +
          ' but you only have <span class="font-semibold tabular-nums">' + totalAvailable +
          '</span> available this season.</p>';
        submitBtn.disabled = true;
      } else {
        previewEl.innerHTML =
          '<p class="text-ts-text"><span class="font-semibold tabular-nums">' + n + '</span> ' + noun +
          ' will be used. <span class="text-ts-text-muted">You\'ll have <span class="tabular-nums">' +
          (totalAvailable - n) + '</span> remaining.</span></p>';
        submitBtn.disabled = false;
      }
    }

    if (startEl && endEl) {
      startEl.addEventListener('change', update);
      endEl.addEventListener('change', update);
      // If we got pre-filled values from a server redirect, preview now.
      update();
    }

    // ─── Disposition picker: reveal the move-week dropdown only when
    //     "Move to another week" is selected; require it then; clear +
    //     disable it otherwise so a stale value is never submitted. ──────
    const dispositionRadios = document.querySelectorAll('[data-disposition-radio]');
    const moveWrap = document.querySelector('[data-move-week-wrap]');
    const moveSelect = document.getElementById('move_to_week');

    function syncDisposition() {
      const checked = document.querySelector('[data-disposition-radio]:checked');
      const value = checked ? checked.value : 'skip';
      const isMove = value === 'move';
      if (moveWrap) moveWrap.hidden = !isMove;
      if (moveSelect) {
        moveSelect.required = isMove;
        moveSelect.disabled = !isMove;
        if (!isMove) moveSelect.value = '';
      }
    }

    if (dispositionRadios.length > 0) {
      dispositionRadios.forEach((r) => r.addEventListener('change', syncDisposition));
      syncDisposition();
    }

    // Submit feedback. Guard: if "move" is selected but no week chosen,
    // block submit and surface the native required message.
    const form = document.querySelector('[data-vacation-form]');
    const submitLabel = document.querySelector('[data-submit-label]');
    if (form && submitBtn && submitLabel) {
      form.addEventListener('submit', (ev) => {
        const checked = document.querySelector('[data-disposition-radio]:checked');
        if (checked && checked.value === 'move' && moveSelect && !moveSelect.value) {
          ev.preventDefault();
          moveSelect.reportValidity?.();
          return;
        }
        submitBtn.disabled = true;
        submitLabel.textContent = 'Scheduling…';
      });
    }
  </script>
  </Fragment>
</MemberShell>
