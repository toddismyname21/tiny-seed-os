---
/**
 * /terms — standalone SMS terms & conditions (dedicated URL for A2P/TCR
 * review; anchor links were rejected twice, error 30882). PUBLIC.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SMS Terms & Conditions — Tiny Seed Farm">
  <main class="mx-auto max-w-2xl px-4 py-10">
    <h1 class="text-2xl font-bold text-ts-text">Tiny Seed Farm — SMS Terms &amp; Conditions</h1>
    <section class="mt-6 space-y-4 text-[15px] leading-7 text-ts-text">
      <p><strong>Program:</strong> Tiny Seed Farm Notifications — recurring informational
        messages (delivery updates, pickup reminders, ordering notifications, occasional farm
        announcements, and login verification codes) for CSA members and wholesale customers
        who opt in.</p>
      <p><strong>Opt-in:</strong> by checking the unchecked "Text messages (SMS)" option in the
        member portal at csa.tinyseedfarm.com/account/preferences. Consent to receive SMS is not
        a condition of any purchase.</p>
      <p><strong>Message frequency:</strong> varies — typically 1–4 messages per week during the
        growing season.</p>
      <p><strong>Cost:</strong> message and data rates may apply per your carrier plan. Carriers
        are not liable for delayed or undelivered messages.</p>
      <p><strong>Opt-out:</strong> reply <strong>STOP</strong> to any message. We will confirm
        your unsubscribe and send no further messages. Rejoin anytime by replying
        <strong>START</strong> or re-enabling SMS in the portal.</p>
      <p><strong>Help:</strong> reply <strong>HELP</strong> or email
        <a class="text-ts-primary underline" href="mailto:tinyseedcsa@gmail.com">tinyseedcsa@gmail.com</a>.</p>
      <p><strong>Eligibility:</strong> you must be the account holder of the mobile number
        provided and 18 years or older.</p>
      <p><strong>Privacy:</strong> see our
        <a class="text-ts-primary underline" href="/privacy">Privacy Policy</a>. No mobile
        information is shared with third parties or affiliates for marketing or promotional
        purposes.</p>
      <p class="pt-4 text-sm text-ts-text-muted">Tiny Seed Farm · Pittsburgh, PA ·
        <a class="text-ts-primary underline" href="https://www.tinyseedfarm.com">tinyseedfarm.com</a></p>
    </section>
  </main>
</BaseLayout>
