---
/**
 * /waitlist — PUBLIC CSA waitlist form (NO login).
 *
 * PHASE 2 · WAVE 1 (gap 4 / proposal 2.2). When a share sells out, this is the
 * warm pool the farm reaches into for cancellations — and it creates urgency
 * for renewal. Customer-facing, light-theme, standalone (matches the presentation
 * of /login + /unsubscribe: BaseLayout, centered card, ts-* tokens).
 *
 * The form is a same-origin POST to /api/waitlist/join, which zod-validates,
 * checks a honeypot, and UPSERTs by email via the service-role client (same
 * trust model as the onboarding endpoints — no anon RLS write path). On success
 * it 303-redirects back here with ?status=joined; validation/failure come back
 * as ?status=invalid|error. Server-rendered end-to-end, no client JS required.
 *
 * PUBLIC route: NOT in middleware's PROTECTED_PREFIXES, so a logged-out visitor
 * reaches it directly. We expose NO business data (no member counts, no stop
 * list) — glossary + public-page rule.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

type Status = 'joined' | 'invalid' | 'error' | null;
const statusParam = Astro.url.searchParams.get('status');
const status: Status =
  statusParam === 'joined' || statusParam === 'invalid' || statusParam === 'error'
    ? statusParam
    : null;

// Share-interest options — canonical labels per CSA_GLOSSARY_OF_TRUTH §2.
const SHARE_OPTIONS = [
  { value: 'Any', label: 'Any — tell me what opens up' },
  { value: 'Summer Veg', label: 'Summer Veg Share' },
  { value: 'Flower', label: 'Flower Share' },
  { value: 'Flex', label: 'Farm Flex' },
];
---

<BaseLayout
  title="Join the waitlist — Tiny Seed Farm CSA"
  canonical="https://csa.tinyseedfarm.com/waitlist"
>
  <main class="mx-auto flex min-h-screen w-full max-w-lg flex-col justify-center px-5 py-12 sm:py-16">
    <div class="text-center">
      <p class="mb-1 text-xs font-semibold uppercase tracking-[0.3em] text-ts-primary">
        🌱 Tiny Seed Farm
      </p>
    </div>

    {status === 'joined' ? (
      <section
        role="status"
        aria-live="polite"
        class="mt-4 rounded-ts-xl border border-ts-primary/30 bg-ts-bg-surface p-6 text-center shadow-ts-sm sm:p-8"
      >
        <span class="text-4xl" aria-hidden="true">🌱</span>
        <h1 class="mt-3 font-display text-2xl font-bold tracking-tight text-ts-text sm:text-3xl">
          You're on the list
        </h1>
        <p class="mx-auto mt-3 max-w-sm text-base leading-relaxed text-ts-text-secondary">
          We'll reach out when a spot opens. Thanks for your interest in growing
          with us this season.
        </p>
        <a
          href="https://tinyseedfarm.com"
          class="mt-6 inline-flex h-11 items-center justify-center rounded-ts-md border border-ts-border bg-ts-bg-surface px-6 text-sm font-semibold text-ts-text-secondary transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
        >
          Back to the farm
        </a>
      </section>
    ) : (
      <>
        <div class="mt-2 text-center">
          <h1 class="font-display text-3xl font-bold tracking-tight text-ts-text sm:text-4xl">
            Join the waitlist
          </h1>
          <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-ts-text-secondary">
            Our shares can fill up fast. Leave your details and we'll reach out
            the moment a spot opens for the season.
          </p>
        </div>

        {status === 'invalid' && (
          <div
            role="alert"
            class="mt-6 rounded-ts-md border border-ts-danger/30 bg-ts-danger/5 px-4 py-3 text-sm font-medium text-ts-danger"
          >
            Please check the highlighted fields — we need at least your name and a
            valid email.
          </div>
        )}
        {status === 'error' && (
          <div
            role="alert"
            class="mt-6 rounded-ts-md border border-ts-danger/30 bg-ts-danger/5 px-4 py-3 text-sm font-medium text-ts-danger"
          >
            We couldn't save that just now. Please try again, or email
            {' '}
            <a
              href="mailto:hello@tinyseedfarm.com?subject=CSA%20waitlist"
              class="font-semibold underline underline-offset-2"
            >hello@tinyseedfarm.com</a>.
          </div>
        )}

        <form
          method="POST"
          action="/api/waitlist/join"
          class="mt-8 flex flex-col gap-5 rounded-ts-xl border border-ts-border bg-ts-bg-surface p-6 shadow-ts-sm sm:p-8"
        >
          {/* Honeypot — hidden from humans, catnip for bots. A non-empty value
              server-side is rejected as spam. Kept off-screen (not display:none)
              so naive bots that skip hidden fields still fill it. */}
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden">
            <label for="wl-website">Leave this field blank</label>
            <input
              id="wl-website"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="wl-name" class="text-sm font-semibold text-ts-text">
              Your name <span class="text-ts-danger" aria-hidden="true">*</span>
            </label>
            <input
              id="wl-name"
              type="text"
              name="name"
              required
              maxlength="120"
              autocomplete="name"
              placeholder="Jane Smith"
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="wl-email" class="text-sm font-semibold text-ts-text">
              Email <span class="text-ts-danger" aria-hidden="true">*</span>
            </label>
            <input
              id="wl-email"
              type="email"
              name="email"
              required
              maxlength="200"
              autocomplete="email"
              placeholder="jane@example.com"
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="wl-phone" class="text-sm font-semibold text-ts-text">
              Phone <span class="font-normal text-ts-text-muted">(optional)</span>
            </label>
            <input
              id="wl-phone"
              type="tel"
              name="phone"
              maxlength="40"
              autocomplete="tel"
              placeholder="(412) 555-0123"
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="wl-share" class="text-sm font-semibold text-ts-text">
              What are you interested in?
            </label>
            <select
              id="wl-share"
              name="share_interest"
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            >
              {SHARE_OPTIONS.map((o) => (
                <option value={o.value}>{o.label}</option>
              ))}
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="wl-pickup" class="text-sm font-semibold text-ts-text">
              Pickup preference <span class="font-normal text-ts-text-muted">(optional)</span>
            </label>
            <input
              id="wl-pickup"
              type="text"
              name="pickup_preference"
              maxlength="200"
              placeholder="e.g. a Wednesday stop near Squirrel Hill, or home delivery"
              class="h-11 w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 text-base text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="wl-notes" class="text-sm font-semibold text-ts-text">
              Anything else? <span class="font-normal text-ts-text-muted">(optional)</span>
            </label>
            <textarea
              id="wl-notes"
              name="notes"
              rows="3"
              maxlength="1000"
              placeholder="Household size, dietary notes, questions…"
              class="w-full rounded-ts-md border border-ts-border bg-ts-bg-base px-3 py-2 text-base leading-relaxed text-ts-text outline-none transition-colors focus:border-ts-primary focus:ring-2 focus:ring-ts-primary/30"
            ></textarea>
          </div>

          <button
            type="submit"
            class="mt-1 inline-flex h-12 w-full items-center justify-center gap-2 rounded-ts-md bg-ts-primary px-6 text-base font-semibold tracking-tight text-white shadow-ts-sm transition-all duration-150 ease-[var(--ease-ts)] hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary [touch-action:manipulation]"
          >
            Add me to the waitlist
          </button>

          <p class="text-center text-xs leading-relaxed text-ts-text-muted">
            We'll only use your details to contact you about a CSA share. No spam,
            ever.
          </p>
        </form>
      </>
    )}
  </main>
</BaseLayout>
