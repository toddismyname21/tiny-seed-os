---
/**
 * /onboarding/box-preview — Step 2 of 5.
 *
 * Read-only preview of the *next* upcoming Wednesday's box for the
 * member's share_type. The intent: show, not edit. Customization is
 * Day 7 — explicitly out of scope here.
 *
 * If we have no `box_contents` rows yet for the upcoming Wednesday
 * (Todd hasn't planned the box), we show a friendly placeholder.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveOnboardingContext } from '../../lib/onboarding';
import OnboardingShell from '../../components/OnboardingShell.astro';

const user = Astro.locals.user;
if (!user || !user.email) return Astro.redirect('/login', 303);

const ctx = await resolveOnboardingContext(Astro.locals.supabase, user.email);
if (!ctx) return Astro.redirect('/dashboard', 303);

// Resolve upcoming Wednesday in America/New_York — same logic as
// dashboard.astro / index.astro.
function upcomingWednesday(now: Date = new Date()): string {
  const fmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric', month: '2-digit', day: '2-digit', weekday: 'short',
  });
  const parts = fmt.formatToParts(now);
  const get = (t: string): string => parts.find((p) => p.type === t)?.value ?? '';
  const dayIndex: Record<string, number> = {
    Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6,
  };
  const todayIdx = dayIndex[get('weekday')] ?? 0;
  const daysUntilWed = (3 - todayIdx + 7) % 7;
  const todayET = new Date(`${get('year')}-${get('month')}-${get('day')}T00:00:00-05:00`);
  const wed = new Date(todayET.getTime() + daysUntilWed * 86_400_000);
  return new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit',
  }).format(wed);
}

const targetWeek = upcomingWednesday();

type BoxItem = {
  product_name: string;
  variety: string | null;
  quantity: number;
  unit: string;
  is_swappable: boolean;
};

const { data: boxRows } = await Astro.locals.supabase
  .from('box_contents')
  .select('product_name, variety, quantity, unit, is_swappable')
  .eq('week_date', targetWeek)
  .eq('share_type', ctx.member.share_type)
  .order('product_name', { ascending: true })
  .overrideTypes<BoxItem[], { merge: false }>();

const boxItems: BoxItem[] = boxRows ?? [];

const targetWeekPretty = new Intl.DateTimeFormat('en-US', {
  weekday: 'long', month: 'long', day: 'numeric',
  timeZone: 'America/New_York',
}).format(new Date(`${targetWeek}T12:00:00-04:00`));

const SHARE_TYPE_LABELS: Record<string, string> = {
  spring_veg: 'Spring Vegetable Share',
  summer_veg: 'Summer Vegetable Share',
  fall_veg: 'Fall Vegetable Share',
  flower: 'Flower Share',
  flex: 'Flex Share',
  add_on: 'Add-On',
  wholesale_csa: 'Wholesale CSA',
};
const shareLabel = SHARE_TYPE_LABELS[ctx.member.share_type] ?? ctx.member.share_type;
---

<BaseLayout
  title="Your first box — Step 2 of 5"
  description="A preview of what your first Tiny Seed Farm CSA box might look like."
  canonical="https://csa.tinyseedfarm.com/onboarding/box-preview"
>
  <OnboardingShell currentStep="box-preview">
    <h1
      id="step-heading"
      class="font-display text-3xl leading-tight font-bold tracking-tight text-ts-text sm:text-4xl"
    >
      Here's what your first box might look like.
    </h1>
    <p class="mt-3 max-w-prose text-base leading-relaxed text-ts-text-secondary">
      We harvest the morning of pickup, so the exact mix shifts week to week
      depending on what's ready. This is a preview of <span class="font-medium text-ts-text">{shareLabel}</span>
      for the week of <span class="tabular-nums">{targetWeekPretty}</span>.
    </p>

    <section
      aria-labelledby="box-heading"
      class="mt-8 rounded-ts-xl border border-ts-border bg-ts-bg-surface shadow-ts-md"
    >
      <header class="flex items-baseline justify-between gap-3 border-b border-ts-border px-5 py-4 sm:px-6">
        <h2 id="box-heading" class="font-display text-lg font-semibold text-ts-text sm:text-xl">
          {shareLabel}
        </h2>
        <span class="text-sm tabular-nums text-ts-text-muted">{targetWeekPretty}</span>
      </header>

      {boxItems.length === 0 ? (
        <div class="px-5 py-8 text-center sm:px-6">
          <span class="text-3xl" aria-hidden="true">🌱</span>
          <p class="mt-3 text-base text-ts-text-secondary">
            We're still planning the box for {targetWeekPretty}.
          </p>
          <p class="mt-1 text-sm text-ts-text-muted">
            We typically post contents the day before pickup. You'll see your
            real box on the dashboard once it's live.
          </p>
        </div>
      ) : (
        <ul class="divide-y divide-ts-border/60">
          {boxItems.map((item) => (
            <li class="flex items-start gap-4 px-5 py-4 sm:px-6">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-ts-md bg-ts-primary/10 text-2xl"
                aria-hidden="true"
              >
                🥬
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-base font-medium text-ts-text">
                  {item.product_name}
                  {item.variety && (
                    <span class="ml-1.5 text-sm font-normal text-ts-text-muted">
                      ({item.variety})
                    </span>
                  )}
                </p>
                <p class="mt-0.5 text-sm tabular-nums text-ts-text-secondary">
                  {item.quantity} {item.unit}
                  {item.is_swappable && (
                    <span
                      class="ml-2 inline-flex items-center rounded-full bg-ts-info/10 px-2 py-0.5 text-xs font-medium text-ts-info"
                    >
                      swappable
                    </span>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <aside
      role="note"
      class="mt-6 rounded-ts-lg border border-ts-info/30 bg-ts-info/5 px-4 py-3 text-sm leading-relaxed text-ts-info"
    >
      <p class="text-ts-text">
        <span class="font-semibold text-ts-info">Heads up:</span>
        Boxes change every week with the harvest. Once your share is live, you'll
        be able to swap items you don't want from your dashboard before each pickup.
      </p>
    </aside>

    <div class="mt-8 flex flex-col-reverse items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="/onboarding/welcome"
        class="inline-flex items-center justify-center gap-2 rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 py-3 text-sm font-medium text-ts-text-secondary transition-colors duration-150 hover:border-ts-border-strong hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        <span aria-hidden="true">←</span>
        <span>Back</span>
      </a>
      <a
        href="/onboarding/preferences"
        class="inline-flex items-center justify-center gap-2 rounded-ts-md bg-ts-primary px-6 py-3 text-base font-semibold text-white shadow-ts-sm transition-all duration-150 hover:bg-ts-primary-dark active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
      >
        <span>Got it</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </OnboardingShell>
</BaseLayout>
