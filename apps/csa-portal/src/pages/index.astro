---
/**
 * Landing page — Day 2 deliverable.
 *
 * Server-rendered. Pulls three data points from Supabase per request to
 * prove the full Astro + Supabase + Vercel stack is wired up end-to-end:
 *   1. Active member count                  (members WHERE status='active')
 *   2. Active pickup location count + list  (pickup_locations WHERE is_active)
 *   3. The current week's box contents      (box_contents WHERE week_date = upcoming Wed)
 *
 * Auth is intentionally NOT here — the magic-link login flow ships Day 3.
 * Members landing here should see a clear "under construction" message with
 * a contact path to Todd if they need help with their share right now.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabaseAdmin } from '../lib/supabase';

// Narrow row shapes for the projections selected below. Declared explicitly
// so TypeScript can infer items in the `.map()` calls — the Supabase JS
// generic types collapse to `never` when a column-subset string is passed
// to `.select()`. This is the recommended pattern (`.returns<T[]>()`) per
// supabase-js docs.
type PickupLocationCard = {
  id: string;
  name: string;
  city: string | null;
  day_of_week: 'Sun' | 'Mon' | 'Tue' | 'Wed' | 'Thu' | 'Fri' | 'Sat' | null;
  time_start: string | null;
  time_end: string | null;
  is_delivery_zone: boolean;
};

type BoxItemCard = {
  share_type: string;
  product_name: string;
  variety: string | null;
  quantity: number;
  unit: string;
};

// ───────────────────────────────────────────────────────────────────────
// Resolve the upcoming Wednesday — every CSA stop runs Wed 4-6:30pm except
// the two Sat farmers' markets, so the "current week" box is keyed by Wed.
// We use America/New_York wall-clock time to avoid UTC off-by-one bugs at
// midnight ET (the Vercel function runs in UTC, but the farm operates in ET).
// ───────────────────────────────────────────────────────────────────────
function upcomingWednesday(now: Date = new Date()): string {
  const fmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    weekday: 'short',
  });
  const parts = fmt.formatToParts(now);
  const get = (t: string): string => parts.find((p) => p.type === t)?.value ?? '';
  // Day-of-week index in ET (Sun=0..Sat=6)
  const weekdayShort = get('weekday');
  const dayIndex: Record<string, number> = {
    Sun: 0,
    Mon: 1,
    Tue: 2,
    Wed: 3,
    Thu: 4,
    Fri: 5,
    Sat: 6,
  };
  const todayIdx = dayIndex[weekdayShort] ?? 0;
  const daysUntilWed = (3 - todayIdx + 7) % 7; // Wed = 3
  const todayET = new Date(`${get('year')}-${get('month')}-${get('day')}T00:00:00-05:00`);
  const wed = new Date(todayET.getTime() + daysUntilWed * 86_400_000);
  // Re-format back to YYYY-MM-DD in ET
  return new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/New_York',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(wed);
}

const targetWeek = upcomingWednesday();

// ───────────────────────────────────────────────────────────────────────
// Three parallel Supabase queries. We use `count: 'exact', head: true` for
// the counts so we don't drag full row payloads back across the wire.
// ───────────────────────────────────────────────────────────────────────
const [activeMembersRes, pickupLocationsRes, boxContentsRes] = await Promise.all([
  supabaseAdmin
    .from('members')
    .select('id', { count: 'exact', head: true })
    .eq('status', 'active'),
  supabaseAdmin
    .from('pickup_locations')
    .select('id, name, city, day_of_week, time_start, time_end, is_delivery_zone')
    .eq('is_active', true)
    .order('day_of_week', { ascending: true })
    .order('name', { ascending: true })
    .overrideTypes<PickupLocationCard[], { merge: false }>(),
  supabaseAdmin
    .from('box_contents')
    .select('share_type, product_name, variety, quantity, unit')
    .eq('week_date', targetWeek)
    .order('share_type', { ascending: true })
    .order('product_name', { ascending: true })
    .overrideTypes<BoxItemCard[], { merge: false }>(),
]);

// ───────────────────────────────────────────────────────────────────────
// Defensive extraction — if any query errored, render the page with safe
// fallbacks rather than a 500. We surface the error in the server log so
// it shows up in Vercel logs without leaking internals to the user.
// ───────────────────────────────────────────────────────────────────────
if (activeMembersRes.error) {
  console.error('[landing] active members count failed:', activeMembersRes.error);
}
if (pickupLocationsRes.error) {
  console.error('[landing] pickup locations query failed:', pickupLocationsRes.error);
}
if (boxContentsRes.error) {
  console.error('[landing] box contents query failed:', boxContentsRes.error);
}

const activeMemberCount = activeMembersRes.count ?? 0;
const pickupLocations = pickupLocationsRes.data ?? [];
const activeLocationCount = pickupLocations.length;
const boxContents = boxContentsRes.data ?? [];

// ───────────────────────────────────────────────────────────────────────
// Format helpers
// ───────────────────────────────────────────────────────────────────────
const dayOrder: Record<string, number> = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };
const dayLong: Record<string, string> = {
  Mon: 'Monday',
  Tue: 'Tuesday',
  Wed: 'Wednesday',
  Thu: 'Thursday',
  Fri: 'Friday',
  Sat: 'Saturday',
  Sun: 'Sunday',
};

const sortedLocations = [...pickupLocations].sort((a, b) => {
  const aDay = dayOrder[a.day_of_week ?? ''] ?? 99;
  const bDay = dayOrder[b.day_of_week ?? ''] ?? 99;
  if (aDay !== bDay) return aDay - bDay;
  return a.name.localeCompare(b.name);
});

function formatTimeRange(start: string | null, end: string | null): string {
  if (!start || !end) return '';
  // Postgres TIME comes back as "HH:MM:SS" — render as "4:00 PM".
  const fmt = (t: string): string => {
    const [hStr, mStr] = t.split(':');
    let h = Number(hStr);
    const m = Number(mStr);
    const period = h >= 12 ? 'PM' : 'AM';
    h = h % 12 === 0 ? 12 : h % 12;
    return m === 0 ? `${h} ${period}` : `${h}:${mStr.padStart(2, '0')} ${period}`;
  };
  return `${fmt(start)} – ${fmt(end)}`;
}

// Pretty target-week display: "Wed, May 13"
const targetWeekPretty = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  timeZone: 'America/New_York',
}).format(new Date(`${targetWeek}T12:00:00-04:00`));

const description =
  'The Tiny Seed Farm CSA member portal is being rebuilt. Magic-link login launches Day 3. ' +
  `Currently serving ${activeMemberCount} active members across ${activeLocationCount} pickup locations.`;
---

<BaseLayout
  title="Tiny Seed Farm CSA — Member Portal"
  description={description}
>
  <main class="mx-auto flex min-h-screen w-full max-w-4xl flex-col gap-12 px-6 py-10 sm:py-16">
    {/* ═════════════════════════════════════════════════════════════
        HERO
        ═════════════════════════════════════════════════════════════ */}
    <header class="flex flex-col items-center text-center">
      <span
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-ts-border bg-ts-bg-surface px-4 py-1.5 text-xs font-medium tracking-wide text-ts-text-secondary uppercase shadow-ts-sm"
        aria-hidden="true"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-ts-primary"></span>
        Tiny Seed Farm
      </span>

      <h1
        class="font-display text-5xl leading-[1.05] font-bold tracking-tight text-ts-text sm:text-6xl md:text-7xl"
      >
        <span class="block text-ts-primary">CSA Member</span>
        <span class="block">Portal</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ts-text-secondary sm:text-xl">
        The home for your weekly share. New portal coming online — same farm,
        same vegetables, dramatically faster.
      </p>
    </header>

    {/* ═════════════════════════════════════════════════════════════
        STATUS BANNER — under construction notice
        ═════════════════════════════════════════════════════════════ */}
    <section
      role="status"
      aria-labelledby="status-heading"
      class="rounded-ts-xl border border-ts-border bg-ts-bg-surface p-6 shadow-ts-md sm:p-8"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-ts-lg bg-ts-primary/10 text-2xl"
          aria-hidden="true"
        >
          🌱
        </div>
        <div class="flex-1">
          <h2
            id="status-heading"
            class="font-display text-2xl font-semibold text-ts-text"
          >
            Sign in to your share
          </h2>
          <p class="mt-2 text-base leading-relaxed text-ts-text-secondary">
            Magic-link login is live — we'll email you a one-time link, no
            password needed. Box customization and vacation holds are coming
            online over the next two weeks.
            <strong class="font-semibold text-ts-text">Need help right now?</strong>
            Email Todd — he answers personally.
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href="/login"
              class="inline-flex items-center gap-2 rounded-ts-md bg-ts-primary px-5 py-3 text-base font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              Sign in
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="mailto:todd@tinyseedfarmpgh.com?subject=CSA%20share%20help"
              class="inline-flex items-center gap-2 rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 py-3 text-base font-medium text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              Email Todd
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* ═════════════════════════════════════════════════════════════
        LIVE STATS — proves Supabase queries are running at SSR time
        ═════════════════════════════════════════════════════════════ */}
    <section aria-labelledby="stats-heading">
      <h2 id="stats-heading" class="sr-only">Live farm stats</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <article
          class="rounded-ts-xl border border-ts-border bg-ts-bg-surface p-6 shadow-ts-sm transition-shadow duration-200 hover:shadow-ts-md sm:p-8"
        >
          <p class="text-sm font-medium tracking-wide text-ts-text-muted uppercase">
            Active members
          </p>
          <p class="mt-2 font-display text-5xl font-bold text-ts-primary tabular-nums sm:text-6xl">
            {activeMemberCount}
          </p>
          <p class="mt-2 text-sm text-ts-text-secondary">
            households eating from Tiny Seed this season
          </p>
        </article>

        <article
          class="rounded-ts-xl border border-ts-border bg-ts-bg-surface p-6 shadow-ts-sm transition-shadow duration-200 hover:shadow-ts-md sm:p-8"
        >
          <p class="text-sm font-medium tracking-wide text-ts-text-muted uppercase">
            Pickup locations
          </p>
          <p class="mt-2 font-display text-5xl font-bold text-ts-primary tabular-nums sm:text-6xl">
            {activeLocationCount}
          </p>
          <p class="mt-2 text-sm text-ts-text-secondary">
            stops across Pittsburgh + the North Hills
          </p>
        </article>
      </div>
    </section>

    {/* ═════════════════════════════════════════════════════════════
        PICKUP LOCATIONS LIST
        ═════════════════════════════════════════════════════════════ */}
    <section aria-labelledby="locations-heading" class="flex flex-col gap-4">
      <div class="flex items-baseline justify-between gap-4">
        <h2
          id="locations-heading"
          class="font-display text-2xl font-bold text-ts-text sm:text-3xl"
        >
          Where to pick up your share
        </h2>
        <span class="hidden text-sm text-ts-text-muted sm:inline">
          {activeLocationCount} stops
        </span>
      </div>

      {sortedLocations.length === 0 ? (
        <div
          class="rounded-ts-lg border border-dashed border-ts-border bg-ts-bg-muted p-8 text-center text-ts-text-secondary"
        >
          <p class="text-base">
            We're loading pickup locations. Check back in a moment.
          </p>
        </div>
      ) : (
        <ul class="divide-y divide-ts-border overflow-hidden rounded-ts-xl border border-ts-border bg-ts-bg-surface shadow-ts-sm">
          {sortedLocations.map((loc) => (
            <li class="flex flex-col gap-1 px-5 py-4 transition-colors duration-150 hover:bg-ts-bg-muted/40 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:px-6 sm:py-5">
              <div class="flex items-center gap-3">
                <span
                  class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-ts-primary"
                  aria-hidden="true"
                ></span>
                <div>
                  <p class="font-semibold text-ts-text">{loc.name}</p>
                  {loc.city && (
                    <p class="text-sm text-ts-text-muted">{loc.city}, PA</p>
                  )}
                </div>
              </div>
              <div class="flex flex-col items-start gap-0.5 pl-5 text-sm sm:items-end sm:pl-0">
                <span class="font-medium text-ts-text">
                  {loc.day_of_week ? dayLong[loc.day_of_week] ?? loc.day_of_week : 'TBD'}
                </span>
                <span class="text-ts-text-muted tabular-nums">
                  {formatTimeRange(loc.time_start, loc.time_end) || 'Times posted weekly'}
                </span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    {/* ═════════════════════════════════════════════════════════════
        THIS WEEK'S BOX (only renders if there's data for the upcoming Wed)
        ═════════════════════════════════════════════════════════════ */}
    {boxContents.length > 0 && (
      <section aria-labelledby="box-heading" class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between gap-4">
          <h2
            id="box-heading"
            class="font-display text-2xl font-bold text-ts-text sm:text-3xl"
          >
            This week's box
          </h2>
          <span class="text-sm text-ts-text-muted">{targetWeekPretty}</span>
        </div>
        <div
          class="rounded-ts-xl border border-ts-border bg-ts-bg-surface p-5 shadow-ts-sm sm:p-6"
        >
          <ul class="grid grid-cols-1 gap-x-6 gap-y-2 sm:grid-cols-2">
            {boxContents.map((item) => (
              <li class="flex items-baseline gap-2 border-b border-ts-border/50 py-2 last:border-b-0">
                <span class="font-medium text-ts-text">{item.product_name}</span>
                {item.variety && (
                  <span class="text-sm text-ts-text-muted">({item.variety})</span>
                )}
                <span class="ml-auto text-sm text-ts-text-secondary tabular-nums">
                  {item.quantity} {item.unit}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* ═════════════════════════════════════════════════════════════
        FOOTER
        ═════════════════════════════════════════════════════════════ */}
    <footer
      class="mt-auto flex flex-col items-center gap-3 border-t border-ts-border pt-8 text-center text-sm text-ts-text-muted"
    >
      <p>
        Tiny Seed Farm — 257 Zeigler Rd, Rochester, PA · Certified Organic
      </p>
      <p class="text-xs">
        Built on
        <a
          href="https://astro.build"
          rel="noopener noreferrer"
          target="_blank"
          class="text-ts-text-secondary underline-offset-2 hover:text-ts-primary hover:underline"
          >Astro</a
        >
        +
        <a
          href="https://supabase.com"
          rel="noopener noreferrer"
          target="_blank"
          class="text-ts-text-secondary underline-offset-2 hover:text-ts-primary hover:underline"
          >Supabase</a
        >
        +
        <a
          href="https://vercel.com"
          rel="noopener noreferrer"
          target="_blank"
          class="text-ts-text-secondary underline-offset-2 hover:text-ts-primary hover:underline"
          >Vercel</a
        >
      </p>
    </footer>
  </main>
</BaseLayout>
