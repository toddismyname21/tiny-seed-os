---
/**
 * Landing page — public, logged-out.
 *
 * This is the sign-in entry point for CSA members. It intentionally renders
 * NO business data (no member counts, no pickup locations, no box contents)
 * so nothing internal leaks to logged-out visitors. The page makes zero
 * database calls — everything below the fold is static markup.
 *
 * The authenticated experience (share management, box customization, vacation
 * holds) lives behind the magic-link login at /login.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'Sign in to your Tiny Seed Farm CSA member account to manage your weekly share, customize your box, and schedule vacation holds.';
---

<BaseLayout
  title="Tiny Seed Farm CSA — Member Portal"
  description={description}
>
  <main class="mx-auto flex min-h-screen w-full max-w-4xl flex-col gap-12 px-6 py-10 sm:py-16">
    {/* ═════════════════════════════════════════════════════════════
        HERO
        ═════════════════════════════════════════════════════════════ */}
    <header class="flex flex-col items-center text-center">
      <span
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-ts-border bg-ts-bg-surface px-4 py-1.5 text-xs font-medium tracking-wide text-ts-text-secondary uppercase shadow-ts-sm"
        aria-hidden="true"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-ts-primary"></span>
        Tiny Seed Farm
      </span>

      <h1
        class="font-display text-5xl leading-[1.05] font-bold tracking-tight text-ts-text sm:text-6xl md:text-7xl"
      >
        <span class="block text-ts-primary">CSA Member</span>
        <span class="block">Portal</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ts-text-secondary sm:text-xl">
        The home for your weekly share — see what's in your box, swap items,
        and schedule a vacation hold in seconds.
      </p>
    </header>

    {/* ═════════════════════════════════════════════════════════════
        SIGN-IN CARD
        ═════════════════════════════════════════════════════════════ */}
    <section
      aria-labelledby="status-heading"
      class="rounded-ts-xl border border-ts-border bg-ts-bg-surface p-6 shadow-ts-md sm:p-8"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-ts-lg bg-ts-primary/10 text-2xl"
          aria-hidden="true"
        >
          🌱
        </div>
        <div class="flex-1">
          <h2
            id="status-heading"
            class="font-display text-2xl font-semibold text-ts-text"
          >
            Sign in to your share
          </h2>
          <p class="mt-2 text-base leading-relaxed text-ts-text-secondary">
            We'll email you a one-time sign-in link — no password to remember.
            Once you're in, you can review this week's box, swap individual
            items, schedule a vacation hold, and check your Farm Flex balance.
            <strong class="font-semibold text-ts-text">Need help?</strong>
            Email Todd — he answers personally.
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href="/login"
              class="inline-flex items-center gap-2 rounded-ts-md bg-ts-primary px-5 py-3 text-base font-semibold text-white shadow-ts-sm transition-colors duration-150 hover:bg-ts-primary-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              Sign in
              <span aria-hidden="true">→</span>
            </a>
            <a
              href="mailto:todd@tinyseedfarmpgh.com?subject=CSA%20share%20help"
              class="inline-flex items-center gap-2 rounded-ts-md border border-ts-border bg-ts-bg-surface px-5 py-3 text-base font-medium text-ts-text transition-colors duration-150 hover:border-ts-primary/40 hover:text-ts-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              Email Todd
            </a>
          </div>

          {/* Anti-phishing reassurance — builds "this is legit" trust for
              members wary of credential-stealing emails. */}
          <p class="mt-3 text-sm leading-relaxed text-ts-text-muted">
            We'll email you a secure sign-in code —
            Tiny Seed will never ask for your password.
          </p>

          {/* Escape hatch for non-members. Returning members are the
              priority, so this is a secondary link, not a button. The link
              points at the Shopify CSA signup. */}
          <p class="mt-4 border-t border-ts-border pt-4 text-sm text-ts-text-secondary">
            Not a member yet?{' '}
            <a
              href="https://tinyseedfarm.com/collections/tiny-seed-farm-csa"
              rel="noopener"
              class="font-medium text-ts-primary underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
            >
              Join the Tiny Seed CSA →
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* ═════════════════════════════════════════════════════════════
        FOOTER
        ═════════════════════════════════════════════════════════════ */}
    <footer
      class="mt-auto flex flex-col items-center gap-3 border-t border-ts-border pt-8 text-center text-sm text-ts-text-muted"
    >
      <p>
        Tiny Seed Farm — 257 Zeigler Rd, Rochester, PA · Certified Organic
      </p>
      <p class="text-xs">
        Built on
        <a
          href="https://astro.build"
          rel="noopener noreferrer"
          target="_blank"
          class="text-ts-text-secondary underline-offset-2 hover:text-ts-primary hover:underline"
          >Astro</a
        >
        +
        <a
          href="https://supabase.com"
          rel="noopener noreferrer"
          target="_blank"
          class="text-ts-text-secondary underline-offset-2 hover:text-ts-primary hover:underline"
          >Supabase</a
        >
        +
        <a
          href="https://vercel.com"
          rel="noopener noreferrer"
          target="_blank"
          class="text-ts-text-secondary underline-offset-2 hover:text-ts-primary hover:underline"
          >Vercel</a
        >
      </p>
    </footer>
  </main>
</BaseLayout>
