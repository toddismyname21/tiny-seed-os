---
/**
 * MemberShell — the single shared chrome for every logged-in member page
 * (dashboard, account/*, box). It replaces the top bar + footer that was
 * previously copy-pasted inline across ~9 files (audit P0-1 / P2-11), and
 * adds the persistent bottom tab bar the prior research called for.
 *
 * What it renders (top → bottom):
 *   1. Skip-to-main link (keyboard a11y, mirrors the old per-page link).
 *   2. Top bar — brand mark (→ /dashboard) + Sign out (POST /logout).
 *   3. Optional breadcrumb back-link (account sub-pages used this inline).
 *   4. <main id="main"> with the page's default <slot>.
 *   5. Footer — "Signed in as <email>" + farm address.
 *   6. Persistent bottom tab bar — Home · Box · Account · Help, thumb-zone,
 *      safe-area-aware, with active-state highlighting + aria-current.
 *   7. An `overlays` slot rendered OUTSIDE <main> (for the box page's
 *      BottomSheets / toast region, which must sit at the document level).
 *
 * Why the bottom bar lives here: it is the highest-leverage consistency
 * + discoverability win (members on /account/pickup could only reach /box
 * via the back button). 4 items max (Hick's Law); icon + visible label
 * (never icon-only); 48px targets in the bottom ~40% thumb zone;
 * `env(safe-area-inset-bottom)` padding so it clears the iPhone home
 * indicator; `aria-current="page"` on the active tab.
 *
 * Content vs. bottom bar overlap: <main> carries bottom padding sized to
 * the bar height + safe area (`--member-bottombar-h`), so nothing is ever
 * hidden behind it. `scroll-padding-bottom` keeps a focused field from
 * being obscured by the bar (WCAG 2.2 SC 2.4.11 Focus Not Obscured).
 *
 * Props:
 *   - title / description / canonical  Passed straight through to BaseLayout.
 *   - userEmail        Rendered in the footer "Signed in as …" line.
 *   - active           Which bottom tab to highlight: 'home' | 'box' |
 *                      'account' | 'help'. Optional — if omitted we derive
 *                      it from the current pathname (robust default).
 *   - back             Optional breadcrumb back-link: { href, label }.
 *                      Account sub-pages render "← Dashboard"; box renders
 *                      "← Back to dashboard".
 *   - mainClass        Optional override for the <main> utility classes
 *                      (pages differ slightly in gap; default matches the
 *                      most common max-w-3xl / gap-6 layout).
 *
 * Slots:
 *   - default   Page body (inside <main>).
 *   - overlays  Document-level extras rendered after </main> (sheets,
 *               toast regions). Optional.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

type Tab = 'home' | 'box' | 'account' | 'help';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  userEmail: string;
  active?: Tab;
  back?: { href: string; label: string };
  mainClass?: string;
}

const {
  title,
  description,
  canonical,
  userEmail,
  active,
  back,
  mainClass = 'mx-auto flex w-full max-w-3xl flex-col gap-6 px-5 py-8 sm:gap-8 sm:px-6 sm:py-12',
} = Astro.props as Props;

const pathname = Astro.url.pathname;

// Derive the active tab from the path when not explicitly set. Help is a
// mailto: link (no route), so it is never "active" — only set via prop.
function deriveActive(): Tab {
  if (pathname === '/dashboard') return 'home';
  if (pathname === '/box' || pathname.startsWith('/box/')) return 'box';
  if (pathname === '/account' || pathname.startsWith('/account/')) return 'account';
  return 'home';
}

const activeTab: Tab = active ?? deriveActive();

interface NavItem {
  key: Tab;
  href: string;
  label: string;
  /** Heroicons-style 24px outline path(s), rendered inline. */
  icon: string;
}

// Inline SVG paths (Heroicons outline, 24px, 1.5 stroke). Kept inline so
// there is no icon-font dependency and they inherit `currentColor`.
const ICONS: Record<Tab, string> = {
  home: 'M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25',
  box: 'M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9',
  account: 'M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z',
  help: 'M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z',
};

const navItems: NavItem[] = [
  { key: 'home',    href: '/dashboard', label: 'Home',    icon: ICONS.home },
  { key: 'box',     href: '/box',       label: 'Box',     icon: ICONS.box },
  { key: 'account', href: '/account',   label: 'Account', icon: ICONS.account },
  {
    key: 'help',
    // Help = email the farm. ContactFarm's clipboard-first affordance
    // lives on the dashboard/account pages; the bottom-tab Help is the
    // always-works mailto (no JS needed, no new route).
    href: 'mailto:todd@tinyseedfarmpgh.com?subject=CSA%20help',
    label: 'Help',
    icon: ICONS.help,
  },
];

const hasOverlays = Astro.slots.has('overlays');
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-ts-md focus:bg-ts-primary focus:px-4 focus:py-2 focus:text-white focus:shadow-ts-md"
  >
    Skip to main content
  </a>

  {/* Bottom-bar height (bar + safe-area) exposed as a custom property so
      <main>'s bottom padding and scroll-padding stay in sync with the
      actual bar. 64px bar (4rem) + the iPhone home-indicator inset. */}
  <div
    class="flex min-h-screen flex-col bg-ts-bg-base"
    style="--member-bottombar-h: calc(4rem + env(safe-area-inset-bottom, 0px));"
  >
    {/* ════ TOP BAR ════ */}
    <header class="border-b border-ts-border bg-ts-bg-surface/80 backdrop-blur-sm">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-4 sm:px-6 sm:py-5">
        <a
          href="/dashboard"
          class="flex items-center gap-2 rounded-ts-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ts-primary"
          aria-label="Tiny Seed Farm CSA dashboard home"
        >
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-ts-primary" aria-hidden="true"></span>
          <span class="font-display text-lg font-bold tracking-tight text-ts-text">
            Tiny Seed Farm
          </span>
        </a>

        <form method="POST" action="/logout" class="m-0">
          <button
            type="submit"
            class="rounded-ts-md px-3 py-2 text-sm font-medium text-ts-text-secondary transition-colors duration-150 hover:bg-ts-bg-muted hover:text-ts-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            Sign out
          </button>
        </form>
      </div>
    </header>

    {/* ════ MAIN ════ */}
    <main
      id="main"
      class={mainClass}
      style="padding-bottom: calc(var(--member-bottombar-h) + 1.5rem); scroll-padding-bottom: var(--member-bottombar-h);"
    >
      {back && (
        <nav aria-label="Breadcrumb" class="text-sm">
          <a
            href={back.href}
            class="inline-flex items-center gap-1 font-medium text-ts-text-secondary underline-offset-2 transition-colors duration-150 hover:text-ts-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            <span aria-hidden="true">←</span>
            <span>{back.label}</span>
          </a>
        </nav>
      )}

      <slot />

      {/* ════ FOOTER ════ */}
      <footer class="mt-auto border-t border-ts-border pt-6 text-center text-xs text-ts-text-muted">
        <p>Signed in as <span class="font-medium text-ts-text-secondary">{userEmail}</span></p>
        <p class="mt-1">Tiny Seed Farm · 257 Zeigler Rd, Rochester, PA · Certified Organic</p>
      </footer>
    </main>

    {/* ════ DOCUMENT-LEVEL OVERLAYS (box sheets / toasts) ════ */}
    {hasOverlays && <slot name="overlays" />}

    {/* ════ PERSISTENT BOTTOM TAB BAR ════
        Mobile-first, thumb-zone navigation. Visible on every member page.
        Fixed to the viewport bottom; clears the iPhone home indicator via
        env(safe-area-inset-bottom). 48px+ targets, icon + visible label,
        aria-current on the active tab. */}
    <nav
      aria-label="Primary"
      class="fixed inset-x-0 bottom-0 z-40 border-t border-ts-border bg-ts-bg-surface/95 backdrop-blur-sm"
      style="padding-bottom: env(safe-area-inset-bottom, 0px);"
    >
      <ul class="mx-auto flex max-w-3xl items-stretch">
        {navItems.map((item) => {
          const isActive = item.key === activeTab;
          return (
            <li class="flex-1">
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={[
                  'group flex h-16 flex-col items-center justify-center gap-1 px-1 text-xs font-medium transition-colors duration-150 ease-[var(--ease-ts)] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ts-primary [touch-action:manipulation]',
                  isActive
                    ? 'text-ts-primary'
                    : 'text-ts-text-muted hover:text-ts-text',
                ].join(' ')}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width={isActive ? 2 : 1.5}
                  stroke="currentColor"
                  class="h-6 w-6 transition-transform duration-150 ease-[var(--ease-ts)] group-active:scale-90"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
                <span>{item.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</BaseLayout>
