            <Card padding="md" elevation="sm">
              <div class="flex items-start gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ts-primary/10 font-display text-base font-bold text-ts-primary" aria-hidden="true">5</span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-display text-lg font-semibold text-ts-text">Cooler staging</h3>
                    <span class={`inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold ${tMoveItCount > 0 ? PILL.pending : PILL.done}`}>
                      {tMoveItCount > 0 ? <><span class="tabular-nums">{tMoveItCount}</span> to move</> : '✓ Nothing flagged'}
                    </span>
                  </div>
                  <p class="mt-1 text-sm text-ts-text-secondary">
                    <span class="font-semibold text-ts-text tabular-nums">{tActivePallets}</span> active pallet{tActivePallets === 1 ? '' : 's'} in the coolers.
                    {tMoveItCount > 0
                      ? <> <span class="font-semibold text-ts-warning tabular-nums">{tMoveItCount}</span> flagged to move.</>
                      : <> Nothing flagged to move right now.</>}
                  </p>
                  <ul class="mt-2 flex flex-col gap-1 rounded-ts-md border border-ts-border bg-ts-bg-muted/30 px-3 py-2.5 text-sm text-ts-text-secondary">
                    <li>Sewickley leaves Saturday — that unblocks South Side for Sunday.</li>
                    <li>PH-1 / PH-2 / PH-3 clear by Friday EOD so returns have a home.</li>
                  </ul>
                  <div class="mt-3">
                    <a href="/admin/cooler" class={tMoveItCount > 0 ? primaryBtn : ghostBtn}>Open cooler board →</a>
                  </div>
                </div>
              </div>
            </Card>
          </li>

          {/* 6. End of day */}
          <li>
            <Card padding="md" elevation="sm">
              <div class="flex items-start gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ts-primary/10 font-display text-base font-bold text-ts-primary" aria-hidden="true">6</span>
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-lg font-semibold text-ts-text">End of day</h3>
                  <div class="mt-3 rounded-ts-md border border-ts-border p-3">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="font-semibold text-ts-text">Fill the handoff</span>
                    </div>
                    <p class="mt-1 text-sm text-ts-text-secondary">
                      Log the end-of-day handoff so the weekend crew starts with everything they need.
                    </p>
                    <div class="mt-3">
                      <a href="/admin/handoff/new" class={ghostBtn}>New handoff →</a>
                    </div>
                  </div>
                </div>
              </div>
            </Card>
          </li>
        </ol>
      </div>
    </details>
  </section>
)}

{/* ════════════════════ SLIM strip (all other days) ════════════════════ */}
{mode === 'slim' && (
  <section aria-labelledby="today-flow-heading" class="flex flex-col gap-3">
    <h2 id="today-flow-heading" class="sr-only">Today</h2>
    <Card padding="md" elevation="sm">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0 flex-1">
          <p class="font-semibold text-ts-text">{slimDayLong}</p>
          <p class="mt-0.5 text-sm text-ts-text-secondary">
            {slimShowChefCountdown
              ? <>Chef ordering for {wedPretty} closes <span class="font-semibold text-ts-text">{CUTOFF_LABEL} ET</span> — <span class={slimChefCountdown.open ? 'font-semibold text-ts-text' : 'font-semibold text-ts-text-muted'}>{slimChefCountdown.text}</span>.</>
              : slimIsDeliveryDay
                ? <>Delivery day — check today's route and keep the stops moving.</>
                : <>No pack or delivery run today. The full Monday and Thursday flows appear here on those days.</>}
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-2">
          {slimIsDeliveryDay && <a href="/admin/route" class={primaryBtn}>Today's route →</a>}
          <a href="/admin/handoff" class={ghostBtn}>Handoff →</a>
        </div>
      </div>
    </Card>
  </section>
)}

{mode === 'mon' && (
  <script is:inline>
    // Step 2 — "Check inbox & import now": POST to the admin endpoint that reuses
    // the cron engine (skip-if-exists safe). Optimistic busy state, inline result.
    (function () {
      const btn = document.querySelector('[data-harvie-now]');
      const label = document.querySelector('[data-harvie-label]');
      const result = document.querySelector('[data-harvie-result]');
      if (!btn || !label || !result) return;

      function show(msg, ok) {
        result.hidden = false;
        result.textContent = msg;
        result.classList.remove('border-ts-primary/40', 'border-ts-danger/40');
        result.classList.add(ok ? 'border-ts-primary/40' : 'border-ts-danger/40');
      }

      btn.addEventListener('click', function () {
        if (btn.disabled) return;
        btn.disabled = true;
        const original = label.textContent;
        label.textContent = 'Checking inbox…';
        result.hidden = true;
        fetch('/api/admin/harvie-ingest-now', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { accept: 'application/json' },
          body: new FormData(),
        })
          .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
          .then(function (res) {
            const body = res.body || {};
            if (res.status !== 200 || body.ok !== true) {
              show((body && body.error) || 'Import failed. Try the manual upload.', false);
              btn.disabled = false;
              label.textContent = original;
              return;
            }
            show(body.detail || 'Done.', true);
            if (body.imported && body.imported > 0) {
              label.textContent = 'Imported — refreshing…';
              setTimeout(function () { window.location.reload(); }, 1200);
            } else {
              btn.disabled = false;
              label.textContent = original;
            }
          })
          .catch(function () {
            show('Network error. Try again, or use the manual upload.', false);
            btn.disabled = false;
            label.textContent = original;
          });
      });
    })();
  </script>
)}
