---
/**
 * CombinedHarvestRow — ONE harvest line for a group of package variants that
 * share a library.harvest_crop (e.g. "King Spring Mix" + "King Spring (Big
 * Bagz)"). The crew harvests the raw green BY WEIGHT, so we show the combined
 * TOTAL POUNDS as the headline, with the per-packaging breakdown underneath so
 * the pack team can still portion it into clamshells vs bags.
 *
 * Used by every Pick & Pack view (overall / CSA / wholesale / market) so a
 * combined line looks identical wherever it appears. Prints cleanly (same
 * .harvest-row break rules as the normal rows).
 */
interface Variant { crop: string; qty: number; unit: string; lb: number | null; }
interface Props {
  harvestCrop: string;
  totalLb: number;
  variants: Variant[];
  /** "10.5 lb" formatter passed in so it matches the page's number style. */
  fmtLb: (lb: number) => string;
}
const { harvestCrop, totalLb, variants, fmtLb } = Astro.props as Props;
/** One breakdown fragment: prefer pounds, else the raw count (no pack weight). */
function part(v: Variant): string {
  const amount = v.lb != null ? fmtLb(v.lb) : `${v.qty.toLocaleString()} ${v.unit}`;
  return `${amount} ${v.crop}`;
}
---
<li class="harvest-row flex items-start gap-4 border-b border-ts-border/60 py-3">
  <span
    class="harvest-check mt-0.5 inline-block h-7 w-7 shrink-0 rounded border-2 border-ts-text bg-white print:border-black"
    aria-hidden="true"
  ></span>
  <div class="min-w-0 flex-1 pp-namewrap">
    <p class="pp-crop text-xl font-bold leading-tight text-ts-text">
      {harvestCrop}
      <span class="ml-2 align-middle text-xs font-bold text-ts-primary">combined</span>
    </p>
    <p class="pp-variants mt-0.5 text-sm font-medium text-ts-text-secondary">
      → {variants.map((v) => part(v)).join('  ·  ')}
    </p>
  </div>
  <span class="pp-leader hidden" aria-hidden="true"></span>
  <div class="shrink-0 text-right pp-amount">
    {totalLb > 0
      ? <>
          <span class="pp-qty font-display text-3xl font-extrabold tabular-nums leading-none text-ts-text">{fmtLb(totalLb)}</span>
          <p class="pp-lb-label mt-0.5 text-xs font-semibold text-ts-text-secondary">to harvest</p>
        </>
      : <span class="text-xs font-semibold text-ts-text-muted">set pack weight</span>}
  </div>
</li>
