---
/**
 * DeliveryTracker — real-time delivery status widget for the member
 * dashboard. V2 (Day 9, 2026-05-11): native Supabase Realtime, no
 * polling-as-primary, no Apps Script.
 *
 * Visual states (seven):
 *   none              — root <section> hidden (caller's gate filtered).
 *   packed            — route exists but not started yet.
 *   out_for_delivery  — route in_progress, this stop pending.
 *   near_you          — this stop is one of the next 1-2 remaining.
 *   arrived           — admin tapped Arrived at this stop.
 *   delivered         — admin tapped Delivered + photo uploaded.
 *   exception         — admin reported an issue with this stop.
 *
 * Real-time:
 *   1. SSR renders the initial state.
 *   2. On mount, the client subscribes to Supabase Realtime via the
 *      anon client (RLS-enforced) on two filters:
 *        a. delivery_stops:id=eq.{stop_id} for THIS member's stop
 *        b. delivery_routes:id=eq.{route_id} for the parent route
 *   3. On any UPDATE event, the client fetches `/api/delivery/today`
 *      to recompute the derived state server-side (we can't run
 *      deriveState in the browser reliably without all-stops, which
 *      RLS hides from members). This is one tiny GET per state change
 *      — typically 5-10 per delivery.
 *   4. If the WebSocket drops, we fall back to a 60s poll.
 *
 * Privacy:
 *   - Driver shown by first name only.
 *   - No GPS map.
 *   - Member sees only THEIR stop via RLS.
 *
 * Props:
 *   - initialStatus    The status fetched server-side at SSR.
 *   - pickupDateLabel  Pretty date string for the "packed for ___" copy.
 *   - supabaseUrl      For the client-side Realtime connection.
 *   - supabaseAnonKey  Anon JWT for Realtime subscription. RLS is
 *                      enforced via the user's session cookie that
 *                      the Realtime client picks up automatically
 *                      from the SDK.
 */
import type { DeliveryStatus } from '../lib/delivery';
import { PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY } from 'astro:env/client';

interface Props {
  initialStatus: DeliveryStatus;
  pickupDateLabel: string;
}

const { initialStatus, pickupDateLabel } = Astro.props as Props;

// Time formatting helpers — both ETA and Completed_At may come as
// ISO timestamps OR short clock strings.
function formatTime(raw: string | null): string {
  if (!raw) return '';
  const trimmed = String(raw).trim();
  if (/^\d{1,2}:\d{2}(?:\s?(?:AM|PM|am|pm))?$/.test(trimmed)) return trimmed.toUpperCase();
  const d = new Date(trimmed);
  if (Number.isNaN(d.getTime())) return trimmed;
  return new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/New_York',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  }).format(d);
}

const etaPretty = formatTime(initialStatus.eta);
const completedPretty = formatTime(initialStatus.completed_at);
const lastUpdatedPretty = formatTime(initialStatus.last_updated);
const driverFirst = initialStatus.driver_name ?? '';
const state = initialStatus.state;
---

<section
  aria-labelledby="delivery-tracker-heading"
  data-delivery-tracker
  data-state={state}
  data-stop-id={initialStatus.stop_id ?? ''}
  data-route-id={initialStatus.route_id ?? ''}
  data-supabase-url={PUBLIC_SUPABASE_URL}
  data-supabase-anon-key={PUBLIC_SUPABASE_ANON_KEY}
  class:list={[
    "relative overflow-hidden rounded-ts-xl border bg-ts-bg-surface shadow-ts-md transition-all duration-300",
    state === 'none'      ? 'hidden' : '',
    state === 'packed'    ? 'border-ts-border' : '',
    state === 'out_for_delivery' ? 'border-ts-primary/30 bg-ts-primary/5' : '',
    state === 'near_you'  ? 'border-ts-primary/40 bg-ts-primary/5' : '',
    state === 'arrived'   ? 'border-ts-primary/40 bg-ts-primary/5' : '',
    state === 'delivered' ? 'border-ts-primary/30 bg-ts-primary/5' : '',
    state === 'exception' ? 'border-ts-danger/30 bg-ts-danger/5' : '',
  ]}
>
  <span
    aria-hidden="true"
    data-pulse={state === 'out_for_delivery' || state === 'near_you' || state === 'arrived' ? state : 'off'}
    class="pointer-events-none absolute inset-0"
  ></span>

  <div class="relative p-5 sm:p-6">
    <header class="flex items-start gap-3">
      <span
        data-icon
        aria-hidden="true"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-xl"
        class:list={[
          state === 'packed'           ? 'bg-ts-bg-muted text-ts-text-secondary' : '',
          state === 'out_for_delivery' ? 'bg-ts-primary/15 text-ts-primary' : '',
          state === 'near_you'         ? 'bg-ts-primary/20 text-ts-primary' : '',
          state === 'arrived'          ? 'bg-ts-primary/25 text-ts-primary' : '',
          state === 'delivered'        ? 'bg-ts-primary/15 text-ts-primary' : '',
          state === 'exception'        ? 'bg-ts-danger/15 text-ts-danger' : '',
        ]}
      >
        <span data-icon-glyph>
          {state === 'packed'           && '📦'}
          {state === 'out_for_delivery' && '🚚'}
          {state === 'near_you'         && '📍'}
          {state === 'arrived'          && '🚪'}
          {state === 'delivered'        && '✓'}
          {state === 'exception'        && '!'}
        </span>
      </span>

      <div class="min-w-0 flex-1">
        <h2
          id="delivery-tracker-heading"
          data-heading
          class="font-display text-lg font-semibold text-ts-text sm:text-xl"
        >
          {state === 'packed'           && `Your box is being packed for ${pickupDateLabel}`}
          {state === 'out_for_delivery' && (driverFirst
            ? `${driverFirst} is on the road`
            : 'Your box is out for delivery')}
          {state === 'near_you'         && (driverFirst
            ? `${driverFirst} is approaching`
            : 'Driver is approaching')}
          {state === 'arrived'          && (driverFirst
            ? `${driverFirst} has arrived`
            : 'The driver has arrived')}
          {state === 'delivered'        && 'Delivered'}
          {state === 'exception'        && 'We had an issue with your delivery'}
        </h2>

        <p data-subheading class="mt-1 text-sm leading-relaxed text-ts-text-secondary">
          {state === 'packed' && (
            <span>We'll update this card the moment the driver heads out.</span>
          )}
          {state === 'out_for_delivery' && (
            <span>
              {etaPretty ? <>ETA at your stop <span class="font-medium tabular-nums text-ts-text">{etaPretty}</span></> : 'Your box is on its way.'}
            </span>
          )}
          {state === 'near_you' && (
            <span>
              <span class="font-medium text-ts-text">~5 min away</span>
              {etaPretty && <> · ETA <span class="tabular-nums">{etaPretty}</span></>}
            </span>
          )}
          {state === 'arrived' && (
            <span>Dropping off now.</span>
          )}
          {state === 'delivered' && (
            <span>
              {completedPretty
                ? <>Marked delivered at <span class="font-medium tabular-nums text-ts-text">{completedPretty}</span></>
                : 'Your box has been delivered.'}
            </span>
          )}
          {state === 'exception' && (
            <span>
              We'll be in touch shortly.
              {initialStatus.issue_notes && (
                <span class="ml-1 text-ts-text-secondary"> {initialStatus.issue_notes}</span>
              )}
            </span>
          )}
        </p>
      </div>
    </header>

    {/* Delivery photo block. Renders inline only when state='delivered' AND photo_url set. */}
    {state === 'delivered' && initialStatus.photo_url && (
      <div data-photo-block class="mt-5">
        <button
          type="button"
          data-photo-trigger
          class="group inline-block overflow-hidden rounded-ts-lg border border-ts-border bg-ts-bg-muted transition-shadow duration-200 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          aria-label="View delivery photo full size"
        >
          <img
            data-photo-thumb
            src={initialStatus.photo_url}
            alt="Photo of your delivered box"
            width="240"
            height="240"
            loading="lazy"
            decoding="async"
            class="block h-[240px] w-[240px] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </button>
      </div>
    )}
    {!(state === 'delivered' && initialStatus.photo_url) && (
      <div data-photo-block class="mt-5 hidden">
        <button
          type="button"
          data-photo-trigger
          class="group inline-block overflow-hidden rounded-ts-lg border border-ts-border bg-ts-bg-muted transition-shadow duration-200 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          aria-label="View delivery photo full size"
        >
          <img
            data-photo-thumb
            src=""
            alt="Photo of your delivered box"
            width="240"
            height="240"
            loading="lazy"
            decoding="async"
            class="block h-[240px] w-[240px] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </button>
      </div>
    )}

    {state === 'exception' && (
      <div data-issue-block class="mt-4">
        <a
          href="mailto:todd@tinyseedfarmpgh.com?subject=CSA%20delivery%20issue"
          class="inline-flex h-9 items-center rounded-ts-md border border-ts-danger/30 bg-ts-bg-surface px-3 text-sm font-semibold text-ts-danger transition-colors duration-150 hover:bg-ts-danger/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-danger"
        >
          Email Todd directly
        </a>
      </div>
    )}

    <footer class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-ts-border/60 pt-3">
      <p class="text-xs text-ts-text-muted">
        Updated <span data-last-updated>{lastUpdatedPretty}</span>
        <span data-poll-indicator aria-hidden="true" class="ml-1 inline-block align-middle text-ts-text-muted/60"></span>
      </p>
      <p class="text-xs text-ts-text-muted" data-conn-indicator>
        Live updates
      </p>
    </footer>
  </div>

  {/* Photo lightbox */}
  <dialog
    data-photo-lightbox
    class="m-0 max-h-[100dvh] max-w-[100dvw] bg-transparent p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
    aria-label="Delivery photo"
  >
    <form method="dialog" class="m-0 p-0">
      <div class="flex h-[100dvh] w-[100dvw] items-center justify-center p-4">
        <div class="relative max-h-full max-w-full">
          <img
            data-photo-full
            src=""
            alt="Photo of your delivered box, full size"
            class="block max-h-[88dvh] max-w-[92dvw] rounded-ts-lg object-contain shadow-ts-xl"
          />
          <button
            type="submit"
            data-photo-close
            aria-label="Close photo"
            class="absolute -top-3 -right-3 flex h-10 w-10 items-center justify-center rounded-full bg-ts-bg-surface text-ts-text shadow-ts-md transition-transform duration-150 hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>
      </div>
    </form>
  </dialog>
</section>

<style>
  [data-pulse="out_for_delivery"]::before,
  [data-pulse="near_you"]::before,
  [data-pulse="arrived"]::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--color-ts-primary);
    opacity: 0;
    animation: ts-delivery-pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  [data-pulse="near_you"]::before { animation-duration: 1.4s; }
  [data-pulse="arrived"]::before  { animation-duration: 1.0s; }

  @keyframes ts-delivery-pulse {
    0%   { opacity: 0.6; transform: scale(1); }
    70%  { opacity: 0; transform: scale(1.01); }
    100% { opacity: 0; transform: scale(1.01); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-pulse="out_for_delivery"]::before,
    [data-pulse="near_you"]::before,
    [data-pulse="arrived"]::before {
      animation: none;
      opacity: 0;
    }
  }

  dialog[data-photo-lightbox] { border: none; }
</style>

<script>
  // ────────────────────────────────────────────────────────────────────
  // Delivery tracker — V2 client logic with Supabase Realtime
  // ────────────────────────────────────────────────────────────────────
  //
  // 1. On mount: subscribe to the two channels via @supabase/supabase-js
  //    (loaded via the same SDK the rest of the portal uses).
  // 2. On any change: re-fetch /api/delivery/today (RLS-scoped, derives
  //    state server-side with full visibility into route.status).
  // 3. Apply the response to the DOM in place (no innerHTML, no
  //    re-render).
  // 4. Fall back to a 60s poll if Realtime disconnects.

  import { createClient } from '@supabase/supabase-js';

  const root = document.querySelector<HTMLElement>('[data-delivery-tracker]');
  if (root) {
    const stopId = root.getAttribute('data-stop-id') || '';
    const routeId = root.getAttribute('data-route-id') || '';
    const supabaseUrl = root.getAttribute('data-supabase-url') || '';
    const supabaseAnonKey = root.getAttribute('data-supabase-anon-key') || '';

    // DOM refs scoped to this widget instance.
    const headingEl       = root.querySelector<HTMLElement>('[data-heading]');
    const subheadingEl    = root.querySelector<HTMLElement>('[data-subheading]');
    const pulseEl         = root.querySelector<HTMLElement>('[data-pulse]');
    const iconEl          = root.querySelector<HTMLElement>('[data-icon]');
    const iconGlyphEl     = root.querySelector<HTMLElement>('[data-icon-glyph]');
    const photoBlockEl    = root.querySelector<HTMLElement>('[data-photo-block]');
    const photoThumbEl    = root.querySelector<HTMLImageElement>('[data-photo-thumb]');
    const photoFullEl     = root.querySelector<HTMLImageElement>('[data-photo-full]');
    const photoTriggerEl  = root.querySelector<HTMLButtonElement>('[data-photo-trigger]');
    const lightboxEl      = root.querySelector<HTMLDialogElement>('[data-photo-lightbox]');
    const lastUpdatedEl   = root.querySelector<HTMLElement>('[data-last-updated]');
    const pollIndicatorEl = root.querySelector<HTMLElement>('[data-poll-indicator]');
    const connIndicatorEl = root.querySelector<HTMLElement>('[data-conn-indicator]');

    let lastUpdatedISO = new Date().toISOString();
    let inFlight = false;
    let pollTimer: ReturnType<typeof setInterval> | null = null;

    type StatusPayload = {
      state: string;
      stop_id: string | null;
      route_id: string | null;
      eta: string | null;
      driver_name: string | null;
      completed_at: string | null;
      photo_url: string | null;
      issue_notes: string | null;
      last_updated: string;
    };

    function fmtTime(raw: string | null): string {
      if (!raw) return '';
      const trimmed = String(raw).trim();
      if (/^\d{1,2}:\d{2}(?:\s?(?:AM|PM|am|pm))?$/.test(trimmed)) return trimmed.toUpperCase();
      const d = new Date(trimmed);
      if (Number.isNaN(d.getTime())) return trimmed;
      return new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        hour: 'numeric', minute: '2-digit', hour12: true,
      }).format(d);
    }
    function fmtRelative(isoString: string): string {
      const then = new Date(isoString);
      if (Number.isNaN(then.getTime())) return '';
      const deltaSec = Math.max(0, Math.round((Date.now() - then.getTime()) / 1000));
      if (deltaSec < 5) return 'just now';
      if (deltaSec < 60) return `${deltaSec}s ago`;
      const deltaMin = Math.round(deltaSec / 60);
      if (deltaMin < 60) return `${deltaMin}m ago`;
      return fmtTime(isoString);
    }

    const TONE_CLASSES: Record<string, string[]> = {
      none:      ['border-ts-border'],
      packed:    ['border-ts-border'],
      out_for_delivery: ['border-ts-primary/30', 'bg-ts-primary/5'],
      near_you:  ['border-ts-primary/40', 'bg-ts-primary/5'],
      arrived:   ['border-ts-primary/40', 'bg-ts-primary/5'],
      delivered: ['border-ts-primary/30', 'bg-ts-primary/5'],
      exception: ['border-ts-danger/30', 'bg-ts-danger/5'],
    };
    const ALL_TONE_CLASSES = Array.from(new Set(Object.values(TONE_CLASSES).flat()));

    const ICON_TONE_CLASSES: Record<string, string[]> = {
      none:      ['bg-ts-bg-muted', 'text-ts-text-secondary'],
      packed:    ['bg-ts-bg-muted', 'text-ts-text-secondary'],
      out_for_delivery: ['bg-ts-primary/15', 'text-ts-primary'],
      near_you:  ['bg-ts-primary/20', 'text-ts-primary'],
      arrived:   ['bg-ts-primary/25', 'text-ts-primary'],
      delivered: ['bg-ts-primary/15', 'text-ts-primary'],
      exception: ['bg-ts-danger/15', 'text-ts-danger'],
    };
    const ALL_ICON_TONE_CLASSES = Array.from(new Set(Object.values(ICON_TONE_CLASSES).flat()));

    const ICON_GLYPHS: Record<string, string> = {
      none: '', packed: '📦', out_for_delivery: '🚚',
      near_you: '📍', arrived: '🚪', delivered: '✓', exception: '!',
    };

    function applyStatus(status: StatusPayload): void {
      const state = status.state;
      const driverFirst = status.driver_name || '';
      const etaPretty = fmtTime(status.eta);
      const completedPretty = fmtTime(status.completed_at);

      root!.setAttribute('data-state', state);
      if (state === 'none') root!.classList.add('hidden');
      else root!.classList.remove('hidden');
      root!.classList.remove(...ALL_TONE_CLASSES);
      (TONE_CLASSES[state] || []).forEach((c) => root!.classList.add(c));

      if (pulseEl) {
        pulseEl.setAttribute('data-pulse',
          state === 'out_for_delivery' || state === 'near_you' || state === 'arrived' ? state : 'off'
        );
      }

      if (iconEl) {
        iconEl.classList.remove(...ALL_ICON_TONE_CLASSES);
        (ICON_TONE_CLASSES[state] || []).forEach((c) => iconEl.classList.add(c));
      }
      if (iconGlyphEl) iconGlyphEl.textContent = ICON_GLYPHS[state] || '';

      if (headingEl) {
        let heading = '';
        switch (state) {
          case 'packed':           heading = headingEl.textContent || ''; break;
          case 'out_for_delivery': heading = driverFirst ? `${driverFirst} is on the road` : 'Your box is out for delivery'; break;
          case 'near_you':         heading = driverFirst ? `${driverFirst} is approaching` : 'Driver is approaching'; break;
          case 'arrived':          heading = driverFirst ? `${driverFirst} has arrived` : 'The driver has arrived'; break;
          case 'delivered':        heading = 'Delivered'; break;
          case 'exception':        heading = 'We had an issue with your delivery'; break;
        }
        if (state !== 'packed') headingEl.textContent = heading;
      }

      if (subheadingEl) {
        subheadingEl.textContent = '';
        switch (state) {
          case 'packed':
            subheadingEl.textContent = "We'll update this card the moment the driver heads out.";
            break;
          case 'out_for_delivery':
            if (etaPretty) {
              subheadingEl.appendChild(document.createTextNode('ETA at your stop '));
              const span = document.createElement('span');
              span.className = 'font-medium tabular-nums text-ts-text';
              span.textContent = etaPretty;
              subheadingEl.appendChild(span);
            } else {
              subheadingEl.textContent = 'Your box is on its way.';
            }
            break;
          case 'near_you': {
            const a = document.createElement('span');
            a.className = 'font-medium text-ts-text';
            a.textContent = '~5 min away';
            subheadingEl.appendChild(a);
            if (etaPretty) {
              subheadingEl.appendChild(document.createTextNode(' · ETA '));
              const b = document.createElement('span');
              b.className = 'tabular-nums';
              b.textContent = etaPretty;
              subheadingEl.appendChild(b);
            }
            break;
          }
          case 'arrived':
            subheadingEl.textContent = 'Dropping off now.';
            break;
          case 'delivered':
            if (completedPretty) {
              subheadingEl.appendChild(document.createTextNode('Marked delivered at '));
              const span = document.createElement('span');
              span.className = 'font-medium tabular-nums text-ts-text';
              span.textContent = completedPretty;
              subheadingEl.appendChild(span);
            } else {
              subheadingEl.textContent = 'Your box has been delivered.';
            }
            break;
          case 'exception':
            subheadingEl.appendChild(document.createTextNode("We'll be in touch shortly."));
            if (status.issue_notes) {
              const span = document.createElement('span');
              span.className = 'ml-1 text-ts-text-secondary';
              span.textContent = ' ' + status.issue_notes;
              subheadingEl.appendChild(span);
            }
            break;
        }
      }

      if (photoBlockEl && photoThumbEl && photoFullEl) {
        if (state === 'delivered' && status.photo_url) {
          photoThumbEl.src = status.photo_url;
          photoFullEl.src = status.photo_url;
          photoBlockEl.classList.remove('hidden');
        } else {
          photoBlockEl.classList.add('hidden');
        }
      }

      lastUpdatedISO = status.last_updated || new Date().toISOString();
      if (lastUpdatedEl) lastUpdatedEl.textContent = fmtRelative(lastUpdatedISO);
    }

    async function refresh(): Promise<void> {
      if (inFlight) return;
      if (document.visibilityState !== 'visible') return;
      inFlight = true;
      if (pollIndicatorEl) pollIndicatorEl.textContent = ' · checking…';
      try {
        const res = await fetch('/api/delivery/today', {
          method: 'GET',
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' },
        });
        if (!res.ok) {
          if (res.status === 401) {
            stopFallbackPoll();
            return;
          }
          return;
        }
        const status = (await res.json()) as StatusPayload;
        applyStatus(status);
      } catch (e) {
        console.warn('[delivery-tracker] refresh failed:', e instanceof Error ? e.message : e);
      } finally {
        inFlight = false;
        if (pollIndicatorEl) pollIndicatorEl.textContent = '';
      }
    }

    // ─── Fallback poll — used when Realtime is not connected ─────────
    function startFallbackPoll(): void {
      stopFallbackPoll();
      pollTimer = setInterval(refresh, 60_000);
    }
    function stopFallbackPoll(): void {
      if (pollTimer) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    // ─── Realtime subscription ──────────────────────────────────────
    let realtimeConnected = false;
    function setConnStatus(connected: boolean): void {
      realtimeConnected = connected;
      if (connIndicatorEl) {
        connIndicatorEl.textContent = connected ? 'Live updates' : 'Updates every minute';
      }
    }

    if (supabaseUrl && supabaseAnonKey && stopId && routeId) {
      try {
        const supabase = createClient(supabaseUrl, supabaseAnonKey, {
          auth: { persistSession: false, autoRefreshToken: false },
        });
        const channel = supabase.channel(`delivery:${routeId}:${stopId}`)
          .on(
            'postgres_changes',
            { event: 'UPDATE', schema: 'public', table: 'delivery_stops', filter: `id=eq.${stopId}` },
            () => { refresh(); }
          )
          .on(
            'postgres_changes',
            { event: 'UPDATE', schema: 'public', table: 'delivery_routes', filter: `id=eq.${routeId}` },
            () => { refresh(); }
          )
          .subscribe((status) => {
            if (status === 'SUBSCRIBED') {
              setConnStatus(true);
              stopFallbackPoll();
            } else if (status === 'CHANNEL_ERROR' || status === 'TIMED_OUT' || status === 'CLOSED') {
              setConnStatus(false);
              startFallbackPoll();
            }
          });

        // Cleanup on page unload to avoid leaking WS connections.
        window.addEventListener('beforeunload', () => {
          try { supabase.removeChannel(channel); } catch (_) { /* noop */ }
        });
      } catch (e) {
        console.warn('[delivery-tracker] realtime init failed:', e instanceof Error ? e.message : e);
        setConnStatus(false);
        startFallbackPoll();
      }
    } else {
      // No stop yet (state='none' or 'packed' before route created) —
      // poll so the widget catches the moment the route appears.
      setConnStatus(false);
      startFallbackPoll();
    }

    // ─── Visibility handling — pause polling when tab hidden ────────
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        refresh();
        if (!realtimeConnected) startFallbackPoll();
      } else {
        stopFallbackPoll();
      }
    });

    // ─── Lightbox wiring ────────────────────────────────────────────
    if (photoTriggerEl && lightboxEl) {
      photoTriggerEl.addEventListener('click', () => {
        if (typeof lightboxEl.showModal === 'function') lightboxEl.showModal();
        else {
          lightboxEl.setAttribute('open', '');
          lightboxEl.style.display = 'block';
        }
      });
      lightboxEl.addEventListener('click', (event) => {
        if (event.target === lightboxEl) lightboxEl.close?.();
      });
      lightboxEl.addEventListener('close', () => {
        photoTriggerEl.focus();
      });
    }

    // ─── "Updated 12s ago" tick ─────────────────────────────────────
    setInterval(() => {
      if (lastUpdatedEl) lastUpdatedEl.textContent = fmtRelative(lastUpdatedISO);
    }, 1000);
  }
</script>
