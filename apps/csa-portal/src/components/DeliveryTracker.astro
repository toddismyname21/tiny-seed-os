---
/**
 * DeliveryTracker — real-time delivery status widget for the member
 * dashboard. Renders the current state server-side, then polls
 * `/api/delivery-status` to stay fresh.
 *
 * Visual states:
 *   none              — root <section> not rendered (caller's gate
 *                       already filtered, but defensive in case JS
 *                       receives a 'none' update mid-session).
 *   packed            — neutral card, "being packed for [date]".
 *   out_for_delivery  — primary tone + pulse animation, driver name + ETA.
 *   near_you          — primary tone + faster pulse, "approaching ~5 min".
 *   delivered         — primary tone, no pulse, photo (240×240) if present.
 *   issue             — danger tone, issue notes, contact link.
 *
 * Polling:
 *   60s default, 15s when state === 'out_for_delivery' (driver actively
 *   moving toward the member's stop). Paused via Page Visibility API
 *   when the tab is hidden — saves Apps Script quota + member's battery.
 *
 * Privacy:
 *   - Driver shown by first name only (resolved server-side in
 *     `firstNameOf`). The widget can never display a last name even
 *     if Apps Script sends one (defense in depth).
 *   - No GPS map in Phase 1. Coordinates from Apps Script are
 *     intentionally ignored.
 *   - Member sees only THEIR stop — the SSR + API both filter to the
 *     row matching their `customers.legacy_id`.
 *
 * Props:
 *   - initialStatus   The status fetched server-side at page render.
 *   - pickupDateLabel Pretty date string for the "packed for ___" copy
 *                     (e.g. "Wed May 14") — produced by the caller in
 *                     America/New_York to avoid TZ confusion.
 */
import type { DeliveryStatus } from '../lib/delivery';

interface Props {
  initialStatus: DeliveryStatus;
  pickupDateLabel: string;
}

const { initialStatus, pickupDateLabel } = Astro.props as Props;

// Pretty time helpers — both ETA and Completed_At may come from Apps
// Script as ISO timestamps OR short "4:15 PM"-style strings. The
// helpers below cope with either and never throw.

/**
 * "4:15 PM" given ISO or already-formatted input. Returns the input
 * verbatim if it's not parseable, since Apps Script sometimes
 * pre-formats ETAs ("4:15 PM") as text in the sheet.
 */
function formatTime(raw: string | null): string {
  if (!raw) return '';
  const trimmed = String(raw).trim();
  // Heuristic: if the string already looks like a clock ("4:15 PM",
  // "16:30"), don't try to parse + reformat — pass through.
  if (/^\d{1,2}:\d{2}(?:\s?(?:AM|PM|am|pm))?$/.test(trimmed)) return trimmed.toUpperCase();
  const d = new Date(trimmed);
  if (Number.isNaN(d.getTime())) return trimmed;
  return new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/New_York',
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  }).format(d);
}

/**
 * "12:14 PM" — same as formatTime but for ISO Completed_At timestamps.
 */
function formatTimestamp(raw: string | null): string {
  if (!raw) return '';
  return formatTime(raw);
}

const etaPretty = formatTime(initialStatus.eta);
const completedPretty = formatTimestamp(initialStatus.completed_at);
const lastUpdatedPretty = formatTimestamp(initialStatus.last_updated);

// Driver string — already first-name-only from `firstNameOf` in lib.
const driverFirst = initialStatus.driver_name ?? '';

// State-derived flags consumed by the markup below. We encode visual
// intent as class names so CSS / Tailwind drives the look, not JS.
const state = initialStatus.state;
---

{/*
   The widget intentionally always renders the wrapper (even for state
   = 'none') so the client-side update path can flip states without
   re-running SSR. CSS hides it when state='none' via the data-state
   attribute. Caller is still expected to skip rendering entirely on
   non-delivery days (we don't poll a hidden widget — efficiency).
*/}
<section
  aria-labelledby="delivery-tracker-heading"
  data-delivery-tracker
  data-state={state}
  class:list={[
    "relative overflow-hidden rounded-ts-xl border bg-ts-bg-surface shadow-ts-md transition-all duration-300",
    state === 'none'      ? 'hidden' : '',
    state === 'packed'    ? 'border-ts-border' : '',
    state === 'out_for_delivery' ? 'border-ts-primary/30 bg-ts-primary/5' : '',
    state === 'near_you'  ? 'border-ts-primary/40 bg-ts-primary/5' : '',
    state === 'delivered' ? 'border-ts-primary/30 bg-ts-primary/5' : '',
    state === 'issue'     ? 'border-ts-danger/30 bg-ts-danger/5' : '',
  ]}
>
  {/*
     Pulse layer — only animated for states that demand attention.
     Uses `data-pulse` so the JS poller can toggle it directly without
     re-rendering. CSS keyframes defined in the <style> block.
  */}
  <span
    aria-hidden="true"
    data-pulse={state === 'out_for_delivery' || state === 'near_you' ? state : 'off'}
    class="pointer-events-none absolute inset-0"
  ></span>

  <div class="relative p-5 sm:p-6">
    <header class="flex items-start gap-3">
      <span
        data-icon
        aria-hidden="true"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-xl"
        class:list={[
          state === 'packed'           ? 'bg-ts-bg-muted text-ts-text-secondary' : '',
          state === 'out_for_delivery' ? 'bg-ts-primary/15 text-ts-primary' : '',
          state === 'near_you'         ? 'bg-ts-primary/20 text-ts-primary' : '',
          state === 'delivered'        ? 'bg-ts-primary/15 text-ts-primary' : '',
          state === 'issue'            ? 'bg-ts-danger/15 text-ts-danger' : '',
        ]}
      >
        <span data-icon-glyph>
          {state === 'packed'           && '📦'}
          {state === 'out_for_delivery' && '🚚'}
          {state === 'near_you'         && '📍'}
          {state === 'delivered'        && '✓'}
          {state === 'issue'            && '!'}
        </span>
      </span>

      <div class="min-w-0 flex-1">
        <h2
          id="delivery-tracker-heading"
          data-heading
          class="font-display text-lg font-semibold text-ts-text sm:text-xl"
        >
          {state === 'packed'           && `Your box is being packed for ${pickupDateLabel}`}
          {state === 'out_for_delivery' && (driverFirst
            ? `Driver ${driverFirst} is on the road`
            : 'Your box is out for delivery')}
          {state === 'near_you'         && (driverFirst
            ? `Driver ${driverFirst} is approaching`
            : 'Driver is approaching')}
          {state === 'delivered'        && 'Delivered'}
          {state === 'issue'            && 'We had an issue with your delivery'}
        </h2>

        <p data-subheading class="mt-1 text-sm leading-relaxed text-ts-text-secondary">
          {state === 'packed' && (
            <span>We'll update this card once the driver is on the road.</span>
          )}
          {state === 'out_for_delivery' && (
            <span>
              {etaPretty ? <>ETA at your stop <span class="font-medium tabular-nums text-ts-text">{etaPretty}</span></> : 'Your box is on its way.'}
            </span>
          )}
          {state === 'near_you' && (
            <span>
              <span class="font-medium text-ts-text">~5 min away</span>
              {etaPretty && <> · ETA <span class="tabular-nums">{etaPretty}</span></>}
            </span>
          )}
          {state === 'delivered' && (
            <span>
              {completedPretty
                ? <>Marked delivered at <span class="font-medium tabular-nums text-ts-text">{completedPretty}</span></>
                : 'Your box has been delivered.'}
            </span>
          )}
          {state === 'issue' && (
            <span>
              We'll be in touch shortly.
              {initialStatus.issue_notes && (
                <span class="ml-1 text-ts-text-secondary"> {initialStatus.issue_notes}</span>
              )}
            </span>
          )}
        </p>
      </div>
    </header>

    {/*
       Delivery photo — only renders when state === 'delivered' AND a
       photo URL is present. We use a native <details>/<summary>-style
       click-to-expand pattern but implemented as a plain <button>
       toggling a modal for finer styling control. The thumbnail is
       240×240 fixed per spec; the expanded view is full-width.
    */}
    {state === 'delivered' && initialStatus.photo_url && (
      <div data-photo-block class="mt-5">
        <button
          type="button"
          data-photo-trigger
          class="group inline-block overflow-hidden rounded-ts-lg border border-ts-border bg-ts-bg-muted transition-shadow duration-200 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          aria-label="View delivery photo full size"
        >
          <img
            data-photo-thumb
            src={initialStatus.photo_url}
            alt="Photo of your delivered box"
            width="240"
            height="240"
            loading="lazy"
            decoding="async"
            class="block h-[240px] w-[240px] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </button>
      </div>
    )}
    {/*
       For non-delivered states we still emit a hidden block so the
       client-side update path can populate it when state flips to
       'delivered'. The JS in the <script> below shows/hides this.
    */}
    {!(state === 'delivered' && initialStatus.photo_url) && (
      <div data-photo-block class="mt-5 hidden">
        <button
          type="button"
          data-photo-trigger
          class="group inline-block overflow-hidden rounded-ts-lg border border-ts-border bg-ts-bg-muted transition-shadow duration-200 hover:shadow-ts-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          aria-label="View delivery photo full size"
        >
          <img
            data-photo-thumb
            src=""
            alt="Photo of your delivered box"
            width="240"
            height="240"
            loading="lazy"
            decoding="async"
            class="block h-[240px] w-[240px] object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </button>
      </div>
    )}

    {/*
       Issue-state CTA — visible only when state === 'issue'. Linked
       to a pre-filled mailto so members can reply with context. The
       mailto is statically composed (no PII in the URL beyond the
       subject) so it works with the user's default mail client.
    */}
    {state === 'issue' && (
      <div data-issue-block class="mt-4">
        <a
          href="mailto:todd@tinyseedfarmpgh.com?subject=CSA%20delivery%20issue"
          class="inline-flex h-9 items-center rounded-ts-md border border-ts-danger/30 bg-ts-bg-surface px-3 text-sm font-semibold text-ts-danger transition-colors duration-150 hover:bg-ts-danger/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-danger"
        >
          Email Todd directly
        </a>
      </div>
    )}

    <footer class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-ts-border/60 pt-3">
      <p class="text-xs text-ts-text-muted">
        Updated <span data-last-updated>{lastUpdatedPretty}</span>
        <span data-poll-indicator aria-hidden="true" class="ml-1 inline-block align-middle text-ts-text-muted/60"></span>
      </p>
      <p class="text-xs text-ts-text-muted">
        Phase 1 · status updates every minute
      </p>
    </footer>
  </div>

  {/*
     Lightbox dialog for the proof-of-delivery photo. Hidden by
     default — opened by the photo-trigger button. Closing options:
     click backdrop, press Escape, click the close button. Focus
     returns to the trigger on close.
  */}
  <dialog
    data-photo-lightbox
    class="m-0 max-h-[100dvh] max-w-[100dvw] bg-transparent p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm"
    aria-label="Delivery photo"
  >
    <form method="dialog" class="m-0 p-0">
      <div class="flex h-[100dvh] w-[100dvw] items-center justify-center p-4">
        <div class="relative max-h-full max-w-full">
          <img
            data-photo-full
            src=""
            alt="Photo of your delivered box, full size"
            class="block max-h-[88dvh] max-w-[92dvw] rounded-ts-lg object-contain shadow-ts-xl"
          />
          <button
            type="submit"
            data-photo-close
            aria-label="Close photo"
            class="absolute -top-3 -right-3 flex h-10 w-10 items-center justify-center rounded-full bg-ts-bg-surface text-ts-text shadow-ts-md transition-transform duration-150 hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ts-primary"
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>
      </div>
    </form>
  </dialog>
</section>

{/*
   ─────────────────────────────────────────────────────────────────
   Styles. Pulse keyframes are defined here (not in global.css)
   because they're only used by this widget — keeps the global
   stylesheet lean. `prefers-reduced-motion` disables the pulse so
   we don't trigger vestibular issues; the colored card still
   conveys urgency visually.
   ───────────────────────────────────────────────────────────────── */}
<style>
  /*
     Pulse animation — a soft expanding ring that draws attention
     without being disruptive. Slower for 'out_for_delivery' (still
     ETA-distant) and faster for 'near_you' (driver imminent).
  */
  [data-pulse="out_for_delivery"]::before,
  [data-pulse="near_you"]::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--color-ts-primary);
    opacity: 0;
    animation: ts-delivery-pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  [data-pulse="near_you"]::before {
    animation-duration: 1.4s;
  }

  @keyframes ts-delivery-pulse {
    0%   { opacity: 0.6; transform: scale(1); }
    70%  { opacity: 0; transform: scale(1.01); }
    100% { opacity: 0; transform: scale(1.01); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-pulse="out_for_delivery"]::before,
    [data-pulse="near_you"]::before {
      animation: none;
      opacity: 0;
    }
  }

  /*
     <dialog> backdrop is opaque by default in some browsers — make
     sure we always have the soft black we want.
  */
  dialog[data-photo-lightbox] {
    border: none;
  }
</style>

<script is:inline>
  /*
     ────────────────────────────────────────────────────────────────
     Delivery tracker — client logic.
     ────────────────────────────────────────────────────────────────
     Responsibilities:
       1. Poll /api/delivery-status to keep the widget fresh.
          - 60s default, 15s when state === 'out_for_delivery'.
          - Paused when document.visibilityState !== 'visible'
            (Page Visibility API — saves Apps Script quota + battery).
       2. Update the visual state in place — no full re-render —
          when the server returns a new state.
       3. Wire the photo lightbox.

     Defensive notes:
       - We use `is:inline` so this script runs immediately on render
         and isn't bundled. The polling loop is self-contained — no
         imports, no shared state with other widgets.
       - All DOM lookups are scoped to a SINGLE widget instance via
         the [data-delivery-tracker] root. Even though only one
         widget renders per page today, scoping is correct for
         future multi-share-row layouts.
       - We never trust the server's `last_updated` blindly — we
         re-format it client-side in the visitor's timezone so
         "Updated 12s ago" math is accurate.
  */
  (function () {
    const root = document.querySelector('[data-delivery-tracker]');
    if (!root) return;

    /** @type {HTMLElement} */
    const headingEl = root.querySelector('[data-heading]');
    /** @type {HTMLElement} */
    const subheadingEl = root.querySelector('[data-subheading]');
    /** @type {HTMLElement} */
    const pulseEl = root.querySelector('[data-pulse]');
    /** @type {HTMLElement} */
    const iconEl = root.querySelector('[data-icon]');
    /** @type {HTMLElement} */
    const iconGlyphEl = root.querySelector('[data-icon-glyph]');
    /** @type {HTMLElement} */
    const photoBlockEl = root.querySelector('[data-photo-block]');
    /** @type {HTMLImageElement} */
    const photoThumbEl = root.querySelector('[data-photo-thumb]');
    /** @type {HTMLImageElement} */
    const photoFullEl = root.querySelector('[data-photo-full]');
    /** @type {HTMLButtonElement} */
    const photoTriggerEl = root.querySelector('[data-photo-trigger]');
    /** @type {HTMLDialogElement} */
    const lightboxEl = root.querySelector('[data-photo-lightbox]');
    /** @type {HTMLButtonElement} */
    const photoCloseEl = root.querySelector('[data-photo-close]');
    /** @type {HTMLElement} */
    const lastUpdatedEl = root.querySelector('[data-last-updated]');
    /** @type {HTMLElement} */
    const pollIndicatorEl = root.querySelector('[data-poll-indicator]');

    const POLL_INTERVAL_DEFAULT = 60_000;   // 60s
    const POLL_INTERVAL_ACTIVE  = 15_000;   // 15s when out_for_delivery
    let pollTimer = null;
    let inFlight = false;
    let currentState = root.getAttribute('data-state') || 'none';
    let lastUpdatedISO = new Date().toISOString();

    /* ──────────────────────────────────────────────────────────────
       Rendering helpers — applied to the SAME DOM that SSR produced.
       Each is idempotent so we can call them on every poll without
       worrying about state divergence.
       ──────────────────────────────────────────────────────────── */

    /** Translate ISO/short time to "4:15 PM". Pure. */
    function fmtTime(raw) {
      if (!raw) return '';
      const trimmed = String(raw).trim();
      if (/^\d{1,2}:\d{2}(?:\s?(?:AM|PM|am|pm))?$/.test(trimmed)) return trimmed.toUpperCase();
      const d = new Date(trimmed);
      if (Number.isNaN(d.getTime())) return trimmed;
      return new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/New_York',
        hour: 'numeric', minute: '2-digit', hour12: true,
      }).format(d);
    }

    /** Pretty "Updated 12s ago" — clock relative to lastUpdatedISO. */
    function fmtRelative(isoString) {
      const then = new Date(isoString);
      if (Number.isNaN(then.getTime())) return '';
      const deltaSec = Math.max(0, Math.round((Date.now() - then.getTime()) / 1000));
      if (deltaSec < 5) return 'just now';
      if (deltaSec < 60) return deltaSec + 's ago';
      const deltaMin = Math.round(deltaSec / 60);
      if (deltaMin < 60) return deltaMin + 'm ago';
      return fmtTime(isoString);
    }

    const TONE_CLASSES = {
      none:      ['border-ts-border'],
      packed:    ['border-ts-border'],
      out_for_delivery: ['border-ts-primary/30', 'bg-ts-primary/5'],
      near_you:  ['border-ts-primary/40', 'bg-ts-primary/5'],
      delivered: ['border-ts-primary/30', 'bg-ts-primary/5'],
      issue:     ['border-ts-danger/30', 'bg-ts-danger/5'],
    };
    const ALL_TONE_CLASSES = Object.values(TONE_CLASSES).flat();

    const ICON_TONE_CLASSES = {
      none:      ['bg-ts-bg-muted', 'text-ts-text-secondary'],
      packed:    ['bg-ts-bg-muted', 'text-ts-text-secondary'],
      out_for_delivery: ['bg-ts-primary/15', 'text-ts-primary'],
      near_you:  ['bg-ts-primary/20', 'text-ts-primary'],
      delivered: ['bg-ts-primary/15', 'text-ts-primary'],
      issue:     ['bg-ts-danger/15', 'text-ts-danger'],
    };
    const ALL_ICON_TONE_CLASSES = Object.values(ICON_TONE_CLASSES).flat();

    const ICON_GLYPHS = {
      none: '', packed: '📦', out_for_delivery: '🚚',
      near_you: '📍', delivered: '✓', issue: '!',
    };

    /**
     * Apply a new DeliveryStatus to the existing DOM. SAFE on every
     * call (no growing classlists, no leaked nodes). Switches
     * heading/subheading text node by node — never innerHTML — so
     * we can never inject untrusted markup from the server.
     */
    function applyStatus(status) {
      const state = status.state;
      const driverFirst = status.driver_name || '';
      const etaPretty = fmtTime(status.eta);
      const completedPretty = fmtTime(status.completed_at);

      // Wrapper visibility + tone
      root.setAttribute('data-state', state);
      if (state === 'none') {
        root.classList.add('hidden');
      } else {
        root.classList.remove('hidden');
      }
      // Clear all tone classes then apply the target set.
      root.classList.remove(...ALL_TONE_CLASSES);
      (TONE_CLASSES[state] || []).forEach(function (c) { root.classList.add(c); });

      // Pulse layer
      if (pulseEl) {
        pulseEl.setAttribute('data-pulse',
          state === 'out_for_delivery' || state === 'near_you' ? state : 'off'
        );
      }

      // Icon + glyph
      if (iconEl) {
        iconEl.classList.remove(...ALL_ICON_TONE_CLASSES);
        (ICON_TONE_CLASSES[state] || []).forEach(function (c) { iconEl.classList.add(c); });
      }
      if (iconGlyphEl) iconGlyphEl.textContent = ICON_GLYPHS[state] || '';

      // Heading + subheading — set as text nodes only (XSS safe).
      if (headingEl) {
        let heading = '';
        switch (state) {
          case 'packed':           heading = headingEl.textContent || ''; break; // SSR already set it
          case 'out_for_delivery': heading = driverFirst ? 'Driver ' + driverFirst + ' is on the road' : 'Your box is out for delivery'; break;
          case 'near_you':         heading = driverFirst ? 'Driver ' + driverFirst + ' is approaching' : 'Driver is approaching'; break;
          case 'delivered':        heading = 'Delivered'; break;
          case 'issue':            heading = 'We had an issue with your delivery'; break;
        }
        if (state !== 'packed') headingEl.textContent = heading;
      }

      if (subheadingEl) {
        subheadingEl.textContent = '';
        switch (state) {
          case 'packed':
            subheadingEl.textContent = "We'll update this card once the driver is on the road.";
            break;
          case 'out_for_delivery':
            if (etaPretty) {
              const lead = document.createTextNode('ETA at your stop ');
              const span = document.createElement('span');
              span.className = 'font-medium tabular-nums text-ts-text';
              span.textContent = etaPretty;
              subheadingEl.appendChild(lead);
              subheadingEl.appendChild(span);
            } else {
              subheadingEl.textContent = 'Your box is on its way.';
            }
            break;
          case 'near_you': {
            const a = document.createElement('span');
            a.className = 'font-medium text-ts-text';
            a.textContent = '~5 min away';
            subheadingEl.appendChild(a);
            if (etaPretty) {
              subheadingEl.appendChild(document.createTextNode(' · ETA '));
              const b = document.createElement('span');
              b.className = 'tabular-nums';
              b.textContent = etaPretty;
              subheadingEl.appendChild(b);
            }
            break;
          }
          case 'delivered':
            if (completedPretty) {
              subheadingEl.appendChild(document.createTextNode('Marked delivered at '));
              const span = document.createElement('span');
              span.className = 'font-medium tabular-nums text-ts-text';
              span.textContent = completedPretty;
              subheadingEl.appendChild(span);
            } else {
              subheadingEl.textContent = 'Your box has been delivered.';
            }
            break;
          case 'issue':
            subheadingEl.appendChild(document.createTextNode("We'll be in touch shortly."));
            if (status.issue_notes) {
              const span = document.createElement('span');
              span.className = 'ml-1 text-ts-text-secondary';
              span.textContent = ' ' + status.issue_notes;
              subheadingEl.appendChild(span);
            }
            break;
        }
      }

      // Photo block — only visible when delivered + photo_url present.
      if (photoBlockEl && photoThumbEl && photoFullEl) {
        if (state === 'delivered' && status.photo_url) {
          photoThumbEl.src = status.photo_url;
          photoFullEl.src = status.photo_url;
          photoBlockEl.classList.remove('hidden');
        } else {
          photoBlockEl.classList.add('hidden');
        }
      }

      // Updated state + timestamp
      currentState = state;
      lastUpdatedISO = status.last_updated || new Date().toISOString();
      if (lastUpdatedEl) lastUpdatedEl.textContent = fmtRelative(lastUpdatedISO);
    }

    /* ──────────────────────────────────────────────────────────────
       Polling loop
       ──────────────────────────────────────────────────────────── */

    function pollInterval() {
      return currentState === 'out_for_delivery' ? POLL_INTERVAL_ACTIVE : POLL_INTERVAL_DEFAULT;
    }

    async function fetchOnce() {
      if (inFlight) return;
      if (document.visibilityState !== 'visible') return;
      inFlight = true;
      if (pollIndicatorEl) pollIndicatorEl.textContent = ' · checking…';
      try {
        const res = await fetch('/api/delivery-status', {
          method: 'GET',
          credentials: 'same-origin',
          headers: { 'Accept': 'application/json' },
        });
        if (!res.ok) {
          // 401 means session expired — stop polling. Anything else
          // is transient; we'll retry on the next tick.
          if (res.status === 401) {
            stopPolling();
            return;
          }
          return;
        }
        const status = await res.json();
        applyStatus(status);
      } catch (e) {
        // Network / parse error — silent, retry on next tick.
        console.warn('[delivery-tracker] poll failed:', e && e.message ? e.message : e);
      } finally {
        inFlight = false;
        if (pollIndicatorEl) pollIndicatorEl.textContent = '';
      }
    }

    /*
       Adaptive polling — interval depends on currentState. Each tick:
       fetch, then check if the cadence needs to change; if so, drop
       the existing timer and arm a new one. This way 'out_for_delivery'
       transitions to 15s polling on the next tick after a state change.
    */
    function startPolling() {
      stopPolling();
      let lastInterval = pollInterval();
      const tick = function () {
        fetchOnce();
        const desired = pollInterval();
        if (desired !== lastInterval) {
          lastInterval = desired;
          stopPolling();
          pollTimer = setInterval(tick, desired);
        }
      };
      pollTimer = setInterval(tick, lastInterval);
    }

    function stopPolling() {
      if (pollTimer) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    // Pause on hidden, resume + fetch-once on visible. Page Visibility
    // API is supported in all browsers we target (iOS Safari 14+).
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') {
        // Immediately refresh on return so the user doesn't stare at
        // stale data while waiting for the next interval tick.
        fetchOnce();
        startPolling();
      } else {
        stopPolling();
      }
    });

    /* ──────────────────────────────────────────────────────────────
       Lightbox wiring
       ──────────────────────────────────────────────────────────── */
    if (photoTriggerEl && lightboxEl) {
      photoTriggerEl.addEventListener('click', function () {
        // <dialog>.showModal() handles focus trap + Escape-to-close
        // for free. We just open + restore focus on close.
        if (typeof lightboxEl.showModal === 'function') {
          lightboxEl.showModal();
        } else {
          // Old browsers without <dialog> — minimal fallback.
          lightboxEl.setAttribute('open', '');
          lightboxEl.style.display = 'block';
        }
      });
      lightboxEl.addEventListener('click', function (event) {
        // Click on backdrop (outside the image) closes — the inner
        // <form method="dialog"> + close button handles the rest.
        if (event.target === lightboxEl) {
          lightboxEl.close && lightboxEl.close();
        }
      });
      lightboxEl.addEventListener('close', function () {
        // Return focus to trigger.
        photoTriggerEl.focus();
      });
    }

    /* ──────────────────────────────────────────────────────────────
       Bootstrap. Update the "Updated …" relative time once per second
       (cheap — no DOM rewiring, just text replacement) and start
       polling.
       ──────────────────────────────────────────────────────────── */
    setInterval(function () {
      if (lastUpdatedEl) lastUpdatedEl.textContent = fmtRelative(lastUpdatedISO);
    }, 1000);

    if (document.visibilityState === 'visible') {
      startPolling();
    }
  })();
</script>
